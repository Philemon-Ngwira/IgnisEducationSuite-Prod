@page "/createliveclass"
@using EDUSphereSharedProject.ChatModels
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Zoom
@inherits AppBaseComponent
<MudCard>
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudAvatar Color="Color.Secondary">
                <MudIcon Icon="@Icons.Material.Filled.LiveTv"></MudIcon>
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.body1"><b>Schedule Live Class Session</b></MudText>
            <MudText Typo="Typo.body2"></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardMedia Image="images/ClassImages/LiveSessionImage.jpg" Height="250"></MudCardMedia>
    <MudCardContent>
        @if (isLoading)
        {
            <div id="loader-overlay" class="loader-overlay">
                <div class="loader-container">
                    <!-- Spinner -->
                    <div class="spinner"></div>
                    <!-- Loader Icon -->
                    <div class="loader-icon">🔄</div>
                    <!-- Loading Text -->
                    <p class="loading-text">Loading, please wait...</p>
                </div>
            </div>
        }
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           ValueChanged="GradeSelected"
                           Value="Grade"
                           Label="Select Academic Level(Grade)">
                    @foreach (var item in availableAcademicLevels)
                    {
                        <MudSelectItem T="string" Value="item">@item</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Disabled="!filteredAvailableClasses.Any()"
                           @bind-Value="Subject"
                           Label="Select Subject">
                    @foreach (var item in filteredAvailableClasses)
                    {
                        <MudSelectItem T="string" Value="item.ClassName">@item.ClassName</MudSelectItem>
                    }
                </MudSelect>

            </MudItem>
            <MudItem xs="12">
                <MudButton Class="form-Control" Variant="Variant.Filled" Color="Color.Success" OnClick="CreateMeeting" Disabled="string.IsNullOrEmpty(Grade) || string.IsNullOrEmpty(Subject)">Create Class</MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info">
                    Meeting Link:
                    @if (!string.IsNullOrEmpty(MeetingLink))
                    {
                        <p>Meeting created! Students can join here: <a href="@MeetingLink">@MeetingLink</a></p>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@MaterialDesignIcons.Normal.Chat"
                                   OnClick="ShareViaChat">
                            Share to Students in @Grade Via IgnisChat
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MaterialDesignIcons.Normal.Mail">Share to Students in @Grade Via Mail</MudButton>
                    }

                </MudAlert>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>


@code {
    private string Subject { get; set; }
    private string Grade { get; set; } = "Select Academic Level";
    private DateTime StartTime { get; set; } = DateTime.Now.AddMinutes(5);
    private string MeetingLink { get; set; }
    [Inject] LessonService lessonService { get; set; } = default!;
    [Inject] NavigationManager navigationManager { get; set; } = default!;
    protected Teacher teacher = new();
    protected bool isLoading;
    protected List<Class> allAvailableClasses = new();
    protected List<Class> filteredAvailableClasses = new();
    protected List<string> availableAcademicLevels = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await GetClasses();
        isLoading = false;
    }
    private async Task ShareViaChat()
    {
        if (string.IsNullOrEmpty(MeetingLink)) return;

        var request = new ShareLiveClassRequest
        {
            Grade = academicLevels.Where(x => x.LevelName == Grade).Select(x => x.LevelInt.ToString()).First(),
            Subject = Subject,
            TeacherId = AppState.UserID,
            MeetingLink = MeetingLink,
            StartTime = StartTime
        };

        var response = await HttpClient.PostAsJsonAsync("api/Zoom/ShareToChat", request);
        var result = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();

        // Navigate teacher to chat page with group opened
        if (result != null && result.ContainsKey("groupName"))
        {
            navigationManager.NavigateTo($"/MainChat?openGroup={Uri.EscapeDataString(result["groupName"])}");
        }
    }
    protected async Task GetClasses()
    {
        await GetTeachers();
        var result = GenericService.GetService<Class>();
        var service = await result.GetAllAsync($"api/Dynamic/GetClassesBySchoolID/{AppState.SchoolID}", true);

        if (service?.Data == null) return; // Null safety check
        // Filter only relevant classes
        var filteredClasses = service.Data
            .Where(item => item.TeacherID == teacher.TeacherID)
            .ToList();
        allAvailableClasses = filteredClasses.ToList();
        foreach (var item in allAvailableClasses)
        {
            if (string.IsNullOrEmpty(item.LevelName))
            {
                item.LevelName = academicLevels.Where(x => x.LevelInt == item.AcademicLevel).Select(c => c.LevelName).FirstOrDefault();
            }
        }
        availableAcademicLevels = filteredClasses.Select(x => x.LevelName).Distinct().ToList();

    }
    protected async Task GetTeachers()
    {

        var UserID = AppState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            var result = GenericService.GetService<Teacher>();
            var service = await result.GetAllAsync($"api/Dynamic/GetTeacherByUserID/{UserID}", true);
            var teachers = service.Data.ToList();
            if (teachers.Any())
            {
                teacher = teachers.FirstOrDefault();
            }
        }

    }
    private async Task CreateMeeting()
    {
        isLoading = true;
        var request = new
        {
            Topic = $"{Subject} Grade {Grade}",
            StartTime = StartTime,
            Duration = 60,
            Password = "",
            TeacherEmail = "ngwira.philemon@gmail.com"
        };

        var response = await HttpClient.PostAsJsonAsync("api/zoom/createmeeting", request);
        response.EnsureSuccessStatusCode();

        var result = await response.Content.ReadFromJsonAsync<ZoomMeetingResponse>();

        // Generate the front-end link for students
        var LiveMeetingReady = await SaveLiveMeetingMasterData(result);
        if (LiveMeetingReady)
            MeetingLink = $"/liveclass/{result.MeetingNumber}/{result.Password}";
        isLoading = false;
    }
    protected async Task<bool> SaveLiveMeetingMasterData(ZoomMeetingResponse zoomMeeting)
    {
        LiveMeeting newMeeting = new()
        {
            MeetingID = Guid.NewGuid(),
            MeetingNumber = zoomMeeting.MeetingNumber,
            MeetingPassword = zoomMeeting.Password,
            CreatedBy = Guid.Parse(AppState.UserID),
            CreatedDate = DateTime.UtcNow,
            CreatorEmail = AppState.UserEmail,
            ScheduledDate = StartTime,
            isDone = false,

        };
        var service = GenericService.GetService<LiveMeeting>();
        var result = await service.PostAsync("api/Dynamic/PostEntity", "livemeeting", newMeeting);
        if (result.IsSuccess)
        {
            Console.WriteLine("Live meeting master data saved successfully.");
            return true;
        }
        else
        {
            Console.WriteLine("Failed to save live meeting master data.");
            return false;
        }
    }


    protected void GradeSelected(string Value)
    {
        Grade = Value;
        filteredAvailableClasses = allAvailableClasses.Where(x => x.LevelName == Grade).ToList();
    }

    public class CreateMeetingResponse
    {
        public string MeetingNumber { get; set; }
        public string JoinUrl { get; set; }
    }
}
