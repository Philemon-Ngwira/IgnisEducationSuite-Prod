                                <PropertyColumn Property="x => x.QuestionNumber" Title="#" Editable="false" />
                                <PropertyColumn Property="x => x.QuestionText" />
                                <PropertyColumn Property="x => x.Marks" />

                                <TemplateColumn CellClass="d-flex justify-end">
                                    <CellTemplate>
                                        <MudStack Row>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                           OnClick="@context.Actions.StartEditingItemAsync" />
                                            <MudIconButton Icon="@Icons.Material.Outlined.List"
                                                           OnClick="() => OpenMultipleChoiceDialog(context.Item.QuestionID)" />
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth
                                   EndIcon="@Icons.Material.Filled.Save">
                            Save Exam
                        </MudButton>
                    }
                </MudPaper>
            }
