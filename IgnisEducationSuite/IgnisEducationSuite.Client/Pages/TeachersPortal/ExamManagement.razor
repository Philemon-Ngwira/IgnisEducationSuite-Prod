                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="@examQuizTestQuestion.Marks" T="int" Label="Question Score" Placeholder="Enter Question Score"></MudNumericField>
                        </MudItem>
