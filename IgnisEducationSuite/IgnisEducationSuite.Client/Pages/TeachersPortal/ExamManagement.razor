    #region To String Func

    protected Func<vw_ClassTeacherDetail, string> ClassTypeConverter = p =>
   {
       if (p == null)
       {
           return "";
       }

       var className = p.ClassName ?? "";
       var teacherFirstName = p.FirstName ?? "";
       var teacherLastName = p.LastName ?? "Teacher";
       var gradeName = p.LevelName ?? "";
       var levelSect = p.GradeSection ?? "";
       return $"{className}:{gradeName}{levelSect}-({teacherFirstName.Substring(0, 1)}.{teacherLastName})";
   };
    #endregion
