@page "/ExamQuizTestManagement"
@using EDUSphereSharedProject.Models
@using IgnisEducationSuite.Client.Pages.TeachersPortal.Dialogs
@inherits AppBaseComponent
@inject IDialogService DialogService

<MudCard Class="p-4">

    <MudText Align="Align.Center" Typo="Typo.h4" Class="mb-2"><b>Exam, Test & Quiz Management</b></MudText>
    <MudDivider Class="mb-4" />

    <MudTabs Class="mb-4" Rounded="true" Elevation="1" Centered="true" Color="@Color.Dark">

        <!-- -------------------------------------- -->
        <!--                EXAMS TAB               -->
        <!-- -------------------------------------- -->
        <MudTabPanel Text="Exams">

            <MudPaper Class="p-4 mb-4" Elevation="0" Style="background:#f8f8f8;">
                <MudText Typo="Typo.h6" Class="mb-3"><b>Exam Information</b></MudText>

                <MudGrid Class="mb-2">
                    <MudItem xs="12">
                        <MudTextField FullWidth @bind-Value="examQuizTestHeader.Title" Label="Exam Title"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField FullWidth Lines="3" @bind-Value="examQuizTestHeader.Description"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Label="Exam Description" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudNumericField FullWidth @bind-Value="examQuizTestHeader.TotalMarks"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Label="Total Marks" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudDatePicker FullWidth Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Label="Exam Date" @bind-Date="_date" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect FullWidth T="vw_ClassTeacherDetail" Label="Subject"
                                   @bind-Value="vw_Class" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Placeholder="Select Class"
                                   ToStringFunc="ClassTypeConverter">

                            @foreach (var item in vw_Classes)
                            {
                                <MudSelectItem Value="item">
                                    Grade @item.LevelName @item.GradeSection @item.ClassName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth
                                   EndIcon="@Icons.Material.Filled.SaveAlt"
                                   OnClick="() => CreateTestExamQuiz(1)">
                            Create New Exam
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- AFTER EXAM IS CREATED -->
            @if (examCreated)
            {
                <MudPaper Class="p-4 mb-4" Elevation="0" Style="background:#f8f8f8;">
                    <MudText Typo="Typo.h6" Class="mb-3"><b>Enter Exam Questions</b></MudText>

                    <MudCheckBox T="bool" @bind-Value="UseGPT" Label="Use ChatGPT?" Class="mb-3" />

                    @if (UseGPT)
                    {
                        <MudTextField FullWidth @bind-Value="GPTQuery" Label="Enter GPT Query"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Placeholder="Ask ChatGPT..." Class="mb-3" />

                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   EndIcon="@Icons.Material.Filled.AutoAwesome"
                                   OnClick="SendMessage" Class="mb-3">
                            Generate Questions
                        </MudButton>
                    }

                    <MudDivider Class="mb-4" />

                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Upload Question Document</b></MudText>
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnFileUpload" Class="mb-4">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload">
                                Upload Questions
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Manually Enter Questions</b></MudText>

                    <MudGrid>
                        <MudItem xs="12" md="10">
                            <MudTextField FullWidth Variant="Variant.Outlined" Margin="Margin.Dense"
                                          @bind-Value="examQuizTestQuestion.QuestionText"
                                          Label="Question Text" />
                        </MudItem>

                        <MudItem xs="12" md="2">
                            <MudNumericField FullWidth Variant="Variant.Outlined" Margin="Margin.Dense"
                                             @bind-Value="examQuizTestQuestion.Marks"
                                             Label="Marks" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth
                                       EndIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddQuestionManually">
                                Add Question
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    @if (questions.Any())
                    {
                        <MudText Typo="Typo.h6" Class="mb-2"><b>Edit Questions</b></MudText>

                        <MudDataGrid T="ExamQuizTestQuestion" Items="@questions"
                                     Dense="true" Bordered="true" EditMode="DataGridEditMode.Form"
                                     EditTrigger="DataGridEditTrigger.OnRowClick"
                                     StartedEditingItem="@StartedEditingItem"
                                     CanceledEditingItem="@CanceledEditingItem"
                                     CommittedItemChanges="@CommittedItemChanges"
                                     Class="mb-4">

