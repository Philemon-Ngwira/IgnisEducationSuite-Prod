@code {



    protected bool isLoading = false;
    protected ExamQuizTestHeader examQuizTestHeader = new();
    protected ExamQuizTestQuestion examQuizTestQuestion = new();
    protected QuestionParser questionParser = new();
    protected Teacher teacher = new();
    private DateTime? _date = DateTime.Today;
    protected List<vw_ClassTeacherDetail> vw_Classes = new();
    protected List<Class> classes = new();
    protected List<ExamQuizTestQuestion> questions = new();
    protected string UserID = string.Empty;
    protected vw_ClassTeacherDetail vw_Class = new();
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] ChatClientService ChatClientService { get; set; } = default!;
    protected Class selectedClass = new();
    protected List<ExamTestQuizMultipleChoiceAnswer> QuestionOptions = new();
    [Inject] HttpClient Http { get; set; } = default!;
    protected bool examCreated = false;
    protected bool testCreated = false;
    protected bool quizCreated = false;
    protected bool UseGPT = false;
    protected string GPTQuery;
    protected string responseMessage = string.Empty;
    private List<string> _events = new();
    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("initializing Environment please wait...");
        await GetClassTeacherDetails();

        await GetTeachers();
        await GetClasses();
        LoaderService.Hide();
    }
    protected async Task GetClasses()
    {
        var result = _genericService.GetService<Class>();
        var service = await result.GetAllAsync($"api/Dynamic/GetClassesBySchoolID/{teacher.SchoolID}", true);

        if (service?.Data == null) return; // Null safety check

        // Filter only relevant classes
        var filteredClasses = service.Data
            .Where(item => item.TeacherID == teacher.TeacherID)
            .ToList();

        // Assign teacher before adding
        foreach (var item in filteredClasses)
        {
            item.Teacher = teacher;
            if (string.IsNullOrEmpty(item.LevelName))
            {
                item.LevelName = academicLevels.Where(x => x.LevelInt == item.AcademicLevel)
                                .Select(a => a.LevelName).First();
            }
            classes.Add(item);
        }
    }

    protected async Task GetTeachers()
    {

        UserID = AppState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            var result = _genericService.GetService<Teacher>();
            var service = await result.GetAllAsync($"api/Dynamic/GetTeacherByUserID/{UserID}", true);
            var teachers = service.Data.ToList();
            if (teachers.Any())
            {
                teacher = teachers.FirstOrDefault();
            }
        }

    }
    protected async Task GetClassTeacherDetails()
    {


        UserID = AppState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            var service = _genericService.GetService<vw_ClassTeacherDetail>();
            var result = await service.GetAllAsync($"api/Dynamic/GetEntity/{"classteacherdetails"}", true);

            if (result.IsSuccess)
            {
                vw_Classes = result.Data.Where(x => x.UserID == UserID).ToList();
                foreach (var item in vw_Classes)
                {
                    item.LevelName = academicLevels.Where(x => x.LevelInt == item.AcademicLevel)
                    .Select(c => c.LevelName)
                    .First();
                }
            }
        }

    }
    protected void CreateTestExamQuiz(int type)
    {
        bool cantContinue = false;
        if (vw_Class.TeacherID != null)
        {
            examQuizTestHeader.TeacherID = vw_Class.TeacherID.Value;
            examQuizTestHeader.ClassID = vw_Class.ClassID;
        }
        examQuizTestHeader.EndDate = examQuizTestHeader.StartDate;
        examQuizTestHeader.CreatedDate = DateTime.Today;
        examQuizTestHeader.Teacher = teacher;
        examQuizTestHeader.Class = classes.Where(x => x.ClassID == vw_Class.ClassID).FirstOrDefault();

        switch (type)
        {
            case 1: //Exam Entered
                examQuizTestHeader.ExamType = "Exam";
                cantContinue = checknullValues.HasNullNonVirtualProperties<ExamQuizTestHeader>(examQuizTestHeader);
                if (cantContinue)
                {
                    examCreated = false;
                    Snackbar.Add("Fill in all information to continue", Severity.Error);
                    return;
                }
                else
                {
                    examCreated = true;
                }
                break;
            case 2: //Test Entered
                examQuizTestHeader.ExamType = "Test";
                cantContinue = checknullValues.HasNullNonVirtualProperties<ExamQuizTestHeader>(examQuizTestHeader);
                if (cantContinue)
                {
                    testCreated = false;
                    Snackbar.Add("Fill in all information to continue", Severity.Error);
                    return;
                }
                else
                {
                    testCreated = true;
                }
                break;
            case 3: //Quiz Entered
                examQuizTestHeader.ExamType = "Quiz";
                cantContinue = checknullValues.HasNullNonVirtualProperties<ExamQuizTestHeader>(examQuizTestHeader);
                if (cantContinue)
                {
                    quizCreated = false;
                    Snackbar.Add("Fill in all information to continue", Severity.Error);
                    return;
                }
                else
                {
                    quizCreated = true;
                }
                break;
        }
    }
    protected async Task GenerateAssignmentQuestionsUsingGPT(bool useGPT)
    {
        this.UseGPT = useGPT;

    }

    protected async Task SaveAssignment()
    {
        LoaderService.Show("Saving, please wait....");
        examQuizTestHeader.ExamQuizID = Guid.NewGuid();
        examQuizTestHeader.StartDate = _date.Value;
        examQuizTestHeader.EndDate = examQuizTestHeader.StartDate;
        examQuizTestHeader.TeacherID = examQuizTestHeader.Teacher.TeacherID;
        examQuizTestHeader.ClassID = examQuizTestHeader.Class.ClassID;
        examQuizTestHeader.Teacher = null;
        examQuizTestHeader.Class = null;
        var serviceHeader = _genericService.GetService<ExamQuizTestHeader>();
        var headerResult = await serviceHeader.PostAsync("api/Dynamic/PostEntity", "examquiztestheader", examQuizTestHeader);
        if (headerResult.IsSuccess)
        {
            Snackbar.Add("Phase one completed Successfully, Please wait while we complete the final phase");
            await SaveDetails(headerResult.Data.ExamQuizID);
        }
        else
        {
            Snackbar.Add("An Error Occured while saving the assignment, please check your network and try again");
            return;
        }
        LoaderService.Hide();

    }
    protected async Task SaveDetails(Guid headerID)
    {
        List<ExamQuizTestQuestion> finalList = new();
        foreach (var item in questions)
        {
            if (item.QuestionText == null || item.Marks == 0)
            {
                return;
            }
            else
            {
                item.ExamQuizID = headerID;
                item.QuestionType = "ShortAnswer";
                if (item.isMultipleChoice == true)
                {
                    item.Options = "HasOptions";
                }
                finalList.Add(item);
            }
        }
        if (finalList.Count != questions.Count)
        {
            Snackbar.Add("Please fill in all required question details", Severity.Error);
            return;
        }
        else
        {

            var service = _genericService.GetService<List<ExamQuizTestQuestion>>();
            var result = await service.PostAsync("api/Dynamic/PostEntities", "examquestion", finalList);
            if (result.IsSuccess)
            {
                await SaveExamMultipleChoices();
                Snackbar.Add("assignment Saved Successfully", Severity.Success);
                questions.Clear();
                examQuizTestHeader = new();
                examQuizTestQuestion = new();
                StateHasChanged();

            }
        }
    }
    //Save Multiple Choice Options
    protected async Task SaveExamMultipleChoices()
    {
        if (QuestionOptions.Any())
        {
            var service = _genericService.GetService<List<ExamTestQuizMultipleChoiceAnswer>>();
            var result = await service.PostAsync("api/Dynamic/PostEntities", "exammultiplechoices", QuestionOptions);
            if (result.IsSuccess)
            {
                Snackbar.Add("Options Saved Successfully", Severity.Success);
                QuestionOptions.Clear();
                StateHasChanged();
            }
        }
    }
    protected void AddQuestionManually()
    {
        if (!string.IsNullOrWhiteSpace(examQuizTestQuestion.QuestionText) && examQuizTestQuestion.Marks != null)
        {
            examQuizTestQuestion.QuestionID = Guid.NewGuid();

            // Assign next question number
            examQuizTestQuestion.QuestionNumber = questions.Count + 1;

            questions.Add(examQuizTestQuestion);

            // Reset the form
            examQuizTestQuestion = new();

            StateHasChanged();
            Snackbar.Add("Question Added Successfully", Severity.Success);
        }
        else
        {
            Snackbar.Add("Fill in both Question and Marks to add question", Severity.Error);
        }
    }

    protected async Task OpenMultipleChoiceDialog(Guid QuestionID)
    {
        var parameters = new DialogParameters<MultipleChoiceManagementDialog>
    {
        { x => x.isExam, true },
        { x => x.QuestionID, QuestionID}
    };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge };
        var dialog = await DialogService.ShowAsync<MultipleChoiceManagementDialog>("Add Choices", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is List<ExamTestQuizMultipleChoiceAnswer> questionOptions)
        {
            if (QuestionOptions is null)
                QuestionOptions = new List<ExamTestQuizMultipleChoiceAnswer>();
            questions.FirstOrDefault(x => x.QuestionID == QuestionID).isMultipleChoice = true;
            QuestionOptions.AddRange(questionOptions);


            // You can now use `QuestionOptions` elsewhere in your component
            StateHasChanged(); // Ensure UI updates
        }
    }
    private async Task OnFileUpload(IBrowserFile file)
    {

        var content = new MultipartFormDataContent();
        content.Add(new StreamContent(file.OpenReadStream()), "file", file.Name);
        var absoluteUri = new Uri(new Uri(_navigationManager.BaseUri), "api/upload/uploadWord");
        var response = await Http.PostAsync(absoluteUri, content);

        if (response.IsSuccessStatusCode)
        {
            questions = await response.Content.ReadFromJsonAsync<List<ExamQuizTestQuestion>>();
        }
        else
        {
            Console.WriteLine("Error uploading file.");
        }
    }

    private async Task SendMessage()
    {
        LoaderService.Show("Thinking for the best answer please wait..");
        if (!string.IsNullOrEmpty(GPTQuery))
        {
            responseMessage = await ChatClientService.GetChatResponseAsync("api/Chat/AskChatGPT", GPTQuery);
            GPTQuery = string.Empty;

            questions = GenerateQuestions(responseMessage);
            foreach (var item in questions)
            {

                item.QuestionID = Guid.NewGuid();
            }
        }
        LoaderService.Hide();
    }
    public List<ExamQuizTestQuestion> GenerateQuestions(string query)
    {

        return questionParser.ParseExamQuestionsFromResponse(query);
    }

