    #region To String Func

    protected Func<Class, string> ClassTypeConverter = p =>
   {
       if (p == null)
       {
           return "";
       }

       var className = p.ClassName ?? "";
       var teacherFirstName = p.Teacher?.FirstName ?? "";
       var teacherLastName = p.Teacher?.LastName ?? "Teacher";
       var gradeName = p.LevelName ?? "";

       return $"{className}:{gradeName},{teacherFirstName.Substring(0, 1)}.{teacherLastName}";
   };
    #endregion
