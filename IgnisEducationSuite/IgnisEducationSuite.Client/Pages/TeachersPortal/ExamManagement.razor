@page "/ExamQuizTestManagement"
@using EDUSphereSharedProject.Models
@using IgnisEducationSuite.Client.Pages.TeachersPortal.Dialogs
@inherits AppBaseComponent
@inject IDialogService DialogService
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>EXAM,QUIZ,TEST MANAGEMENT</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />
        @if (isLoading)
        {
            <div id="loader-overlay" class="loader-overlay">
                <div class="loader-container">
                    <!-- Spinner -->
                    <div class="spinner"></div>
                    <!-- Loader Icon -->
                    <div class="loader-icon">🔄</div>
                    <!-- Loading Text -->
                    <p class="loading-text">Loading, please wait...</p>
                </div>
            </div>
        }
        <MudTabs Class="mb-3" Elevation="4" Rounded="true" Centered="true" Color="@Color.Primary">
            <MudTabPanel Text="Exams">
                <MudGrid Class="mb-3">
                    <MudItem Class="mb-3" xs="12">
                        <MudAlert Severity="Severity.Normal" Dense="true" Variant="Variant.Filled">Exam Information</MudAlert>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="@examQuizTestHeader.Title" Label="Exam Title" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Enter Exam Title"></MudTextField>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Lines="3" @bind-Value="@examQuizTestHeader.Description" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Exam Description" Placeholder="Enter a Description can even be instructions"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="@examQuizTestHeader.TotalMarks" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Exam Total Mark" Placeholder="Enter Total marks "></MudNumericField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Label="Exam Date" @bind-Date="_date" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="vw_ClassTeacherDetail" Placeholder="Select Subject" Label="Subject" ToStringFunc="ClassTypeConverter" @bind-Value="vw_Class" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var item in vw_Classes)
                            {
                                <MudSelectItem T="vw_ClassTeacherDetail" Value="item">Grade: @item.AcademicLevel @item.ClassName</MudSelectItem>

                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.SaveAlt" OnClick="() => CreateTestExamQuiz(1)" Color="Color.Primary">Create New Exam</MudButton>
                    </MudItem>
                </MudGrid>
                @if (examCreated)
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Filled">Enter Exam Question</MudAlert>
                    <MudCheckBox Label="Use Chat GPT?" Value="UseGPT" T="bool" ValueChanged="GenerateAssignmentQuestionsUsingGPT"></MudCheckBox>
                    @if (UseGPT)
                    {
                        <MudTextField Class="mb-3" @bind-Value="@GPTQuery" Label="GPT Query" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ask ChatGPT"></MudTextField>

                        <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.SaveAlt" OnClick="SendMessage" Color="Color.Primary">Generate Questions</MudButton>


                    }
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Filled">Upload Question Document</MudAlert>
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnFileUpload">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
