@page "/ExamAnswers"
@using EDUSphereSharedProject.Models
@inherits AppBaseComponent

<MudCard Class="pa-4">

    <!-- Header -->
    <MudCardHeader Class="mb-2">
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4" Class="font-weight-bold">
                Answers
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>

        <!-- Exam Details -->
        <MudPaper Elevation="1" Class="pa-4 mb-4 rounded">
            <MudText Typo="Typo.h6" Class="mb-2 font-weight-bold">
                Exam Details
            </MudText>

            <MudDivider Class="mb-4" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText>Exam Title: <b>@LessonService.ExamDetails.Title</b></MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText>Type: <b>@LessonService.ExamDetails.ExamType</b></MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText>Subject: <b>@LessonService.ExamDetails.ClassName</b></MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText>Student: <b>@($"{LessonService.ExamDetails.FirstName} {LessonService.ExamDetails.LastName} • {LessonService.ExamDetails.StudentNumber}")</b></MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText>Total Marks: <b>@LessonService.ExamDetails.TotalMarks</b></MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>


        <!-- Answers Section -->
        <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">Exam Answers</MudText>
        <MudDivider Class="mb-4" />

        @foreach (var item in answers)
        {
            <MudPaper Elevation="0" Class="pa-3 mb-3 border rounded">

                @if (item.Question?.isMultipleChoice == true)
                {
                    <!-- Multiple Choice Question -->
                    <MudGrid>
                        <MudItem xs="12" md="9">
                            <MudText Typo="Typo.body1" Class="font-weight-medium">
                                Q @item.Question.QuestionNumber: @item.Question.QuestionText 
                                <span class="text-secondary">(@item.Question.Marks marks)</span>
                            </MudText>
                        </MudItem>

                        <MudItem xs="6" md="1">
                            <MudCheckBox T="bool?" Value="@(item.isCorrect ?? false)"
                                         ValueChanged="@(v => SetCorrect(item, v.Value))"
                                         Label="Correct"
                                         Dense="true"
                                         Color="Color.Success"
                                         Disabled="@((item.isWrong ?? false))"/>
                        </MudItem>

                        <MudItem xs="6" md="1">
                            <MudCheckBox T="bool?" Value="@(item.isWrong ?? false)"
                                         ValueChanged="@(v => SetWrong(item, v.Value))"
                                         Label="Wrong"
                                         Dense="true"
                                         Color="Color.Error"
                                         CheckedIcon="@Icons.Material.Filled.Cancel"
                                         Disabled="@((item.isCorrect ?? false))"/>
                        </MudItem>

                        <!-- Choices -->
                        <MudItem xs="12" Class="mt-3">
                            <MudList T="string" Disabled="true">
                                @foreach (var choice in LessonService.ExamAnswerChoices
                                        .Where(a => a.ExamTestQuizQuestionID == item.QuestionID)
                                        .OrderBy(x => x.MultipleChoiceLetter))
                                {
                                    <MudListItem>
                                        <MudCheckBox Disabled="true"
                                                     Value="@(choice.MultipleChoiceLetter == item.AnswerText)">
                                            <span>
                                                <b>@choice.MultipleChoiceLetter)</b> @choice.MuiltpleChoiceAnswer
                                            </span>
                                        </MudCheckBox>
                                    </MudListItem>
                                }
                            </MudList>
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <!-- Written Question -->
                    <MudGrid>
                        <MudItem xs="12" md="9">
                            <MudText Typo="Typo.body1" Class="font-weight-medium">
                                Q @item.Question?.QuestionNumber: 
                                @item.Question?.QuestionText 
                                <span class="text-secondary">(@item.Question?.Marks marks)</span>
                            </MudText>
                        </MudItem>

                        <MudItem xs="6" md="1">
                            <MudCheckBox T="bool?" Value="@(item.isCorrect ?? false)"
                                         ValueChanged="@(v => SetCorrect(item, v.Value))"
                                         Label="Correct"
                                         Dense="true"
                                         Color="Color.Success"
                                         Disabled="@((item.isWrong ?? false))"/>
                        </MudItem>

                        <MudItem xs="6" md="1">
                            <MudCheckBox T="bool?" Value="@(item.isWrong ?? false)"
                                         ValueChanged="@(v => SetWrong(item, v.Value))"
                                         Label="Wrong"
                                         Dense="true"
                                         Color="Color.Error"
                                         CheckedIcon="@Icons.Material.Filled.Cancel"
                                         Disabled="@((item.isCorrect ?? false))"/>
                        </MudItem>

                        <MudItem xs="12" Class="mt-3">
                            <MudText Typo="Typo.body2" Class="italic">
                                <b>Answer:</b> @item.AnswerText
                            </MudText>
                        </MudItem>
                    </MudGrid>
                }
            </MudPaper>
        }


        <!-- Complete Button -->
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   EndIcon="@Icons.Material.Filled.Checklist"
                   OnClick="CompleteExamTestQuizMarking"
                   Class="mt-4">
            Complete Marking
        </MudButton>

    </MudCardContent>

</MudCard>

@code {
    protected List<StudentExamQuizAndTestAnswer> answers = new();
    [Inject] LessonService LessonService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Initializing Please wait...");
        await Task.Delay(1000);

        // Ensure answers are ordered by question number (safe if Question may be null)
        answers = LessonService.studentExamAnswers?
                    .OrderBy(a => a.Question?.QuestionNumber ?? int.MaxValue)
                    .ToList() ?? new List<StudentExamQuizAndTestAnswer>();

        LoaderService.Hide();
    }

    // Ensures only one of isCorrect/isWrong is true and avoids null problems
    private void SetCorrect(StudentExamQuizAndTestAnswer item, bool value)
    {
        item.isCorrect = value;
        if (value)
            item.isWrong = false;
    }

    private void SetWrong(StudentExamQuizAndTestAnswer item, bool value)
    {
        item.isWrong = value;
        if (value)
            item.isCorrect = false;
    }

    protected async Task CompleteExamTestQuizMarking()
    {
        // Calculate total possible: sum unique questions' marks (safe if Question null)
        var totalPossible = answers
            .GroupBy(a => a.QuestionID)
            .Select(g => g.First().Question?.Marks ?? 0)
            .Sum();

        // If there are no marks, avoid divide-by-zero
        if (totalPossible <= 0)
            totalPossible = 1;

        // Assign marks obtained per answer
        foreach (var item in answers)
        {
            if (item.isCorrect == true)
            {
                item.MarksObtained = item.Question?.Marks ?? 0;
                // Do NOT set item.Question = null here; we'll null only for the API payload below if needed
            }
            else
            {
                item.MarksObtained = 0;
            }
        }

        var totalObtained = answers.Sum(c => c.MarksObtained);

        var studentExam = LessonService.ExamQuizTest;
        studentExam.Grade = ((decimal)totalObtained / (decimal)totalPossible) * 100m;
        studentExam.Status = "Graded";

        var SAService = GenericService.GetService<StudentExamsTestsAndQuiz>();
        var SAResult = await SAService.UpdateAsync("api/Dynamic/UpdateEntity", "studentexamsheader", studentExam);

        if (!SAResult.IsSuccess)
        {
            Snackbar.Add("Error saving exam header. Check your internet.", Severity.Error);
            return;
        }

        // Prepare answers payload: temporarily null Question navigation property to avoid circular/virtual issues
        var originalQuestions = answers.Select(a => a.Question).ToList();
        try
        {
            foreach (var a in answers)
                a.Question = null;

            var answerService = GenericService.GetService<List<StudentExamQuizAndTestAnswer>>();
            var result = await answerService.UpdateAsync("api/Dynamic/UpdateEntities", "examanswers", answers);

            if (result.IsSuccess)
            {
                Snackbar.Add($"Marking of Student Exam Completed!", Severity.Success);
                NavigationManager.NavigateTo("/ExamMarking");
            }
            else
            {
                Snackbar.Add("Error saving answers. Check your internet.", Severity.Error);
            }
        }
        finally
        {
            // Restore question navigation props for UI after update attempt
            for (int i = 0; i < answers.Count && i < originalQuestions.Count; i++)
            {
                answers[i].Question = originalQuestions[i];
            }
        }
    }
}
