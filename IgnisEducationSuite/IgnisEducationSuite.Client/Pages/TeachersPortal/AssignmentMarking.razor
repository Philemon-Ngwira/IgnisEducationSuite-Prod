@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@inherits AppBaseComponent
@page "/AssingmentChecking"
<MudCard Elevation="2" Class="pa-4">

    <!-- Header -->
    <MudCardHeader>
        <MudText Align="Align.Center" Typo="Typo.h4" Class="mb-0"><b>Assignments</b></MudText>
    </MudCardHeader>

    <MudDivider Class="my-2" />

    <MudCardContent>

        <MudTable Items="@assignmentsResults"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  FixedHeader="true"
                  Height="500px"
                  Dense="true"
                  GroupBy="@_groupDefinition"
                  GroupHeaderStyle="background-color: var(--mud-palette-background-grey-light); font-weight: 500;"
                  GroupFooterClass="mud-table-cell-custom-group-footer mb-4"
                  @ref="_tableRef">

            <ColGroup>
                <col style="width: 60px;" />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col style="width: 60px;" />
            </ColGroup>

            <!-- Table Header -->
            <HeaderContent>
                <MudTh>First Name</MudTh>
                <MudTh>Last Name</MudTh>
                <MudTh>Score</MudTh>
                <MudTh>Class</MudTh>
                <MudTh>Total Marks</MudTh>
                <MudTh>Level</MudTh>
                <MudTh>Submission Date</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>

            <!-- Group Header -->
            <GroupHeaderTemplate>
                <MudTh ColSpan="9" Class="mud-table-cell-custom-group">
                    <b>@($"{context.GroupName}: {context.Key}")</b>
                </MudTh>
            </GroupHeaderTemplate>

            <!-- Row Template -->
            <RowTemplate>
                <MudTd DataLabel="First Name">@context.FirstName</MudTd>
                <MudTd DataLabel="Last Name">@context.LastName</MudTd>
                <MudTd DataLabel="Score">@context.Grade</MudTd>
                <MudTd DataLabel="Class">@context.ClassName</MudTd>
                <MudTd DataLabel="Total Marks">@context.TotalMarks</MudTd>
                <MudTd DataLabel="Level">@context.LevelName</MudTd>
                <MudTd DataLabel="Submission Date">@context.SubmissionDate?.ToShortDateString()</MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Overdue == 1)
                    {
                        <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Warning">Overdue</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">@context.Status</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Action">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                   OnClick="() => NavigateToDetails(context)"
                                   ToolTip="Edit Assignment" />
                </MudTd>
            </RowTemplate>

            <!-- Group Footer -->
            <GroupFooterTemplate>
                <MudTh ColSpan="9" Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer">
                    <b>Total Submitted Assignments: @context.Items.Count()</b>
                </MudTh>
            </GroupFooterTemplate>

        </MudTable>
    </MudCardContent>

</MudCard>

<style>
    /* Polished custom styles */
    .mud-table-cell-custom-group {
        font-weight: 600;
        background-color: var(--mud-palette-background-grey-light);
    }

    .mud-table-cell-custom-group-footer {
        padding-top: 10px;
        padding-bottom: 20px;
        text-align: right;
        font-weight: 500;
        font-size: 0.95rem;
        color: var(--mud-palette-text-secondary);
    }
</style>


@code {
    protected List<GetTeacherAssignmentsResult> assignmentsResults = new();

    private MudTable<GetTeacherAssignmentsResult> _tableRef;
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    [Inject] LessonService LessonService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    protected string UserID = string.Empty;
    protected bool isLoading = false;
    private TableGroupDefinition<GetTeacherAssignmentsResult> _groupDefinition = new()
    {
        GroupName = "Class",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = false,
        Selector = (e) => e.ClassName
    };


    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Preparing Environment Please wait...");

        UserID = AppState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            await GetAssignments();
        }
        LoaderService.Hide();
        //Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    protected async Task GetAssignments()
    {
        var service = _genericService.GetService<GetTeacherAssignmentsResult>();
        var result = await service.GetAllAsync($"api/Dynamic/GetTeacherAssignments/{UserID}", true);
        if (result.IsSuccess)
        {
            assignmentsResults = result.Data.ToList();
            foreach (var item in assignmentsResults)
            {
                item.LevelName = academicLevels.Where(x => x.LevelInt == item.GradeLevel).Select(c => c.LevelName).First();
            }
        }
    }

    protected async Task NavigateToDetails(GetTeacherAssignmentsResult result)
    {
        LoaderService.Show("Gathering data please wait...");
        await GetAssignmentDetails(result.StudentAssignmentID);
        LessonService.studentID = result.StudentID.Value;
        LessonService.assignmentID = result.AssignmentID.Value;
        var SA = new StudentAssignment()
        {
            StudentAssignmentID = result.StudentAssignmentID,
            StudentID = result.StudentID,
            AssignmentID = result.AssignmentID,
            SubmissionDate = result.SubmissionDate,
            Grade = 0,
            Status = result.Status,
            QuestionID = result.QuestionID
        };
        LessonService.Assignment = SA;

        LoaderService.Hide();
        _navigationManager.NavigateTo("/MarkingAssignmentDetails");
    }

    protected async Task GetAssignmentDetails(Guid id)
    {

        var service = _genericService.GetService<StudentAssignmentAnswer>();
        var result = await service.GetAllAsync($"api/Dynamic/GetAssignmentAnswers/{id}", true);
        if (result.IsSuccess)
        {
            LessonService.studentAssignmentAnswers = result.Data.ToList();

        }
        else
        {
            Snackbar.Add("Failed to Assignment Details, Please refresh and try again", Severity.Error);
        }

    }
}
