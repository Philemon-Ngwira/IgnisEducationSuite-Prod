@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@inherits AppBaseComponent
@page "/AssingmentChecking"
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Assignments</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    @if (isLoading)
    {
        <div id="loader-overlay" class="loader-overlay">
            <div class="loader-container">
                <!-- Spinner -->
                <div class="spinner"></div>
                <!-- Loader Icon -->
                <div class="loader-icon">🔄</div>
                <!-- Loading Text -->
                <p class="loading-text">Loading, please wait...</p>
            </div>
        </div>
    }


    <MudCardContent>
        <style>
            .mud-table-cell-custom-group {
                font-weight: 500;
            }

            .mud-table-cell-custom-group-footer {
                padding-bottom: 50px;
                text-align: right;
            }
        </style>

        <MudTable Hover="true" Breakpoint="Breakpoint.Sm" Height="500px" FixedHeader="true"
                  Items="@assignmentsResults"
                  GroupBy="@_groupDefinition"
                  GroupHeaderStyle="background-color:var(--mud-palette-background-gray)"
                  GroupFooterClass="mb-4"
                  Dense="true"
                  @ref="_tableRef">
            <ColGroup>
                <col style="width: 60px;" />
                <col />
                <col />
                <col />
                <col />
                <col />
            </ColGroup>
            <HeaderContent>
                <MudTh>FirstName</MudTh>
                <MudTh>LastName</MudTh>
                <MudTh>Score</MudTh>
                <MudTh>Class</MudTh>
                <MudTh>AssignmentMarks</MudTh>
                <MudTh>Grade</MudTh>
                <MudTh>SubmissionDate</MudTh>
                <MudTh>SubmissionStatus</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh Class="mud-table-cell-custom-group" colspan="9">@($"{context.GroupName}: {context.Key}") </MudTh>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd DataLabel="First Name">@context.FirstName</MudTd>
                <MudTd DataLabel="Last Name">@context.LastName</MudTd>
                <MudTd DataLabel="Score">@context.Grade</MudTd>
                <MudTd DataLabel="Class">@context.ClassName</MudTd>
                <MudTd DataLabel="Assignment Marks">@context.TotalMarks</MudTd>
                <MudTd DataLabel="Grader">@context.GradeLevel</MudTd>
                <MudTd DataLabel="SubmissionDate">@context.SubmissionDate.Value.ToShortDateString()</MudTd>
                <MudTd DataLabel="SubmissionStatus">
                    @if (context.Overdue == 1)
                    {
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Error">Overdue</MudChip>
                    }
                    else
                    {

                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@context.Status</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="SubmissionStatus"><MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit" OnClick="() => NavigateToDetails(context)" /></MudTd>
            </RowTemplate>
            <GroupFooterTemplate>
                <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" colspan="9">Total Submitted Assignments: @context.Items.Count())</MudTh>
            </GroupFooterTemplate>
        </MudTable>
    </MudCardContent>
</MudCard>

@code {
    protected List<GetTeacherAssignmentsResult> assignmentsResults = new();

    private MudTable<GetTeacherAssignmentsResult> _tableRef;
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    [Inject] LessonService LessonService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    protected string UserID = string.Empty;
    protected bool isLoading = false;
    private TableGroupDefinition<GetTeacherAssignmentsResult> _groupDefinition = new()
    {
        GroupName = "Class",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = false,
        Selector = (e) => e.ClassName
    };


    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        UserID = AppState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            await GetAssignments();
        }
        isLoading = false;
        //Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    protected async Task GetAssignments()
    {
        var service = _genericService.GetService<GetTeacherAssignmentsResult>();
        var result = await service.GetAllAsync($"api/Dynamic/GetTeacherAssignments/{UserID}", true);
        if (result.IsSuccess)
        {
            assignmentsResults = result.Data.ToList();
        }
    }

    protected async Task NavigateToDetails(GetTeacherAssignmentsResult result)
    {
        isLoading = true;
        await GetAssignmentDetails(result.StudentAssignmentID);
        LessonService.studentID = result.StudentID.Value;
        LessonService.assignmentID = result.AssignmentID.Value;
        var SA = new StudentAssignment()
        {
            StudentAssignmentID = result.StudentAssignmentID,
            StudentID = result.StudentID,
            AssignmentID = result.AssignmentID,
            SubmissionDate = result.SubmissionDate,
            Grade = 0,
            Status = result.Status,
            QuestionID = result.QuestionID
        };
        LessonService.Assignment = SA;
       
        isLoading = false;
        _navigationManager.NavigateTo("/MarkingAssignmentDetails");
    }
   
    protected async Task GetAssignmentDetails(Guid id)
    {

        var service = _genericService.GetService<StudentAssignmentAnswer>();
        var result = await service.GetAllAsync($"api/Dynamic/GetAssignmentAnswers/{id}", true);
        if (result.IsSuccess)
        {
            LessonService.studentAssignmentAnswers = result.Data.ToList();

        }
        else
        {
            Snackbar.Add("Failed to Assignment Details, Please refresh and try again", Severity.Error);
        }

    }
}
