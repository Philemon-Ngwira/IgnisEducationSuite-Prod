@page "/ExamMarking"
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@inherits AppBaseComponent

<MudCard>
    <MudCardHeader>
        <MudText Typo="Typo.h4" Align="Align.Center" Class="py-2"><b>Mark Exams, Tests & Quizzes</b></MudText>
    </MudCardHeader>

    <MudCardContent>
        <MudTabs Elevation="4" Rounded="true" Centered="true" Color="@Color.Dark">
            @foreach (var type in new[] { "Exam", "Test", "Quiz" })
            {
                <MudTabPanel Text="@type">
                    @BuildStudentTable(studentExams.Where(x => x.ExamType == type).ToList())
                </MudTabPanel>
            }
        </MudTabs>
    </MudCardContent>
</MudCard>
@code {
    protected bool isLoading = false;
    protected List<GetStudentExamDetailsByTeacherResult> studentExams = new();

    ///Injects///
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    [Inject] LessonService LS { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    ///Strings Numbers And bools///
    protected string UserID = string.Empty;
    private MudTable<GetStudentExamDetailsByTeacherResult> _tableRef;
    private TableGroupDefinition<GetStudentExamDetailsByTeacherResult> _groupDefinition =
    new()
    {
        GroupName = "Group",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = false,
        Selector = (e) => new { e.ClassName, e.LevelName }
    };


    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Initializing please wait...");

        UserID = AppState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            await GetStudentExams();
        }
        LoaderService.Hide();
    }
    private RenderFragment BuildStudentTable(List<GetStudentExamDetailsByTeacherResult> exams) => __builder =>
    {
        <MudTable Hover="true" Breakpoint="Breakpoint.Sm" Height="500px" FixedHeader="true"
                  Items="exams"
                  GroupBy="@_groupDefinition"
                  GroupHeaderStyle="background-color:var(--mud-palette-background-gray)"
                  GroupFooterClass="mb-4"
                  Dense="true"
                  @ref="_tableRef">
            <ColGroup>
                <col style="width: 60px;" />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
            </ColGroup>

            <HeaderContent>
                <MudTh>First Name</MudTh>
                <MudTh>Last Name</MudTh>
                <MudTh>Score</MudTh>
                <MudTh>Class</MudTh>
                <MudTh>Exam Marks</MudTh>
                <MudTh>Grade</MudTh>
                <MudTh>Submission Date</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>

            <GroupHeaderTemplate>
                <MudTh Class="mud-table-cell-custom-group" ColSpan="8">
                    @($"{context.GroupName}: {context.Key}")
                </MudTh>
            </GroupHeaderTemplate>

            <RowTemplate>
                <MudTd DataLabel="First Name">@context.FirstName</MudTd>
                <MudTd DataLabel="Last Name">@context.LastName</MudTd>
                <MudTd DataLabel="Score">@context.Grade</MudTd>
                <MudTd DataLabel="Class">@context.ClassName</MudTd>
                <MudTd DataLabel="Exam Marks">@context.TotalMarks</MudTd>
                <MudTd DataLabel="Grade">@context.LevelName</MudTd>
                <MudTd DataLabel="Submission Date">@context.SubmissionDate?.ToShortDateString()</MudTd>
                <MudTd DataLabel="Action">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="() => NavigateToDetails(context)" />
                </MudTd>
            </RowTemplate>

            <GroupFooterTemplate>
                <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" ColSpan="8">
                    Total Submitted Assignments: @context.Items.Count()
                </MudTh>
            </GroupFooterTemplate>
        </MudTable>
    };

    #region Get Data
    protected async Task GetStudentExams()
    {
        var service = _genericService.GetService<GetStudentExamDetailsByTeacherResult>();
        var result = await service.GetAllAsync($"api/Dynamic/GetStudentExamDetails/{UserID}", true);
        if (result.IsSuccess)
        {
            studentExams = result.Data.ToList();
            foreach (var item in studentExams)
            {
                if (string.IsNullOrEmpty(item.LevelName))
                {
                    item.LevelName = academicLevels.Where(x => x.LevelInt == item.GradeLevel).Select(x => x.LevelName).FirstOrDefault();
                }
            }
        }
    }
    #endregion
    protected async Task<List<StudentExamQuizAndTestAnswer>> GetStudentExamQuizAndTestAnswers(GetStudentExamDetailsByTeacherResult exam)
    {
        var service = _genericService.GetService<StudentExamQuizAndTestAnswer>();
        var result = await service.GetAllAsync($"api/Dynamic/GetStudentExamAnswers/{exam.StudentExamID}", true);
        if (result.IsSuccess)
        {

            return result.Data.ToList();
        }
        else
        {
            Snackbar.Add("Falied to Fetch Students Answers");
            return new List<StudentExamQuizAndTestAnswer>();
        }
    }
    protected async Task<List<ExamQuizTestQuestion>> GetExamQuizTestQuestionsAsync(Guid ExamID)
    {
        var service = _genericService.GetService<ExamQuizTestQuestion>();
        var result = await service.GetAllAsync($"api/Dynamic/GetExamTestQuizQuestions/{ExamID}", true);
        if (result.IsSuccess)
        {
            return result.Data.ToList();
        }
        else
        {
            Snackbar.Add("Falied to Fetch Students Answers");
            return new List<ExamQuizTestQuestion>();
        }
    }

    protected async Task GetMultipleChoiceAnswers(Guid QuestionID)
    {

        var service = _genericService.GetService<ExamTestQuizMultipleChoiceAnswer>();
        var result = await service.GetAllAsync($"api/Dynamic/GetQuestionChoicesExams/{QuestionID}", true);
        if (result.IsSuccess)
        {
            LS.ExamAnswerChoices.AddRange(result.Data.ToList());
        }



    }

    protected async Task NavigateToDetails(GetStudentExamDetailsByTeacherResult selectedExam)
    {
        // Load answers
        LS.studentExamAnswers = await GetStudentExamQuizAndTestAnswers(selectedExam);

        // Load and order questions
        var questions = (await GetExamQuizTestQuestionsAsync(selectedExam.ExamQuizID))
                            .OrderBy(q => q.QuestionNumber)
                            .ToList();
        foreach (var item in questions)
        {
            if (item.isMultipleChoice == true)
            {
                await GetMultipleChoiceAnswers(item.QuestionID);
            }
        }
        // Set current exam header
        LS.ExamQuizTest = new StudentExamsTestsAndQuiz()
        {
            StudentExamID = selectedExam.StudentExamID,
            StudentID = selectedExam.StudentID,
            Grade = 0,
            SubmissionDate = selectedExam.SubmissionDate,
            ExamID = selectedExam.ExamQuizID
        };

        // Save exam details
        LS.ExamDetails = selectedExam;

        // If answers and questions exist, match them
        if (LS.studentExamAnswers.Any() && questions.Any())
        {
            foreach (var ans in LS.studentExamAnswers)
            {
                ans.Question = questions.FirstOrDefault(q => q.QuestionID == ans.QuestionID);
            }

            // Now questions are guaranteed sorted before navigation
            _navigationManager.NavigateTo("/ExamAnswers");
        }
    }


}
