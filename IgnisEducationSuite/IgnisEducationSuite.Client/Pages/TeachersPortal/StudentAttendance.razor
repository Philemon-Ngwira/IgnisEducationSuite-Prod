@page "/StudentAttendance"
@using EDUSphereSharedProject.Models.StoreProModels
@using IgnisEducationSuite.Client.Pages.TeachersPortal.Dialogs
@inherits AppBaseComponent
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Student Attendance</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="9">
                <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Label="Enter Attendace Date" @bind-Date="_date" />
            </MudItem>
            <MudItem xs="3">
                <MudButton OnClick="GetTimeSheets" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Search">Get Attendance Schedule</MudButton>
            </MudItem>
            <MudDivider />
            <MudItem xs="12">
                @if (isLoading)
                {
                    <div id="loader-overlay" class="loader-overlay">
                        <div class="loader-container">
                            <!-- Spinner -->
                            <div class="spinner"></div>
                            <!-- Loader Icon -->
                            <div class="loader-icon">🔄</div>
                            <!-- Loading Text -->
                            <p class="loading-text">Loading, please wait...</p>
                        </div>
                    </div>
                }


                <MudTable Items="FilteredAttendances" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<GetAttendanceByTeacherAndDateResult, bool>(FilterFunc1)" @bind-SelectedItem="selectedItem">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Student Attendance</MudText>
                        <MudSpacer />
                        <MudAutocomplete T="string" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Label="Filter By Academic Level" ValueChanged="(e) => FilterResultsByAcademicLevel(e)" Value="AcademicLvlFilterValue" SearchFunc="@AcademicLvlFilter"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true" CoerceValue="true" SelectValueOnTab="true"
                                         AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" />
                        <MudAutocomplete T="string" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Label="Filter By Class Level" ValueChanged="(e) => FilterResultsByClass(e)" Value="SelectedClass" SearchFunc="@ClassFilter"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true" CoerceValue="true" SelectValueOnTab="true"
                                         AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" />
                        <MudSpacer />
                        <MudButton Color="Color.Primary" OnClick="UpdateAttendance" Variant="Variant.Filled">Submit Attendance</MudButton>
                        <MudSpacer />
                        <MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>First Name</MudTh>
                        <MudTh>Last Name</MudTh>
                        <MudTh>Class Name</MudTh>
                        <MudTh>Attendance Status</MudTh>
                        <MudTh>Late ?</MudTh>
                        <MudTh>Date</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="First Name">@context.FirstName</MudTd>
                        <MudTd DataLabel="Last Name">@context.LastName</MudTd>
                        <MudTd DataLabel="Class Name">@context.ClassName</MudTd>
                        <MudTd DataLabel="Attendance Status"><MudCheckBox @bind-Value="context.AttendanceStatus" Label="Attendance Status"></MudCheckBox></MudTd>
                        <MudTd DataLabel="Late Status"><MudCheckBox @bind-Value="context.LateStatus" Label="Lateness Status"></MudCheckBox></MudTd>
                        <MudTd DataLabel="Late Status">@context.AttendanceDate.Value.ToShortDateString()</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </MudItem>


        </MudGrid>
    </MudCardContent>
</MudCard>

@code {



    protected bool isLoading = false;
    private DateTime? _date = DateTime.Today;
    protected string UserID = string.Empty;

    protected string AcademicLvlFilterValue = string.Empty;
    protected string SelectedClass = string.Empty;

    protected List<GetAttendanceByTeacherAndDateResult> getAttendances = new();
    protected List<GetAttendanceByTeacherAndDateResult> FilteredAttendances = new();

    protected GetAttendanceByTeacherAndDateResult selectedItem = new();

    protected List<string> TeacherGrades = new();
    protected List<string> ClassNames = new();
    protected string searchString = string.Empty;

    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    [Inject] IDialogService DialogService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;


    // GET SCHEDULE
    protected async Task GetTimeSheets()
    {
        isLoading = true;

        UserID = AppState.UserID;

        if (!string.IsNullOrWhiteSpace(UserID))
        {
            string formattedDate = _date.Value.ToString("yyyy-MM-ddTHH:mm:ss");

            var service = _genericService.GetService<GetAttendanceByTeacherAndDateResult>();
            var result = await service.GetAllAsync($"api/Dynamic/GetStudentAttendance/{UserID}/{formattedDate}", true);

            if (result.IsSuccess)
            {
                getAttendances = result.Data.ToList();

                // Fix missing LevelName
                foreach (var item in getAttendances)
                {
                    if (string.IsNullOrEmpty(item.LevelName))
                    {
                        item.LevelName = academicLevels
                            .Where(x => x.LevelInt == item.AcademicLevel)
                            .Select(x => x.LevelName)
                            .FirstOrDefault();
                    }
                }

                TeacherGrades = getAttendances.Select(x => x.LevelName).Distinct().ToList();
                ClassNames = getAttendances.Select(x => x.ClassName).Distinct().ToList();

                FilteredAttendances = getAttendances.ToList();
            }
        }

        isLoading = false;
    }


    // OPEN CONFIRMATION DIALOG
    protected async Task UpdateAttendance()
    {
        var dialog = await DialogService.ShowAsync<AttendacnceConfirmattionDialog>("");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool confirmed && confirmed)
        {
            await CompleteAttendanceMarking();
        }
    }


    // SAVE ATTENDANCE
    protected async Task CompleteAttendanceMarking()
    {
        List<EDUSphereSharedProject.Models.StudentAttendance> attendances = FilteredAttendances
            .Select(item => new EDUSphereSharedProject.Models.StudentAttendance
            {
                StudentAttendanceID = item.StudentAttendanceID,
                StudentScheduleID = item.StudentScheduleID,
                AttendanceStatus = item.AttendanceStatus,
                LateStatus = item.LateStatus,
                AttendanceDate = item.AttendanceDate,
                CreatedDate = item.CreatedDate,
                Marked = true
            })
            .ToList();

        var service = _genericService.GetService<List<EDUSphereSharedProject.Models.StudentAttendance>>();
        var result = await service.UpdateAsync("api/Dynamic/UpdateEntities", "studentattendance", attendances);

        if (result.IsSuccess)
        {
            // Remove updated items
            getAttendances.RemoveAll(a => attendances.Any(s => s.StudentAttendanceID == a.StudentAttendanceID));

            // Refresh grid
            if (string.IsNullOrEmpty(AcademicLvlFilterValue))
                FilteredAttendances = getAttendances.ToList();
            else
                FilteredAttendances = getAttendances.Where(x => x.LevelName == AcademicLvlFilterValue).ToList();

            Snackbar.Add("Attendance Successfully Marked", Severity.Success);
            StateHasChanged();
        }
    }


    // SEARCH FILTERS
    private bool FilterFunc1(GetAttendanceByTeacherAndDateResult element) =>
        FilterFunc(element, searchString);

    private bool FilterFunc(GetAttendanceByTeacherAndDateResult element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        return element.FirstName.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || element.LastName.Contains(searchString, StringComparison.OrdinalIgnoreCase);
    }


    // AUTOCOMPLETE FILTERS
    private async Task<IEnumerable<string>> AcademicLvlFilter(string value, CancellationToken token)
    {
        await Task.Delay(5, token);
        if (string.IsNullOrEmpty(value))
            return new string[0];

        return TeacherGrades.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> ClassFilter(string value, CancellationToken token)
    {
        await Task.Delay(5, token);
        if (string.IsNullOrEmpty(value))
            return new string[0];

        return ClassNames.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }


    // APPLY SELECTED FILTERS

    private void ApplyFilters()
    {
        IEnumerable<GetAttendanceByTeacherAndDateResult> query = getAttendances;

        if (!string.IsNullOrEmpty(AcademicLvlFilterValue))
            query = query.Where(x => x.LevelName == AcademicLvlFilterValue);

        if (!string.IsNullOrEmpty(SelectedClass))
            query = query.Where(x => x.ClassName == SelectedClass);

        // Optional: search filter
        if (!string.IsNullOrWhiteSpace(searchString))
            query = query.Where(x =>
                x.FirstName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                x.LastName.Contains(searchString, StringComparison.OrdinalIgnoreCase));

        FilteredAttendances = query.ToList();
    }

    private void FilterResultsByAcademicLevel(string value)
    {
        AcademicLvlFilterValue = value;
        ApplyFilters();
    }

    private void FilterResultsByClass(string Value)
    {
        SelectedClass = Value;

        ApplyFilters();
    }
}

