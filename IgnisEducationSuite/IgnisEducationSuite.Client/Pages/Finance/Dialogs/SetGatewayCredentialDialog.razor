@using System.Net.Http.Json
@using EDUSphereSharedProject.PaymentDTos.Lipila
@inherits AppBaseComponent

<MudDialog>

    <DialogContent>

        <MudText Typo="Typo.h6" Class="mb-2">Set API Key - @WalletLabel</MudText>

        <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
            The key is encrypted immediately and never displayed again after saving.
            Setting a new key does not delete the previous one - it simply becomes
            the one Ignis uses going forward.
        </MudAlert>

        <MudForm @ref="form">
            <MudTextField Label="Lipila API Key"
                          @bind-Value="ApiKey"
                          InputType="InputType.Password"
                          Required="true"
                          HelperText="Starts with Lsk... Paste the key exactly as shown in the Lipila dashboard." />
        </MudForm>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@ErrorMessage</MudAlert>
        }

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="Saving">
            Save Key
        </MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid AccountId { get; set; }
    [Parameter] public string WalletLabel { get; set; } = default!;

    private MudForm form = default!;
    private string ApiKey = string.Empty;
    private bool Saving;
    private string? ErrorMessage;

    private async Task Save()
    {
        await form.Validate();
        if (!form.IsValid)
        {
            return;
        }

        Saving = true;
        ErrorMessage = null;

        try
        {
            var request = new SetPaymentGatewayCredentialRequest { ApiKey = ApiKey };
            var response = await HttpClient.PostAsJsonAsync(
                $"api/payments/lipila/accounts/{AccountId}/credential",
                request,
                JsonDefaults.Web);

            // Clear the field from memory regardless of outcome.
            ApiKey = string.Empty;

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "Failed to save the API key. Please try again.";
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            Saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
