@using EDUSphereSharedProject.FinanceModels
@inherits AppBaseComponent

<MudCard Class="pa-4">

    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">Record Payment</MudText>
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                Log a payment received from a parent or guardian.
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>

        <MudGrid Spacing="3">

            <!-- Student Search -->
            <MudItem xs="12" md="6">
                <MudAutocomplete T="Student"
                                 Label="Search Student"
                                 SearchFunc="SearchStudents"
                                 ToStringFunc="@(s => s == null ? "" : $"{s.FirstName} {s.LastName}")"
                                 Value="_selectedStudent"
                                 ValueChanged="LoadFinancialDataAsync"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>

            <!-- Invoice -->
            <MudItem xs="12" md="6">
                <MudSelect T="Invoice"
                           Label="Select Invoice"
                           @bind-Value="_selectedInvoice"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">

                    @foreach (var invoice in studentInvoices)
                    {
                        <MudSelectItem Value="@invoice">
                            @($"{invoice.InvoiceType} | Outstanding: {(invoice.Amount - invoice.PaidAmount):N2}")
                        </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

            <!-- Invoice Summary -->
            @if (_selectedInvoice != null)
            {
                <MudItem xs="12">

                    <MudPaper Class="pa-3">

                        <MudText Typo="Typo.subtitle2">Invoice Summary</MudText>

                        <MudText>
                            Invoice Amount:
                            @(AppState.Currency.CurrencySymbol) @_selectedInvoice.Amount
                        </MudText>

                        <MudText>
                            Paid So Far:
                            @(AppState.Currency.CurrencySymbol) @_selectedInvoice.PaidAmount
                        </MudText>

                        <MudText Color="Color.Error">
                            Outstanding:
                            @(AppState.Currency.CurrencySymbol) @(_selectedInvoice.Amount - _selectedInvoice.PaidAmount)
                        </MudText>

                    </MudPaper>

                </MudItem>
            }

            <!-- Payment Amount -->
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal?"
                                 Label="Payment Amount"
                                 Value="_paymentAmount"
                                 ValueChanged="CheckPayment"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Disabled="_selectedInvoice == null"
                                 Adornment="Adornment.Start"
                                 AdornmentText="@(AppState.Currency.CurrencySymbol ?? "$")" />
            </MudItem>

            <!-- Payment Method -->
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           Label="Payment Method"
                           @bind-Value="_paymentMethod"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">

                    <MudSelectItem Value="@("Cash")">Cash</MudSelectItem>
                    <MudSelectItem Value="@("BankTransfer")">Bank Transfer</MudSelectItem>
                    <MudSelectItem Value="@("MobileMoney")">Mobile Money</MudSelectItem>
                    <MudSelectItem Value="@("POS")">POS</MudSelectItem>

                </MudSelect>
            </MudItem>

            <!-- Payment Date -->
            <MudItem xs="12" md="6">
                <MudDatePicker Label="Payment Date"
                               @bind-Date="_paymentDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <!-- Notes -->
            <MudItem xs="12">
                <MudTextField Label="Notes / Reference"
                              @bind-Value="_notes"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="2" />
            </MudItem>

            <!-- Submit -->
            <MudItem xs="12">
                <MudDivider Class="my-2" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Size="Size.Large"
                           OnClick="RecordPayment"
                           Disabled="_saving || disablePaymentButton || _selectedInvoice == null || _paymentAmount == null">

                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Record Payment</span>
                    }

                </MudButton>
            </MudItem>

        </MudGrid>

    </MudCardContent>

</MudCard>

@code {

    private Student _selectedStudent;
    private Invoice _selectedInvoice;

    private List<Student> students = new();
    private List<Invoice> studentInvoices = new();

    private decimal? _paymentAmount;
    private string _paymentMethod;
    private DateTime? _paymentDate = DateTime.Today;
    private string _notes;

    private bool _saving = false;
    private bool disablePaymentButton = true;

    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait while we prepare your environment...");
        await GetStudents();
        LoaderService.Hide();
    }

    private async Task LoadFinancialDataAsync(Student student)
    {
        _selectedStudent = student;

        _selectedInvoice = null;
        _paymentAmount = null;
        disablePaymentButton = true;

        var service = GenericService.GetService<Invoice>();

        var result = await service.GetAllAsync(
            $"api/Invoice/GetStudentInvoices/{_selectedStudent.UserID}", true);

        studentInvoices = result.Data?.ToList() ?? new List<Invoice>();
    }

    private void CheckPayment(decimal? payment)
    {
        _paymentAmount = payment;

        if (_selectedInvoice == null || _paymentAmount == null)
        {
            disablePaymentButton = true;
            return;
        }

        var outstanding = _selectedInvoice.Amount - _selectedInvoice.PaidAmount;

        if (_paymentAmount > outstanding)
        {
            Snackbar.Add("Payment exceeds outstanding balance.", Severity.Error);
            disablePaymentButton = true;
        }
        else
        {
            disablePaymentButton = false;
        }
    }

    private async Task GetStudents()
    {
        var result = GenericService.GetService<Student>();

        var service = await result.GetAllAsync(
            $"api/Dynamic/GetStudentsBySchoolID/{Guid.Parse(AppState.SchoolID)}", true);

        students = service.Data?.ToList() ?? new List<Student>();
    }

    private async Task<IEnumerable<Student>> SearchStudents(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return students;

        return students.Where(s =>
            s.FirstName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            s.LastName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            s.StudentNumber.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task RecordPayment()
    {
        if (_selectedStudent == null || _selectedInvoice == null || _paymentAmount == null)
            return;

        _saving = true;

        try
        {
            // API call here
            var _payment = new Payment
            {
                Id = Guid.NewGuid(),
                InvoiceId = _selectedInvoice.Id,
                AmountPaid = _paymentAmount.Value,
                CreatedAt = DateTime.UtcNow,
                PaymentDate = _paymentDate ?? DateTime.Today,
                PaymentMethod = _paymentMethod,
                UpdatedAt = DateTime.UtcNow,
            };

            var paymentResult = await GenericService.GetService<Payment>()
                .PostAsync("api/Payment/SavePayment", "payment", _payment);
            if (paymentResult.IsSuccess)
            {
                Snackbar.Add("Payment recorded successfully!", Severity.Success);
                _selectedInvoice = new();
                _selectedStudent = new();
                _paymentAmount = null;
                _paymentDate = DateTime.Today;
                _paymentMethod = "";
            }
        }
        finally
        {
            _saving = false;
        }
    }

}