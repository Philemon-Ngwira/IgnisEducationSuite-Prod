@using EDUSphereSharedProject.FinanceModels
@using EDUSphereSharedProject.UniversalModels
@inherits AppBaseComponent

<MudCard Class="pa-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">Invoice Generation</MudText>
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                Generate bulk invoices for a selected term and invoice type.
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        <MudGrid Spacing="3">

            <!-- Term Dates -->
            <MudItem xs="12" md="6">
                <MudDatePicker Label="Term Start Date"
                               @bind-Date="_termStartDate"
                               Required="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudDatePicker Label="Term End Date"
                               @bind-Date="_termEndDate"
                               Required="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <!-- Invoice Type -->
            <MudItem xs="12" md="6">
                <MudSelect T="InvoiceType"
                           Label="Invoice Type"
                           @bind-Value="selectedType"
                           Required="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                ToStringFunc="Converter">
                    @foreach (var type in invoiceTypes)
                    {
                        <MudSelectItem Value="@type">@type.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Amount -->
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal?"
                                 Label="Amount"
                                 @bind-Value="_amount"
                                 Required="true"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 Margin="Margin.Dense"
                                 AdornmentText="@(AppState.Currency?.CurrencySymbol ?? "$")" />
            </MudItem>

            <!-- Due Date -->
            <MudItem xs="12" md="6">
                <MudDatePicker Label="Due Date"
                               @bind-Date="_dueDate"
                               Required="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <!-- Generate Button -->
            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="GenerateInvoices"
                           Disabled="_isGenerating">
                    @if (_isGenerating)
                    {
                        <MudProgressCircular Indeterminate="true"
                                             Size="Size.Small"
                                             Class="me-2" />
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>Generate Invoices</span>
                    }
                </MudButton>
            </MudItem>

        </MudGrid>
    </MudCardContent>
</MudCard>

@code {

    private DateTime? _termStartDate;
    private DateTime? _termEndDate;
    private DateTime? _dueDate;
    private Guid? _invoiceTypeId;
    private decimal? _amount;
    private bool _isGenerating = false;

    protected List<InvoiceType> invoiceTypes = new();
    protected InvoiceType selectedType = new();
    protected Func<InvoiceType, string> Converter = p => p.Name;
    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait...");
        await GetInvoiceTypes();
        LoaderService.Hide();
    }

    private async Task GenerateInvoices()
    {
        if (_termStartDate == null ||
            _termEndDate == null ||
            _dueDate == null ||
            _amount == null)
            return;

        _isGenerating = true;

        try
        {
            var service = GenericService.GetService<BulkInvoiceRequest>();

            var request = new BulkInvoiceRequest
            {
                TermStartDate = _termStartDate.Value,
                TermEndDate = _termEndDate.Value,
                DueDate = _dueDate.Value,
                InvoiceTypeId = selectedType.Id,
                InvoiceType = selectedType.Name,
                Amount = _amount.Value,
                SchoolID = Guid.Parse(AppState.SchoolID)
            };

            var result = await service.PostAsync("api/Invoice/generate-bulk", "invoice",request);

            if (result.IsSuccess)
            {
                Snackbar.Add("Invoices generated successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to generate invoices.", Severity.Error);
            }
        }
        finally
        {
            _isGenerating = false;
        }
    }

    protected async Task GetInvoiceTypes()
    {
        var service = GenericService.GetService<InvoiceType>();
        var result = await service.GetAllAsync("api/Invoice/GetInvoiceTypes", true);

        if (result.IsSuccess)
            invoiceTypes = result.Data.ToList();
    }
}