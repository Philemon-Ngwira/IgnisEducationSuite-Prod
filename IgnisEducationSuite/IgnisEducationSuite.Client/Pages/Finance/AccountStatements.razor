@using EDUSphereSharedProject.FinanceModels
@using EDUSphereSharedProject.FinanceModels.DTOs
@using EDUSphereSharedProject.Models
@inherits AppBaseComponent


<MudCard Class="pa-4">

    <!-- Page Header -->
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">Student Account Statement</MudText>
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                Detailed financial history of student invoices and payments
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>

        <!-- Filters -->
        <MudGrid Spacing="3">

            <!-- Student Search -->
            <MudItem xs="12" md="4">
                <MudAutocomplete T="Student"
                                 Label="Search Student"
                                 SearchFunc="SearchStudents"
                                 ToStringFunc="@(s => s?.FirstName + " " + s?.LastName+":"+s?.LevelName)"
                                 Value="_selectedStudent"
                                 ValueChanged="OnStudentSelected"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>

            <!-- Date Range Filter -->
            <MudItem xs="12" md="4">
                <MudDateRangePicker Label="Statement Period"
                                    @bind-DateRange="_dateRange"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"/>
            </MudItem>

            <!-- Load Button -->
            <MudItem xs="12" md="2" >
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="LoadLedgerAsync">
                    Load
                </MudButton>
            </MudItem>

        </MudGrid>

        <!-- Student Summary -->
        @if (_selectedStudent != null)
        {
            <MudPaper Class="pa-4 mt-4 mb-4" Elevation="1">

                <MudGrid>

                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption">Student</MudText>
                        <MudText Typo="Typo.h6">
                            @_selectedStudent.FirstName @_selectedStudent.LastName
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption">Student ID</MudText>
                        <MudText Typo="Typo.body1">
                            @_selectedStudent.StudentNumber
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption">Outstanding Balance</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Error">
                            @FormatCurrency(_runningBalance)
                        </MudText>
                    </MudItem>

                </MudGrid>

            </MudPaper>
        }

        <!-- Empty State -->
        @if (_selectedStudent == null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">
                Search and select a student to view their financial statement.
            </MudAlert>
        }

        <!-- Ledger Table -->
        @if (_selectedStudent != null)
        {
            <MudTable Items="ledgerEntries"
                      Hover="true"
                      Dense="true"
                      Bordered="true"
                      FixedHeader="true"
                      Height="450px">

                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Debit</MudTh>
                    <MudTh>Credit</MudTh>
                    <MudTh>Balance</MudTh>
                </HeaderContent>

                <RowTemplate>

                    <MudTd>@context.CreatedAt.ToShortDateString()</MudTd>

                    <MudTd>
                        <MudChip T="string" Color="@(context.EntryType == "Debit" ? Color.Error : Color.Success)">
                            @context.EntryType
                        </MudChip>
                    </MudTd>

                    <MudTd>@context.Description</MudTd>

                    <MudTd>
                        @(context.EntryType == "Debit"
                                            ? FormatCurrency(context.Amount)
                                            : "-")
                                              </MudTd>

                    <MudTd>
                        @(context.EntryType == "Credit"
                                            ? FormatCurrency(context.Amount)
                                            : "-")
                </MudTd>

                    <MudTd Class="fw-bold">
                        @FormatCurrency((decimal)context.RunningBalance)
                    </MudTd>

                </RowTemplate>

            </MudTable>

            <!-- Footer -->
            <MudDivider Class="my-4" />

            <MudStack Row Justify="Justify.SpaceBetween">

                <MudText Typo="Typo.subtitle2">
                    All amounts displayed in school currency
                </MudText>

                <MudText Typo="Typo.h6">
                    Current Balance: <b>@FormatCurrency(_runningBalance)</b>
                </MudText>

            </MudStack>

            <!-- Export Buttons -->
            <MudStack Row
                      Justify="Justify.FlexEnd"
                      Class="mt-3"
                      Spacing="2">

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="ExportToPdf">
                    Export PDF
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           OnClick="ExportToExcel">
                    Export Excel
                </MudButton>

            </MudStack>
                }

    </MudCardContent>

</MudCard>




@code {
    private Student _selectedStudent;

    private List<Student> students = new();

    private List<StudentFinanceLedgerDTO> ledgerEntries = new();

    private decimal _runningBalance = 0;

    private DateRange _dateRange = new DateRange(
        DateTime.Today.AddMonths(-3),
        DateTime.Today);

    private string FormatCurrency(decimal amount)
    {
        return (AppState.Currency.CurrencySymbol ?? "$") + amount.ToString("N2");
    }


    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait, we are setting everything up for you...");
        await GetStudent();
        LoaderService.Hide();
    }

    private void OnStudentSelected(Student student)
    {
        _selectedStudent = student;
    }


    // Placeholder methods you can bind
    private Task<IEnumerable<Student>> SearchStudents(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult(students.AsEnumerable());
        return Task.FromResult(students.Where(s => $"{s.FirstName} {s.LastName}".Contains(value, StringComparison.OrdinalIgnoreCase)));
    }
    private async Task LoadLedgerAsync()
    {
        var data = new FinanceLedgerRequestDTO()
        {
            SchoolID = Guid.Parse(AppState.SchoolID),
            StudentFinanceID = _selectedStudent.StudentID,
            TermStart = _dateRange.Start.Value,
            TermEnd = _dateRange.End.Value
        };

        var ledgerResult = await HttpClient.PostAsJsonAsync($"api/Finance/GetStudentLedgers", data);

        if (ledgerResult.IsSuccessStatusCode)
        {
            var Data = await ledgerResult.Content.ReadFromJsonAsync<List<StudentFinanceLedgerDTO>>();
            if (Data is not null && Data.Any())
            {
                // Order descending for UI display (newest first)
                ledgerEntries = Data.OrderByDescending(e => e.CreatedAt).ToList();

                // Running balance should come from the **most recent entry**
                _runningBalance = (decimal)ledgerEntries.First().RunningBalance;
            }
            else
            {
                ledgerEntries.Clear();
                _runningBalance = 0;
            }
        }
        else
        {
            Snackbar.Add("Failed to load ledger entries.", Severity.Error);
            ledgerEntries.Clear();
            _runningBalance = 0;
        }
    }
    private void ExportToPdf() { }
    private void ExportToExcel() { }
    protected async Task GetStudent()
    {
        var result = GenericService.GetService<Student>();
        var service = await result.GetAllAsync($"api/Dynamic/GetStudentsBySchoolID/{Guid.Parse(AppState.SchoolID)}", true);
        students = service.Data.ToList();

    }
}