@using EDUSphereSharedProject.PaymentDTos.Lipila
@using IgnisEducationSuite.Client.Pages.Finance.Dialogs
@using System.Net.Http.Json

@inherits AppBaseComponent
@inject IDialogService DialogService
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <!-- Header -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-4">

        <MudText Typo="Typo.h5">
            Payments
        </MudText>

        <MudChip T="string"
                 Color="Color.Primary"
                 Variant="Variant.Filled">
            Total Outstanding: @CurrencySymbol@Buckets.Sum(x => x.TotalOutstanding).ToString("N2")
        </MudChip>

    </MudStack>

    @if (Loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
    }
    else if (!Buckets.Any())
    {
        <MudAlert Severity="Severity.Success">
            Nothing outstanding right now.
        </MudAlert>
    }
    else
    {
        <MudGrid>

            @foreach (var bucket in Buckets)
            {
                var currentBucket = bucket;

                <MudItem xs="12" md="6" lg="4">

                    <MudPaper Elevation="2" Class="pa-4">

                        <MudStack>

                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                                @currentBucket.BucketName
                            </MudChip>

                            @if (!string.IsNullOrEmpty(currentBucket.StudentName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@currentBucket.StudentName</MudText>
                            }

                            <MudDivider Class="my-2" />

                            <MudText Typo="Typo.caption">Outstanding</MudText>

                            <MudText Typo="Typo.h4">
                                @CurrencySymbol@currentBucket.TotalOutstanding.ToString("N2")
                            </MudText>

                            <MudSpacer />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="@(() => OpenPayment(currentBucket))">
                                Pay
                            </MudButton>

                        </MudStack>

                    </MudPaper>

                </MudItem>
            }

        </MudGrid>
    }

</MudContainer>

@code {
    [Parameter] public List<StudentPaymentContext> Students { get; set; } = new();
    [Parameter] public string CurrencySymbol { get; set; } = "$";

    private List<BucketCard> Buckets = new();
    private bool Loading = true;
    private List<Guid>? _loadedForStudentIds;

    protected override async Task OnParametersSetAsync()
    {
        var currentIds = Students.Select(s => s.StudentFinanceId).OrderBy(x => x).ToList();

        // _loadedForStudentIds starts null so the first pass always loads, even
        // when Students is (still, or genuinely) empty - otherwise the spinner
        // would never resolve to "Nothing outstanding" for a student with no fees.
        if (_loadedForStudentIds is not null && currentIds.SequenceEqual(_loadedForStudentIds))
        {
            return;
        }

        _loadedForStudentIds = currentIds;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        StateHasChanged();

        var combined = new List<BucketCard>();

        foreach (var student in Students)
        {
            try
            {
                var summaries = await HttpClient.GetFromJsonAsync<List<StudentBucketSummaryDto>>(
                    $"api/payments/lipila/bucket/outstanding/{student.StudentFinanceId}",
                    JsonDefaults.Web);

                if (summaries is null)
                {
                    continue;
                }

                combined.AddRange(summaries.Select(s => new BucketCard
                {
                    StudentFinanceId = student.StudentFinanceId,
                    StudentName = student.StudentName,
                    BucketId = s.BucketId,
                    BucketName = s.BucketName,
                    TotalOutstanding = s.TotalOutstanding
                }));
            }
            catch
            {
                Snackbar.Add("Failed to load outstanding fees for one of the students.", Severity.Error);
            }
        }

        Buckets = combined.OrderBy(b => b.StudentName).ThenBy(b => b.BucketName).ToList();
        Loading = false;
        StateHasChanged();
    }

    private async Task OpenPayment(BucketCard bucket)
    {
        var parameters = new DialogParameters<PaymentDialog>
        {
            { x => x.StudentFinanceId, bucket.StudentFinanceId },
            { x => x.BucketId, bucket.BucketId },
            { x => x.BucketName, bucket.BucketName },
            { x => x.CurrencySymbol, CurrencySymbol }
        };

        var options = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<PaymentDialog>(
            $"Pay {bucket.BucketName}",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private sealed class BucketCard
    {
        public Guid StudentFinanceId { get; set; }
        public string StudentName { get; set; } = string.Empty;
        public Guid BucketId { get; set; }
        public string BucketName { get; set; } = string.Empty;
        public decimal TotalOutstanding { get; set; }
    }
}
