@using EDUSphereSharedProject.FinanceModels
@using IgnisEducationSuite.Client.Pages.Finance.Dialogs

@inherits AppBaseComponent
@inject IDialogService DialogService
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <!-- Header -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-4">

        <MudText Typo="Typo.h5">
            Payments
        </MudText>

        <MudChip T="string"
                 Color="Color.Primary"
                 Variant="Variant.Filled">
            Total Outstanding: @CurrencySymbol@OutstandingInvoices.Sum(x => x.GetOutstandingAmount()).ToString("N2")
        </MudChip>

    </MudStack>

    @if (!OutstandingInvoices.Any())
    {
        <MudAlert Severity="Severity.Success">
            Nothing outstanding right now.
        </MudAlert>
    }
    else
    {
        <MudGrid>

            @foreach (var invoice in OutstandingInvoices)
            {
                var currentInvoice = invoice;

                <MudItem xs="12" md="6" lg="4">

                    <MudPaper Elevation="2" Class="pa-4">

                        <MudStack>

                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                                    @(currentInvoice.InvoiceType ?? "Fees")
                                </MudChip>

                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(currentInvoice.PaymentStatus)">
                                    @currentInvoice.PaymentStatus
                                </MudChip>
                            </MudStack>

                            @if (StudentNamesByInvoiceId.TryGetValue(currentInvoice.Id, out var studentName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@studentName</MudText>
                            }

                            <MudDivider Class="my-2" />

                            <MudText Typo="Typo.caption">Outstanding</MudText>

                            <MudText Typo="Typo.h4">
                                @CurrencySymbol@currentInvoice.GetOutstandingAmount().ToString("N2")
                            </MudText>

                            <MudText Typo="Typo.caption">
                                Due @currentInvoice.DueDate.ToShortDateString()
                                @(currentInvoice.IsOverdue() ? " (overdue)" : "")
                            </MudText>

                            <MudSpacer />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="@(() => OpenPayment(currentInvoice))">
                                Pay
                            </MudButton>

                        </MudStack>

                    </MudPaper>

                </MudItem>
            }

        </MudGrid>
    }

</MudContainer>

@code {
    [Parameter] public List<Invoice> Invoices { get; set; } = new();
    [Parameter] public Dictionary<Guid, string> StudentNamesByInvoiceId { get; set; } = new();
    [Parameter] public string CurrencySymbol { get; set; } = "$";

    private List<Invoice> OutstandingInvoices => Invoices
        .Where(x => x.GetOutstandingAmount() > 0)
        .OrderBy(x => x.DueDate)
        .ToList();

    private async Task OpenPayment(Invoice invoice)
    {
        var parameters = new DialogParameters<PaymentDialog>
        {
            { x => x.Invoice, invoice },
            { x => x.CurrencySymbol, CurrencySymbol }
        };

        var options = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseButton = true
        };

        await DialogService.ShowAsync<PaymentDialog>(
            $"Pay {invoice.InvoiceType ?? "Invoice"}",
            parameters,
            options);
    }

    private Color GetStatusColor(string? status) => status switch
    {
        "Paid" => Color.Success,
        "Partial" => Color.Info,
        "Pending" => Color.Warning,
        _ => Color.Default
    };
}
