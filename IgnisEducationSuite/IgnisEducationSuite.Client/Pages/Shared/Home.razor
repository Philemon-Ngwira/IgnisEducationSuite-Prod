        while (!AppState.IsInitialized && maxRetries > 0)
        {
            await Task.Delay(500); // Wait for 500ms
            maxRetries--;
        }
        if (!AppState.IsInitialized)
        {
            //Snackbar.Add("Failed to load license data. Please refresh.", Severity.Error);
