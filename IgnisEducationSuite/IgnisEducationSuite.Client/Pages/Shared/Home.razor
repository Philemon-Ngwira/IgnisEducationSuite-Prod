                    await GetAttendances();
                }
            }
            catch (Exception ex)
            {
                // Handle exceptions (log, show error message, etc.)
                Console.Error.WriteLine($"Error during initialization: {ex.Message}");
            }
            finally
            {
                isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        else
        {
            isAuthenticated = false;
            isLoading = false;
        }
        isLoading = false;
