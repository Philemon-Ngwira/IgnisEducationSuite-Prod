﻿@using EDUSphereSharedProject.Models.StoreProModels
@inherits AppBaseComponent
<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <div id="loader-overlay" class="loader-overlay">
                <div class="loader-container">
                    <!-- Spinner -->
                    <div class="spinner"></div>
                    <!-- Loader Icon -->
                    <div class="loader-icon">🔄</div>
                    <!-- Loading Text -->
                    <p class="loading-text">Loading, please wait...</p>
                </div>
            </div>
        }
        <div class="dialog-container">
            <div class="report-card">
                <!-- Header -->
                <div class="header">
                    <img src="@($"data:image/jpeg;base64, {AppState.SchoolLogo}")" alt="School Logo" />
                    <h4>@student.SchoolName</h4>
                    <p>Email: @student.SchoolEmail</p>
                    <p>Website: <a href="@student.SchoolWebsite" target="_blank">@student.SchoolWebsite</a></p>
                </div>

                <!-- Student Info -->
                <div class="student-info">
                    <table>
                        <tr>
                            <th>Name of Student:</th>
                            <td>@student.FirstName @student.LastName</td>
                            <th>School Year:</th>
                            <td>@student.IssuedDate?.Year</td>
                        </tr>
                        <tr>
                            <th>Grade Level:</th>
                            <td>@student.LevelName</td>
                            <th>GPA:</th>
                            <td>@student.GPA</td>
                        </tr>
                        <tr>
                            <th>Points in Best Six:</th>
                            @if (isGCE)
                            {
                                <td>@("GCE")</td>

                            }
                            else
                            {
                                <td>@student.PointsInBestSix</td>

                            }
                            <th>Marks in Best Six:</th>
                            <td>@student.MarksInBestSix</td>
                        </tr>
                        <tr>
                            <th>Position in Class:</th>
                            @if (isGCE)
                            {
                                <td>@("GCE")</td>

                            }
                            else
                            {
                                <td>@student.PositionInClass</td>
                            }
                            <th>Term:</th>
                            <td>@student.Term</td>
                        </tr>
                        <tr>
                            <th>Report Card Type:</th>
                            <td colspan="3">@student.ReportCardType</td>
                        </tr>
                    </table>
                </div>

                <!-- Grades Table -->
                <div class="grades">
                    <table>
                        <thead>
                            <tr>
                                <th>SUBJECT</th>
                                <th>SCORE</th>
                                <th>GRADE</th>
                                <th>FINAL</th>
                            </tr>
                        </thead>
                        <tbody id="gradesTable">
                            @foreach (var item in Results)
                            {
                                <tr>
                                    <td>@item.ClassName</td>
                                    <td>@item.Score</td>
                                    <td>@item.Grade</td>
                                    <td>@item.Final</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Attendance -->
                <div class="attendance">
                    <table>
                        <thead>
                            <tr>
                                <th>ATTENDED</th>
                                <th>ABSENCES</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceTable">
                            @foreach (var item in attendances)
                            {
                                <tr>
                                    <td>@item.AttendanceCount</td>
                                    <td>@(item.ExpectedAttendances - item.AttendanceCount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Dean/Principal Comments -->
                @if (!string.IsNullOrWhiteSpace(student.DeanName) || !string.IsNullOrWhiteSpace(student.PrincipleName))
                {
                    <div class="comments">
                        <table>
                            <thead>
                                <tr>
                                    <th>ROLE</th>
                                    <th>NAME</th>
                                    <th>COMMENT</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!string.IsNullOrWhiteSpace(student.DeanName))
                                {
                                    <tr>
                                        <td>Dean</td>
                                        <td>@student.DeanName</td>
                                        <td>@student.DeansComment</td>
                                    </tr>
                                }
                                @if (!string.IsNullOrWhiteSpace(student.PrincipleName))
                                {
                                    <tr>
                                        <td>Principal</td>
                                        <td>@student.PrincipleName</td>
                                        <td>@student.PrinciplesComment</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </DialogContent>
    <DialogActions>
        <MudButtonGroup OverrideStyles="false">
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="MudDialog.Cancel">Close</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Mail" OnClick="PrepareAndMailDocument">Get Report Card</MudButton>
        </MudButtonGroup>
    </DialogActions>
</MudDialog>

