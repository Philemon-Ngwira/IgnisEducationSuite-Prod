@using EDUSphereSharedProject.UniversalModels.TimeTabling

<div class="timetable-cell
            @(IsSelected ? "selected" : "")
            @(IsInvalid ? "invalid" : "")
            @(IsLocked ? "locked" : "")"
     @onclick="HandleClick">

    @if (IsLocked)
    {
        <!-- Activity slot (locked) -->
        <MudChip T="string"
                 Size="Size.Small"
                 Color="Color.Secondary"
                 Variant="Variant.Filled">
            @Slot.ActivityName
        </MudChip>
    }
    else if (Slot.SubjectId == Guid.Empty)
    {
        <span class="free">Free</span>
    }
    else
    {
        <MudChip T="string"
                 Size="Size.Small"
                 Color="Color.Primary"
                 Variant="Variant.Filled">
            @Slot.SubjectName
        </MudChip>
    }
</div>

<style>
    .timetable-cell {
        min-height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border-radius: 6px;
        transition: background 0.15s ease, box-shadow 0.15s ease;
    }

        .timetable-cell:hover:not(.locked) {
            background: #f0f7ff;
        }

        .timetable-cell.selected {
            background: #e3f2fd;
            box-shadow: inset 0 0 0 2px #1976d2;
        }

        .timetable-cell.invalid {
            background-color: rgba(255, 0, 0, 0.12);
            box-shadow: inset 0 0 0 1px red;
        }

        .timetable-cell.locked {
            background: #f5f5f5;
            cursor: not-allowed;
            opacity: 0.85;
        }

    .free {
        color: #999;
        font-style: italic;
    }

    /* Table layout styles (unchanged but kept here for completeness) */
    .timetable-editor {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .timetable-editor th {
            background: #f5f5f5;
            font-weight: 600;
            text-align: center;
            padding: 8px;
            border: 1px solid #ddd;
        }

        .timetable-editor td {
            border: 1px solid #ddd;
            padding: 6px;
            text-align: center;
            vertical-align: middle;
        }
</style>

@code {
    [Parameter] public GeneratedSlotPreview Slot { get; set; } = null!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsInvalid { get; set; }
    [Parameter] public bool IsLocked { get; set; }

    [Parameter] public EventCallback<GeneratedSlotPreview> OnPick { get; set; }

    private async Task HandleClick()
    {
        if (IsLocked)
            return;

        await OnPick.InvokeAsync(Slot);
    }
}
