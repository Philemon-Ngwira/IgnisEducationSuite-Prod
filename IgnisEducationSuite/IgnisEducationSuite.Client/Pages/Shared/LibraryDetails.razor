@page "/LibraryDetails"
@using EDUSphereSharedProject.AchievementModels
@using EDUSphereSharedProject.Models
@using IgnisEducationSuite.Client.Pages.Achievements
@inherits AppBaseComponent
@inject IDialogService DialogService
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>@selectedCourse.CourseName</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />
    @if (isLoading)
    {
        <div id="loader-overlay" class="loader-overlay">
            <div class="loader-container">
                <!-- Spinner -->
                <div class="spinner"></div>
                <!-- Loader Icon -->
                <div class="loader-icon">🔄</div>
                <!-- Loading Text -->
                <p class="loading-text">Loading, please wait...</p>
            </div>
        </div>
    }
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudNavMenu>
                    <MudText Typo="Typo.h6" Class="px-4">Course Content</MudText>
                    <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">Lessons</MudText>
                    <MudDivider Class="my-2" />
                    @foreach (var item in details)
                    {
                        <MudNavLink OnClick="() => SelectLesson(item.Lesson)" Icon="@Icons.Material.Filled.PlayLesson">@item.Lesson.Title</MudNavLink>

                    }
                </MudNavMenu>

            </MudItem>
            <MudItem xs="12" md="9">
                <MudPaper Height="650">
                    @((MarkupString)LessonFormatter.FormatLessonContent(Lesson.Content))
                    <MudDivider Class="my-2" />
                    <MudButton EndIcon="@Icons.Material.Filled.NavigateNext" Color="Color.Primary" OnClick="NavigateNextLesson" Variant="Variant.Filled">Next Lesson</MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    protected bool isLoading = false;
    [Inject] GenericServiceFactory GenericService { get; set; } = default!;
    [Inject] LessonService lessonService { get; set; }
    protected Course selectedCourse = new();
    protected Lesson Lesson = new();
    protected List<CourseDetail> details = new();
    [Inject] AchievementDecider achievementDecider { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(500);
        selectedCourse = lessonService.Course;
        details = lessonService.courseDetails;
        StateHasChanged();
        isLoading = false;
    }

    protected async Task GetBadges()
    {
        var service = GenericService.GetService<Badge>();
        var result = await service.GetAllAsync("api/Dynamic/GetAllSystemBadges", true);
        if (result.IsSuccess)
        {

        }
    }
    private async Task<List<UserActivity>> GetUserActivitiesDone(string UserRole, string UserID)
    {
        if (UserRole == "Student")
        {
            var service = GenericService.GetService<UserActivity>();
            var result = await service.GetAllAsync($"api/Dynamic/GetAllUserActivities/{UserID}", true);
            if (result.IsSuccess)
            {
                return result.Data.ToList();
            }
            else
            {
                return new List<UserActivity>();
            }
        }
        else
        {
            return new List<UserActivity>();
        }
    }

    protected async Task NavigateNextLesson()
    {

        string userID = AppState.UserID.ToString();
        await GetBadges();
        // // Replace with the actual user ID
        // achievementDecider.Badges = AppState.Badges;
        // achievementDecider.UserActivities = AppState.UserActivities;
        if (AppState.UserRole == "Student")
        {
            achievementDecider.NumberOfLessons = details.Count;
            var result = await achievementDecider.EvaluateAndAwardBadges(userID, "Lesson");

            foreach (var item in result)
            {
                var parameters = new DialogParameters<AchivementDialog> { { x => x.badge, item } };

                var dialog = await DialogService.ShowAsync<AchivementDialog>("", parameters);
                var resulted = await dialog.Result;
            }
        }
        // Move to the next lesson
        var currentIndex = details.FindIndex(d => d.Lesson.LessonID == Lesson.LessonID);
        if (currentIndex >= 0 && currentIndex < details.Count - 1)
        {
            SelectLesson(details[currentIndex + 1].Lesson);
        }
        else
        {
            // Handle end of course logic
        }
    }
    protected void SelectLesson(Lesson lesson)
    {
        Lesson = new();
        Lesson = lesson;
        StateHasChanged();
    }
}
