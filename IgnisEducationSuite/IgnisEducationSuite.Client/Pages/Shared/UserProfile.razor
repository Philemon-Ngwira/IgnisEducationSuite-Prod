@page "/Profile"
@using EDUSphereSharedProject.IdentiyModels
@using EDUSphereSharedProject.Models.StoreProModels
@inherits AppBaseComponent
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h5"><b>User Profile</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudCard>
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Size="Size.Large" Color="Color.Secondary">
                        @if (LoggedInUser.ProfilePic == null)
                        {
                        }
                        else
                        {
                            <MudImage Src="@($"data:image/jpeg;base64,{Convert.ToBase64String(LoggedInUser.ProfilePic)}")"></MudImage>
                        }
                    </MudAvatar>
                    @if (isInEditMode)
                    {
                        <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
                            <ActivatorContent>
                                <MudFab Color="Color.Secondary"
                                        StartIcon="@Icons.Material.Filled.Image"
                                        Label="Update Profile Picture" />
                            </ActivatorContent>
                        </MudFileUpload>
                    }
                </CardHeaderAvatar>
                <CardHeaderContent>
                    @if (!isInEditMode)
                    {
                        <MudText Typo="Typo.h6">First Name: @LoggedInUser.FirstName</MudText>
                        <MudText Typo="Typo.h6"> Last Name: @LoggedInUser.LastName</MudText>
                    }
                    else
                    {
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="LoggedInUser.FirstName" Label="Update First Name"></MudTextField>
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="LoggedInUser.LastName" Label="Update Last Name"></MudTextField>
                    }

                </CardHeaderContent>

                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="SwitchPageMode" Color="Color.Default" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Info">More Information</MudAlert>
                <MudGrid>
                    @if (!isInEditMode)
                    {
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.body1">Username: @LoggedInUser.UserName</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.body1">User Email: @LoggedInUser.Email</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            @if (LoggedInUser.AccountActive)
                            {
                                <MudChip T="string" Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Info">Account Active</MudChip>
                            }
                            else
                            {

                                <MudChip T="string" Icon="@Icons.Material.Filled.NotAccessible" Color="Color.Error">Account Not Active</MudChip>
                            }
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="LoggedInUser.UserName" Label="Update UserName"></MudTextField>

                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="LoggedInUser.Email" Label="Update EmailName"></MudTextField>

                        </MudItem>
                    }

                </MudGrid>
                @if (AppState.UserRole == "Student")
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Badge">Current Acquired Badges</MudAlert>
                    if (userBadges.Any())
                    {
                        <MudGrid>
                            @foreach (var item in userBadges)
                            {

                                <MudItem xs="12" md="4">
                                    <MudCard>
                                        <MudCardMedia Image="@item.image_url" Height="200" />
                                        <MudCardContent>
                                            <MudText Typo="Typo.h5"><b>@item.BadgeName</b></MudText>
                                            <MudText Typo="Typo.body1">@item.BadgeDescription</MudText>
                                            <MudText Typo="Typo.body1"><b>Level: @item.BadgeLevel</b></MudText>
                                            <MudText Typo="Typo.body2"><b>Date Collected: @item.DateEarned</b></MudText>
                                        </MudCardContent>

                                    </MudCard>
                                </MudItem>


                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Info">No Badges Acquired yet</MudAlert>
                    }
                }
            </MudCardContent>
        </MudCard>
    </MudCardContent>
</MudCard>

@code {
    protected ApplicationUser LoggedInUser = new();
    protected bool isInEditMode = false;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] HttpClient http { get; set; } = default!;
    [Inject] NavigationManager navigationManager { get; set; } = default!;
    protected List<GetUserBadgesByUserIDResult> userBadges = new();


    private async Task UploadFiles(IBrowserFile file)
    {
        if (file == null || LoggedInUser == null)
            throw new ArgumentNullException(nameof(file), "File or model cannot be null");

        using (var memoryStream = new MemoryStream())
        {
            await file.OpenReadStream().CopyToAsync(memoryStream);

            // Check if the byte array size exceeds 500 KB
            if (memoryStream.Length > 500 * 1024)
            {
                Snackbar.Add("File too large", Severity.Error);

                throw new InvalidOperationException("File size exceeds the 500 KB limit.");
            }
            else
                LoggedInUser.ProfilePic = memoryStream.ToArray();
            Snackbar.Add("Image Uploaded Succesfullt", Severity.Success);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await GetUser();
        await GetCurrentAcquiredBadges();
    }

    protected void SwitchPageMode()
    {
        isInEditMode = !isInEditMode;
    }
    protected async Task GetUser()
    {
        var user = await http.GetFromJsonAsync<ApplicationUser>($"{navigationManager.BaseUri}api/Admin/getUserById/{AppState.UserID}");
        if (user != null)
        {
            LoggedInUser = user;
        }
        else
        {
            Snackbar.Add("Failed to collect user information, Please check your internet and try again", Severity.Error);
            LoggedInUser = new();
        }
    }

    protected async Task GetCurrentAcquiredBadges()
    {
        var result = await http.GetFromJsonAsync<List<GetUserBadgesByUserIDResult>>($"api/Dynamic/GetUserBadges/{AppState.UserID}");
        if (result.Any())
        {
            userBadges = result.ToList();
        }
    }

}
