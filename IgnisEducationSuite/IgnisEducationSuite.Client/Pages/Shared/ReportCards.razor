@page "/ReportCards"

@using EDUSphereSharedProject.Models.StoreProModels
@using IgnisEducationSuite.Client.Pages.Shared.Dialogs
@inherits AppBaseComponent
@inject IDialogService DialogService
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Report Cards</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudAlert Severity="Severity.Normal" Variant="Variant.Filled">Search for Report Cards</MudAlert>
        @if (isLoading)
        {
            <div id="loader-overlay" class="loader-overlay">
                <div class="loader-container">
                    <!-- Spinner -->
                    <div class="spinner"></div>
                    <!-- Loader Icon -->
                    <div class="loader-icon">🔄</div>
                    <!-- Loading Text -->
                    <p class="loading-text">Loading, please wait...</p>
                </div>
            </div>
        }
        <MudGrid>
            <MudItem xs="12">
                <MudDataGrid Items="@studentResults" Filterable="false" SortMode="@SortMode.None" Groupable="false">
                    <Columns>
                        <PropertyColumn Property="x => x.FirstName" />
                        <PropertyColumn Property="x => x.LastName" />
                        <PropertyColumn Property="x => x.GradeLevel" Title="Grade" />
                        <PropertyColumn Property="x => x.GPA" />
                        <PropertyColumn Property="x => x.IssuedDate.Value.ToShortDateString()" />
                        <PropertyColumn Property="x => x.TermStartDate.Value.ToShortDateString()" Title="Term Start" />
                        <PropertyColumn Property="x => x.TermEndDate.Value.ToShortDateString()" Title="Term End" />
                        <TemplateColumn CellClass="d-flex justify-center">
                            <CellTemplate>
                                <MudStack Row>
                                    <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary" OnClick="() => OpenDetailsDialogAsync(context.Item)">View Report Card</MudButton>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    protected List<GetReportCardsByStudentResult> studentResults = new();
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    protected bool isLoading = false;
    protected string StudentID = string.Empty;
    protected string ParentID = string.Empty;
    [Inject] AppState _appState { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        if (_appState.UserRole == "Student")
        {

            StudentID = _appState.UserID;

            if (StudentID != string.Empty || StudentID != null)
            {

                await GetStudentReportCards();
            }
        }
        else if (_appState.UserRole == "Parent")
        {

            ParentID = _appState.UserID;

            if (ParentID != string.Empty || ParentID != null)
            {

                await GetStudentReportCards();
            }
        }
        isLoading = false;

    }

    protected async Task GetStudentReportCards()
    {
        var service = _genericService.GetService<GetReportCardsByStudentResult>();
        if (StudentID == null || StudentID == string.Empty)
        {
            var result = await service.GetAllAsync($"api/Dynamic/GetstudentReportCardsParent/{ParentID}", true);
            if (result.IsSuccess)
            {
                studentResults = result.Data.ToList();
            }
        }
        else
        {
            var result = await service.GetAllAsync($"api/Dynamic/GetstudentReportCards/{StudentID}", true);
            if (result.IsSuccess)
            {
                studentResults = result.Data.ToList();
            }
        }
    }

    protected async Task<IEnumerable<GetAttendanceSummaryResult>> GetReportCardAttendanceSummary(GetReportCardsByStudentResult student)
    {
        string formattedStartDate = student.TermStartDate.Value.ToString("yyyy-MM-ddTHH:mm:ss");
        string formattedEndDate = student.TermEndDate.Value.ToString("yyyy-MM-ddTHH:mm:ss");
        var service = _genericService.GetService<GetAttendanceSummaryResult>();
        var result = await service.GetAllAsync($"api/Dynamic/GetReportCardAttendanceDate/{student.StudentID}/{formattedStartDate}/{formattedEndDate}", true);
        if (result.IsSuccess)
        {
            return result.Data.ToList();
        }
        else
        {
            return new List<GetAttendanceSummaryResult>();
        }
    }

    protected async Task<IEnumerable<GetReportCardDetailsResult>> GetReportCardDetailsResults(GetReportCardsByStudentResult student)
    {
        var service = _genericService.GetService<GetReportCardDetailsResult>();
        var result = await service.GetAllAsync($"api/Dynamic/GetReportCardDetailsByReportCardID/{student.ReportCardID}", true);
        if (result.IsSuccess)
        {
            return result.Data.ToList();
        }
        else
        {
            return new List<GetReportCardDetailsResult>();
        }
    }
    #region Dialog
    private async Task OpenDetailsDialogAsync(GetReportCardsByStudentResult student)
    {

        var attendances = await GetReportCardAttendanceSummary(student);
        var details = await GetReportCardDetailsResults(student);
        var parameters = new DialogParameters<ReportCardDetails> { { x => x.attendances, attendances }, { r => r.Results, details }, { rp => rp.student, student } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, NoHeader = true, Position = DialogPosition.Center };

        var dialog = await DialogService.ShowAsync<ReportCardDetails>("", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var data = result.Data;
            if (data is bool)
            {
                bool completed = (bool)data;
                if (completed)
                {
                    Snackbar.Add("Check your email address for your/ your child's Report Card", Severity.Success);
                }
            }
        }
    }
    #endregion
}