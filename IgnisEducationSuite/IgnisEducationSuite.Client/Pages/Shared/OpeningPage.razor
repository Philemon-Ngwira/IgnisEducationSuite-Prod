@inherits AppBaseComponent
<MudDialog Options="dialogOptions">
    <DialogContent>
        @if (AppState.UserRole == "Student")
        {
            <MudText Align="Align.Justify" Typo="Typo.h4">
                <b>Welcome to Ignis Education Suite! 🎓✨</b>
            </MudText>
            <MudText Typo="Typo.body1">
                <i>Ignis Education Suite is your all-in-one platform for a dynamic and engaging learning experience. Here, you can track your progress, set personal goals, and earn badges that recognize your hard work and achievements. The system is designed to motivate and inspire you to reach your full potential through a variety of activities and challenges.</i>
            </MudText>
            <MudDivider Class="mb-3" />
            <MudText Align="Align.Center" Typo="Typo.h5">
                <b>Badge Categories:</b>
            </MudText>
            <MudList T="string">
                <MudListItem>
                    <AvatarContent>
                        <MudAvatar>
                            <MudImage Src="/AchievementImages/Assignments/Tier4.png" />
                        </MudAvatar>
                    </AvatarContent>
                    <ChildContent>
                        <b>Assignment Badges</b>
                    </ChildContent>
                </MudListItem>
                <MudListItem>
                    <AvatarContent>
                        <MudAvatar>
                            <MudImage Src="/AchievementImages/Attendance/Tier4.png" />
                        </MudAvatar>
                    </AvatarContent>
                    <ChildContent>
                        <b>Attendance Badges</b>
                    </ChildContent>
                </MudListItem>
                <MudListItem>
                    <AvatarContent>
                        <MudAvatar>
                            <MudImage Src="/AchievementImages/Exams/T4.png" />
                        </MudAvatar>
                    </AvatarContent>
                    <ChildContent>
                        <b>Exam Badges</b>
                    </ChildContent>
                </MudListItem>
                <MudListItem>
                    <AvatarContent>
                        <MudAvatar>
                            <MudImage Src="/AchievementImages/LessonBadges/T4.png" />
                        </MudAvatar>
                    </AvatarContent>
                    <ChildContent>

                        <b>Lesson Badges</b>
                    </ChildContent>
                </MudListItem>
            </MudList>
            <MudText Align="Align.Center" Typo="Typo.h5">
                <b>Special Badges:</b>
            </MudText>
            <MudList T="string">
                <MudListItem SecondaryText="">
                    <AvatarContent>
                        <MudAvatar>
                            <MudImage Src="/AchievementImages/SpecialAchievements/TierThree/lvl5.png" />
                        </MudAvatar>
                    </AvatarContent>
                    <ChildContent>
                        <b>Goal Setter :</b> Earned by completing five system-defined goals, including excelling in assignments, tests, and consistent attendance and participation.
                    </ChildContent>
                </MudListItem>
                <MudListItem SecondaryText="">
                    <AvatarContent>
                        <MudAvatar>
                            <MudImage Src="/AchievementImages/SpecialAchievements/TierOne/lvl5.png" />
                        </MudAvatar>
                    </AvatarContent>
                    <ChildContent>
                        <b>All Rounder :</b> Earned by achieving at least one badge from each category, showcasing your versatility and dedication.
                    </ChildContent>
                </MudListItem>
                <MudListItem SecondaryText="">
                    <AvatarContent>
                        <MudAvatar>
                            <MudImage Src="/AchievementImages/SpecialAchievements/TierTwo/lvl5.png" />
                        </MudAvatar>
                    </AvatarContent>
                    <ChildContent>
                        <b>Marathon Learner :</b> Awarded for spending 5 consecutive hours actively learning on the LMS, demonstrating your commitment to focused learning.
                    </ChildContent>
                </MudListItem>
                <MudListItem SecondaryText="">
                    <AvatarContent>
                        <MudAvatar>
                            <MudImage Src="/AchievementImages/SpecialAchievements/TierFour/lvl5.png" />
                        </MudAvatar>
                    </AvatarContent>
                    <ChildContent>
                        <b>Overachiever :</b> Earned by achieving the highest-level badge in all categories, showcasing your unparalleled dedication and excellence across multiple areas.
                    </ChildContent>
                </MudListItem>
            </MudList>
            <MudDivider Class="mb-3" />
            <MudText Class="mb-3">Start your journey today and see how many badges you can collect as you grow and excel in your studies!</MudText>
            <MudButton Class="form-control" Variant="Variant.Outlined" FullWidth="true" EndIcon="@Icons.Material.Filled.Start" Color="Color.Primary">Start</MudButton>
        }
    </DialogContent>
</MudDialog>
<style>
    .blurydialog {
        backdrop-filter: blur(10px);
    }
</style>
@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    DialogOptions dialogOptions = new DialogOptions()
        {
            MaxWidth = MaxWidth.ExtraLarge,
            NoHeader = true,
            BackgroundClass = "blurydialog",
            BackdropClick = false
        };
    public void Close() => MudDialog.Close();
}
