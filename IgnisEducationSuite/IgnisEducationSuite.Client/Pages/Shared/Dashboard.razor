@page "/"
@using ChartJs.Blazor
@using ChartJs.Blazor.BarChart
@using ChartJs.Blazor.Common
@using ChartJs.Blazor.Common.Axes
@using ChartJs.Blazor.PieChart
@using EDUSphereSharedProject.AchievementModels
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@using IgnisEducationSuite.Client.Pages.Achievements
@using IgnisEducationSuite.Client.Services
@inject IDialogService DialogService
@inherits AppBaseComponent
<MudCard>
    <MudCardHeader Class="mb-3">
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Dashboard</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="mb-3">
        @if (isLoading)
        {
            <div id="loader-overlay" class="loader-overlay">
                <div class="loader-container">
                    <!-- Spinner -->
                    <div class="spinner"></div>
                    <!-- Loader Icon -->
                    <div class="loader-icon">🔄</div>
                    <!-- Loading Text -->
                    <p class="loading-text">Loading, please wait...</p>
                </div>
            </div>
        }
        <AuthorizeView>
            <Authorized>
                @if (AppState.IsInitialized)
                {
                    @if (!AppState.LicenseIsActive)
                    {

                        <div class="license-warning-container">
                            <div class="license-warning">
                                <p>Your license is not active.</p>
                                <p>Please contact support or renew your license to continue using this application.</p>
                            </div>
                        </div>
                    }
                    else
                    {

                        @if (AppState.UserRole == "Student" || AppState.UserRole == "Parent")
                        {
                            <MudAlert Variant="Variant.Filled" Class="mb-3" Severity="Severity.Normal" Icon="@Icons.Material.Filled.Person2">Your Role is Student</MudAlert>
                            <MudDivider Class="border border-secondary border-2 opacity-50 mb-3 "></MudDivider>

                            <div class="row gy-4 mb-24">
                                <!-- ======================= First Row Cards Start =================== -->
                                <div class="col-xxl-6">
                                    <div class="card radius-8 border-0 p-20">
                                        <div class="row gy-4">
                                            <div class="col-xxl-4">
                                                <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-1 mb-12">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                            <div class="d-flex align-items-center gap-2 mb-12">
                                                                <span class="mb-0 w-48-px h-48-px bg-base text-pink text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                    <i class="ri-group-fill"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="mb-0 fw-medium text-secondary-light text-lg">Total Students</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                            <h5 class="fw-semibold mb-0">@studentDetails.TotalStudents</h5>
                                                            <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm">+@studentDetails.NewStudentsCurrentMonth</span>
                                                                This Month
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-2 mb-12">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                            <div class="d-flex align-items-center gap-2 mb-12">
                                                                <span class="mb-0 w-48-px h-48-px bg-base text-purple text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                    <i class="ri-youtube-fill"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="mb-0 fw-medium text-secondary-light text-lg">Total Courses</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                            <h5 class="fw-semibold mb-0">@lesson.TotalLessons</h5>
                                                            <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm">+ @lesson.LessonsAddedThisMonth</span>
                                                                This Month
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-3 mb-0">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                            <div class="d-flex align-items-center gap-2 mb-12">
                                                                <span class="mb-0 w-48-px h-48-px bg-base text-info text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                    <i class="ri-money-dollar-circle-fill"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="mb-0 fw-medium text-secondary-light text-lg">Student Perdentage Increase </span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                            <h5 class="fw-semibold mb-0">@studentDetails.PercentageIncreaseInStudents%</h5>
                                                            <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm"></span>
                                                                Difference
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xxl-8">
                                                <div class="card-body p-0">
                                                    <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                        <h6 class="mb-2 fw-bold text-lg">
                                                            Perfomances
                                                        </h6>

                                                    </div>
                                                    <ul class="d-flex flex-wrap align-items-center justify-content-center mt-3 gap-3">
                                                    </ul>
                                                    <div class="mt-40">
                                                        <div id="performanceChart" class="apexcharts-tooltip-style-1">
                                                            @if (StudentPerformanceChartConfig == null)
                                                            {
                                                                <MudAlert Severity="Severity.Info" Variant="Variant.Filled">No Data found to visualize</MudAlert>
                                                            }
                                                            else
                                                            {
                                                                <Chart Config="StudentPerformanceChartConfig" />
                                                            }
                                                            @* <MudChart ChartType="ChartType.StackedBar" ChartSeries="@StudentPerfomanceSeries" @bind-SelectedIndex="Index" LegendPosition="@LegendPosition" XAxisLabels="@XAxisLabels" Width="100%" Height="350px"></MudChart> *@
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xxl-3 col-md-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                @if (AppState.UserRole == "Parent")
                                                {
                                                    <h6 class="mb-2 fw-bold text-lg mb-0">Student Attendance Trends</h6>

                                                }
                                                else
                                                {
                                                    <h6 class="mb-2 fw-bold text-lg mb-0">Current Pending Lessons</h6>
                                                    <a href="StudentLessons" class="text-primary-600 hover-text-primary d-flex align-items-center gap-1">
                                                        Pending Lessons
                                                        <iconify-icon icon="solar:alt-arrow-right-linear" class="icon"></iconify-icon>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            @if (AppState.UserRole == "Parent")
                                            {
                                                @if (attendancesTrends.Any())
                                                {
                                                    @foreach (var item in attendancesTrends)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                                            <div class="d-flex align-items-center gap-12">
                                                                <div class="flex-grow-1">
                                                                    <h6 class="text-md mb-0 fw-normal">@item.FirstName @item.LastName: <b><i></i>@item.TotalPresent Total Present</b></h6>
                                                                    <span class="text-sm text-secondary-light fw-normal">Period: Past 7 Days</span>
                                                                    <span class="text-sm text-secondary-light fw-normal">
                                                                        Attendance Percentage @item.AttendancePercentage%
                                                                    </span>
                                                                    <span class="text-sm text-secondary-light fw-normal">
                                                                        Total Number Classes Missed @item.TotalAbsent
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }


                                                }
                                                else
                                                {
                                                    <MudAlert Severity="Severity.Success">Nothing to see here ;)</MudAlert>
                                                }
                                            }
                                            else
                                            {
                                                @if (uncompletedLessons.Any())
                                                {
                                                    @foreach (var item in uncompletedLessons)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                                            <div class="d-flex align-items-center gap-12">
                                                                <div class="flex-grow-1">
                                                                    <h6 class="text-md mb-0 fw-normal">@item.ClassName: <b><i></i>@item.Title</b></h6>
                                                                    <span class="text-sm text-secondary-light fw-normal">Date Posted: @item.DatePosted.Value.ToShortDateString()</span>
                                                                    <span class="text-sm text-secondary-light fw-normal">
                                                                        <MudRating SelectedValue="@item.Rating.Value" />
                                                                    </span>
                                                                </div>
                                                            </div>
                                                            <a href="StudentLessons" class="w-24-px h-24-px bg-primary-50 text-primary-600 d-flex justify-content-center align-items-center text-lg bg-hover-primary-100 radius-4">
                                                                <i class="ri-arrow-right-s-line"></i>
                                                            </a>
                                                        </div>
                                                    }


                                                }
                                                else
                                                {
                                                    <MudAlert Severity="Severity.Success">Congrats, you are all Caught up :)</MudAlert>

                                                }
                                            }

                                        </div>
                                    </div>
                                </div>
                                <div class="col-xxl-3 col-md-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                @if (AppState.UserRole == "Student")
                                                {
                                                    <h6 class="mb-2 fw-bold text-lg mb-0">Attendance</h6>
                                                    <a href="StudentLessons" class="text-primary-600 hover-text-primary d-flex align-items-center gap-1">
                                                        Class Attendance
                                                        <iconify-icon icon="solar:alt-arrow-right-linear" class="icon"></iconify-icon>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <h6 class="mb-2 fw-bold text-lg mb-0">Missed Classes Last 7 Days</h6>

                                                }
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            @if (AppState.UserRole == "Student")
                                            {
                                                @if (attendances.Any())
                                                {
                                                    @foreach (var item in attendances)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                                            <div class="d-flex align-items-center gap-12">
                                                                <div class="flex-grow-1">
                                                                    <h6 class="text-md mb-0 fw-normal">@item.AttendanceDate.Value.ToShortDateString(): @item.ClassName</h6>
                                                                    <span class="text-sm text-secondary-light fw-normal">
                                                                        Attendance:
                                                                        @if (item.AttendanceStatus == true)
                                                                        {

                                                                            <MudChip T="string" Variant="Variant.Text" Color="Color.Success">Attended</MudChip>
                                                                        }
                                                                        else
                                                                        {

                                                                            <MudChip T="string" Variant="Variant.Text" Color="Color.Error">Absent</MudChip>
                                                                        }

                                                                    </span>
                                                                </div>
                                                            </div>
                                                            <a href="StudentLessons" class="w-24-px h-24-px bg-primary-50 text-primary-600 d-flex justify-content-center align-items-center text-lg bg-hover-primary-100 radius-4">
                                                                <i class="ri-arrow-right-s-line"></i>
                                                            </a>
                                                        </div>
                                                    }


                                                }
                                                else
                                                {
                                                    <MudAlert Severity="Severity.Success">Congrats, you are all Caught up :)</MudAlert>

                                                }
                                            }
                                            else
                                            {
                                                @if (missedClasses.Any())
                                                {
                                                    @foreach (var item in missedClasses)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                                            <div class="d-flex align-items-center gap-12">
                                                                <div class="flex-grow-1">
                                                                    <h6 class="text-md mb-0 fw-normal">@item.AttendanceDate.Value.ToShortDateString(): @item.ClassName</h6>
                                                                    <span class="text-sm text-secondary-light fw-normal">
                                                                        @item.FirstName @item.LastName
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }


                                                }
                                                else
                                                {
                                                    <MudAlert Severity="Severity.Success">Congrats, you are all Caught up :)</MudAlert>

                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                <!--==========================Second Row===============================-->
                                <div class="col-xxl-12 col-md-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                <h6 class="mb-2 fw-bold text-lg mb-0">Recent Test Results</h6>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            @if (Currentschedules.Any())
                                            {
                                                <table class="timetable">
                                                    <thead>
                                                        <tr>
                                                            <th>Time</th>
                                                            @foreach (var day in daysofTheWeek)
                                                            {
                                                                <th>@day.DayName</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var group in groupedSchedules)
                                                        {
                                                            <tr>
                                                                <td class="time">@($"{group.Key.StartTime:hh\\:mm}") - @($"{group.Key.EndTime:hh\\:mm}")</td>
                                                                @foreach (var day in dayOrder)
                                                                {
                                                                    <td class="@((group.Any(cs => cs.DayName == day) ? "" : "empty"))">
                                                                        @{
                                                                            var schedule = group.FirstOrDefault(cs => cs.DayName == day);
                                                                            if (schedule != null)
                                                                            {
                                                                                <span>@schedule.ClassName</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span>No Classes</span>
                                                                            }
                                                                        }
                                                                    </td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>

                                                </table>
                                            }
                                            else
                                            {

                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (AppState.UserRole == "Teacher" || AppState.UserRole == "Admin" || AppState.UserRole == "Staff")
                        {
                            <div class="row gy-4 mb-24">
                                <!-- ======================= First Row Cards Start =================== -->
                                <div class="col-xxl-8">
                                    <div class="card radius-8 border-0 p-20">
                                        <div class="row gy-4">
                                            <div class="col-xxl-4">
                                                <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-1 mb-12">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                            <div class="d-flex align-items-center gap-2 mb-12">
                                                                <span class="mb-0 w-48-px h-48-px bg-base text-pink text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                    <i class="ri-group-fill"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="mb-0 fw-medium text-secondary-light text-lg">Total Students</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                            <h5 class="fw-semibold mb-0">@studentDetails.TotalStudents</h5>
                                                            <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm">+@studentDetails.NewStudentsCurrentMonth</span>
                                                                This Month
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-2 mb-12">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                            <div class="d-flex align-items-center gap-2 mb-12">
                                                                <span class="mb-0 w-48-px h-48-px bg-base text-purple text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                    <i class="ri-youtube-fill"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="mb-0 fw-medium text-secondary-light text-lg">Total Courses</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                            <h5 class="fw-semibold mb-0">@lesson.TotalLessons</h5>
                                                            <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm">+ @lesson.LessonsAddedThisMonth</span>
                                                                This Month
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-3 mb-0">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                            <div class="d-flex align-items-center gap-2 mb-12">
                                                                <span class="mb-0 w-48-px h-48-px bg-base text-info text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                    <i class="ri-money-dollar-circle-fill"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="mb-0 fw-medium text-secondary-light text-lg">Student Perdentage Increase </span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                            <h5 class="fw-semibold mb-0">@studentDetails.PercentageIncreaseInStudents%</h5>
                                                            <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm"></span>
                                                                Difference
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xxl-8">
                                                <div class="card-body p-0">
                                                    <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                        <h6 class="mb-2 fw-bold text-lg">
                                                            Student Country Demographic
                                                        </h6>

                                                    </div>
                                                    <div class="mt-40">
                                                        <div id="enrollmentChart" class="apexcharts-tooltip-style-1">
                                                            @if (StudentCountryChartConfig == null)
                                                            {
                                                                <MudAlert Severity="Severity.Info" Variant="Variant.Filled">No Data found to visualize</MudAlert>
                                                            }
                                                            else
                                                            {
                                                                <Chart Config="@StudentCountryChartConfig"></Chart>
                                                            }
                                                            @* <MudChart ChartType="ChartType.StackedBar" ChartSeries="@StudentCountryDemographic" @bind-SelectedIndex="Index" LegendPosition="@LegendPosition" XAxisLabels="@CountryNames" Width="100%" Height="550px"></MudChart> *@

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <div class="col-xxl-4">
                                    <div class="card-body p-0">
                                        <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                            <h6 class="mb-2 fw-bold text-lg">
                                                Student City Demographic
                                            </h6>

                                        </div>
                                        <div class="mt-40">
                                            <div id="enrollmentChart" class="apexcharts-tooltip-style-1">
                                                @if (StudentCityChartConfig == null)
                                                {
                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">No Data found to visualize</MudAlert>
                                                }
                                                else
                                                {
                                                    <Chart Config="@StudentCityChartConfig"></Chart>
                                                }
                                                @* <MudChart ChartType="ChartType.Pie" InputData="@StudentCityDemographic" @bind-SelectedIndex="Index" InputLabels="@CityNames" Width="300px" Height="500px" /> *@

                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <!-- ======================= First Row Cards End =================== -->
                                <!-- ================== Second Row Cards Start ======================= -->
                                <!-- Top Categories Card Start -->
                                <div class="col-xxl-4 col-md-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                <h6 class="mb-2 fw-bold text-lg mb-0">Top Lessons</h6>
                                                <a href="javascript:void(0)" class="text-primary-600 hover-text-primary d-flex align-items-center gap-1">
                                                    View All
                                                    <iconify-icon icon="solar:alt-arrow-right-linear" class="icon"></iconify-icon>
                                                </a>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            @if (HighRatedLessons.Any())
                                            {
                                                @foreach (var item in HighRatedLessons)
                                                {
                                                    <div class="d-flex align-items-center justify-content-between gap-3 mb-24">
                                                        <div class="d-flex align-items-center gap-12">
                                                            <div class="w-40-px h-40-px radius-8 flex-shrink-0 bg-info-50 d-flex justify-content-center align-items-center">
                                                                @if (item.ProfilePic != null)
                                                                {
                                                                    <img src=$"data:image/jpeg;base64,{Convert.ToBase64String(@item.ProfilePic)}"; alt="" class="w-40-px h-40-px rounded-circle flex-shrink-0 me-12 overflow-hidden">
                                                                }
                                                                else
                                                                {
                                                                    @if (item.Gender == "Male")
                                                                    {
                                                                        <img src="images/avatar/Man.png" ; alt="" class="w-40-px h-40-px rounded-circle flex-shrink-0 me-12 overflow-hidden">
                                                                    }
                                                                    else
                                                                    {
                                                                        <img src="images/avatar/Woman.png" ; alt="" class="w-40-px h-40-px rounded-circle flex-shrink-0 me-12 overflow-hidden">
                                                                    }
                                                                }
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <h6 class="text-md mb-0 fw-normal">@item.ClassName @item.TeacherName</h6>
                                                                <span class="text-sm text-secondary-light fw-normal">@item.TotalLessons Courses</span>
                                                            </div>
                                                        </div>
                                                        <a href="#" class="w-24-px h-24-px bg-primary-50 text-primary-600 d-flex justify-content-center align-items-center text-lg bg-hover-primary-100 radius-4">
                                                            <i class="ri-arrow-right-s-line"></i>
                                                        </a>
                                                    </div>
                                                }
                                            }
                                            else
                                            {

                                                <MudAlert Severity="Severity.Info" Variant="Variant.Filled">No data found, Please wait for ratings to be submitted</MudAlert>

                                            }


                                        </div>
                                    </div>
