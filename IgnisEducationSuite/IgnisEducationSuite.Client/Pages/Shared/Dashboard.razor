@page "/"
@using ChartJs.Blazor
@using ChartJs.Blazor.BarChart
@using ChartJs.Blazor.Common
@using ChartJs.Blazor.Common.Axes
@using ChartJs.Blazor.PieChart
@using EDUSphereSharedProject.AchievementModels
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@using IgnisEducationSuite.Client.Pages.Achievements
@using IgnisEducationSuite.Client.Services
@using System.Security.Claims
@inject HttpClient httpClient
@inherits AppBaseComponent

<MudCard>
    <MudCardHeader Class="mb-3">
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Dashboard</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="mb-3">
        @if (isLoading)
        {
            <div id="loader-overlay" class="loader-overlay">
                <div class="loader-container">
                    <!-- Spinner -->
                    <div class="spinner"></div>
                    <!-- Loader Icon -->
                    <div class="loader-icon">🔄</div>
                    <!-- Loading Text -->
                    <p class="loading-text">Loading, please wait...</p>
                </div>
            </div>
        }
        <AuthorizeView>
            <Authorized>
                @if (AppState.IsFullyInitialized)
                {
                    @if (!AppState.LicenseIsActive)
                    {

                        <div class="license-warning-container">
                            <div class="license-warning">
                                <p>Your license is not active.</p>
                                <p>Please contact support or renew your license to continue using this application.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <MudAlert Variant="MudBlazor.Variant.Filled" Class="mb-3" Severity="Severity.Normal" Icon="@Icons.Material.Filled.Person2">Date and Time: @DateTime.Now</MudAlert>
                        @if (AppState.UserRole == "Student" || AppState.UserRole == "Parent")
                        {

                            <MudDivider Class="border border-secondary border-2 opacity-50 mb-3 "></MudDivider>
                            @if (AppState.HideStudentDashboard)
                            {
                                <MudPaper Height="700">
                                    <MudGrid>
                                        <MudItem xs="12" md="4">
                                            <MudCard>
                                                <MudCardMedia Image="images/KidsDash/a.jpg" Height="200" />
                                                <MudCardContent>
                                                    <MudText Typo="Typo.h5">Learn</MudText>
                                                    <MudText Typo="Typo.body2">Check Lessons From Teachers and Study them</MudText>
                                                </MudCardContent>
                                                <MudCardActions>
                                                    <MudButton Variant="MudBlazor.Variant.Filled" EndIcon="@Icons.Material.Filled.NavigateNext" Href="/StudentLessons" Color="Color.Primary">Go</MudButton>
                                                </MudCardActions>
                                            </MudCard>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudCard>
                                                <MudCardMedia Image="images/KidsDash/b.jpg" Height="200" />
                                                <MudCardContent>
                                                    <MudText Typo="Typo.h5">Home Work</MudText>
                                                    <MudText Typo="Typo.body2">Check Lessons From Teachers and Study them</MudText>
                                                </MudCardContent>
                                                <MudCardActions>
                                                    <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.NavigateNext" Href="/StudentAssignments" Color="Color.Secondary">Go</MudButton>
                                                </MudCardActions>
                                            </MudCard>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudCard>
                                                <MudCardMedia Image="images/KidsDash/c.jpg" Height="200" />
                                                <MudCardContent>
                                                    <MudText Typo="Typo.h5">Tests and Quizzes</MudText>
                                                    <MudText Typo="Typo.body2">Go to Exams Tests and Quizzes to keep learning</MudText>
                                                </MudCardContent>
                                                <MudCardActions>
                                                    <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.NavigateNext" Href="/Exams" Color="Color.Error">Go</MudButton>
                                                </MudCardActions>
                                            </MudCard>
                                        </MudItem>
                                    </MudGrid>
                                    <MudItem xs="12">
                                        <MudCard>
                                            <MudCardHeader>
                                                <MudText Align="Align.Left" Typo="Typo.h6" Style="color:aliceblue"><b>Class Time Table</b></MudText>
                                            </MudCardHeader>
                                            <MudCardContent>
                                                <div class="card-body">
                                                    @if (Currentschedules.Any())
                                                    {
                                                        <TimeTableViewer TimetableEntries="Currentschedules"
                                                                         Title="@(Currentschedules.Select(x=>x.LevelName).First())" />
                                                    }
                                                    else
                                                    {
                                                        <MudAlert Variant="Variant.Filled" Severity="Severity.Info">Class Time Table Not Assigned Yet</MudAlert>
                                                    }
                                                </div>

                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>

                                </MudPaper>
                            }
                            else
                            {
                                <div class="row gy-4 mb-24">
                                    <!-- ======================= First Row Cards Start =================== -->
                                    <div class="col-xxl-6">
                                        <div class="card radius-8 border-0 p-20">
                                            <div class="row gy-4">
                                                <div class="col-xxl-4">
                                                    <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-1 mb-12">
                                                        <div class="card-body p-0">
                                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                                <div class="d-flex align-items-center gap-2 mb-12">
                                                                    <span class="mb-0 w-48-px h-48-px bg-base text-pink text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                        <i class="ri-group-fill"></i>
                                                                    </span>
                                                                    <div>
                                                                        <span class="mb-0 fw-medium text-secondary-light text-lg">Total Students</span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                                <h5 class="fw-semibold mb-0">@studentDetails.TotalStudents</h5>
                                                                <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                    <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm">+@studentDetails.NewStudentsCurrentMonth</span>
                                                                    This Month
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-2 mb-12">
                                                        <div class="card-body p-0">
                                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                                <div class="d-flex align-items-center gap-2 mb-12">
                                                                    <span class="mb-0 w-48-px h-48-px bg-base text-purple text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                        <i class="ri-youtube-fill"></i>
                                                                    </span>
                                                                    <div>
                                                                        <span class="mb-0 fw-medium text-secondary-light text-lg">Total Courses</span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                                <h5 class="fw-semibold mb-0">@lesson.TotalLessons</h5>
                                                                <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                    <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm">+ @lesson.LessonsAddedThisMonth</span>
                                                                    This Month
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-3 mb-0">
                                                        <div class="card-body p-0">
                                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                                <div class="d-flex align-items-center gap-2 mb-12">
                                                                    <span class="mb-0 w-48-px h-48-px bg-base text-info text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                        <i class="ri-money-dollar-circle-fill"></i>
                                                                    </span>
                                                                    <div>
                                                                        <span class="mb-0 fw-medium text-secondary-light text-lg">Student Perdentage Increase </span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                                <h5 class="fw-semibold mb-0">@studentDetails.PercentageIncreaseInStudents%</h5>
                                                                <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                    <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm"></span>
                                                                    Difference
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-xxl-8">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                            <h6 class="mb-2 fw-bold text-lg">
                                                                Perfomances
                                                            </h6>

                                                        </div>
                                                        <ul class="d-flex flex-wrap align-items-center justify-content-center mt-3 gap-3">
                                                        </ul>
                                                        <div class="mt-40">
                                                            <div id="performanceChart" class="apexcharts-tooltip-style-1">
                                                                @if (StudentPerformanceChartConfig == null)
                                                                {
                                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">No Data found to visualize</MudAlert>
                                                                }
                                                                else
                                                                {
                                                                    <Chart Config="StudentPerformanceChartConfig" />
                                                                }
                                                                @* <MudChart ChartType="ChartType.StackedBar" ChartSeries="@StudentPerfomanceSeries" @bind-SelectedIndex="Index" LegendPosition="@LegendPosition" XAxisLabels="@XAxisLabels" Width="100%" Height="350px"></MudChart> *@
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xxl-3 col-md-4">
                                        <div class="card">
                                            <div class="card-header">
                                                <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                    @if (AppState.UserRole == "Parent")
                                                    {
                                                        <h6 class="mb-2 fw-bold text-lg mb-0" style="color:aliceblue">Attendance Trends</h6>

                                                    }
                                                    else
                                                    {
                                                        <h6 class="mb-2 fw-bold text-lg mb-0" style="color:aliceblue">Pending Lessons</h6>
                                                        <a href="StudentLessons" class="text-primary-600 hover-text-primary d-flex align-items-center gap-1">
                                                            Pending Lessons
                                                            <iconify-icon icon="solar:alt-arrow-right-linear" class="icon"></iconify-icon>
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                @if (AppState.UserRole == "Parent")
                                                {
                                                    @if (attendancesTrends.Any())
                                                    {
                                                        @foreach (var item in attendancesTrends)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                                                <div class="d-flex align-items-center gap-12">
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="text-md mb-0 fw-normal">@item.FirstName @item.LastName: <b><i></i>@item.TotalPresent Total Present</b></h6>
                                                                        <span class="text-sm text-secondary-light fw-normal">Period: Past 7 Days</span>
                                                                        <span class="text-sm text-secondary-light fw-normal">
                                                                            Attendance Percentage @item.AttendancePercentage%
                                                                        </span>
                                                                        <span class="text-sm text-secondary-light fw-normal">
                                                                            Total Number Classes Missed @item.TotalAbsent
                                                                            <br />
                                                                            Total Number Of Days Off @item.SickOffDays
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }


                                                    }
                                                    else
                                                    {
                                                        <MudAlert Severity="Severity.Success">Nothing to see here ;)</MudAlert>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (uncompletedLessons.Any())
                                                    {
                                                        @foreach (var item in uncompletedLessons)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                                                <div class="d-flex align-items-center gap-12">
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="text-md mb-0 fw-normal">@item.ClassName: <b><i></i>@item.Title</b></h6>
                                                                        <span class="text-sm text-secondary-light fw-normal">Date Posted: @item.DatePosted.Value.ToShortDateString()</span>
                                                                        <span class="text-sm text-secondary-light fw-normal">
                                                                            <MudRating SelectedValue="@item.Rating.Value" />
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                                <a href="StudentLessons" class="w-24-px h-24-px bg-primary-50 text-primary-600 d-flex justify-content-center align-items-center text-lg bg-hover-primary-100 radius-4">
                                                                    <i class="ri-arrow-right-s-line"></i>
                                                                </a>
                                                            </div>
                                                        }


                                                    }
                                                    else
                                                    {
                                                        <MudAlert Severity="Severity.Success">Congrats, you are all Caught up :)</MudAlert>

                                                    }
                                                }

                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xxl-3 col-md-4">
                                        <div class="card">
                                            <div class="card-header">
                                                <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                    @if (AppState.UserRole == "Student")
                                                    {
                                                        <h6 class="mb-2 fw-bold text-lg mb-0" style="color:aliceblue">Attendance</h6>
                                                        <a href="StudentLessons" class="text-primary-600 hover-text-primary d-flex align-items-center gap-1">
                                                            Class Attendance
                                                            <iconify-icon icon="solar:alt-arrow-right-linear" class="icon"></iconify-icon>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <h6 class="mb-2 fw-bold text-lg mb-0" style="color:aliceblue">Missed Classes Last 7 Days</h6>

                                                    }
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                @if (AppState.UserRole == "Student")
                                                {
                                                    @if (attendances.Any())
                                                    {
                                                        @foreach (var item in attendances)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                                                <div class="d-flex align-items-center gap-12">
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="text-md mb-0 fw-normal">@item.AttendanceDate.Value.ToShortDateString(): @item.ClassName</h6>
                                                                        <span class="text-sm text-secondary-light fw-normal">
                                                                            Attendance:
                                                                            @if (item.AttendanceStatus == true)
                                                                            {

                                                                                <MudChip T="string" Variant="Variant.Text" Color="Color.Success">Attended</MudChip>
                                                                            }
                                                                            else
                                                                            {

                                                                                <MudChip T="string" Variant="Variant.Text" Color="Color.Error">Absent</MudChip>
                                                                            }

                                                                        </span>
                                                                    </div>
                                                                </div>
                                                                <a href="StudentLessons" class="w-24-px h-24-px bg-primary-50 text-primary-600 d-flex justify-content-center align-items-center text-lg bg-hover-primary-100 radius-4">
                                                                    <i class="ri-arrow-right-s-line"></i>
                                                                </a>
                                                            </div>
                                                        }


                                                    }
                                                    else
                                                    {
                                                        <MudAlert Severity="Severity.Success">Congrats, you are all Caught up :)</MudAlert>

                                                    }
                                                }
                                                else
                                                {
                                                    @if (missedClasses.Any())
                                                    {
                                                        @foreach (var item in missedClasses)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                                                <div class="d-flex align-items-center gap-12">
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="text-md mb-0 fw-normal">@item.AttendanceDate.Value.ToShortDateString(): @item.ClassName</h6>
                                                                        <span class="text-sm text-secondary-light fw-normal">
                                                                            @item.FirstName @item.LastName
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }


                                                    }
                                                    else
                                                    {
                                                        <MudAlert Severity="Severity.Success">Congrats, you are all Caught up :)</MudAlert>

                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <!--==========================Second Row===============================-->
                                    <div class="col-xxl-12 col-md-12">
                                        <div class="card">
                                            <div class="card-header">
                                                <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                    <h6 class="mb-2 fw-bold text-lg mb-0" style="color:aliceblue">Time Table</h6>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                @if (Currentschedules.Any())
                                                {
                                                    <TimeTableViewer TimetableEntries="Currentschedules"
                                                                     Title="@(Currentschedules?.Where(x => !string.IsNullOrWhiteSpace(x.LevelName)).Select(x => x.LevelName).FirstOrDefault())" />


                                                }
                                                else
                                                {
                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                                        No timetable has been assigned yet.
                                                    </MudAlert>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <!--==========================Food Time Table===============================-->
                                    <div class="col-xxl-12 col-md-12">
                                        <div class="card">
                                            <div class="card-header">
                                                <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                    <h6 class="mb-2 fw-bold text-lg mb-0" style="color:aliceblue">Dining Menu</h6>
                                                </div>
                                            </div>

                                            <div class="card-body">
                                                @if (schoolMenu.Any())
                                                {
                                                    <MudTabs @bind-ActivePanelIndex="activeDayIndex">
                                                        @for (int i = 0; i < dayOrder.Count; i++)
                                                        {
                                                            var day = dayOrder[i];
                                                            <MudTabPanel Text="@day">
                                                                <MudGrid>
                                                                    @foreach (var item in schoolMenu.Where(x => x.DayOfWeek == day))
                                                                    {
                                                                        <MudItem xs="12" md="4">
                                                                            <MudCard Class="mb-3">
                                                                                <MudCardHeader>
                                                                                    <CardHeaderAvatar>
                                                                                        <MudIcon Icon="@Icons.Material.Filled.Dining" />
                                                                                    </CardHeaderAvatar>
                                                                                    <CardHeaderContent>
                                                                                        <MudText Typo="Typo.h6"><b>@item.MealName</b></MudText>
                                                                                    </CardHeaderContent>
                                                                                </MudCardHeader>
                                                                                <MudCardContent>
                                                                                    <MudText Typo="Typo.body2">Main Dish</MudText>
                                                                                    <MudText Typo="Typo.subtitle1"><b>@item.MainDish</b></MudText>
                                                                                    <MudGrid>
                                                                                        <MudItem xs="12" sm="6">
                                                                                            <MudText Typo="Typo.body2">Side Dish</MudText>
                                                                                            <MudText Typo="Typo.body1"><b>@item.SideDish</b></MudText>
                                                                                        </MudItem>
                                                                                        <MudItem xs="12" sm="6">
                                                                                            <MudText Typo="Typo.body2">Drink</MudText>
                                                                                            <MudText Typo="Typo.body1"><b>@item.Drink</b></MudText>
                                                                                        </MudItem>
                                                                                    </MudGrid>
                                                                                </MudCardContent>
                                                                            </MudCard>
                                                                        </MudItem>
                                                                    }
                                                                </MudGrid>
                                                            </MudTabPanel>
                                                        }
                                                    </MudTabs>
                                                }
                                                else
                                                {
                                                    <MudAlert Severity="Severity.Info">No menu available this week</MudAlert>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            }
                        }
                        else if (AppState.UserRole == "Teacher" || AppState.UserRole == "Admin" || AppState.UserRole == "Staff")
                        {
                            <div class="row gy-4 mb-24">
                                <!-- ======================= First Row Cards Start =================== -->
                                <div class="col-xxl-8">
                                    <div class="card radius-8 border-0 p-20">
                                        <div class="row gy-4">
                                            <div class="col-xxl-4">
                                                <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-1 mb-12">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                            <div class="d-flex align-items-center gap-2 mb-12">
                                                                <span class="mb-0 w-48-px h-48-px bg-base text-pink text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                    <i class="ri-group-fill"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="mb-0 fw-medium text-secondary-light text-lg">Total Students</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                            <h5 class="fw-semibold mb-0">@studentDetails.TotalStudents</h5>
                                                            <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm">+@studentDetails.NewStudentsCurrentMonth</span>
                                                                This Month
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-2 mb-12">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                            <div class="d-flex align-items-center gap-2 mb-12">
                                                                <span class="mb-0 w-48-px h-48-px bg-base text-purple text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                    <i class="ri-youtube-fill"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="mb-0 fw-medium text-secondary-light text-lg">Total Courses</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                            <h5 class="fw-semibold mb-0">@lesson.TotalLessons</h5>
                                                            <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm">+ @lesson.LessonsAddedThisMonth</span>
                                                                This Month
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card p-3 radius-8 shadow-none bg-gradient-dark-start-3 mb-0">
                                                    <div class="card-body p-0">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-0">
                                                            <div class="d-flex align-items-center gap-2 mb-12">
                                                                <span class="mb-0 w-48-px h-48-px bg-base text-info text-2xl flex-shrink-0 d-flex justify-content-center align-items-center rounded-circle h6">
                                                                    <i class="ri-money-dollar-circle-fill"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="mb-0 fw-medium text-secondary-light text-lg">Student Perdentage Increase </span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-8">
                                                            <h5 class="fw-semibold mb-0">@studentDetails.PercentageIncreaseInStudents%</h5>
                                                            <p class="text-sm mb-0 d-flex align-items-center gap-8">
                                                                <span class="text-white px-1 rounded-2 fw-medium bg-success-main text-sm"></span>
                                                                Difference
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xxl-8">
                                                <div class="card-body p-0">
                                                    <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                        <h6 class="mb-2 fw-bold text-lg">
                                                            Student Country Demographic
                                                        </h6>

                                                    </div>
                                                    <div class="mt-40">
                                                        <div id="enrollmentChart" class="apexcharts-tooltip-style-1">
                                                            @if (StudentCountryChartConfig == null)
                                                            {
                                                                <MudAlert Severity="Severity.Info" Variant="MudBlazor.Variant.Filled">No Data found to visualize</MudAlert>
                                                            }
                                                            else
                                                            {
                                                                <div class="rz-p-0 rz-p-md-12">
                                                                    <Radzen.Blazor.RadzenChart>
                                                                        <Radzen.Blazor.RadzenColumnSeries Data="@StudentCountryDemographicRadzen"
                                                                                            CategoryProperty="Country"
                                                                                            ValueProperty="StudentCount"
                                                                                            Title="Total Students">
                                                                            <Radzen.Blazor.RadzenSeriesDataLabels Visible="true" />
                                                                        </Radzen.Blazor.RadzenColumnSeries>

                                                                        <Radzen.Blazor.RadzenCategoryAxis Title="Countries" />
                                                                        <Radzen.Blazor.RadzenValueAxis Title="Total Number" />
                                                                    </Radzen.Blazor.RadzenChart>
                                                                </div>
                                                                @* <Chart Config="@StudentCountryChartConfig"></Chart> *@
                                                            }
                                                            @* <MudChart ChartType="ChartType.StackedBar" ChartSeries="@StudentCountryDemographic" @bind-SelectedIndex="Index" LegendPosition="@LegendPosition" XAxisLabels="@CountryNames" Width="100%" Height="550px"></MudChart> *@

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <div class="col-xxl-4">
                                    <div class="card-body p-0">
                                        <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                            <h6 class="mb-2 fw-bold text-lg">
                                                Student City Demographic
                                            </h6>

                                        </div>
                                        <div class="mt-40">
                                            <div id="enrollmentChart" class="apexcharts-tooltip-style-1">
                                                @if (StudentCityChartConfig == null)
                                                {
                                                    <MudAlert Severity="Severity.Info" Variant="MudBlazor.Variant.Filled">No Data found to visualize</MudAlert>
                                                }
                                                else
                                                {
                                                    @*  <Chart Config="@StudentCityChartConfig"></Chart> *@
                                                    <Radzen.Blazor.RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12" AlignItems="Radzen.AlignItems.Center">
                                                        <Radzen.Blazor.RadzenCard Variant="Radzen.Variant.Outlined" Style="width: 100%;">
                                                            <Radzen.Blazor.RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="Radzen.AlignItems.Center" Gap="0.5rem" Wrap="Radzen.FlexWrap.Wrap">
                                                                <Radzen.Blazor.RadzenCheckBox @bind-Value="@showDataLabels" Name="dataLabels"></Radzen.Blazor.RadzenCheckBox>
                                                                <Radzen.Blazor.RadzenLabel Text="Show Data Labels" Component="dataLabels" />
                                                                <Radzen.Blazor.RadzenCheckBox @bind-Value="@showTooltipOnLegend" Name="legendTooltip"></Radzen.Blazor.RadzenCheckBox>
                                                                <Radzen.Blazor.RadzenLabel Text="Show Tooltip On Legend" Component="legendTooltip" />
                                                            </Radzen.Blazor.RadzenStack>
                                                        </Radzen.Blazor.RadzenCard>

                                                        <Radzen.Blazor.RadzenStack Style="width: 100%; max-width: 600px;">
                                                            <Radzen.Blazor.RadzenChart>
                                                                <Radzen.Blazor.RadzenDonutSeries Data="@StudentCityDemographicRadzen" CategoryProperty="City" ValueProperty="StudentCount"
                                                                                                 TotalAngle="180" StartAngle="180" ShowTooltipOnLegend="@showTooltipOnLegend">
                                                                    <ChildContent>
                                                                        <Radzen.Blazor.RadzenSeriesDataLabels Visible="@showDataLabels" />
                                                                    </ChildContent>
                                                                    <TitleTemplate>
                                                                        <div class="rz-donut-content">
                                                                            <div>Students</div>
                                                                            <div>by City</div>
                                                                        </div>
                                                                    </TitleTemplate>
                                                                </Radzen.Blazor.RadzenDonutSeries>
                                                            </Radzen.Blazor.RadzenChart>
                                                        </Radzen.Blazor.RadzenStack>
                                                    </Radzen.Blazor.RadzenStack>
                                                }
                                                @* <MudChart ChartType="ChartType.Pie" InputData="@StudentCityDemographic" @bind-SelectedIndex="Index" InputLabels="@CityNames" Width="300px" Height="500px" /> *@

                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <!-- ======================= First Row Cards End =================== -->
                                <!-- ================== Second Row Cards Start ======================= -->
                                <!-- Top Categories Card Start -->
                                <div class="col-xxl-4 col-md-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                <h6 class="mb-2 fw-bold text-lg mb-0" style="color:aliceblue">Top Lessons</h6>

                                            </div>
                                        </div>
                                        <div class="card-body">
                                            @if (HighRatedLessons.Any())
                                            {
                                                @foreach (var item in HighRatedLessons)
                                                {
                                                    <div class="d-flex align-items-center justify-content-between gap-3 mb-24">
                                                        <div class="d-flex align-items-center gap-12">
                                                            <div class="w-40-px h-40-px radius-8 flex-shrink-0 bg-info-50 d-flex justify-content-center align-items-center">

                                                                @if (item.Gender == "Male")
                                                                {
                                                                    <img src="images/avatar/Man.png" ; alt="" class="w-40-px h-40-px rounded-circle flex-shrink-0 me-12 overflow-hidden">
                                                                }
                                                                else
                                                                {
                                                                    <img src="images/avatar/Woman.png" ; alt="" class="w-40-px h-40-px rounded-circle flex-shrink-0 me-12 overflow-hidden">
                                                                }

                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <h6 class="text-md mb-0 fw-normal">@item.ClassName @item.TeacherName</h6>
                                                                <span class="text-sm text-secondary-light fw-normal">@item.TotalLessons Courses</span>
                                                            </div>
                                                        </div>
                                                        <a href="#" class="w-24-px h-24-px bg-primary-50 text-primary-600 d-flex justify-content-center align-items-center text-lg bg-hover-primary-100 radius-4">
                                                            <i class="ri-arrow-right-s-line"></i>
                                                        </a>
                                                    </div>
                                                }
                                            }
                                            else
                                            {

                                                <MudAlert Severity="Severity.Info" Variant="MudBlazor.Variant.Filled">No data found, Please wait for ratings to be submitted</MudAlert>

                                            }


                                        </div>
                                    </div>
                                </div>
                                <!-- Top Categories Card End -->
                                <!-- Instructor Card Start -->
                                <div class="col-xxl-4 col-md-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                <h6 class="mb-2 fw-bold text-lg mb-0" style="color:aliceblue">Top Instructors</h6>

                                            </div>
                                        </div>
                                        <div class="card-body">
                                            @if (_top5Teachers.Any())
                                            {
                                                @foreach (var item in _top5Teachers)
                                                {
                                                    <div class="d-flex align-items-center justify-content-between gap-3 mb-24">
                                                        <div class="d-flex align-items-center">


                                                            @if (item.Gender == "Male")
                                                            {
                                                                <img src="images/avatar/Man.png" alt="" class="w-40-px h-40-px rounded-circle flex-shrink-0 me-12 overflow-hidden">
                                                            }
                                                            else
                                                            {
                                                                <img src="images/avatar/Woman.png" alt="" class="w-40-px h-40-px rounded-circle flex-shrink-0 me-12 overflow-hidden">
                                                            }

                                                            <div class="flex-grow-1">
                                                                <h6 class="text-md mb-0 fw-medium">@item.FirstName @item.LastName</h6>
                                                                <span class="text-sm text-secondary-light fw-medium">Average Rating: @item.AverageRating</span>
                                                            </div>
                                                        </div>
                                                        <div class="">
                                                            <div class="d-flex align-items-center gap-6 mb-1">
                                                                @for (int i = 0; i < (item.AverageRating); i++)
                                                                {
                                                                    <span class="text-lg text-warning-600 d-flex line-height-1"><i class="ri-star-fill"></i></span>
                                                                }

                                                            </div>
                                                            <span class="text-primary-light text-sm d-block text-end">@item.TotalHighRatedLessons Lessons Rated 4 and above</span>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <MudAlert Severity="Severity.Info" Variant="MudBlazor.Variant.Filled">No data found</MudAlert>
                                            }



                                        </div>
                                    </div>
                                </div>
                                <!-- Instructor Card End -->
                                <!-- Student Progress Card Start -->
                                <div class="col-xxl-4 col-md-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="d-flex align-items-center flex-wrap gap-2 justify-content-between">
                                                <h6 class="mb-2 fw-bold text-lg mb-0" style="color:aliceblue">Best Perfoming Students</h6>

                                            </div>
                                        </div>
                                        <div class="card-body">
                                            @if (bestPerformingStudents.Any())
                                            {
                                                @foreach (var item in bestPerformingStudents)
                                                {
                                                    <div class="d-flex align-items-center justify-content-between gap-3 mb-24">
                                                        <div class="d-flex align-items-center">
                                                            @if (item.ProfilePic != null)
                                                            {
                                                                <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(item.ProfilePic)}")" alt="" class="w-40-px h-40-px radius-8 flex-shrink-0 me-12 overflow-hidden">
                                                            }
                                                            else
                                                            {
                                                                <img src="images/Avatar/Man.png" alt="" class="w-40-px h-40-px radius-8 flex-shrink-0 me-12 overflow-hidden">
                                                            }
                                                            <div class="flex-grow-1">
                                                                <h6 class="text-md mb-0 fw-medium">@item.FirstName @item.LastName</h6>
                                                                <span class="text-sm text-secondary-light fw-medium">Total Badges: @item.BadgeScore</span>
                                                            </div>
                                                        </div>
                                                        <div class="">
                                                            <span class="text-primary-light text-sm d-block text-end">
                                                                @{
                                                                    var percentage = Math.Round(item.FinalScore ?? 0, 2);
                                                                    var maxPercentage = 100;
                                                                    var dashOffset = (1 - (percentage / maxPercentage)) * 220;
                                                                }
                                                                <svg class="radial-progress" data-percentage="@percentage" viewBox="0 0 80 80">
                                                                    <circle class="incomplete" cx="40" cy="40" r="35"></circle>
                                                                    <circle class="complete" cx="40" cy="40" r="35" style="stroke-dashoffset: @dashOffset;"></circle>
                                                                </svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                }



                                            }
                                            else
                                            {
                                                <MudAlert Severity="Severity.Info" Variant="MudBlazor.Variant.Filled">No data found</MudAlert>

                                            }


                                        </div>
                                    </div>
                                </div>
                                <!-- Student Progress Card End -->

                            </div>
                        }
                        else if (AppState.UserRole == "Chef/Cook")
                        {
                            <IgnisEducationSuite.Client.Pages.Staff.Kitchen></IgnisEducationSuite.Client.Pages.Staff.Kitchen>
                        }
                        else if (AppState.UserRole == "Clinic Staff")
                        {
                            <IgnisEducationSuite.Client.Pages.Shared.DashboardLayers.ClinicDashboard />
                        }
                        else if (AppState.UserRole == "TransportStaff")
                        {
                            <IgnisEducationSuite.Client.Pages.Management.SchoolOperations.TransportManagement.Driver.DriverDashboard />
                        }
                    }
                }

            </Authorized>
            <NotAuthorized>
                <div class="unauthorized-container">
                    <div class="animation-container">
                        <!-- Animation or icon can go here -->
                        <div class="circle"></div>
                        <div class="lock-icon">🔒</div>
                    </div>
                    <h1>You Are Not Authorized</h1>
                    <p>It seems like you don't have the required permissions to access this page. Please login with your account to get access.</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>



    </MudCardContent>
</MudCard>
