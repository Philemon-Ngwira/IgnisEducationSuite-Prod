@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.UniversalModels
@inherits AppBaseComponent

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudText Align="Align.Center" Typo="Typo.h4">@($"{AppState.SchoolName ?? "IGNIS EDUCATION SUITE"}")</MudText>
            </MudItem>

            <MudItem xs="12">
                <MudAlert NoIcon="true">
                    <MudSpacer />
                    <MudText Typo="Typo.h5"><b>REPORT CARD</b></MudText>
                    <MudSpacer />
                </MudAlert>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Align="Align.Left"><b>Name: @student.FirstName @student.LastName</b></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Align="Align.Left"><b>Grade: @student.LevelName</b></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Align="Align.Left"><b>StudentID: @student.StudentNumber</b></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDateRangePicker @bind-DateRange="_dateRangeTerm" Margin="Margin.Dense" Clearable="true"
                                    PlaceholderStart="Term Start Date" PlaceholderEnd="Term End Date" />
            </MudItem>

            <MudItem xs="12" Class="mb-3">
                <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.School">Classes</MudAlert>
                <MudDivider Class="mb-3" />
                @if (AppState.UserRole == "Teacher" || AppState.UserRole == "Admin")
                {
                    <MudDataGrid T="ReportCardDetail" Items="_visibleReportCardDetails"
                                 EditMode="DataGridEditMode.Cell"
                                 StartedEditingItem="@StartedEditingItem"
                                 CanceledEditingItem="@CanceledEditingItem"
                                 CommittedItemChanges="@CommittedItemChanges"
                                 Bordered="true" Dense="true"
                                 EditTrigger="DataGridEditTrigger.OnRowClick">

                        <Columns>
                            <PropertyColumn Property="x => x.Class.ClassName" Title="Class" Editable="false" />
                            <!-- Score is editable -->
                            <TemplateColumn Title="Score">
                                <CellTemplate>
                                    @if (CanEditScores && context.Item.CanBeEditied)
                                    {
                                        <MudTextField T="double?" Value="context.Item.Score"
                                                       ValueChanged="@(v => OnScoreChanged(context.Item, v))"
                                                       Immediate="true"
                                                       Margin="Margin.Dense"
                                                       Variant="Variant.Outlined"
                                                       Style="max-width:80px" />
                                    }
                                    else
                                    {
                                        @context.Item.Score
                                    }
                                </CellTemplate>
                            </TemplateColumn>

                            <!-- Grade auto-fills, not editable -->
                            <PropertyColumn Property="x => x.Grade" Title="Grading" Editable="false" />
                        </Columns>
                    </MudDataGrid>
                }
            </MudItem>

            <MudItem xs="12" Class="mt-3">
                <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Info">Summary (fill manually if applicable)</MudAlert>
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudTextField T="int?" Disabled="!CanEditScores" Margin="Margin.Dense" Label="Points in Best Six" @bind-Value="newReportCard.PointsInBestSix" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="int?" Disabled="!CanEditScores" Margin="Margin.Dense" Label="Marks in Best Six" @bind-Value="newReportCard.MarksInBestSix" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="int?" Disabled="!CanEditScores" Margin="Margin.Dense" Label="Position in Class" @bind-Value="newReportCard.PositionInClass" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            @if (ReportCardType == "EndTerm")
            {
                @if (AppState.UserRole == "Dean" || AppState.UserRole == "Principal")
                {
                    <MudItem xs="12" Class="mt-3">
                        <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.People">Review & Comments</MudAlert>
                        <MudGrid>
                            @if (AppState.UserRole == "Dean")
                            {
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string" Label="Dean Name" @bind-Value="newReportCard.DeanName" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string" Label="Dean's Comment" @bind-Value="newReportCard.DeansComment" Variant="Variant.Outlined" />
                                </MudItem>
                            }
                            @if (AppState.UserRole == "Principal")
                            {
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string" Label="Principal Name" @bind-Value="newReportCard.PrincipleName" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string" Label="Principal's Comment" @bind-Value="newReportCard.PrinciplesComment" Variant="Variant.Outlined" />
                                </MudItem>
                            }
                        </MudGrid>
                    </MudItem>
                }
            }

        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButtonGroup Class="mn-3" OverrideStyles=false>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" Color="Color.Error" OnClick="CloseDialog">Close</MudButton>
            <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.SaveAlt" Color="Color.Success" OnClick="SubmitReportCard">Submit Report Card</MudButton>
        </MudButtonGroup>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<ClassTeacher> ClassTeachers { get; set; } = new();
    [Parameter] public StudentWithClassesDTO student { get; set; } = new();
    [Parameter] public List<Class> Classes { get; set; } = new();
    [Parameter] public List<GradingScale> GradingScales { get; set; } = new();
    [Parameter] public ReportCard newReportCard { get; set; } = new();
    [Parameter] public List<ReportCardDetail> reportCardDetails { get; set; } = new();
    [Parameter] public Guid TeacherID { get; set; }
    [Parameter] public string ReportCardType { get; set; }
    private DateRange _dateRangeTerm { get; set; }
    private List<ReportCardDetail> _visibleReportCardDetails = new();

    [Inject] GenericServiceFactory _genericService { get; set; } = default!;

    protected bool isLoading = false;
    protected bool _editTriggerRowClick = true;

    private bool IsTeacher => AppState.UserRole == "Teacher";
    private bool IsAdmin => AppState.UserRole == "Admin";

    bool CanEditScores =>
        AppState.UserRole is "Teacher" or "Staff" or "Admin"
        && string.Equals(
            newReportCard.ApprovalStatus?.Trim(),
            "DCB75F3C-FF7C-4472-AAEB-667DB7BC86A0",
            StringComparison.OrdinalIgnoreCase
        );

    /// Detect if school uses sections
    bool SchoolUsesSections => student.LevelSectionID != null;

    /// Detect if logged teacher is the class teacher of this student
    bool IsClassTeacherForStudent =>
     ClassTeachers.Any(ct =>
         ct.TeacherID == TeacherID &&
         ct.AcademicLevelID == student.AcademicLevelID &&
         (
             !SchoolUsesSections ||
             (
                 ct.LevelSectionID == student.LevelSectionID ||
                 (!ct.LevelSectionID.HasValue && !student.LevelSectionID.HasValue)
             )
         ));

    protected override void OnParametersSet()
    {
        _dateRangeTerm ??= new DateRange
        {
            Start = newReportCard.TermStartDate,
            End = newReportCard.TermEndDate
        };

        var studentClassIds = student.Classes
            .Select(x => x.ClassID)
            .ToHashSet();

        List<Class> allowedClasses;

        // Determine which classes the user can SEE
        if (IsAdmin)
        {
            // Admin sees all student classes
            allowedClasses = Classes
                .Where(c => studentClassIds.Contains(c.ClassID))
                .ToList();
        }
        else if (IsTeacher)
        {
            if (IsClassTeacherForStudent)
            {
                // Class teacher sees all student classes
                allowedClasses = Classes
                    .Where(c => studentClassIds.Contains(c.ClassID))
                    .ToList();
            }
            else
            {
                // Subject teacher sees only their subjects
                allowedClasses = Classes
                    .Where(c =>
                        c.TeacherID == TeacherID &&
                        studentClassIds.Contains(c.ClassID))
                    .ToList();
            }
        }
        else
        {
            allowedClasses = new List<Class>();
        }

        // Build the visible report card rows
        _visibleReportCardDetails = allowedClasses.Select(cls =>
        {
            var detail = reportCardDetails
                .FirstOrDefault(r => r.ClassID == cls.ClassID);

            bool canEdit =
                IsAdmin ||
                (IsTeacher && cls.TeacherID == TeacherID);

            if (detail != null)
            {
                detail.Class = cls;
                detail.CanBeEditied = canEdit;
                return detail;
            }

            return new ReportCardDetail
            {
                ReportCardDetailID = Guid.Empty, // 🔥 THIS IS THE KEY FIX,
                ReportCardID = newReportCard.ReportCardID,
                ClassID = cls.ClassID,
                Class = cls,
                Score = 0,
                CanBeEditied = canEdit
            };
        }).ToList();
    }

    private void CloseDialog() => MudDialog.Cancel();
    void OnScoreChanged(ReportCardDetail item, double? value)
    {
        item.Score = value ?? 0;

        var gradeAndGPA = GetGradeAndCalculateGPA(item, GradingScales);

        item.Grade = gradeAndGPA.Grade;
        item.GPA = gradeAndGPA.GPA;
        item.FinalComment = gradeAndGPA.Comment;

        StateHasChanged();
    }
  private async void SubmitReportCard()
{
    LoaderService.Show("Please wait while we create the report card...");

    var service = _genericService.GetService<ReportCard>();

    var subjectGPAs = _visibleReportCardDetails
        .Select(x => (double)x.GPA.GetValueOrDefault())
        .ToList();

    newReportCard.GPA = (decimal?)CalculateFinalGPA(subjectGPAs);

    var savedHeader = await service.UpdateAsync(
        "api/Dynamic/UpdateEntity",
        "reportcard",
        newReportCard);

    if (savedHeader.IsSuccess)
    {
        foreach (var item in _visibleReportCardDetails)
            item.Class = null;

        // 🔥 FIX STARTS HERE

        var existingItems = _visibleReportCardDetails
            .Where(x => x.ReportCardDetailID != Guid.Empty)
            .ToList();

        var newItems = _visibleReportCardDetails
            .Where(x => x.ReportCardDetailID == Guid.Empty)
            .ToList();

        var updateService = _genericService.GetService<ReportCardDetail>();
        var createService = _genericService.GetService<List<ReportCardDetail>>();

        // ✅ UPDATE existing
        foreach (var item in existingItems)
        {
            await updateService.UpdateAsync(
                "api/Dynamic/UpdateEntity",
                "reportcarddetail",
                item);
        }

        // ✅ CREATE new
        if (newItems.Any())
        {
            foreach (var item in newItems)
                item.ReportCardDetailID = Guid.NewGuid();

            await createService.PostAsync(
                "api/Dynamic/PostEntities",
                "reportcarddetail",
                newItems);
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    LoaderService.Hide();
}

    public (string Grade, double? GPA, string? Comment)
        GetGradeAndCalculateGPA(ReportCardDetail detail, List<GradingScale> gradingScales)
    {
        var grade = gradingScales.FirstOrDefault(gs =>
            detail.Score >= gs.LoweScore &&
            detail.Score <= gs.UpperScore);

        if (grade == null)
            throw new ArgumentException(
                $"Score {detail.Score} does not fall within any defined grading scale.");

        return (grade.Description, (double)grade.GPA.Value, grade.Comment);
    }

    #region DataGrid Events

    void StartedEditingItem(ReportCardDetail item) { }

    void CanceledEditingItem(ReportCardDetail item) { }

    void CommittedItemChanges(ReportCardDetail item)
    {
        var gradeAndGPA = GetGradeAndCalculateGPA(item, GradingScales);

        item.Grade = gradeAndGPA.Grade;
        item.GPA = gradeAndGPA.GPA;
        item.FinalComment = gradeAndGPA.Comment;

        StateHasChanged();
    }

    public double CalculateFinalGPA(List<double> gpas)
    {
        if (gpas == null || gpas.Count == 0)
            throw new ArgumentException("No GPAs provided to calculate the final GPA.");

        return Math.Round(gpas.Sum() / gpas.Count, 2);
    }

    #endregion
}
