@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.UniversalModels
@inherits AppBaseComponent

<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <div id="loader-overlay" class="loader-overlay">
                <div class="loader-container">
                    <div class="spinner"></div>
                    <div class="loader-icon">🔄</div>
                    <p class="loading-text">Loading, please wait...</p>
                </div>
            </div>
        }

        <MudGrid>
            <MudItem xs="12">
                <MudText Align="Align.Center" Typo="Typo.h4">@($"{AppState.SchoolName ?? "IGNIS EDUCATION SUITE"}")</MudText>
            </MudItem>

            <MudItem xs="12">
                <MudAlert NoIcon="true">
                    <MudSpacer />
                    <MudText Typo="Typo.h5"><b>REPORT CARD</b></MudText>
                    <MudSpacer />
                </MudAlert>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Align="Align.Left"><b>Name: @student.FirstName @student.LastName</b></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Align="Align.Left"><b>Grade: @student.LevelName</b></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Align="Align.Left"><b>StudentID: @student.StudentNumber</b></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDateRangePicker @bind-DateRange="_dateRangeTerm" Margin="Margin.Dense" Clearable="true"
                                    PlaceholderStart="Term Start Date" PlaceholderEnd="Term End Date" />
            </MudItem>

            <MudItem xs="12" Class="mb-3">
                <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.School">Classes</MudAlert>
                <MudDivider Class="mb-3" />

                <MudDataGrid ReadOnly="@(!CanEditScores)" T="ReportCardDetail" Items="reportCardDetails"
                             EditMode="DataGridEditMode.Cell"
                             StartedEditingItem="@StartedEditingItem"
                             CanceledEditingItem="@CanceledEditingItem"
                             CommittedItemChanges="@CommittedItemChanges"
                             Bordered="true" Dense="true"
                             EditTrigger="@(_editTriggerRowClick ? DataGridEditTrigger.OnRowClick : DataGridEditTrigger.Manual)">

                    <Columns>
                        <PropertyColumn Property="x => x.Class.ClassName" Title="Class" Editable="false" />
                        <!-- Score is editable -->
                        <PropertyColumn Property="x => x.Score" Title="Score" @* Editable="@context.Item.CanBeEdited"  *@/>
                        <!-- Grade auto-fills, not editable -->
                        <PropertyColumn Property="x => x.Grade" Title="Grading" Editable="false" />
                    </Columns>
                </MudDataGrid>

            </MudItem>

            <MudItem xs="12" Class="mt-3">
                <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Info">Summary (fill manually if applicable)</MudAlert>
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudTextField T="int?" Disabled="!CanEditScores" Margin="Margin.Dense" Label="Points in Best Six" @bind-Value="newReportCard.PointsInBestSix" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="int?" Disabled="!CanEditScores" Margin="Margin.Dense" Label="Marks in Best Six" @bind-Value="newReportCard.MarksInBestSix" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="int?" Disabled="!CanEditScores" Margin="Margin.Dense" Label="Position in Class" @bind-Value="newReportCard.PositionInClass" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            @if (AppState.UserRole == "Dean" || AppState.UserRole == "Principal")
            {
                <MudItem xs="12" Class="mt-3">
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.People">Review & Comments</MudAlert>
                    <MudGrid>
                        @if (AppState.UserRole == "Dean")
                        {
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="Dean Name" @bind-Value="newReportCard.DeanName" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="Dean's Comment" @bind-Value="newReportCard.DeansComment" Variant="Variant.Outlined" />
                            </MudItem>
                        }
                        @if (AppState.UserRole == "Principal")
                        {
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="Principal Name" @bind-Value="newReportCard.PrincipleName" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="Principal's Comment" @bind-Value="newReportCard.PrinciplesComment" Variant="Variant.Outlined" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudItem>
            }

        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButtonGroup Class="mn-3" OverrideStyles=false>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" Color="Color.Error" OnClick="CloseDialog">Close</MudButton>
            <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.SaveAlt" Color="Color.Success" OnClick="SubmitReportCard">Submit Report Card</MudButton>
        </MudButtonGroup>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public StudentWithClassesDTO student { get; set; } = new();
    [Parameter] public List<Class> Classes { get; set; } = new();
    [Parameter] public List<GradingScale> GradingScales { get; set; } = new();
    [Parameter] public ReportCard newReportCard { get; set; } = new();
    private DateRange _dateRangeTerm { get; set; }
    [Parameter] public List<ReportCardDetail> reportCardDetails { get; set; } = new();
    protected bool _editTriggerRowClick = false;
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    protected bool isLoading = false;
    bool CanEditScores =>
    AppState.UserRole is "Teacher" or "Staff" or "Admin" &&
    newReportCard.ApprovalStatus == "DCB75F3C-FF7C-4472-AAEB-667DB7BC86A0"; // TeacherEntryOpen

    protected override void OnParametersSet()
    {
        if (_dateRangeTerm == null)
            _dateRangeTerm = new DateRange();

        _dateRangeTerm.Start = newReportCard.TermStartDate;
        _dateRangeTerm.End = newReportCard.TermEndDate;

        // Filter classes based on role
        List<Class> classesToUse;

        if (AppState.UserRole == "Teacher")
        {
            classesToUse = Classes
                .Where(c =>
                    c.Teacher != null &&
                    c.Teacher.UserID == AppState.UserID &&
                    student.ClassNames.Any(n =>
                        string.Equals(n, c.ClassName, StringComparison.OrdinalIgnoreCase)
                    )
                )
                .ToList();
        }
        else
        {
            classesToUse = Classes.ToList();
        }
        var containedClasses = new List<Class>();
        foreach (var item in classesToUse)
        {
            if (reportCardDetails.Any(r => r.ClassID == item.ClassID))
            {
                containedClasses.Add(item);
                continue;
            }
            reportCardDetails.Add(new ReportCardDetail
            {
                ReportCardDetailID = Guid.NewGuid(),
                ReportCardID = newReportCard.ReportCardID,
                ClassID = item.ClassID,
                Score = 0,
                Class = item,

            });

        }
        foreach (var CA in containedClasses)
        {
            var rd = reportCardDetails.Where(x => x.ClassID == CA.ClassID).First();
            reportCardDetails.Remove(rd);
            rd.Class = CA;
            rd.CanBeEditied = false;
            reportCardDetails.Add(rd);
        }
    }

    private void CloseDialog() => MudDialog.Cancel();

    private async void SubmitReportCard()
    {
        isLoading = true;

        var service = _genericService.GetService<ReportCard>();

        // Calculate final GPA
        var subjectGPAs = reportCardDetails.Select(x => (double)x.GPA.GetValueOrDefault()).ToList();
        newReportCard.GPA = (decimal?)CalculateFinalGPA(subjectGPAs);

        // Save report card header
        var savedHeader = await service.UpdateAsync("api/Dynamic/UpdateEntity", "reportcard", newReportCard);
        if (savedHeader.IsSuccess)
        {
            // Remove navigation properties before saving details
            foreach (var item in reportCardDetails)
                item.Class = null;

            var serviceDetails = _genericService.GetService<List<ReportCardDetail>>();
            var result = await serviceDetails.PostAsync("api/Dynamic/PostEntities", "reportcarddetail", reportCardDetails);

            if (result.IsSuccess)
                MudDialog.Close(DialogResult.Ok(true));
        }

        isLoading = false;
    }

    public (string Grade, double? GPA) GetGradeAndCalculateGPA(ReportCardDetail detail, List<GradingScale> gradingScales)
    {
        var grade = gradingScales.FirstOrDefault(gs => detail.Score >= gs.LoweScore && detail.Score <= gs.UpperScore);
        if (grade == null)
            throw new ArgumentException($"Score {detail.Score} does not fall within any defined grading scale.");

        return (grade.Description, (double)grade.GPA.Value);
    }

    #region DataGrid Events
    void StartedEditingItem(ReportCardDetail item) { }
    void CanceledEditingItem(ReportCardDetail item) { }

    void CommittedItemChanges(ReportCardDetail item)
    {
        var gradeAndGPA = GetGradeAndCalculateGPA(item, GradingScales);
        item.Grade = gradeAndGPA.Grade;
        item.GPA = gradeAndGPA.GPA;

        StateHasChanged();
    }

    public double CalculateFinalGPA(List<double> gpas)
    {
        if (gpas == null || gpas.Count == 0)
            throw new ArgumentException("No GPAs provided to calculate the final GPA.");

        return Math.Round(gpas.Sum() / gpas.Count, 2);
    }
    #endregion
}
