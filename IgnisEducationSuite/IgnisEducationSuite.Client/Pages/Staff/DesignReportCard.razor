@* @page "/reportcarddesigner"


@using EDUSphereSharedProject.UniversalModels
@using Microsoft.AspNetCore.Components.Web
<h3 class="text-xl font-bold mb-4">Report Card Template Designer</h3>

<div class="flex gap-4">
    <!-- Fields Palette -->
    <div class="w-1/4 p-4 border rounded bg-orange-100">
        <h4 class="text-2xl font-bold mb-2">Available Fields</h4>
        @foreach (var field in AvailableFields)
        {
            <div draggable="true"
                 @ondragstart="e => OnDragStart(e, field)"
                 class="p-2 mb-2 bg-blue-200 rounded cursor-move text-lg">
                @field
            </div>
        }
    </div>

    <!-- Drag-and-Drop Canvas -->
    <div class="relative border w-[800px] h-[1100px] bg-gray-200 flex items-center justify-center"
         @ondrop="OnDrop"
         @ondragover="OnDragOver">
        <span class="text-gray-600">Drag fields here</span>

        @foreach (var field in PlacedFields)
        {
            <div class="absolute bg-green-200 p-1 rounded text-lg"
                 style="left:@field.PositionX; top:@field.PositionY;">
                @field.FieldName
            </div>
        }
    </div>
</div>

@code {
    List<string> AvailableFields = new() { "Student Name", "Grade", "Attendance", "Comments" };
    List<TemplateField> PlacedFields = new();

    string DraggedField = "";

    void OnDragStart(DragEventArgs e, string field)
    {
        DraggedField = field;
        e.DataTransfer.SetData("text", field); // Ensure data is set
    }

    void OnDragOver(DragEventArgs e)
    {
        e.PreventDefault(); // Fix drag not working
    }

    void OnDrop(DragEventArgs e)
    {
        e.PreventDefault();

        var x = e.OffsetX;
        var y = e.OffsetY;

        PlacedFields.Add(new TemplateField
            {
                FieldName = DraggedField,
                PositionX = x,
                PositionY = y
            });

        StateHasChanged(); // Ensure UI updates
    }
} *@