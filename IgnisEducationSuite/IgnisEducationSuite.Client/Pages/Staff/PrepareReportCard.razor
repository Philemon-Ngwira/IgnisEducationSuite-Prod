@page "/ReportCardManagement"
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@using EDUSphereSharedProject.UniversalModels
@using IgnisEducationSuite.Client.Pages.Staff.Dialogs
@inject IDialogService DialogService
@inherits AppBaseComponent

<MudCard Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Report Card Management</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        <MudDivider Class="border border-secondary border-2 opacity-50 mb-4" />

        <MudPaper Class="p-4 mb-4" Elevation="2">
            <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Book">
                Prepare Report Cards
            </MudAlert>
            <MudPaper Class="p-4 mb-4" Elevation="2">
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudSelect T="string" Label="Report Type" Value="SelectedReportType" ValueChanged="UpdateCompletionState">
                            @foreach (var type in ReportTypes)
                            {
                                <MudSelectItem Value="@type">@type</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                </MudGrid>
            </MudPaper>
            <MudGrid Spacing="3" Class="mt-2">

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     Variant="Variant.Outlined"
                                     Label="Filter By Academic Level"
                                     Value="AcademicLvlFilterValue"
                                     ValueChanged="FilterResultsByAcademicLevel"
                                     SearchFunc="AcademicLvlFilter"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     SelectValueOnTab="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     AdornmentColor="Color.Primary"
                                     FullWidth="true"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     Variant="Variant.Outlined"
                                     Label="Filter By Class"
                                     Value="SelectedClass"
                                     ValueChanged="FilterResultsByClass"
                                     SearchFunc="ClassFilter"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     SelectValueOnTab="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     AdornmentColor="Color.Primary"
                                     FullWidth="true"
                                     Margin="Margin.Dense" />
                </MudItem>
                @if (AppState.UserRole == "Admin")
                {
                    <MudItem xs="12">
                        <MudButton OnClick="UpdatePositionsInClass" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh">Update Positions In Class</MudButton>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudDataGrid Items="filteredStudents" Filterable="false" SortMode="SortMode.None" Groupable="false" Class="mt-4" RowClassFunc="GetRowClass">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Students</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.FirstName" Title="First Name" />
                <PropertyColumn Property="x => x.LastName" Title="Last Name" />
                <PropertyColumn Property="x => x.LevelName" Title="Academic Level" />
                <PropertyColumn Property="x => x.GradeSection" Title="Section" Sortable="true" />
                <PropertyColumn Property="x => x.StudentNumber" Title="Student ID" />
                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Filled"
                                   Disabled="!context.Item.isInteractable"
                                   Color="Color.Primary"
                                   OnClick="@(() => OpenDetailsDialogAsync(context.Item))">
                            Prepare Report Card
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="StudentWithClassesDTO" />
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>




@code {
    protected Guid SelectedAcademicYearID;
    protected Guid SelectedTermID;
    protected string SelectedReportType = "Midterm"; // default
    private string _searchString;
    protected List<string> ReportTypes = new() { "Midterm", "EndTerm" };
    protected List<Teacher> teachers = new();
    protected List<Class> classes = new();
    protected List<StudentWithClassesDTO> students = new();
    protected List<StudentWithClassesDTO> filteredStudents = new();
    protected List<StudentWithClassesDTO> teacherFilteredStudents = new();
    protected List<GradingScale> gradingScales = new();
    protected List<string> TeacherGrades = new();
    protected List<string> ClassNames = new();
    protected string AcademicLvlFilterValue = string.Empty;
    protected string SelectedClass = string.Empty;
    protected string searchString = string.Empty;
    private bool _sortNameByLength;
    protected Staff Dean = new();
    protected Teacher loggedInTeacher = new();
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait, we are preparing your work environment");
        await Task.Delay(500); // Simulate loading delay
        if (AppState.UserRole == "Dean")
        {
            var s = await GetStaffAsync("Dean");
            if (s != null)
            {
                Dean = s.Where(x => x.UserID == AppState.UserID).FirstOrDefault();
            }
            await GetGenders();
        }
        await GetTeachers();
        var initTasks = new List<Task>
        {
            GetClasses(),
            GetScoreGrading(),
            GetStudents()
        };

        await Task.WhenAll(initTasks);
        // 👇 ONLY for teacher
        if (AppState.UserRole == "Teacher" && loggedInTeacher != null)
        {
            await LoadCompletionStatus();
        }
        ApplyTeacherFiltering();
        PrepareFilterLists();
        StateHasChanged();
        LoaderService.Hide();
    }
    private async Task UpdateCompletionState(string cardType)
    {
        SelectedReportType = cardType;
        await LoadCompletionStatus();
    }

    private async Task LoadCompletionStatus()
    {
        var response = await HttpClient.GetFromJsonAsync<List<StudentCompletionStatusDTO>>(
            $"api/Dynamic/GetTeacherStudentCompletionStatus/{Guid.Parse(AppState.SchoolID)}/{loggedInTeacher.TeacherID}/{SelectedReportType}"
        );

        if (response == null) return;

        var statusDict = response.ToDictionary(x => x.StudentID, x => x.IsCompleted);

        foreach (var student in students)
        {
            student.IsCompleted =
                statusDict.TryGetValue(student.StudentID, out var completed) && completed;
        }
    }
    private string GetRowClass(StudentWithClassesDTO student, int rowNumber)
    {
        if (AppState.UserRole != "Teacher")
            return string.Empty;

        return student.IsCompleted
            ? "bg-success text-white"
            : string.Empty;
    }
    #region Search

    private async Task UpdatePositionsInClass()
    {
        var response = await HttpClient.PostAsync(
            $"api/Dynamic/recalculatepositions/{Guid.Parse(AppState.SchoolID)}",
            null
        );

        if (response.IsSuccessStatusCode)
        {
            // optional: show success message
            Snackbar.Add("Positions in class have been updated successfully.", Severity.Success);

        }
        else
        {
            Snackbar.Add("Failed to update positions in class. Please try again later.", Severity.Error);
            // optional: handle error
        }
    }
    // custom sort by name length
    private Func<StudentWithClassesDTO, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.FirstName.Length;
        else
            return x.FirstName;
    };
    // quick filter - filter globally across multiple columns with the same input
    private Func<StudentWithClassesDTO, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.FirstName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.LastName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if ($"{x.StudentNumber}".Contains(_searchString))
            return true;

        return false;
    };

    #endregion
    private async Task<List<ClassTeacher>> LoadClassTeachers()
    {
        var service = GenericService.GetService<ClassTeacher>();
        var result = await service.GetAllAsync($"api/Dynamic/GetClassTeachersBySchoolID/{Guid.Parse(AppState.SchoolID)}", true);
        if (result.IsSuccess)
        {
            return result.Data.ToList() ?? new List<ClassTeacher>();

        }
        return new List<ClassTeacher>();
    }
    protected async Task GetGenders()
    {
        var result = GenericService.GetService<Gender>();
        var service = await result.GetAllAsync($"api/Dynamic/GetEntity/{"genders"}", true);
        var genders = service.Data.ToList();
        if (AppState.UserRole == "Dean")
            Dean.DeanForGenderNavigation = genders.Where(x => x.GenderId == Dean.DeanForGender).FirstOrDefault();
    }
    private void ApplyTeacherFiltering()
    {
        // ADMIN → see all students
        if (AppState.UserRole == "Admin")
        {
            filteredStudents = students.ToList();
            return;
        }

        // TEACHER
        if (AppState.UserRole == "Teacher")
        {
            // No linked teacher account yet → show none safely
            if (loggedInTeacher == null)
            {
                filteredStudents = new List<StudentWithClassesDTO>();
                return;
            }

            var teacherClassIds = classes
                .Where(c => c.TeacherID == loggedInTeacher.TeacherID)
                .Select(c => c.ClassID)
                .ToHashSet();

            filteredStudents = students
                .Where(s => s.Classes.Any(c => teacherClassIds.Contains(c.ClassID)))
                .ToList();
            teacherFilteredStudents = filteredStudents.ToList();
            return;
        }

        // DEAN
        if (AppState.UserRole == "Dean")
        {
            filteredStudents = students
                .Where(s => s.Gender == Dean.DeanForGenderNavigation.GenderDescription)
                .ToList();

            return;
        }

        // Fallback (future roles)
        filteredStudents = students.ToList();
    }


    private void PrepareFilterLists()
    {
        // ADMIN (or non-teacher roles) → see everything
        if (AppState.UserRole != "Teacher")
        {
            TeacherGrades = students
                .Select(s => s.LevelName)
                .Distinct()
                .ToList();

            ClassNames = students
                .SelectMany(s => s.Classes)
                .Select(c => c.ClassName)
                .Distinct()
                .ToList();

            return;
        }

        // TEACHER but no linked teacher account yet
        if (loggedInTeacher == null)
        {
            TeacherGrades = new List<string>();
            ClassNames = new List<string>();
            return;
        }

        // Teacher-specific filtering
        var teacherClassIds = classes
            .Where(c => c.TeacherID == loggedInTeacher.TeacherID)
            .Select(c => c.ClassID)
            .ToHashSet();

        TeacherGrades = students
            .Where(s => s.Classes.Any(c => teacherClassIds.Contains(c.ClassID)))
            .Select(s => s.LevelName)
            .Distinct()
            .ToList();

        ClassNames = students
            .SelectMany(s => s.Classes)
            .Where(c => teacherClassIds.Contains(c.ClassID))
            .Select(c => c.ClassName)
            .Distinct()
            .ToList();
    }


    #region API Calls
    protected async Task GetTeachers()
    {
        loggedInTeacher = null;
        teachers = new List<Teacher>();

        var service = _genericService.GetService<Teacher>();
        var result = await service.GetAllAsync(
            $"api/Dynamic/GetTeachersBySchool/{AppState.SchoolID}",
            true
        );

        if (result?.Data == null || !result.Data.Any())
            return;

        teachers = result.Data.ToList();

        // Only match teachers that are linked to a user account
        loggedInTeacher = teachers.FirstOrDefault(t =>
            t.UserID != null &&
            t.UserID == AppState.UserID
        );
    }

    protected async Task GetClasses()
    {
        var service = _genericService.GetService<Class>();
        var result = await service.GetAllAsync($"api/Dynamic/GetClassesBySchool/{AppState.SchoolID}", true);
        classes = result.Data.ToList();

        foreach (var c in classes)
        {
            c.Teacher = teachers.Where(x => x.TeacherID == c.TeacherID).First();


        }

    }

    private void SetCompletionStatusPerTeacher(
    List<StudentWithClassesDTO> students,
    List<ReportCardDetail> allDetails)
    {
        if (AppState.UserRole != "Teacher" || loggedInTeacher == null)
            return;

        var teacherClassIds = classes
            .Where(c => c.TeacherID == loggedInTeacher.TeacherID)
            .Select(c => c.ClassID)
            .ToHashSet();

        foreach (var student in students)
        {
            var studentDetails = allDetails
                .Where(d =>
                    d.ReportCardID != Guid.Empty && // safety
                    teacherClassIds.Contains(d.ClassID.Value))
                .ToList();

            // Completed ONLY if ALL subjects for this teacher are filled
            student.IsCompleted = studentDetails.Any() &&
                                  studentDetails.All(d =>
                                      d.Score != null &&
                                      !string.IsNullOrEmpty(d.Grade));
        }
    }
    protected async Task GetStudents()
    {
        var service = _genericService.GetService<StudentWithClassesDTO>();
        var result = await service.GetAllAsync($"api/Dynamic/GetStudentsAndStudentClasses/{AppState.SchoolID}", true);

        if (result.IsSuccess)
        {
            students = result.Data.ToList();

            // Fill missing LevelName
            foreach (var s in students)
            {
                if (string.IsNullOrEmpty(s.LevelName))
                    s.LevelName = academicLevels
                        .First(x => x.LevelInt == s.AcademicLevel)
                        .LevelName;
            }

            // ✅ SORTING (Academic Level → Grade Section → Name)
            students = students
                .OrderBy(s => s.AcademicLevel)              // Primary: Level (e.g., Grade 8, 9, etc.)
                .ThenBy(s => s.LevelSectionID ?? Guid.Empty) // Secondary: Section (A, B, etc.)
                .ThenBy(s => s.LastName)                    // Optional: nicer grouping
                .ThenBy(s => s.FirstName)
                .ToList();
        }
    }

    protected async Task GetScoreGrading()
    {
        var service = _genericService.GetService<GradingScale>();
        bool shouldRecall = gradingScales.Any();
        var result = await service.GetAllAsync($"api/Dynamic/GetGradingScaleBySchool/{AppState.SchoolID}", true);
        if (result.IsSuccess)
            gradingScales = result.Data.ToList();
    }

    protected async Task<ReportCard> GetReportCardHeader(string studentID)
    {
        var service = _genericService.GetService<ReportCard>();

        var result = await service.GetAllAsync(
            $"api/Dynamic/GetStudentReportCardHeader/{studentID}/{SelectedReportType}",
            true
        );

        if (result.IsSuccess && result.Data.Any())
            return result.Data.First();

        return null;
    }

    protected async Task<List<ReportCardDetail>> GetReportCardDetails(Guid ReportCardID)
    {
        var service = _genericService.GetService<GetReportCardDetailsResult>();
        var result = await service.GetAllAsync($"api/Dynamic/GetReportCardDetailsByReportCardID/{ReportCardID}", true);
        if (result.IsSuccess)
        {
            return result.Data
            .Select(x => new ReportCardDetail
            {
                ReportCardDetailID = x.ReportCardDetailID,
                ReportCardID = x.ReportCardID,
                ClassID = x.ClassID,
                Score = x.Score,
                Grade = x.Grade,

            })
            .ToList();
        }
        else
        {
            return new List<ReportCardDetail>();
        }
    }
    #endregion

    #region Dialog
    private async Task OpenDetailsDialogAsync(StudentWithClassesDTO student)
    {
        if (string.IsNullOrEmpty(SelectedReportType))
        {
            Snackbar.Add("Please select Report Type first.", Severity.Warning);
            return;
        }
        // Load report card header first
        var reportCardHeader = await GetReportCardHeader(student.StudentID.ToString());
        if (reportCardHeader == null)
        {
            Snackbar.Add("No report card exists for this selection yet.", Severity.Warning);

            // Optional (better UX):
            // reportCardHeader = await CreateReportCardHeader(...);

            return;
        }
        // Extract state ID once
        var state = reportCardHeader.ApprovalStatus;

        // ----------------------------------------------
        // ROLE/STATE ACCESS LOGIC
        // ----------------------------------------------

        bool canProceed = false;

        if (state == "DCB75F3C-FF7C-4472-AAEB-667DB7BC86A0") // TeacherEntryOpen
        {
            canProceed = AppState.UserRole is "Teacher" or "Staff" or "Admin";
        }
        else if (state == "40CF47A6-705F-4432-9DF7-38776A7DE5C0") // DeanEntryOpen
        {
            canProceed = AppState.UserRole == "Dean";
        }
        else if (state == "4B571B0A-9CC0-42E4-BDB6-5A143124BC52") // PrincipalEntryOpen
        {
            canProceed = AppState.UserRole == "Principal";
        }

        if (!canProceed)
        {
            Snackbar.Add("You do not have permission to enter results at this stage.", Severity.Error);
            student.isInteractable = false;
            return;
        }

        // ----------------------------------------------
        // TEACHER SPECIFIC VALIDATION (only when teacher)
        // ----------------------------------------------
        List<Class> classesToSend;
        var ClassTeachers = await LoadClassTeachers();
        if (AppState.UserRole == "Teacher")
        {
            bool isClassTeacher = ClassTeachers.Any(ct =>
                ct.TeacherID == loggedInTeacher.TeacherID &&
                ct.AcademicLevelID == student.AcademicLevelID &&
                (
                    student.LevelSectionID == null ||
                    ct.LevelSectionID == student.LevelSectionID
                ));

            if (isClassTeacher)
            {
                // Class teacher → send ALL classes for the student's level
                classesToSend = classes
               .Where(x => student.Classes.Any(c => c.ClassID == x.ClassID))
                 .ToList();
            }
            else
            {
                // Subject teacher → send only subjects they teach
                classesToSend = classes
                    .Where(c =>
                        c.Teacher != null &&
                        c.TeacherID == loggedInTeacher.TeacherID &&
                        c.AcademicLevel == student.AcademicLevel)
                    .ToList();
            }

            var teacherClassIds = classesToSend
                .Select(c => c.ClassID)
                .ToHashSet();

            if (!student.Classes.Any(c => teacherClassIds.Contains(c.ClassID)))
            {
                Snackbar.Add(
                    "You do not have permission to prepare a report card for this student.",
                    Severity.Error
                );
                return;
            }
        }
        else
        {
            classesToSend = classes
              .Where(x => student.Classes.Any(c => c.ClassID == x.ClassID))
                .ToList();
        }
        var reportCardDetails = await GetReportCardDetails(reportCardHeader.ReportCardID);

        // ----------------------------------------------
        // OPEN DIALOG
        // ----------------------------------------------
        var parameters = new DialogParameters<CreateStudentReportCardDialog>
    {
        { x => x.student, student },
        { c => c.Classes, classesToSend },
        { g => g.GradingScales, gradingScales },
        { r => r.newReportCard, reportCardHeader },
        { d => d.reportCardDetails, reportCardDetails },
        { c=>c.ClassTeachers, ClassTeachers},
        {t => t.TeacherID, loggedInTeacher.TeacherID }
    };

        var opt = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            CloseButton = true,
            NoHeader = true,
            Position = DialogPosition.Center
        };

        var dialog = await DialogService.ShowAsync<CreateStudentReportCardDialog>("", parameters, opt);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool returned && returned)
        {

            await LoadCompletionStatus(); // 🔥 refresh colors
            ApplyFilters();               // reapply UI filters
            Snackbar.Add($"Report Card for {student.FirstName} {student.LastName} has been generated successfully", Severity.Success);

        }
    }

    #endregion

    #region Filters
    private void ApplyFilters()
    {
        IEnumerable<StudentWithClassesDTO> query;

        if (AppState.UserRole == "Teacher")
            query = teacherFilteredStudents;
        else
            query = students; // Admin / Dean / others

        // Academic Level filter
        if (!string.IsNullOrEmpty(AcademicLvlFilterValue))
        {
            query = query.Where(s =>
                string.Equals(s.LevelName?.Trim(),
                              AcademicLvlFilterValue?.Trim(),
                              StringComparison.OrdinalIgnoreCase));
        }

        // Class filter
        if (!string.IsNullOrEmpty(SelectedClass))
        {
            query = query.Where(s =>
                s.Classes.Any(c =>
                    string.Equals(c.ClassName?.Trim(),
                                  SelectedClass?.Trim(),
                                  StringComparison.OrdinalIgnoreCase)));
        }

        // Search filter
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(s =>
                s.FirstName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                s.LastName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                s.StudentNumber.Contains(searchString));
        }

        filteredStudents = query.ToList();
    }
    private void FilterResultsByAcademicLevel(string value)
    {
        AcademicLvlFilterValue = value;
        ApplyFilters();
    }

    private void FilterResultsByClass(string value)
    {
        SelectedClass = value;
        ApplyFilters();
    }

    private Task<IEnumerable<string>> AcademicLvlFilter(string value, CancellationToken token)
    {
        return Task.FromResult(TeacherGrades.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }

    private Task<IEnumerable<string>> ClassFilter(string value, CancellationToken token)
    {
        return Task.FromResult(ClassNames.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }
    #endregion
}
