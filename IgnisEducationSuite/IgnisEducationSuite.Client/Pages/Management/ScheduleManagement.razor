    private async Task HandleFileUpload(IBrowserFile file)
    {
        LoaderService.Show("Please wait, processing file...");

        try
        {
            if (!classes.Any())
            {
                Snackbar.Add("Cannot Create Schedule without Classes, Please add all classes first", Severity.Error);
                return;
            }

            if (file == null) return;

            using var content = new MultipartFormDataContent();

            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);

            // Important: Name MUST match the parameter name in the API (e.g., "file")
            content.Add(fileContent, "file", file.Name);

            content.Add(new StringContent(_appState.SchoolID.ToString()), "SchoolID");

            var absoluteUri = new Uri(new Uri(_navigationManager.BaseUri), "api/Upload/uploadSchedules");
            var response = await Http.PostAsync(absoluteUri, content);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Failed to upload schedule", Severity.Error);
                return;
            }

            // Read schedules safely
            schedules = await response.Content.ReadFromJsonAsync<List<ScheduleMappingClass>>() ?? new List<ScheduleMappingClass>();

            CreateSchedules(schedules);

            // Null-safe ordering & grouping
            groupedSchedules = classSchedules
 .OrderBy(cs => dayOrder.IndexOf(cs.DayOfTheWeek.DayName)) // Order by day
 .ThenBy(cs => cs.TimeSlot.StartTime)                     // Then by time
 .GroupBy(cs => cs.TimeSlot)                              // Group by TimeSlot
 .OrderBy(g => g.Key.StartTime);                          // Order groups by StartTime

            var dayOrderDict = dayOrder.Select((day, index) => new { day, index })
                       .ToDictionary(x => x.day, x => x.index);

            var orderedDays = daysofTheWeek.OrderBy(x => dayOrderDict[x.DayName]).ToList();
            daysofTheWeek = orderedDays;
            GradeLevel = $"{schedules.Select(x => x.GradeLevel).FirstOrDefault()}{schedules.Select(x => x.GradeSection).FirstOrDefault()}";
            GradeInt = schedules.Select(x => x.GradeLevel).FirstOrDefault();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading schedule: {ex.Message}");
            Snackbar.Add("An error occurred while uploading the schedule", Severity.Error);
        }
        finally
        {
            LoaderService.Hide();
        }
    }

    protected IEnumerable<ClassSchedule> CreateSchedules(List<ScheduleMappingClass> schedules)
    {
        var SchoolTimeSlots = timeSlots
            .Where(x => x.SchoolID == Guid.Parse(_appState.SchoolID))
            .OrderBy(x => x.StartTime)
            .ToList();

        foreach (var item in schedules)
        {
            var rowStart = TimeSpan.Parse(item.StartTime);
            var rowEnd = TimeSpan.Parse(item.EndTime);

            // Find *all* slots that fall inside this time range
            var matchingSlots = SchoolTimeSlots
                .Where(ts => ts.StartTime >= rowStart && ts.EndTime <= rowEnd)
                .OrderBy(ts => ts.StartTime)
                .ToList();

            // If nothing matched, skip
            if (!matchingSlots.Any())
                continue;

            // Create multiple class schedule entries
            foreach (var slot in matchingSlots)
            {
                ClassSchedule newClassSchedule = new()
                {
                    ClassScheduleID = Guid.NewGuid(),
                    Class = classes
                        .Where(x => x.AcademicLevel == item.GradeLevel &&
                                    x.ClassName.ToUpper().Contains(item.Class.ToUpper()))
                        .FirstOrDefault(),

                    DayOfTheWeek = daysofTheWeek
                        .Where(x => x.DayName.Contains(item.Day))
                        .FirstOrDefault(),

                    TimeSlot = slot
                };

                classSchedules.Add(newClassSchedule);
            }
        }

        return classSchedules;
    }
    /// <summary>
    /// Converts GeneratedSlotPreview list into ClassSchedule objects for UI binding and saving.
    /// </summary>
    protected IEnumerable<ClassSchedule> CreateSmartSchedules(List<GeneratedSlotPreview> generatedSlots)
    {
        classSchedules.Clear();

        foreach (var slot in generatedSlots)
        {
            // Find the class object
            var cls = classes.FirstOrDefault(c => c.ClassID == slot.SubjectId);
            if (cls == null) continue;

            // Find the day object
            var day = daysofTheWeek.FirstOrDefault(d => d.DayName.Equals(slot.Slot.Day.ToString(), StringComparison.OrdinalIgnoreCase));
            if (day == null) continue;

            classSchedules.Add(new ClassSchedule
            {
                ClassScheduleID = Guid.NewGuid(),
                Class = cls,
                DayOfTheWeek = day,
                TimeSlot = slot.Slot
            });
        }

        return classSchedules;
    }


    protected async Task AssignSchedule()
    {
        LoaderService.Show("Assigning Schedules Please wait!");
        await GetStudentsForSchedule();

        foreach (var student in StudentsInGrade)
        {
            foreach (var schedule in classSchedules)
            {
                schedule.StartDate = _dateRange.Start;
                schedule.EndDate = _dateRange.End;
                schedule.IsActive = true;
                schedule.SchoolID = loggedInAdmin.SchoolID;
                // Create a new StudentClassSchedule for each student and schedule pair
                StudentClassSchedule newSchedule = new()
                {
                    StudentClassScheduleID = Guid.NewGuid(),
                    StudentID = student.StudentID,
                    ScheduleID = schedule.ClassScheduleID
                };

                // Add to the list
                classSchedulestoSave.Add(newSchedule);
            }
        }

        //save Schedules and assign
        var serviceOne = _genericService.GetService<List<ClassSchedule>>();
        foreach (var item in classSchedules)
        {
            item.DayOfTheWeekID = item.DayOfTheWeek.DayID;
            item.DayOfTheWeek = null;
            item.ClassID = item.Class.ClassID;
            item.Class = null;
            item.TimeSlotID = item.TimeSlot.TimeslotID;
            item.TimeSlot = null;
        }
        var result = await serviceOne.PostAsync("api/Dynamic/PostEntities", "classschedule", classSchedules);
        if (result.IsSuccess)
        {
            //Save Assigned Schedules
            var ServiceTwo = _genericService.GetService<List<StudentClassSchedule>>();
            var resultFinal = await ServiceTwo.PostAsync("api/Dynamic/PostEntities", "studentclassschedule", classSchedulestoSave);

            if (resultFinal.IsSuccess)
            {
                LoaderService.Hide();
                classSchedulestoSave.Clear();
                classSchedules.Clear();
                Snackbar.Add($"Successfully Saved And TimeTable assigned to all students of Grade: {GradeLevel}", Severity.Success);
            }
            else
            {
                LoaderService.Hide();
                classSchedulestoSave.Clear();
                Snackbar.Add($"Failed to Save And Assign Timetable to all students of Grade: {GradeLevel}", Severity.Error);
            }
        }
        else
        {
            LoaderService.Hide();
            classSchedulestoSave.Clear();
            Snackbar.Add($"Failed to Save And Assign Timetable to all students of Grade: {GradeLevel}", Severity.Error);
        }

    }
