@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@using EDUSphereSharedProject.UniversalModels
@using System.Net.Http.Headers
@using EDUSphereSharedProject.UniversalModels.TimeTabling
@page "/ClassSchedules"
@inherits AppBaseComponent
<MudCard Elevation="3" Class="pa-4">

    <!-- PAGE HEADER -->
    <MudText Typo="Typo.h4"><b>Class Schedules</b></MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Define school time slots, upload class schedules, and assign them to students.
    </MudText>

    <!-- MAIN TABS -->
    <MudTabs Outlined="true" Rounded="true">

        <!-- TAB 1: TIME SLOTS -->
        <MudTabPanel Text="Time Slots" Icon="@Icons.Material.Filled.Schedule">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Create School Time Slots</MudText>

                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudTimePicker Label="Start Time" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       @bind-Time="newTimeSlot.StartTime" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTimePicker Label="End Time" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       @bind-Time="newTimeSlot.EndTime" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField Label="Slot Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      @bind-Value="newTimeSlot.Description" />
                    </MudItem>
                    <MudItem xs="12" md="4">


                        <MudSelect T="string"
                                   Label="Slot Type"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   @bind-Value="newTimeSlot.SlotType"
                                   Required="true"
                                   RequiredError="Please select a slot type"
                                   Placeholder="Select slot type">

                            <MudSelectItem Value="@(SlotType.None.ToString())" ">Select slot type</MudSelectItem>
                            <MudSelectItem Value="@(SlotType.Morning.ToString())">Morning</MudSelectItem>
                            <MudSelectItem Value="@(SlotType.MidMorning.ToString())">Mid-morning</MudSelectItem>
                            <MudSelectItem Value="@(SlotType.Afternoon.ToString())">Afternoon</MudSelectItem>
                            <MudSelectItem Value="@(SlotType.Evening.ToString())">Evening</MudSelectItem>
                            <MudSelectItem Value="@(SlotType.BreakTime.ToString())">Break</MudSelectItem>
                            <MudSelectItem Value="@(SlotType.LunchTime.ToString())">Lunch</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.Add"
                           OnClick="RegisterTimeSlot">
                    Register Time Slot
                </MudButton>
            </MudPaper>
        </MudTabPanel>

        <!-- TAB 2: CREATE MANUAL SCHEDULE -->
        <MudTabPanel Text="Create Manual Schedule" Icon="@Icons.Material.Filled.UploadFile">
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Manual Upload Class Schedule</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Use the provided Excel template to define weekly lessons.
                </MudText>

                <MudStack Direction="Row" Spacing="2" Class="mt-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="DownloadScheduleTemplate">
                        Download Template
                    </MudButton>

                    <MudFileUpload T="IBrowserFile" FilesChanged="HandleFileUpload">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary">Upload Excel</MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </MudStack>
            </MudPaper>

            <!-- TIMETABLE PREVIEW -->
            @if (groupedSchedules != null && groupedSchedules.Any())
            {
                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-2">@GradeLevel Term Timetable</MudText>

                    <table class="timetable">
                        <thead>
                            <tr>
                                <th>Time</th>
                                @foreach (var day in daysofTheWeek)
                                {
                                    <th>@day.DayName</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in groupedSchedules)
                            {
                                <tr>
                                    <td class="time">
                                        @($"{group.Key.StartTime:hh\\:mm}") – @($"{group.Key.EndTime:hh\\:mm}")
                                    </td>
                                    @foreach (var day in dayOrder)
                                    {
                                        var schedule = group.FirstOrDefault(cs => cs.DayOfTheWeek.DayName == day);
                                        <td class="@(schedule == null ? "empty" : "filled")">
                                            @if (schedule != null)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                                                    @schedule.Class.ClassName
                                                </MudChip>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>

                    <MudDivider Class="my-3" />

                    <MudDateRangePicker Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        @bind-DateRange="_dateRange"
                                        PlaceholderStart="Schedule Start Date"
                                        PlaceholderEnd="Schedule End Date" />

                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Class="mt-3"
                               EndIcon="@Icons.Material.Filled.SaveAlt"
                               OnClick="AssignSchedule">
                        Save Class Timetable
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No schedule uploaded yet.
                </MudAlert>
            }
        </MudTabPanel>

        <!-- TAB 3: SMART GENERATION -->
        <MudTabPanel Text="Smart Generation" Icon="@Icons.Material.Filled.AutoAwesome">
            <MudPaper Class="pa-4" Elevation="2">

                <MudText Typo="Typo.h6">Auto-generate Class Timetable</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
                    Quickly generate a timetable using school rules and teacher availability.
                </MudText>

                <!-- Step 1: Grade & Class -->
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudSelect T="string"
                                   Label="Grade"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Value="SmartGradeLevel"
                                   ValueChanged="OnSmartGradeChanged">
                            @foreach (var level in academicLevels)
                            {
                                <MudSelectItem Value="@level.LevelName">@level.LevelName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <!-- Step 2: Simple Rules -->
                <MudText Typo="Typo.subtitle2" Class="mb-2">Preferences (Optional)</MudText>
                <MudCheckBox T="bool" @bind-Checked="PreferMorning" Label="Prefer morning for core subjects" />
                <MudCheckBox T="bool" @bind-Checked="AllowDoublePeriods" Label="Allow double periods" />
                <MudCheckBox T="bool" @bind-Checked="SpreadSubjects" Label="Spread subjects across the week" />

                <MudDivider Class="my-4" />

                <!-- Class Time Preferences & Periods -->
                <MudText Typo="Typo.subtitle2" Class="mb-2">Class Preferences & Periods</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    Define when each class prefers to be scheduled and how many periods it should have per week.
                </MudText>

                <MudGrid Spacing="2">
                    @foreach (var cls in classes.Where(c => c.AcademicLevel == SmartGrade))
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-3" Elevation="1">
                                <MudText Typo="Typo.subtitle2">@cls.ClassName</MudText>

                                <!-- Class Time Preference -->
                                <MudSelect T="ClassTimePreference"
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Value="@GetClassTimePreference(cls.ClassID)"
                                           ValueChanged="@(v => SetClassTimePreference(cls.ClassID, v))">
                                    <MudSelectItem Value="ClassTimePreference.Flexible">Flexible</MudSelectItem>
                                    <MudSelectItem Value="ClassTimePreference.MorningOnly">Morning only</MudSelectItem>
                                    <MudSelectItem Value="ClassTimePreference.MidMorning">Mid-morning+</MudSelectItem>
                                </MudSelect>
                                <!-- Core subject checkbox -->
                                <MudCheckBox T="bool" @bind-Value="cls.IsCore" Label="Core subject?" Class="mt-2" />
                                <!-- Toggle to show/hide specific periods -->
                                <MudCheckBox T="bool" @bind-Value="cls.HasCustomPeriods" Label="Set specific periods?" Class="mt-2" />

                                @if (cls.HasCustomPeriods)
                                {
                                    <!-- Periods per week -->
                                    <MudNumericField T="int" Label="Periods per week"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Value="@GetPeriodsPerWeek(cls.ClassID)"
                                                     ValueChanged="@(v => SetPeriodsPerWeek(cls.ClassID, v))"
                                                     Immediate="true"
                                                     HelperText="Leave empty for smart distribution" />

                                    <!-- Double periods per week -->
                                    <MudNumericField T="int" Label="Double periods per week"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Value="@GetDoublePeriodsPerWeek(cls.ClassID)"
                                                     ValueChanged="@(v => SetDoublePeriodsPerWeek(cls.ClassID, v))"
                                                     Immediate="true"
                                                     HelperText="Leave empty for smart distribution" />
                                }
                            </MudPaper>
                        </MudItem>
                    }

                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">
                    Classes that should NOT follow each other
                </MudText>

                <MudGrid Spacing="2">
                    @foreach (var cls in classes.Where(c => c.AcademicLevel == SmartGrade))
                    {
                        <MudItem xs="12" md="6">
                            <MudSelect T="Guid"
                                       Label="@($"{cls.ClassName} cannot follow")"
                                       Variant="Variant.Outlined"
                                       MultiSelection="true"
                                       SelectedValues="@GetAdjacency(cls.ClassID)"
                                       SelectedValuesChanged="@(v => SetAdjacency(cls.ClassID, v))"
                                       MultiSelectionTextFunc="@(values => FormatAdjacencyText(values))">
                                @foreach (var other in classes.Where(o => o.ClassID != cls.ClassID && o.AcademicLevel == SmartGrade))
                                {
                                    <MudSelectItem Value="@other.ClassID">
                                        @other.ClassName
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                </MudGrid>

                <MudDivider Class="my-4" />

                <!-- Activity Preferences -->
                <MudText Typo="Typo.subtitle2" Class="mb-2">Activity Scheduling Preferences</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    Define when non-academic activities should be scheduled.
                </MudText>

                <MudGrid Spacing="2">
                    @foreach (var activity in activities)
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-3" Elevation="1">
                                <MudText Typo="Typo.subtitle2">@activity.ActivityName</MudText>

                                <MudSelect T="ActivityTimePreference" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Value="@GetActivityTime(activity.ActivityID)"
                                           ValueChanged="@(v => SetActivityTime(activity.ActivityID, v))">
                                    <MudSelectItem Value="ActivityTimePreference.Any">Any time</MudSelectItem>
                                    <MudSelectItem Value="ActivityTimePreference.MorningOnly">Morning only (before 10:00)</MudSelectItem>
                                    <MudSelectItem Value="ActivityTimePreference.MidMorning">Mid-morning (10:00+)</MudSelectItem>
                                    <MudSelectItem Value="ActivityTimePreference.AfternoonOnly">Afternoon only</MudSelectItem>
                                </MudSelect>

                                <MudCheckBox T="bool" Dense="true" Class="mt-2"
                                             Value="@GetActivityFixed(activity.ActivityID)"
                                             ValueChanged="@(v => SetActivityFixed(activity.ActivityID, v))"
                                             Label="Must respect this time" />
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="GenerateSmartTimetable">
                    Generate Timetable
                </MudButton>
            </MudPaper>

            @if (SmartGeneratedSchedules.Any())
            {
                <MudPaper Class="pa-3 mt-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-2">Generated Timetable Preview</MudText>
                    <MudDivider Class="my-3" />

                    <!-- Buttons -->
                    <MudStack Direction="Row" Spacing="2" Class="mb-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   EndIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveSmartTimetable">
                            Save & Assign
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Secondary"
                                   OnClick="RegenerateSmartTimetable">
                            Regenerate
                        </MudButton>
                    </MudStack>

                    <!-- Timetable Table -->
                    @if (groupedSmartSchedules != null && groupedSmartSchedules.Any())
                    {
                        <MudPaper Class="pa-3" Elevation="1">
                            <MudText Typo="Typo.h6" Class="mb-2">
                                @GradeLevel Term Timetable
                            </MudText>

                            <table class="timetable">
                                <thead>
                                    <tr>
                                        <th>Time</th>
                                        @foreach (var day in daysofTheWeek)
                                        {
                                            <th>@day.DayName</th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var group in groupedSmartSchedules)
                                    {
                                        <tr>
                                            <!-- TIME COLUMN -->
                                            <td class="time">
                                                @($"{group.TimeSlot.StartTime:hh\\:mm}") –
                                                @($"{group.TimeSlot.EndTime:hh\\:mm}")
                                            </td>

                                            <!-- DAY COLUMNS -->
                                            @foreach (var day in dayOrder)
                                            {
                                                var schedule = group.Slots
                                                .FirstOrDefault(s => s.DayOfTheWeek.DayName == day);

                                                <td class="@(schedule == null ? "empty" : "filled")">
                                                    @if (schedule != null)
                                                    {
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary">
                                                            @schedule.Class?.ClassName
                                                        </MudChip>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <MudDivider Class="my-3" />

                            <MudDateRangePicker Variant="Variant.Outlined"
                                                Margin="Margin.Dense"
                                                @bind-DateRange="_dateRange"
                                                PlaceholderStart="Schedule Start Date"
                                                PlaceholderEnd="Schedule End Date" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="mt-3"
                                       EndIcon="@Icons.Material.Filled.SaveAlt"
                                       OnClick="AssignSchedule">
                                Save Class Timetable
                            </MudButton>
                        </MudPaper>
                    }

                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No schedule uploaded yet.
                        </MudAlert>
                    }

                </MudPaper>
            }


        </MudTabPanel>

        <!-- TAB 4: ASSIGN SCHEDULE -->
        <MudTabPanel Text="Assign Schedule" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Assign Schedule to Class</MudText>

                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudNumericField Label="Grade" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         @bind-Value="GradeInt" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField Label="Section" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      @bind-Value="GradeLevel" />
                    </MudItem>

                    <MudItem xs="12" md="4" Class="d-flex align-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="GradeInt == 0"
                                   OnClick="GetActiveSchedulesPerClass">
                            Load Schedule
                        </MudButton>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           EndIcon="@Icons.Material.Filled.AssignmentTurnedIn"
                           OnClick="AssignScheduleToUnAssignedStudents">
                    Assign Schedule to Students
                </MudButton>
            </MudPaper>
        </MudTabPanel>

    </MudTabs>
</MudCard>




@code {
    public enum SlotType
    {
        None = 0,        // ❗ invalid / forces selection
        Morning = 1,
        MidMorning = 2,
        Afternoon = 3,
        Evening = 4,
        BreakTime = 5,
        LunchTime = 6,
    }


    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    [Inject] HttpClient Http { get; set; } = default!;
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] AppState _appState { get; set; } = default!;
    private Dictionary<Guid, ClassTimePreference> ClassTimePreferences = new();
    public enum ClassTimePreference
    {
        Flexible = 0,
        MorningOnly = 1,
        MidMorning = 2
    }
    private Dictionary<Guid, HashSet<Guid>> subjectAdjacencyDict = new();
    // Dictionary to store periods per class
    private Dictionary<Guid, int> classPeriodsPerWeek = new();
    private Dictionary<Guid, int> classDoublePeriodsPerWeek = new();
    protected ClientAdmin loggedInAdmin = new();
    protected List<ScheduleMappingClass> schedules = new();
    protected List<ClassSchedule> classSchedules = new();
    protected List<StudentClassSchedule> classSchedulestoSave = new();
    protected List<Class> classes = new();
    protected List<GetActiveClassScheduleResult> activeClassSchedules = new();
    protected List<TimeSlot> timeSlots = new();
    protected TimeSlot newTimeSlot = new();
    protected List<DayofTheWeek> daysofTheWeek = new();
    protected List<GetStudentsInGradeResult> StudentsInGrade = new();
    protected List<GetStudentsInGradeWithoutScheduleResult> StudentsInGradeWithoutSchedule = new();
    private IEnumerable<IGrouping<TimeSlot, ClassSchedule>> groupedSchedules;
    List<TimeSlotGroup> groupedSmartSchedules;



    protected List<TimeTableActivity> activities = new();
    protected int GradeInt = 0;
    protected string GradeLevel = string.Empty;
    protected string NoGradeLevel = "N/A";
    protected MudTabs mudTabs = new();
    private bool _editable = true;
    private bool _clearable = true;
    private DateRange _dateRange { get; set; }
    MudTabPanel panel01;
    MudTabPanel panel02;
    MudTabPanel panel03;

    private bool GetActivityFixed(Guid id) =>
     ActivityFixed.TryGetValue(id, out var val) && val;

    private void SetActivityFixed(Guid id, bool value) =>
        ActivityFixed[id] = value;
    private void SetClassTimePreference(Guid id, ClassTimePreference value) =>
          ClassTimePreferences[id] = value;

    private ActivityTimePreference GetActivityTime(Guid id) =>
        ActivityTimePreferences.TryGetValue(id, out var val) ? val : ActivityTimePreference.Any;

    private void SetActivityTime(Guid id, ActivityTimePreference value) =>
        ActivityTimePreferences[id] = value;
    private ClassTimePreference GetClassTimePreference(Guid id) =>
    ClassTimePreferences.TryGetValue(id, out var val) ? val : ClassTimePreference.Flexible;
    // -------------------------------
    // Periods per week
    // -------------------------------
    private int GetPeriodsPerWeek(Guid classId)
    {
        if (classPeriodsPerWeek.TryGetValue(classId, out var value))
            return value;
        return 0; // default if not set
    }

    private void SetPeriodsPerWeek(Guid classId, int value)
    {
        classPeriodsPerWeek[classId] = value;
    }

    // -------------------------------
    // Double periods per week
    // -------------------------------
    private int GetDoublePeriodsPerWeek(Guid classId)
    {
        if (classDoublePeriodsPerWeek.TryGetValue(classId, out var value))
            return value;
        return 0; // default if not set
    }

    private void SetDoublePeriodsPerWeek(Guid classId, int value)
    {
        classDoublePeriodsPerWeek[classId] = value;
    }
    private readonly List<string> dayOrder = new List<string>

{
    "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"
};
    protected string UserID = string.Empty;
    public enum ActivityTimePreference
    {
        Any = 0,
        MorningOnly = 1,        // before 10:00
        MidMorning = 2,         // 10:00+
        AfternoonOnly = 3,
        None = 4 // e.g. after 13:00
    }



    // -----------------------------
    // SMART GENERATION STATE
    // -----------------------------
    private Dictionary<Guid, ActivityTimePreference> ActivityTimePreferences = new();
    private Dictionary<Guid, bool> ActivityFixed = new();
    private static readonly Random _rng = new Random();
    private int SmartGrade;
    private string? SmartClass;
    private string SmartGradeLevel = string.Empty;
    private bool PreferMorning = true;
    private bool AllowDoublePeriods = true;
    private bool SpreadSubjects = true;

    private bool IsGenerating = false;

    // Result
    private List<GeneratedSlotPreview> SmartGeneratedSchedules = new();

    // -----------------------------
    // ACTIONS
    // -----------------------------
    private int RandomBetween(int min, int max)
    {
        // Returns a random integer >= min and <= max
        return _rng.Next(min, max + 1);
    }
    private async Task GenerateSmartTimetable()
    {
        if (SmartGrade <= 0 || string.IsNullOrWhiteSpace(SmartGradeLevel))
        {
            Snackbar.Add("Please select a grade and class.", Severity.Warning);
            return;
        }

        IsGenerating = true;
        SmartGeneratedSchedules.Clear();
        classSchedules.Clear();
        groupedSmartSchedules = new();

        try
        {
            // --- Build API request ---
            var smartRequest = new SmartTimetableRequest
            {
                Grade = SmartGrade,
                ClassName = SmartGradeLevel,
                ClassTimePreferences = ClassTimePreferences,
                ActivityTimePreferences = ActivityTimePreferences,
                ActivityFixed = ActivityFixed,
                SubjectAdjacencyRules = subjectAdjacencyDict,
                Rules = new SmartTimetableRules
                {
                    PreferMorning = PreferMorning,
                    AllowDoublePeriods = AllowDoublePeriods,
                    SpreadSubjects = SpreadSubjects
                }
            };

            // --- Map request for timetable generation ---
            GenerateTimetableRequest request = MapToGenerateRequest(smartRequest);

            // --- Send request to API ---
            var response = await HttpClient.PostAsJsonAsync("api/TimeTable/generate", request);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(error, Severity.Error);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<GenerateTimetableResponse>();

            if (result == null || !result.Success || result.Slots == null || result.Slots.Count == 0)
            {
                Snackbar.Add("No valid timetable could be generated.", Severity.Warning);
                return;
            }

            // --- Assign raw API result ---
            SmartGeneratedSchedules = result.Slots;

            // --- Convert GeneratedSlotPreview to ClassSchedule ---
            CreateSmartSchedules(SmartGeneratedSchedules);

            // --- Group and order for display ---
            var dayOrderDict = dayOrder.Select((day, index) => new { day, index })
                                       .ToDictionary(x => x.day, x => x.index);

            groupedSmartSchedules = classSchedules
                .Where(cs => cs?.TimeSlot != null && cs.DayOfTheWeek != null)
                .OrderBy(cs => dayOrderDict.TryGetValue(cs.DayOfTheWeek.DayName, out var d) ? d : int.MaxValue)
                .ThenBy(cs => cs.TimeSlot.StartTime!.Value)
                .GroupBy(cs => new
                {
                    cs.TimeSlot.StartTime,
                    cs.TimeSlot.EndTime
                })
                .OrderBy(g => g.Key.StartTime)
                .Select(g => new TimeSlotGroup
                {
                    TimeSlot = g.First().TimeSlot!,
                    Slots = g.ToList()
                })
                .ToList();

            // --- Optional: reorder days for display ---
            daysofTheWeek = daysofTheWeek
                .OrderBy(d => dayOrderDict.ContainsKey(d.DayName) ? dayOrderDict[d.DayName] : int.MaxValue)
                .ToList();

            // --- Update grade info for display ---
            GradeLevel = $"{SmartGradeLevel}";
            GradeInt = SmartGrade;

            Snackbar.Add("Timetable generated successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            IsGenerating = false;
            StateHasChanged();
        }
    }

    private GenerateTimetableRequest MapToGenerateRequest(SmartTimetableRequest smartRequest)
    {
        // --- Step 0: Determine usable slots ---
        var slotsToUse = timeSlots
     .Where(x => x.SlotType != "BreakTime" && x.SlotType != "LunchTime")
     .ToList();

        int totalSlotsPerDay = slotsToUse.Count(); // slots per day
        int learningDays = 5; // Monday–Friday
        int totalSlots = totalSlotsPerDay * learningDays;

        int activitySlots = smartRequest.ActivityTimePreferences.Count(a => a.Value != ActivityTimePreference.None) * learningDays;
        int usableSlots = totalSlots - activitySlots;

        // --- Order slots and determine boundaries ---
        var slotsOrdered = slotsToUse.OrderBy(s => s.StartTime).ToList();

        var lastMorning = slotsOrdered.Where(s => s.SlotType == "Morning")
                                      .OrderByDescending(s => s.StartTime)
                                      .FirstOrDefault();
        var morningEnd = lastMorning?.EndTime ?? TimeSpan.Zero;

        var firstAfternoon = slotsOrdered.Where(s => s.SlotType == "Afternoon")
                                         .OrderBy(s => s.StartTime)
                                         .FirstOrDefault();
        var afternoonStart = firstAfternoon?.StartTime ?? TimeSpan.Zero;

        var processedSlots = slotsOrdered.Select(s => new TimeSlot
        {
            SlotType = s.SlotType,
            StartTime = s.StartTime,
            EndTime = s.EndTime,
            ScheduledActivityId = s.ScheduledActivityId,
            SchoolMorningEnd = morningEnd,
            SchoolAfternoonStart = afternoonStart
        }).ToList();

        // --- Step 1: Separate core and non-core subjects ---
        var coreSubjects = classes.Where(c => c.AcademicLevel == SmartGrade && c.IsCore).ToList();
        var nonCoreSubjects = classes.Where(c => c.AcademicLevel == SmartGrade && !c.IsCore).ToList();
        int totalSubjects = coreSubjects.Count + nonCoreSubjects.Count;

        // --- Step 2: Compute default max periods per subject ---
        int maxPeriodsPerSubject = totalSubjects > 0 ? Math.Max(1, usableSlots / totalSubjects) : 1;

        var subjectPeriods = new Dictionary<Guid, int>();

        // --- Step 3: Assign core subjects first ---
        foreach (var subject in coreSubjects)
        {
            int userPeriods = GetPeriodsPerWeek(subject.ClassID);
            int weekly = userPeriods > 0 ? userPeriods : maxPeriodsPerSubject;
            subjectPeriods[subject.ClassID] = weekly;
            usableSlots -= weekly;


        }

        // --- Step 4: Assign non-core subjects ---
        foreach (var subject in nonCoreSubjects)
        {
            if (usableSlots <= 0)
            {
                subjectPeriods[subject.ClassID] = 0;
                continue;
            }

            int userPeriods = GetPeriodsPerWeek(subject.ClassID);
            int weekly = userPeriods > 0 ? userPeriods : Math.Min(maxPeriodsPerSubject, usableSlots);
            subjectPeriods[subject.ClassID] = weekly;
            usableSlots -= weekly;
        }

        // --- Step 5: Redistribute leftover slots to core subjects ---
        while (usableSlots > 0)
        {
            foreach (var subject in coreSubjects)
            {
                subjectPeriods[subject.ClassID]++;
                usableSlots--;
                if (usableSlots == 0) break;
            }
        }

        // --- Step 6: Build schedules with doubles ---
        var schedules = new List<SubjectScheduleConfig>();
        var structureConstraints = new List<SubjectStructureConstraints>();
        foreach (var subject in coreSubjects.Concat(nonCoreSubjects))
        {
            int weekly = subjectPeriods[subject.ClassID];
            int userDoubles = GetDoublePeriodsPerWeek(subject.ClassID);
            int doubles = userDoubles;

            if (doubles == 0 && smartRequest.Rules.AllowDoublePeriods)
            {
                doubles = RandomBetween(0, Math.Min(weekly / 2, subject.IsCore ? 2 : 1));
            }

            schedules.Add(new SubjectScheduleConfig
            {
                SubjectId = subject.ClassID,
                WeeklyPeriods = weekly,
                DoublePeriods = doubles,
                TeacherId = subject.TeacherID ?? Guid.Empty,
                SubjectName = subject.ClassName,
                IsCoreSubject = subject.IsCore,
            });
            var SubjectStructureConstraint = new SubjectStructureConstraints()
            {
                SubjectId = subject.ClassID,
                WeeklyPeriods = weekly,
                RequiredDoublePeriods = doubles,

                MaxPeriodsPerDay = 2,

                CannotFollowSubjects = smartRequest.SubjectAdjacencyRules
    .Where(kvp => kvp.Key == subject.ClassID)
    .SelectMany(kvp => kvp.Value)
    .ToList(),
            };
            structureConstraints.Add(SubjectStructureConstraint);
        }

        // --- Step 7: Time rules ---
        var timeRules = smartRequest.ClassTimePreferences.Select(kvp => new SubjectTimeConstraints
        {
            SubjectId = kvp.Key,
            MustBeMorning = kvp.Value == ClassTimePreference.MorningOnly,
            MustBeAfternoon = kvp.Value == ClassTimePreference.MidMorning,
            EarlyMorningEnd = slotsOrdered.Where(s => s.SlotType == "EarlyMorning")
                                          .OrderByDescending(s => s.EndTime)
                                          .FirstOrDefault()?.EndTime ?? TimeSpan.Zero,
            MorningEnd = morningEnd
        }).ToList();

        // --- Step 8: Adjacency rules ---
        var adjacencyRules = smartRequest.SubjectAdjacencyRules.Select(kvp => new SubjectAdjacencyConstraints
        {
            SubjectId = kvp.Key,
            CannotFollowSubjects = kvp.Value.ToList()
        }).ToList();

        // --- Step 9: Activities ---
        var activities = smartRequest.ActivityTimePreferences.Select(kvp =>
        {
            var pref = kvp.Value;
            return new TimeTableActivity
            {
                ActivityID = kvp.Key,
                MustBeMorning = pref == ActivityTimePreference.MorningOnly,
                MustBeAfternoon = pref == ActivityTimePreference.AfternoonOnly,
                MustRespectTime = smartRequest.ActivityFixed.TryGetValue(kvp.Key, out var fixedVal) && fixedVal
            };
        }).ToList();


        return new GenerateTimetableRequest
        {
            Grade = smartRequest.Grade,
            GradeName = smartRequest.ClassName,
            Schedules = schedules,
            TimeRules = timeRules,
            AdjacencyRules = adjacencyRules,
            Activities = activities,
            TimeSlots = processedSlots,
            structureConstraints = structureConstraints
        };
    }

