    private async Task SendOneTimePasswordEmail(string ToEmail, string Password, string UserName, string recipientName, string studentID)
    {
        try
        {
            var emailRequest = new EmailRequest
            {
                To = ToEmail,
                Reciepient = recipientName,
                Password = Password,
                UserName = UserName,
                StudentID = studentID,
                isFirstMail = true
            };

            var emailResult = await _emailService.SendPasswordResetEmailAsync(emailRequest, NavigationManager.BaseUri);
            if (emailResult == "Password reset email sent successfully!")
            {
                Snackbar.Add($"One time password sent successfully to {recipientName}", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Email failed to send: {emailResult}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error sending email: {ex.Message}", Severity.Error);
        }
    }
    protected async Task<string> CreateNewUser(string Email, Guid ModelID, string Role, string StudentNumber)
    {
        try
        {
            LoaderService.Show("Please wait, creating user!");
            StateHasChanged();

            // Generate credentials
            newUser.Password = StudentNumberGenerator.GenerateOneTimePassword();
            newUser.Role = Role;
            var createUserModel = new CreateUserModel
            {
                UserName = newUser.UserName,
                Password = newUser.Password,
                Email = Email,
                Role = newUser.Role,
                SchoolID = Guid.Parse(AppState.SchoolID),
                UserID = StudentNumber ?? "N/A",
                ProfilePic = newUser.profilePic,
                FirstName = newUser.FirstName,
                LastName = newUser.LastName
            };

            // Create Identity User
            var result = await Http.PostAsJsonAsync($"{NavigationManager.BaseUri}api/Admin/createUser", createUserModel);
            if (!result.IsSuccessStatusCode)
            {
                Snackbar.Add("Error: Saving user failed", Severity.Error);
                return string.Empty;
            }

            var createdUser = await result.Content.ReadFromJsonAsync<ApplicationUser>();
            newUser.UserID = createdUser.Id;
            return createdUser.Id;

        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error);
            return string.Empty;
        }
        finally
        {
            StateHasChanged();
        }
    }


