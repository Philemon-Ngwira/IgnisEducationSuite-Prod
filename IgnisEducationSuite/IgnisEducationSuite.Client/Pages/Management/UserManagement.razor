    private async Task DownloadTemplate(string role)
    {
        LoaderService.Show("Preparing download...");
        var path = "";
        var fileName = "";
        switch (role)
        {
            case "Student":
                path = "api/Templates/DownloadStudentTemplate";
                fileName = "Student_Upload_Template.xlsx";
                break;
            case "Teacher":
                path = "api/Templates/DownloadTeacherTemplate";
                fileName = "Teacher_Upload_Template.xlsx";
                break;
            case "Parent":
                path = "api/Templates/DownloadParentTemplate";
                fileName = "Parent_Upload_Template.xlsx";
                break;
            default:
                break;
        }
        var response = await HttpClient.GetAsync(path);

        if (response.IsSuccessStatusCode)
        {
            // Read the file content as a byte array
            var fileBytes = await response.Content.ReadAsByteArrayAsync();

            // Get file name from response header if present, fallback to default
            if (response.Content.Headers.ContentDisposition != null)
            {
                fileName = response.Content.Headers.ContentDisposition.FileName.Trim('"');
            }

            // Use JSInterop to trigger the browser download
            await JS.InvokeVoidAsync("BlazorDownloadFile", fileName, fileBytes);
        }
        else
        {
            // Handle error (optional)
            Console.WriteLine("Failed to download template: " + response.StatusCode);
        }
        LoaderService.Hide();

    }
    private async Task GenerateUsernamesForUploadedStudents()
    {
        var payload = uploadedStudents
            .Select(s => new UserNameRequest
            {
                FirstName = s.FirstName,
                LastName = s.LastName
            })
            .ToList();

        var response = await Http.PostAsJsonAsync(
            "api/Dynamic/generateUsernames",
            payload);

        if (!response.IsSuccessStatusCode)
            throw new Exception("Failed to generate usernames.");

        var results = await response.Content
            .ReadFromJsonAsync<List<UsernameResult>>();

        foreach (var result in results!)
        {
            uploadedStudents[result.Index].GeneratedUserName = result.Username;
        }
    }

