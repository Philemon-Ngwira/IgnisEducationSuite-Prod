@inherits AppBaseComponent
@using EDUSphereSharedProject.Models

<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.h6">Timetable Overrides</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary">
        Overrides apply only to students in the selected group unless you choose to merge.
    </MudText>

    <MudGrid Spacing="2" Class="mt-3">

        <!-- Group -->
        <MudItem xs="12" md="6">
            <MudSelect T="string"
                       Label="Student Group"
                       @bind-Value="model.StudentGroup"
                       Variant="Variant.Outlined"
                       Required>
                @foreach (var grp in GroupNames)
                {
                    <MudSelectItem Value="@grp">@grp</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <!-- Day -->
        <MudItem xs="12" md="6">
            <MudSelect T="Guid"
                       Label="Day"
                       @bind-Value="model.DayOfTheWeekID"
                       Variant="Variant.Outlined"
                       Required
                       Placeholder="--Select Day--">
                @foreach (var d in Days)
                {
                    <MudSelectItem Value="@d.DayID">@d.DayName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <!-- Time Slot -->
        <MudItem xs="12" md="6">
            <MudSelect T="Guid"
                       Label="Time Slot"
                       @bind-Value="model.TimeSlotID"
                       Variant="Variant.Outlined"
                       Required
                       Placeholder="--Select Time Slot--">
                @foreach (var slot in TimeSlots)
                {
                    <MudSelectItem Value="@slot.TimeslotID">
                        @($"{slot.StartTime:hh\\:mm} - {slot.EndTime:hh\\:mm}")
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <!-- Replacement Subject -->
        <MudItem xs="12" md="6">
            <MudSelect T="Guid"
                       Label="Override Subject"
                       Value="model.ReplacementClassID"
                       Variant="Variant.Outlined"
                       Required
                       Placeholder="--Select Subject Override--"
                       ValueChanged="UpdateAffectedGroups">
                @foreach (var cls in UniqueSubjects)
                {
                    <MudSelectItem Value="@cls.ClassID">@cls.ClassName</MudSelectItem>
                }
            </MudSelect>

            <!-- Info tooltip -->
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                Overrides will automatically apply to all groups sharing this class.
            </MudText>
        </MudItem>

        <!-- Merge Checkbox -->
        <MudItem xs="12">
            <MudCheckBox T="bool" @bind-Value="applyToAllGroups"
                         Label="Apply to all groups sharing this class"
                         CheckedIcon="@Icons.Material.Filled.CheckBox"
                         UncheckedIcon="@Icons.Material.Filled.CheckBoxOutlineBlank" />
        </MudItem>

        <!-- Dynamic Visual Cue: affected groups -->
        @if (AffectedGroups.Any())
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info">
                    <MudText Typo="Typo.body2">
                        <b>This override will apply to: @string.Join(", ", AffectedGroups)</b>
                    </MudText>
                </MudAlert>

            </MudItem>
        }

    </MudGrid>

    <MudButton Class="mt-4"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="SaveOverride">
        Save Override
    </MudButton>

    <MudButton Class="mt-4"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="Complete">
        Finish
    </MudButton>
</MudPaper>

@code {
    [Parameter] public int AcademicLevel { get; set; }
    [Parameter] public string GradeSection { get; set; } = string.Empty;
    [Parameter] public List<Class> SpecialClasses { get; set; } = new();
    [Parameter] public List<Class> AllClasses { get; set; } = new();
    [Parameter] public List<TimeSlot> TimeSlots { get; set; } = new();
    [Parameter] public List<DayofTheWeek> Days { get; set; } = new();
    [Parameter] public Guid SchoolID { get; set; }
    [Parameter] public ClientAdmin loggedInAdmin { get; set; } = new();
    [Parameter] public DateRange _dateRange { get; set; } = default!;
    [Parameter] public EventCallback<List<TimetableOverride>> OnComplete { get; set; }

    public List<TimetableOverride> overridesCreated = new();
    public List<TimetableOverride> overridesInDB = new();
    protected List<TermSetting> termSettings = new();

    private TimetableOverride model = new();
    private bool applyToAllGroups = true; // ✅ Default to merge
    private List<string> AffectedGroups = new(); // For visual cue

    protected override async Task OnParametersSetAsync()
    {
        TimeSlots = TimeSlots
            .Where(x => x.SlotType != "BreakTime" && x.SlotType != "LunchTime")
            .OrderBy(x => x.StartTime)
            .ToList();

        await LoadTermSettings();
        await GetOverrides();
    }

    private async Task Complete()
        => await OnComplete.InvokeAsync(overridesCreated);

    private async Task LoadTermSettings()
    {
        var service = GenericService.GetService<TermSetting>();
        var result = await service.GetAllAsync($"api/Dynamic/GetTermSettings/{Guid.Parse(AppState.SchoolID)}", true);
        if (result.IsSuccess)
            termSettings = result.Data.ToList();
    }

    private async Task GetOverrides()
    {
        var service = GenericService.GetService<TimetableOverride>();
        var result = await service.GetAllAsync($"api/Dynamic/GetTimeTableOverrides/{Guid.Parse(AppState.SchoolID)}", true);
        if (result.IsSuccess)
            overridesInDB = result.Data.ToList();
    }

    // ✅ Use GroupName directly
    private IEnumerable<string> GroupNames =>
        SpecialClasses.Select(c => c.GroupName).Distinct();

    // ✅ Unique subjects only
    private IEnumerable<Class> UniqueSubjects =>
        SpecialClasses.GroupBy(c => c.ClassName).Select(g => g.First());

    // 🔹 Update visual cue for affected groups dynamically
    private void UpdateAffectedGroups(Guid id)
    {
        model.ReplacementClassID = id;
        if (id == Guid.Empty) return;
        var selectedId = id;
        var selectedClass = SpecialClasses.FirstOrDefault(c => c.ClassID == selectedId);
        if (selectedClass == null) return;

        AffectedGroups = applyToAllGroups
            ? SpecialClasses
                .Where(c =>
                    c.ClassName == selectedClass.ClassName &&
                    c.AcademicLevel == AcademicLevel &&
                    c.GradeSection == GradeSection
                )
                .Select(c => c.GroupName)
                .Distinct()
                .ToList()
            : new List<string> { model.StudentGroup };
    }

    private async Task SaveOverride()
    {
        var selectedClass = SpecialClasses
            .FirstOrDefault(c => c.ClassID == model.ReplacementClassID);
        if (selectedClass == null) return;

        var subjectName = selectedClass.ClassName;

        // 🔹 Determine which groups to apply to
        var relatedGroups = applyToAllGroups
            ? SpecialClasses
                .Where(c =>
                    c.ClassName == subjectName &&
                    c.AcademicLevel == AcademicLevel &&
                    c.GradeSection == GradeSection
                )
                .Select(c => c.GroupName)
                .Distinct()
                .ToList()
            : new List<string> { model.StudentGroup };

        // 🔹 Resolve effective dates once
        var newStart = termSettings.Select(x => x.ActualStartTermDate).First() ?? _dateRange.Start;
        var newEnd = termSettings.Select(x => x.ActualEndTermDate).First() ?? _dateRange.End;

        // 🔹 Conflict check
        bool hasConflict = overridesInDB.Concat(overridesCreated).Any(o =>
            o.DayOfTheWeekID == model.DayOfTheWeekID &&
            o.TimeSlotID == model.TimeSlotID &&
            relatedGroups.Contains(o.StudentGroup) &&
            (newStart <= o.EffectiveTo && newEnd >= o.EffectiveFrom)
        );

        if (hasConflict)
        {
            Snackbar.Add("Conflict detected for one of the groups within the selected date range.", Severity.Warning);
            return;
        }

        var service = GenericService.GetService<TimetableOverride>();

        foreach (var group in relatedGroups)
        {
            var classForGroup = SpecialClasses.First(c =>
                c.ClassName == subjectName &&
                c.GroupName == group &&
                c.AcademicLevel == AcademicLevel &&
                c.GradeSection == GradeSection
            );

            var newOverride = new TimetableOverride
            {
                AcademicLevel = AcademicLevel,
                GradeSection = GradeSection,
                StudentGroup = group,
                DayOfTheWeekID = model.DayOfTheWeekID,
                TimeSlotID = model.TimeSlotID,
                ReplacementClassID = classForGroup.ClassID,
                IsActive = true,
                EffectiveFrom = newStart,
                EffectiveTo = newEnd,
                CreatedBy = loggedInAdmin.AdminID
            };

            var result = await service.PostAsync(
                "api/Dynamic/PostEntity",
                "timetableoverride",
                newOverride
            );

            if (result.IsSuccess)
            {
                overridesCreated.Add(result.Data);
            }
            else
            {
                Snackbar.Add("Failed to save override", Severity.Error);
            }
        }

        Snackbar.Add("Override(s) saved successfully", Severity.Success);
        model = new TimetableOverride();
        AffectedGroups.Clear();
    }
}