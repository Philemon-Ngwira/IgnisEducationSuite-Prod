};
    protected string UserID = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Initializing Please wait");
        await GetClasses();
        await GetTimeSlots();
        await GetDaysOfWeek();
        await GetAdminData();
        await GetSchoolActivities();
        LoaderService.Hide();
    }


    private async Task GetSchoolActivities()
    {
        var service = GenericService.GetService<TimeTableActivity>();
        var result = await service.GetAllAsync($"api/Dynamic/GetSchoolActivities/{AppState.SchoolID}", true);
        if (result.IsSuccess)
        {
            activities = result.Data.ToList();
            foreach (var act in activities)
            {
                ActivityTimePreferences[act.ActivityID] = ActivityTimePreference.Any;
                ActivityFixed[act.ActivityID] = false;
            }

        }

    }


    #region Get from Database
    protected async Task GetAdminData()
    {

        UserID = _appState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            var service = _genericService.GetService<ClientAdmin>();
            var result = await service.GetAllAsync($"api/Dynamic/GetAdminByUserID/{UserID}", true);
            if (result.IsSuccess)
            {
                loggedInAdmin = result.Data.FirstOrDefault();
            }
        }
    }
    protected async Task GetClasses()
    {
        var result = _genericService.GetService<Class>();
        var service = await result.GetAllAsync($"api/Dynamic/GetEntity/{"class"}", true);
        classes = service.Data.Where(x => x.SChoolID == Guid.Parse(AppState.SchoolID)).ToList();


    }

