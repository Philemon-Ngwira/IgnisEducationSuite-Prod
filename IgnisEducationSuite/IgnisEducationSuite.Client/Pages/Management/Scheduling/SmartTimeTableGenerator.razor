    protected async Task GetStudentsForSchedule()
    {
        var service = GenericService.GetService<GetStudentsInGradeResult>();
        var result = await service.GetAllAsync($"api/Dynamic/GetStudentsInGrade/{GradeInt}/{loggedInAdmin.SchoolID.ToString()}", true);
        if (result.IsSuccess)
        {
            StudentsInGrade = result.Data.ToList();
        }
    }
    protected async Task AssignSchedule()
    {
        LoaderService.Show("Assigning schedules, please wait...");

        try
        {
            // -----------------------------
            // 0. Load students
            // -----------------------------
            await GetStudentsForSchedule();

            if (!StudentsInGrade.Any())
                throw new InvalidOperationException("No students found for grade.");

            // -----------------------------
            // 1. Validate BASE timetable integrity
            // -----------------------------
            var baseSchedules = classSchedules
                .Where(s =>
                    s.DayOfTheWeekID != Guid.Empty &&
                    s.TimeSlotID != Guid.Empty
                )
                .ToList();

            var conflicts = baseSchedules
     .GroupBy(s => new
     {
         DayId = s.DayOfTheWeek!.DayID,
         SlotId = s.TimeSlot!.TimeslotID
     })
     .Where(g => g.Count() > 1)
     .ToList();

            if (conflicts.Any())
            {
                Snackbar.Add(
                    "Overlapping base schedules detected. Fix timetable first.",
                    Severity.Error
                );
                return;
            }

            // -----------------------------
            // 2. Normalize BASE schedules
            // -----------------------------
            foreach (var s in baseSchedules)
            {
                s.StartDate = _dateRange.Start;
                s.EndDate = _dateRange.End;
                s.IsActive = true;
                s.SchoolID = loggedInAdmin.SchoolID;
            }

            // -----------------------------
            // 3. Index overrides (ONCE)
            // -----------------------------
            var overrideMap = overrides
                .Where(o =>
                    o.IsActive == true &&
                    o.DayOfTheWeekID != Guid.Empty &&
                    o.TimeSlotID != Guid.Empty &&
                    !string.IsNullOrWhiteSpace(o.StudentGroup)
                )
                .ToDictionary(
                    o => (
                        o.DayOfTheWeekID,
                        o.TimeSlotID,
                        o.StudentGroup
                    ),
                    o => o
                );

            // -----------------------------
            // 4. Persist BASE schedules only (UPSERT)
            // -----------------------------
            PrepareSchedulesForSave(baseSchedules);

            var scheduleResponse = await HttpClient.PostAsJsonAsync(
                "api/Dynamic/UpsertClassSchedules",
                baseSchedules
            );

            if (!scheduleResponse.IsSuccessStatusCode)
                throw new InvalidOperationException("Failed to save class schedules.");

            var persistedSchedules =
                await scheduleResponse.Content.ReadFromJsonAsync<List<ClassSchedule>>()
                ?? throw new InvalidOperationException("Schedule persistence failed.");

            var scheduleLookup = persistedSchedules.ToDictionary(
                s => (s.DayOfTheWeekID, s.TimeSlotID),
                s => s.ClassScheduleID
            );

            // -----------------------------
            // 5. Assign schedules to students
            // -----------------------------
            classSchedulestoSave.Clear();

            foreach (var student in StudentsInGrade)
            {
                foreach (var baseSlot in baseSchedules)
                {
                    var slotKey = (
                        baseSlot.DayOfTheWeekID,
                        baseSlot.TimeSlotID
                    );

                    var overrideKey = (
     baseSlot.DayOfTheWeekID!.Value,
     baseSlot.TimeSlotID!.Value,
     student.GroupName
 );

                    Guid? effectiveClassId =
     overrideMap.TryGetValue(overrideKey, out var o)
         ? o.ReplacementClassID
         : null;



                    classSchedulestoSave.Add(new StudentClassSchedule
                    {
                        StudentClassScheduleID = Guid.NewGuid(),
                        StudentID = student.StudentID,

                        // 🔒 Always BASE schedule
                        ScheduleID = scheduleLookup[slotKey],

                        // 🎯 Override applied here
                        EffectiveClassID = effectiveClassId
                    });
                }
            }

            // -----------------------------
            // 6. Persist student schedules
            // -----------------------------
            var assignService = GenericService.GetService<List<StudentClassSchedule>>();
            var assignResult = await assignService.PostAsync(
                "api/Dynamic/PostEntities",
                "studentclassschedule",
                classSchedulestoSave
            );

            if (!assignResult.IsSuccess)
                throw new InvalidOperationException("Failed to assign schedules.");

            Snackbar.Add(
                $"Timetable assigned successfully for Grade {GradeLevel}",
                Severity.Success
            );

            classSchedulestoSave.Clear();
            classSchedules.Clear();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            Console.WriteLine(ex);
        }
        finally
        {
            LoaderService.Hide();
        }
    }

