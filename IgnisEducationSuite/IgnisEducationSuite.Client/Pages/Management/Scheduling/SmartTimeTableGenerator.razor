    private HashSet<Guid> GetAdjacency(Guid id)
    {
        if (!subjectAdjacencyDict.ContainsKey(id))
            subjectAdjacencyDict[id] = new HashSet<Guid>();

        return subjectAdjacencyDict[id];
    }
    private string FormatAdjacencyText(IEnumerable<string> values)
    {
        var GuidList = new List<Guid>();
        foreach (var item in values)
        {
            GuidList.Add(Guid.Parse(item));
        }
        return string.Join(", ",
            classes
                .Where(c => GuidList.Contains(c.ClassID))
                .Select(c => c.ClassName)
        );
    }

    private void SetAdjacency(Guid sourceId, IEnumerable<Guid> selectedTargets)
    {
        // Ensure source exists
        if (!subjectAdjacencyDict.ContainsKey(sourceId))
            subjectAdjacencyDict[sourceId] = new HashSet<Guid>();

        // Remove old reverse links
        foreach (var other in subjectAdjacencyDict[sourceId].ToList())
        {
            if (subjectAdjacencyDict.TryGetValue(other, out var set))
                set.Remove(sourceId);
        }

        // Apply new adjacency
        subjectAdjacencyDict[sourceId] = selectedTargets.ToHashSet();

        // Enforce symmetry
        foreach (var targetId in selectedTargets)
        {
            if (!subjectAdjacencyDict.ContainsKey(targetId))
                subjectAdjacencyDict[targetId] = new HashSet<Guid>();

            subjectAdjacencyDict[targetId].Add(sourceId);
        }

        StateHasChanged();
    }


