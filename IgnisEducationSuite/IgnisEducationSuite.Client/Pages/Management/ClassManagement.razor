@page "/ClassManagement"
@using EDUSphereSharedProject.Models
@inherits AppBaseComponent
<MudCard Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Class Management</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />

    <MudCardContent>

        <!-- Section: Add New Class -->
        <MudPaper Class="p-4 mb-4" Elevation="1">
            <MudAlert Severity="Severity.Normal" Icon="@Icons.Material.Filled.Class" Variant="Variant.Filled">
                Create New Class
            </MudAlert>

            <MudGrid Class="mt-3" GutterSize="3">
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="newClass.ClassName" Label="Class Name" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="int?" Variant="Variant.Outlined" Label="Select Academic Level" @bind-Value="newClass.AcademicLevel" Margin="Margin.Dense">
                        @foreach (var a in academicLevels)
                        {
                            <MudSelectItem T="int?" Value="a.LevelInt">@a.LevelName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="newClass.GradeSection" Label="Grade Section" Placeholder="Enter Section e.g. For 10A enter 'A'" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="Teacher"
                                     Label="Assign Teacher"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     ToStringFunc="TeacherTypeconverter"
                                     @bind-Value="newClass.Teacher"
                                     SearchFunc="@Search2"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     AdornmentColor="Color.Primary" />
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddNewClass">Add Class</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />

        <!-- Section: Class Table -->
        <MudPaper Class="p-4 mb-4" Elevation="1">
            <MudAlert Severity="Severity.Normal" Icon="@Icons.Material.Filled.Class" Variant="Variant.Filled">
                Available Classes
            </MudAlert>

            <MudDataGrid Items="classes" Filterable="false" SortMode="@SortMode.Multiple" Groupable="false">
                <Columns>
                    @if (classes.Any())
                    {
                        <PropertyColumn Property="x => x.Teacher.FirstName" Title="Teacher First Name" />
                        <PropertyColumn Property="x => x.Teacher.LastName" Title="Teacher Last Name" />
                        <PropertyColumn Property="x => x.ClassName" Title="Class Name" />
                        <PropertyColumn Property="x => x.LevelName" Title="Level" />
                        <TemplateColumn Title="Actions" CellClass="d-flex justify-end">
                            <CellTemplate>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary">
                                    Manage
                                </MudButton>
                            </CellTemplate>
                        </TemplateColumn>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Info" Variant="Variant.Filled">
                            No classes found
                        </MudAlert>
                    }
                </Columns>
            </MudDataGrid>
        </MudPaper>

    </MudCardContent>
</MudCard>


@code {

    protected Class newClass = new();
    protected Teacher teacherSelected = new();
    protected ClientAdmin loggedInAdmin = new();
    protected List<Class> classes = new();
    protected List<Teacher> teachers = new();
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] AppState _appState { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait...");
        await GetLoggedInAdmin();
        await GetTeachers();
        await GetClasses();
        LoaderService.Hide();
    }
    #region Get From Database
    protected async Task GetTeachers()
    {
        var result = _genericService.GetService<Teacher>();
        var service = await result.GetAllAsync($"api/Dynamic/GetTeachersBySchoolID/{loggedInAdmin.SchoolID}", true);
        teachers = service.Data.ToList();

    }
    protected async Task GetClasses()
    {
        var result = _genericService.GetService<Class>();
        var service = await result.GetAllAsync($"api/Dynamic/GetClassesBySchoolID/{loggedInAdmin.SchoolID}", true);
        classes = service.Data.ToList();

        foreach (var item in classes)
        {
            item.Teacher = teachers.Where(x => x.TeacherID == item.TeacherID).FirstOrDefault();

        }

    }
    protected async Task GetLoggedInAdmin()
    {
        string UserID = string.Empty;

        UserID = _appState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            var service = _genericService.GetService<ClientAdmin>();
            var result = await service.GetAllAsync($"api/Dynamic/GetAdminByUserID/{UserID}", true);
            if (result.IsSuccess)
            {
                loggedInAdmin = result.Data.FirstOrDefault();
            }
        }
    }
    #endregion
    protected async Task AddNewClass()
    {

        newClass.ClassID = Guid.NewGuid();
        if (newClass.Teacher != null)
        {
            newClass.TeacherID = newClass.Teacher.TeacherID;
            teacherSelected = newClass.Teacher;
            newClass.Teacher = null;
        }
        newClass.SChoolID = loggedInAdmin.SchoolID;

        newClass.LevelName = academicLevels.Where(c => c.LevelInt == newClass.AcademicLevel)
        .Select(x => x.LevelName).FirstOrDefault();
        var service = _genericService.GetService<Class>();
        var result = await service.PostAsync("api/Dynamic/PostEntity", "class", newClass);
        if (result.IsSuccess)
        {
            newClass.Teacher = teacherSelected;
            classes.Add(newClass);
            newClass = new();
            Snackbar.Add("Class Added Successfully", Severity.Success);
        }
        else
        {
            Snackbar.Add("Something went wrong Error EDUx000002", Severity.Error);
            return;
        }
    }
    private async Task<IEnumerable<Teacher>> Search2(string value, CancellationToken token)
    {

        if (string.IsNullOrEmpty(value))
            return new List<Teacher>();
        return teachers.Where(x => x.FirstName.Contains(value, StringComparison.InvariantCultureIgnoreCase) || x.LastName.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #region To String Func

    protected Func<Teacher, string> TeacherTypeconverter = p => p?.FirstName + " " + p?.LastName;
    #endregion
}
