@page "/ClientManagement"
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.UniversalModels
@using IgnisEducationSuite.Client.Pages.Management.Dialog
@using IgnisEducationSuite.Client.Pages.Management.SuperAdmin.Dialogs
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits AppBaseComponent
@inject AppState appState

<SuperAdminOnly>
<MudText Typo="Typo.h5" Class="mb-1"><b>Register a school</b></MudText>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Adds a new tenant to Ignis. A school is not usable until it has a licence and an administrator,
    so both are offered here as soon as it is created.
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudForm @ref="_form" Model="newSchool">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense"
                              @bind-Value="newSchool.SchoolName" T="string"
                              Label="School name" Placeholder="e.g. Lusaka Trust Secondary School"
                              Required="true" RequiredError="A school name is required."
                              Validation="@(new Func<string, string?>(ValidateName))" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense"
                              @bind-Value="newSchool.SchoolPhoneContact" T="string"
                              Label="Contact number" Placeholder="+260 123456789"
                              Required="true" RequiredError="A contact number is required." />
            </MudItem>

            <MudItem xs="12" md="6">
                @* Required, and not only for tidiness: the licensing service records this address
                   against the client, and it is where the school's first admin credentials go. *@
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense"
                              @bind-Value="newSchool.SchoolEmail" T="string"
                              Label="Email address" Placeholder="admin@school.edu"
                              InputType="InputType.Email"
                              Required="true" RequiredError="An email address is required."
                              Validation="@(new Func<string, string?>(ValidateEmail))" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense"
                              @bind-Value="newSchool.SchoolWebsite" T="string"
                              Label="Website (optional)" Placeholder="https://school.edu" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudAutocomplete T="CountryInfo"
                                 Label="Currency"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 ToStringFunc="CountryWithCurrencyConverter"
                                 @bind-Value="selectedCurrencyCountry"
                                 SearchFunc="SearchCountriesWithCurrency"
                                 ResetValueOnEmptyText="true"
                                 SelectValueOnTab="true"
                                 HelperText="Used for every fee and invoice. It cannot be changed later."
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 AdornmentColor="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="6" class="d-flex align-center gap-3">
                <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Accept="image/*">
                    <ActivatorContent>
                        <MudFab Color="Color.Secondary"
                                StartIcon="@Icons.Material.Filled.Image"
                                Size="Size.Small"
                                Label="School logo (optional)" />
                    </ActivatorContent>
                </MudFileUpload>

                @if (newSchool.SchoolLogo is { Length: > 0 } logo)
                {
                    <MudImage Width="56" Height="56" ObjectFit="ObjectFit.Contain"
                              Src="@($"data:image/jpeg;base64,{Convert.ToBase64String(logo)}")" />
                }
            </MudItem>

            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddBusiness"
                           DropShadow="true"
                           Disabled="_saving"
                           OnClick="AddSchool">
                    @if (_saving)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    }
                    Register school
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

<MudPaper Class="pa-4" Elevation="1">
    <div class="d-flex align-center mb-3">
        <MudText Typo="Typo.subtitle1"><b>Registered schools (@schools.Count)</b></MudText>
        <MudSpacer />
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Label="Search schools"
                      Clearable="true"
                      Immediate="true"
                      @bind-Value="searchString"
                      Style="max-width:300px;" />
    </div>

    @if (!schools.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No schools are registered yet.</MudAlert>
    }
    else
    {
        <MudDataGrid Items="FilteredSchools" Filterable="false" SortMode="SortMode.None"
                     Groupable="false" Dense="true" Elevation="0" T="School">
            <Columns>
                <PropertyColumn Property="x => x.SchoolName" Title="School" />
                <PropertyColumn Property="x => x.SchoolEmail" Title="Email" />
                <PropertyColumn Property="x => x.CurrencyCode" Title="Currency" />
                <TemplateColumn CellClass="d-flex justify-end" Title="">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       OnClick="() => LicenceAsync(context.Item)" Color="Color.Warning">
                                Licence
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled"
                                       OnClick="() => ManageSchoolDetailsAsync(context.Item)" Color="Color.Primary">
                                Manage
                            </MudButton>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudPaper>

</SuperAdminOnly>

@code {
    protected School newSchool = new();
    protected List<School> schools = new();
    protected List<CountryInfo> CountriesWithCurrency = new();
    protected string searchString = string.Empty;

    // Snackbar, DialogService and NavigationManager come from AppBaseComponent — re-injecting them
    // here shadowed the base members and warned (CS0108).
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] CountryCurrencyService countryCurrencyService { get; set; } = default!;

    private MudForm _form = default!;
    private bool _saving;

    protected Func<CountryInfo, string> CountryWithCurrencyConverter => c =>
        c is null ? "" : $"{c.Name} ({c.CurrencySymbol})";

    protected CountryInfo? selectedCurrencyCountry;

    private IEnumerable<School> FilteredSchools =>
        string.IsNullOrWhiteSpace(searchString)
            ? schools
            : schools.Where(s =>
                (s.SchoolName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (s.SchoolEmail?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await GetSchools();
        await LoadCurrencyCountries();
    }

    protected async Task GetSchools()
    {
        var service = _genericService.GetService<School>();
        var result = await service.GetAllAsync($"api/Dynamic/GetEntity/{"school"}", true);

        if (result.IsSuccess)
        {
            schools = result.Data.OrderBy(s => s.SchoolName).ToList();
        }
    }

    private async Task<IEnumerable<CountryInfo>> SearchCountriesWithCurrency(string value, CancellationToken token)
    {
        await Task.Delay(5, token);
        if (string.IsNullOrWhiteSpace(value)) return new List<CountryInfo>();
        return CountriesWithCurrency.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    // ---- Validation -------------------------------------------------------------------
    //
    // The form previously had none, so a school could be saved with a blank name and no contact
    // details — and would then appear in every list as an unnamed row nobody could identify.

    private string? ValidateName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "A school name is required.";

        return schools.Any(s => string.Equals(s.SchoolName?.Trim(), name.Trim(), StringComparison.OrdinalIgnoreCase))
            ? "A school with this name is already registered."
            : null;
    }

    private static string? ValidateEmail(string? email) =>
        string.IsNullOrWhiteSpace(email) ? "An email address is required."
        : !email.Contains('@') || !email.Contains('.') ? "That does not look like an email address."
        : null;

    protected async Task AddSchool()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add("Please correct the highlighted fields.", Severity.Warning);
            return;
        }

        if (selectedCurrencyCountry is null)
        {
            Snackbar.Add("Choose a currency. It cannot be set later.", Severity.Error);
            return;
        }

        _saving = true;
        try
        {
            newSchool.SchoolID = Guid.NewGuid();
            newSchool.SchoolCurrencyName = selectedCurrencyCountry.CurrencyName;
            newSchool.CurrencySymbol = selectedCurrencyCountry.CurrencySymbol;
            newSchool.CurrencyCountry = selectedCurrencyCountry.Name;
            newSchool.CurrencyCode = selectedCurrencyCountry.CurrencyCode;

            var service = _genericService.GetService<School>();
            var result = await service.PostAsync("api/Dynamic/PostEntity", "school", newSchool);

            if (!result.IsSuccess)
            {
                Snackbar.Add("The school could not be saved. Please try again.", Severity.Error);
                return;
            }

            var created = newSchool;
            schools.Add(created);
            schools = schools.OrderBy(s => s.SchoolName).ToList();

            newSchool = new();
            selectedCurrencyCountry = null;
            await _form.ResetAsync();

            Snackbar.Add($"{created.SchoolName} registered.", Severity.Success);

            // The old flow ended at a toast saying "don't forget to activate License", which left
            // the operator to find licensing on their own. Offer it here instead, at the one moment
            // it is certainly needed.
            await OfferNextStepsAsync(created);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Walks the operator through the two things a newly registered school cannot work
    /// without: a licence, and somebody who can sign in.</summary>
    private async Task OfferNextStepsAsync(School created)
    {
        var licenceNow = await DialogService.ShowMessageBox(
            $"{created.SchoolName} is registered",
            "It has no licence and no administrator yet, so nobody can use it. Activate a licence now?",
            yesText: "Activate licence", cancelText: "Later");

        if (licenceNow == true)
        {
            await LicenceAsync(created);
        }

        var adminNow = await DialogService.ShowMessageBox(
            "Add an administrator?",
            $"{created.SchoolName} still needs at least one administrator account before anyone can sign in.",
            yesText: "Add administrator", cancelText: "Later");

        if (adminNow == true)
        {
            NavigationManager.NavigateTo("/ManageSchoolAdmins");
        }
    }

    private async Task LicenceAsync(School school)
    {
        var parameters = new DialogParameters<LicenseDialog>
        {
            { x => x.SchoolId, school.SchoolID },
            { x => x.SchoolName, school.SchoolName ?? "this school" },
        };

        await DialogService.ShowAsync<LicenseDialog>(
            "Licence", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task LoadCurrencyCountries()
    {
        try
        {
            var result = await countryCurrencyService.GetAllCountriesWithCurrencyAsync();
            CountriesWithCurrency = result ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load currency data: {ex.Message}", Severity.Error);
        }
    }

    private async Task UploadFiles(IBrowserFile file)
    {
        if (file is null) return;

        using var memoryStream = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(memoryStream);
        newSchool.SchoolLogo = memoryStream.ToArray();
    }

    private async Task ManageSchoolDetailsAsync(School school)
    {
        var parameters = new DialogParameters<ManageSchoolDetails> { { x => x.school, school } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ManageSchoolDetails>("", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string message })
        {
            Snackbar.Add(message, Severity.Success);
            await GetSchools();
            StateHasChanged();
        }
    }
}
