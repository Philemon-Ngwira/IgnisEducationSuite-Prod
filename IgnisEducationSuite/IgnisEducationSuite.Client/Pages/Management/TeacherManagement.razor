@page "/TeacherManagement"
@using EDUSphereSharedProject.Models
@using IgnisEducationSuite.Client.Pages.Management.Dialog
@inherits AppBaseComponent
<MudCard Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Teacher Management</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />

    <MudCardContent>

        <!-- Section: Add New Teacher -->
        <MudPaper Class="p-4 mb-4" Elevation="1">
            <MudAlert Severity="Severity.Normal" Icon="@Icons.Material.Filled.Person" Variant="Variant.Filled">
                Create New Teacher Profile
            </MudAlert>

            <MudGrid Class="mt-3" GutterSize="3">
                <MudItem xs="12" md="6">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newTeacher.FirstName" Label="First Name" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newTeacher.LastName" Label="Last Name" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Variant="Variant.Outlined" Label="Gender" Margin="Margin.Dense" @bind-Value="newTeacher.Gender">
                        @foreach (var item in genders)
                        {
                            <MudSelectItem T="string" Value="item.GenderDescription">@item.GenderDescription</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newTeacher.ContactNo" Label="Contact #" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newTeacher.EmailAddress" Label="Email Address" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="newTeacher.DateEngaged" Label="Date Engaged" />
                </MudItem>
                <MudItem xs="12" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTeacher">Add Teacher</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />

        <!-- Section: Teacher Table -->
        <MudPaper Class="p-4 mb-4" Elevation="1">
            <MudAlert Severity="Severity.Normal" Icon="@Icons.Material.Filled.People" Variant="Variant.Filled">
                All Available Teachers
            </MudAlert>

            <MudDataGrid Items="teachers" Filterable="false" SortMode="@SortMode.None" Groupable="false">
                <Columns>
                    @if (teachers.Any())
                    {
                        <PropertyColumn Property="x => x.FirstName" />
                        <PropertyColumn Property="x => x.LastName" />
                        <PropertyColumn Property="x => x.Gender" Title="Gender" />
                        <PropertyColumn Property="x => x.ContactNo" Title="Contact #" />
                        <PropertyColumn Property="x => x.EmailAddress" Title="Email" />
                        <TemplateColumn Title="Actions" CellClass="d-flex justify-end">
                            <CellTemplate>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => OpenTeacherDetails(context.Item)">
                                    Manage
                                </MudButton>
                            </CellTemplate>
                        </TemplateColumn>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Info" Variant="Variant.Filled">
                            No Teachers found
                        </MudAlert>
                    }
                </Columns>
            </MudDataGrid>
        </MudPaper>

    </MudCardContent>
</MudCard>


@code {

    protected Teacher newTeacher = new();
    protected Teacher selectedTeacher = new();
    protected ClientAdmin clientAdmin = new();
    protected List<Teacher> teachers = new();

    protected List<Gender> genders = new();
    protected List<Class> subjects = new();
    protected List<Class> Teachersubjects = new();

    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] IDialogService DialogService { get; set; } = default!;
    [Inject] AppState _appState { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {

        LoaderService.Show("Initializing Please wait...");
        await GetLoggedInAdmin();
        await GetSubjects();
        await GetTeachers();
        await GetGenders();

        LoaderService.Hide();
    }


    #region Calls to get data From DB
    protected async Task GetLoggedInAdmin()
    {
        string UserID = string.Empty;

        UserID = _appState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            var service = _genericService.GetService<ClientAdmin>();
            var result = await service.GetAllAsync($"api/Dynamic/GetAdminByUserID/{UserID}", true);
            if (result.IsSuccess)
            {
                clientAdmin = result.Data.FirstOrDefault();
            }
        }
    }
    protected async Task GetGenders()
    {
        var result = _genericService.GetService<Gender>();
        var service = await result.GetAllAsync($"api/Dynamic/GetEntity/{"genders"}", true);
        genders = service.Data.ToList();

    }
    protected async Task GetTeachers()
    {
        var result = _genericService.GetService<Teacher>();
        var service = await result.GetAllAsync($"api/Dynamic/GetTeachersBySchoolID/{clientAdmin.SchoolID}", true);
        teachers = service.Data.ToList();

    }
    protected async Task GetSubjects()
    {
        var result = _genericService.GetService<Class>();
        var service = await result.GetAllAsync($"api/Dynamic/GetClassesBySchoolID/{clientAdmin.SchoolID}", true);
        subjects = service.Data.ToList();

    }
    protected async Task GetTeaherSubjects(Teacher teacher)
    {
        var result = _genericService.GetService<Class>();
        var service = await result.GetAllAsync($"api/Dynamic/GetTeacherSubjectsByID/{teacher.TeacherID}", true);
        Teachersubjects = service.Data.ToList();

    }
    #endregion

    protected async Task AddTeacher()
    {

        LoaderService.Show("Please wait saving changes...");

        newTeacher.TeacherID = Guid.NewGuid();

        var result = _genericService.GetService<Teacher>();
        var service = await result.PostAsync("api/Dynamic/PostEntity", "teacher", newTeacher);
        if (service.IsSuccess)
        {
            teachers.Add(newTeacher);
            newTeacher = new();
            Snackbar.Add("Student Added Successfully", Severity.Success);
        }
        LoaderService.Hide();
    }
    void RowClicked(DataGridRowClickEventArgs<Teacher> args)
    {
        selectedTeacher = args.Item;
    }
    private async Task OpenTeacherDetails(Teacher teacher)
    {

        await GetTeaherSubjects(teacher);
        var listtoSend = new List<Class>();
        var Ids = new HashSet<Guid>(Teachersubjects.Select(x => x.ClassID));
        foreach (var item in subjects)
        {
            if (Ids.Contains(item.ClassID) || item.TeacherID != null)
            {
                continue;
            }
           
            listtoSend.Add(item);

        }
        var parameters = new DialogParameters<ManageTeacherDetails> { { d => d.teacher, teacher }, { x => x.subjects, listtoSend }, { x => x.teachersSubjects, Teachersubjects } };
        var opt = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge };
        var dialog = await DialogService.ShowAsync<ManageTeacherDetails>("", parameters, opt);
        var result = await dialog.Result;
    }
}
