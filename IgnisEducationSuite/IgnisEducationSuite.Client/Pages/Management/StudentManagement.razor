@page "/StudentManagement"
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@using IgnisEducationSuite.Client.Pages.Management.Dialog
@using System.Text.Json
@inject IDialogService DialogService
@inherits AppBaseComponent
<MudTabs>
    <MudTabPanel Text="Students">
        <MudCard Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Align="Align.Center" Typo="Typo.h4"><b>Student Management</b></MudText>
                </CardHeaderContent>
            </MudCardHeader>

            <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />

            <MudCardContent>

                <!-- Section: Add New Student -->
                <MudPaper Class="p-4 mb-4" Elevation="1">
                    <MudAlert Severity="Severity.Normal" Icon="@Icons.Material.Filled.Person" Variant="Variant.Filled">
                        Create New Student Profile
                    </MudAlert>

                    <MudGrid Class="mt-3" GutterSize="3">
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newStudent.FirstName" Label="First Name" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newStudent.LastName" Label="Last Name" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect Variant="Variant.Outlined" T="int?" Label="Select Academic Level" @bind-Value="newStudent.AcademicLevel" Margin="Margin.Dense">
                                @foreach (var a in academicLevels)
                                {
                                    <MudSelectItem T="int?" Value="a.LevelInt">@a.LevelName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newStudent.GradeSection" Label="Grade Section" Placeholder="Enter Section e.g For 10A enter 'A'" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" Variant="Variant.Outlined" Label="Gender" Margin="Margin.Dense" @bind-Value="newStudent.Gender">
                                @foreach (var item in genders)
                                {
                                    <MudSelectItem T="string" Value="item.GenderDescription">@item.GenderDescription</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newStudent.Address" Label="Address" />
                        </MudItem>
                        <MudItem xs="12" Class="d-flex justify-end">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddStudent">Add Student</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />

                <!-- Section: Student Table -->
                <MudPaper Class="p-4 mb-4" Elevation="1">
                    <MudAlert Severity="Severity.Normal" Icon="@Icons.Material.Filled.People" Variant="Variant.Filled">
                        All Available Students
                    </MudAlert>

                    <MudDataGrid Breakpoint="Breakpoint.Sm" Items="Students" Filterable="false" SortMode="@SortMode.None" Groupable="false" QuickFilter="_quickFilter">
                        <ToolBarContent>
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.Search" Label="Search Student" @bind-Value="searchString" />
                        </ToolBarContent>

                        <Columns>
                            @if (Students.Any())
                            {
                                <PropertyColumn Property="x => x.StudentNumber" Title="Student Number" />
                                <PropertyColumn Property="x => x.FirstName" />
                                <PropertyColumn Property="x => x.LastName" />
                                <PropertyColumn Property="x => x.Gender" />
                                <PropertyColumn Property="x => x.Address" />
                                <PropertyColumn Property="x => x.LevelName" Title="Level" />
                                <TemplateColumn Title="Actions" CellClass="d-flex justify-end">
                                    <CellTemplate>
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ManageStudentDetailsAsync(context.Item)">
                                            Manage
                                        </MudButton>
                                    </CellTemplate>
                                </TemplateColumn>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Info" Variant="Variant.Filled">
                                    No Students found
                                </MudAlert>
                            }
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="Student" />
                        </PagerContent>
                    </MudDataGrid>
                </MudPaper>

            </MudCardContent>
        </MudCard>
    </MudTabPanel>

    <MudTabPanel Text="Payment Management">
        <!-- Section: Template Download -->
        <MudPaper Class="p-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Download Template</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Use the template to update student payment status. Ensure the Excel file contains <b>StudentNumber</b> and <b>PaymentStatus</b> (Paid/Unpaid).
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DownloadPaymentTemplate" StartIcon="@Icons.Material.Filled.Download">
                Download Payment Template
            </MudButton>
        </MudPaper>

        <!-- Section: Upload Excel -->
        <MudPaper Class="p-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Upload Payment Updates</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Select an Excel file (.xlsx) with updated payment statuses.
            </MudText>
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Accept=".xlsx">
                <ActivatorContent>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                        Upload Excel File
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudPaper>

        <!-- Section: Unmatched Rows / Errors -->
        @if (unmatchedRows.Any())
        {
            <MudPaper Class="p-4 mb-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Unmatched Rows / Errors</MudText>
                <MudTable Items="unmatchedRows" Dense="true" Hover="true" Bordered="true">
                    <HeaderContent>
                        <MudTh>Row Info</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Row Info">@context</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        <!-- Section: Student Payment Table -->
        <MudPaper Class="p-4 mb-4" Elevation="1">
            <MudDataGrid Items="Students" Filterable="true" Breakpoint="Breakpoint.Sm">
                <ToolBarContent>
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Label="Search Student" @bind-Value="searchString">
                    </MudTextField>
                </ToolBarContent>

                <Columns>
                    @if (Students.Any())
                    {
                        <PropertyColumn Property="x => x.StudentNumber" Title="Student Number" />
                        <PropertyColumn Property="x => x.FirstName" />
                        <PropertyColumn Property="x => x.LastName" />
                        <PropertyColumn Property="x => x.Gender" />
                        <PropertyColumn Property="x => x.Address" />
                        <PropertyColumn Property="x => x.LevelName" Title="Level" />
                        <TemplateColumn Title="Payment Status">
                            <CellTemplate>
                                @if (context.Item.PaymentStatus == true)
                                {
                                    <MudChip Color="Color.Success" Variant="Variant.Filled">Paid</MudChip>
                                }
                                else
                                {
                                    <MudChip Color="Color.Error" Variant="Variant.Filled">Unpaid</MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Info" Variant="Variant.Filled">
                            No students found
                        </MudAlert>
                    }
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="Student" />
                </PagerContent>
            </MudDataGrid>
        </MudPaper>

        <!-- Section: Apply Updates Button -->
        <div class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" >
                Apply Updates
            </MudButton>
        </div>
    </MudTabPanel>

</MudTabs>


@code {

    protected Student newStudent = new();
    protected ClientAdmin clientAdmin = new();
    protected List<Student> Students = new();
    protected List<Gender> genders = new();
    protected List<Class> classes = new();
    protected List<string> unmatchedRows = new();
    protected List<GetStudentClassInfoResult> Studentclasses = new();
    protected List<Teacher> teachers = new();
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] AppState _appState { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    protected string searchString = string.Empty;
    protected string successMessage = "";
    IList<IBrowserFile> _files = new List<IBrowserFile>();

    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait preparing everything for you.....");
        await GetLoggedInAdmin();
        await GetStudent();
        await GetTeachers();
        await GetClasses();
        await GetGenders();

        LoaderService.Hide();
    }


    #region Calls to get data From DB
    private async Task UploadFiles(IBrowserFile file)
    {
        unmatchedRows.Clear();

        LoaderService.Show("Processing the file, please wait...");
        if (file == null || file.Size == 0)
        {
            unmatchedRows.Add("No file selected or the file is empty.");
            return;
        }

        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10 MB max
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            // Add school ID
            content.Add(new StringContent(AppState.SchoolID ?? ""), "schoolId");

            var response = await HttpClient.PostAsync("api/upload/uploadPayments", content);

            if (response.IsSuccessStatusCode)
            {
                // Successful upload
                var json = await response.Content.ReadFromJsonAsync<JsonElement>();
                successMessage = json.GetProperty("message").GetString();
            }
            else
            {
                // Failed upload - capture unmatched rows
                var json = await response.Content.ReadFromJsonAsync<JsonElement>();
                if (json.TryGetProperty("errors", out var errors))
                {
                    unmatchedRows = errors.EnumerateArray().Select(x => x.GetString() ?? "").ToList();
                }
                else if (json.TryGetProperty("message", out var message))
                {
                    unmatchedRows.Add(message.GetString() ?? "Unknown error.");
                }
            }
        }
        catch (Exception ex)
        {
            unmatchedRows.Add($"Error uploading file: {ex.Message}");
        }
        finally
        {
            LoaderService.Hide();
        }
    }

    protected async Task DownloadPaymentTemplate()
    {
        var response = await HttpClient.GetAsync($"api/Templates/DownloadPaymentTemplate/{Guid.Parse(AppState.SchoolID)}");

        if (response.IsSuccessStatusCode)
        {
            // Read the file content as a byte array
            var fileBytes = await response.Content.ReadAsByteArrayAsync();

            // Get file name from response header if present, fallback to default
            var fileName = "StudentPaymentTemplate.xlsx";
            if (response.Content.Headers.ContentDisposition != null)
            {
                fileName = response.Content.Headers.ContentDisposition.FileName.Trim('"');
            }

            // Use JSInterop to trigger the browser download
            await JS.InvokeVoidAsync("BlazorDownloadFile", fileName, fileBytes);
        }
        else
        {
            // Handle error (optional)
            Console.WriteLine("Failed to download template: " + response.StatusCode);
        }

    }



    protected async Task GetClasses()
    {
        var result = _genericService.GetService<Class>();
        var service = await result.GetAllAsync($"api/Dynamic/GetClassesBySchoolID/{clientAdmin.SchoolID}", true);
        var classesdata = service.Data.ToList();
        foreach (var item in classesdata)
        {
            item.Teacher = teachers.Where(x => x.TeacherID == item.TeacherID).FirstOrDefault();
            if (item.SChoolID == clientAdmin.SchoolID)
            {
                classes.Add(item);
            }
        }

    }
    protected async Task GetTeachers()
    {
        var result = _genericService.GetService<Teacher>();
        var service = await result.GetAllAsync($"api/Dynamic/GetTeachersBySchoolID/{clientAdmin.SchoolID}", true);
        teachers = service.Data.ToList();

    }
    protected async Task GetGenders()
    {
        var result = _genericService.GetService<Gender>();
        var service = await result.GetAllAsync($"api/Dynamic/GetEntity/{"genders"}", true);
        genders = service.Data.ToList();

    }
    protected async Task GetStudent()
    {
        var result = _genericService.GetService<Student>();
        var service = await result.GetAllAsync($"api/Dynamic/GetStudentsBySchoolID/{clientAdmin.SchoolID}", true);
        Students = service.Data.ToList();
        Students.OrderByDescending(x => x.AcademicLevel);

    }
    protected async Task GetLoggedInAdmin()
    {
        string UserID = string.Empty;

        UserID = _appState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            var service = _genericService.GetService<ClientAdmin>();
            var result = await service.GetAllAsync($"api/Dynamic/GetAdminByUserID/{UserID}", true);
            if (result.IsSuccess)
            {
                clientAdmin = result.Data.FirstOrDefault();
            }
        }
    }
    protected async Task AddStudent()
    {
        LoaderService.Show("Please wait...");
        newStudent.StudentID = Guid.NewGuid();

        newStudent.LevelName = academicLevels.Where(a => a.LevelInt == newStudent.AcademicLevel)
                                .Select(s => s.LevelName)
                                .FirstOrDefault();
        var result = _genericService.GetService<Student>();
        var service = await result.PostAsync("api/Dynamic/PostEntity", "student", newStudent);
        if (service.IsSuccess)
        {
            Students.Add(newStudent);
            newStudent = new();
            Snackbar.Add("Student Added Successfully", Severity.Success);
        }
        LoaderService.Hide();
    }

    protected async Task<IEnumerable<GetStudentClassInfoResult>> GetStudentClasses(Guid StudentId)
    {

        var service = _genericService.GetService<GetStudentClassInfoResult>();
        var result = await service.GetAllAsync($"api/Dynamic/GetStudentClassInfo/{StudentId}", true);
        return result.Data.ToList();


    }
    #endregion

    private async Task ManageStudentDetailsAsync(Student student)
    {

        var studentClasses = await GetStudentClasses(student.StudentID);
        var classesToSend = classes
     .Where(x => x.AcademicLevel == student.AcademicLevel
                 && !studentClasses.Any(s => s.ClassID == x.ClassID))
     .ToList();

        var parameters = new DialogParameters<StudentManagementDialog> { { x => x.selectedStudent, student }, { x => x.classes, classesToSend }, { s => s.newstudentClasses, studentClasses } };
        var DialogOpt = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<StudentManagementDialog>("", parameters, DialogOpt);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var dt = result.Data;
            if (dt is string)
            {
                var message = (string)dt;
                if (message == "Successful")
                {
                    LoaderService.Show("Completing");
                    await GetStudent();
                    StateHasChanged();
                    LoaderService.Hide();

                }
            }
        }
    }

    private Func<Student, bool> _quickFilter => x =>
       {
           if (string.IsNullOrWhiteSpace(searchString))
               return true;

           if (x.FirstName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
               return true;

           if (x.LastName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
               return true;

           if ($"{x.StudentNumber} ".Contains(searchString))
               return true;

           return false;
       };
}
