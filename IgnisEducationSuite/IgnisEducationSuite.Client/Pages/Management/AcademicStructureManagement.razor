@using EDUSphereSharedProject.Models
@inherits AppBaseComponent

<MudStack Spacing="3">

    <MudText Typo="Typo.h5">
        Academic Structure Management
    </MudText>

    <MudText Typo="Typo.caption">
        Manage levels, sections and class teacher assignments.
    </MudText>

    <MudDivider />

    <MudExpansionPanels MultiExpansion="true">

        @foreach (var level in AcademicLevels.OrderBy(x => x.SortOrder))
        {
            <MudExpansionPanel>

                <!-- HEADER -->

                <TitleContent>

                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">

                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                                @level.LevelName
                            </MudChip>

                            <MudChip T="string" Color="@(level.isActive == true ? Color.Success : Color.Error)" Variant="Variant.Outlined">
                                @(level.isActive == true ? "Active" : "Inactive")
                            </MudChip>

                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                                @GetLevelStudentCount(level.AcademicLevelID) Students
                            </MudChip>

                        </MudStack>

                        <MudStack Row Spacing="1">

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           OnClick="@(() => ToggleEdit(level))" />

                            <MudIconButton Icon="@Icons.Material.Filled.PowerSettingsNew"
                                           Color="Color.Warning"
                                           OnClick="@(() => ToggleLevelStatus(level))" />

                        </MudStack>

                    </MudStack>

                </TitleContent>

                <!-- BODY -->

                <ChildContent>

                    <!-- LEVEL EDIT -->
                    @if (editingLevels.Contains(level.AcademicLevelID))
                    {
                        <MudPaper Class="pa-3 mb-3">

                            <MudGrid>

                                <MudItem xs="12" md="6">
                                    <MudTextField Label="Level Name"
                                                  Margin="Margin.Dense"
                                                  @bind-Value="level.LevelName" />
                                </MudItem>

                                <MudItem xs="12" md="3">
                                    <MudNumericField Label="Sort Order"
                                                     Margin="Margin.Dense"
                                                     @bind-Value="level.SortOrder" />
                                </MudItem>

                                <MudItem xs="12" md="3">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="@(() => SaveLevel(level))">
                                        Save
                                    </MudButton>
                                </MudItem>

                            </MudGrid>

                        </MudPaper>
                    }

                    <!-- SECTIONS -->

                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        Sections
                    </MudText>

                    @if (levelSections.Any(x => x.AcademicLevelID == level.AcademicLevelID))
                    {

                        <MudTable Dense="true"
                                  Items="levelSections.Where(x => x.AcademicLevelID == level.AcademicLevelID)">

                            <HeaderContent>
                                <MudTh>Section</MudTh>
                                <MudTh>Students</MudTh>
                                <MudTh>Class Teacher</MudTh>
                                <MudTh>Actions</MudTh>
                            </HeaderContent>

                            <RowTemplate>

                                <!-- Section Name -->

                                <MudTd>
                                    <MudTextField Margin="Margin.Dense"
                                                  @bind-Value="context.SectionCode" />
                                </MudTd>

                                <!-- Student Count -->

                                <MudTd>
                                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                                        @GetSectionStudentCount(context.LevelSectionID) Students
                                    </MudChip>
                                </MudTd>

                                <!-- Teacher -->

                                <MudTd>

                                    <MudSelect T="Guid?"
                                               Dense="true"
                                               Placeholder="Assign Teacher"
                                               @bind-Value="sectionTeacherAssignments[context.LevelSectionID]">

                                        @foreach (var teacher in teachers)
                                        {
                                            <MudSelectItem Value="@((Guid?)teacher.TeacherID)">
                                                @teacher.FullName
                                            </MudSelectItem>
                                        }

                                    </MudSelect>

                                </MudTd>

                                <!-- Actions -->

                                <MudTd>

                                    <MudIconButton Icon="@Icons.Material.Filled.Save"
                                                   Color="Color.Success"
                                                   OnClick="@(() => SaveSection(context))" />

                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteSection(context))" />

                                </MudTd>

                            </RowTemplate>

                        </MudTable>

                    }
                    else
                    {

                        <!-- NO SECTIONS SCHOOL -->

                        <MudAlert Severity="Severity.Info">
                            This level has no sections. Assign a class teacher for the entire level.
                        </MudAlert>

                        <MudStack Row Spacing="2" Class="mt-2">

                            <MudSelect T="Guid?"
                                       Dense="true"
                                       Placeholder="Assign Class Teacher"
                                       @bind-Value="levelTeacherAssignments[level.AcademicLevelID]">

                                @foreach (var teacher in teachers)
                                {
                                    <MudSelectItem Value="@((Guid?)teacher.TeacherID)">
                                        @teacher.FullName
                                    </MudSelectItem>
                                }

                            </MudSelect>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="@(() => SaveLevelTeacher(level))">
                                Save
                            </MudButton>

                        </MudStack>

                    }

                    <!-- ADD SECTION -->

                    <MudDivider Class="my-3" />

                    <MudStack Row Spacing="2">

                        <MudTextField T="string" Placeholder="New Section Name"
                                      Margin="Margin.Dense"
                                      @bind-Value="newSectionPerLevel[level.AcademicLevelID]" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="@(() => AddSection(level))">
                            Add Section
                        </MudButton>

                    </MudStack>

                </ChildContent>

            </MudExpansionPanel>
        }

    </MudExpansionPanels>

</MudStack>

@code {

    protected List<AcademicLevel> AcademicLevels = new();
    protected List<LevelSection> LevelSections = new();
    protected List<Teacher> teachers = new();
    protected List<ClassTeacher> classTeachers = new();

    protected List<Student> students = new(); // for student counts

    private HashSet<Guid> editingLevels = new();

    private Dictionary<Guid, string> newSectionPerLevel = new();

    private Dictionary<Guid, Guid?> sectionTeacherAssignments = new();
    private Dictionary<Guid, Guid?> levelTeacherAssignments = new();

    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait while we load the academic structure...");
        AcademicLevels = academicLevels.ToList();
        LevelSections = levelSections.ToList();
        await LoadTeachers();
        await LoadClassTeachers();
        // Ensure dictionary has all levels
        foreach (var level in academicLevels)
        {
            if (!levelTeacherAssignments.ContainsKey(level.AcademicLevelID))
                levelTeacherAssignments[level.AcademicLevelID] = null;
            newSectionPerLevel[level.AcademicLevelID] = "";
        }

        LoaderService.Hide();
    }

    void ToggleEdit(AcademicLevel level)
    {
        if (editingLevels.Contains(level.AcademicLevelID))
            editingLevels.Remove(level.AcademicLevelID);
        else
            editingLevels.Add(level.AcademicLevelID);
    }

    private async Task LoadClassTeachers()
    {
        var service = GenericService.GetService<ClassTeacher>();
        var result = await service.GetAllAsync($"api/Dynamic/GetClassTeachersBySchoolID/{Guid.Parse(AppState.SchoolID)}", true);
        if (result.IsSuccess)
        {
            classTeachers = result.Data.ToList() ?? new List<ClassTeacher>();
            PopulateTeacherAssignments();
        }
    }
    private async Task LoadTeachers()
    {
        var result = GenericService.GetService<Teacher>();
        var service = await result.GetAllAsync($"api/Dynamic/GetTeachersBySchoolID/{Guid.Parse(AppState.SchoolID)}", true);
        teachers = service.Data.ToList() ?? new List<Teacher>();
    }

    void ToggleLevelStatus(AcademicLevel level)
    {
        level.isActive = !level.isActive;
    }

    int GetLevelStudentCount(Guid levelId)
    {
        return students.Count(x => x.AcademicLevelID == levelId);
    }

    int GetSectionStudentCount(Guid sectionId)
    {
        return students.Count(x => x.LevelSectionID == sectionId);
    }
    private void PopulateTeacherAssignments()
    {
        // Clear existing
        sectionTeacherAssignments.Clear();
        levelTeacherAssignments.Clear();

        // Sections
        foreach (var ct in classTeachers)
        {
            if (ct.LevelSectionID != Guid.Empty && ct.LevelSectionID != null)
            {
                sectionTeacherAssignments[(Guid)ct.LevelSectionID] = ct.TeacherID;
            }
            else
            {
                levelTeacherAssignments[(Guid)ct.AcademicLevelID] = ct.TeacherID;
            }
        }

        // Ensure every level has a key in case there is no assignment yet
        foreach (var level in AcademicLevels)
        {
            if (!levelTeacherAssignments.ContainsKey(level.AcademicLevelID))
                levelTeacherAssignments[level.AcademicLevelID] = null;
        }

        // Ensure every section has a key in case there is no assignment yet
        foreach (var section in LevelSections)
        {
            if (!sectionTeacherAssignments.ContainsKey(section.LevelSectionID))
                sectionTeacherAssignments[section.LevelSectionID] = null;
        }
    }
    private async Task SaveLevel(AcademicLevel level)
    {
        // API call
        editingLevels.Remove(level.AcademicLevelID);
    }

    private async Task SaveSection(LevelSection section)
    {
        var teacherId = sectionTeacherAssignments.ContainsKey(section.LevelSectionID)
            ? sectionTeacherAssignments[section.LevelSectionID]
            : null;

        if (teacherId == null)
        {
            Snackbar.Add("Please select a teacher to assign.", Severity.Warning);
            return;
        }

        // Check if there is an existing assignment
        var existing = classTeachers.FirstOrDefault(ct => ct.LevelSectionID == section.LevelSectionID);

        if (existing != null)
        {
            // Update existing assignment
            existing.TeacherID = teacherId;
            existing.DateUpdated = DateTime.UtcNow;
            await GenericService.GetService<ClassTeacher>()
                .UpdateAsync("api/Dynamic/UpdateEntity", "classteachers", existing);
        }
        else
        {
            // Create new assignment
            var newAssignment = new ClassTeacher
            {
                ClassTeacherID = Guid.NewGuid(),
                TeacherID = teacherId,
                LevelSectionID = section.LevelSectionID,
                AcademicLevelID = section.AcademicLevelID,
                SchoolID = Guid.Parse(AppState.SchoolID),
                DateCreated = DateTime.UtcNow,
                DateUpdated = DateTime.UtcNow,
                CreatedBy = $"{AppState.FirstName} {AppState.LastName}"
            };
            await GenericService.GetService<List<ClassTeacher>>()
                .PostAsync("api/Dynamic/PostEntities", "classteachers", new List<ClassTeacher> { newAssignment });

            // Add to local list so we can track updates
            classTeachers.Add(newAssignment);
        }

        Snackbar.Add("Class teacher assignment saved.", Severity.Success);
    }

    private async Task DeleteSection(LevelSection section)
    {
        // API call
        section.IsActive = false;
        await GenericService.GetService<LevelSection>()
            .UpdateAsync("api/Dynamic/UpdateEntity", "levelsection", section);
        // Remove from local list to update UI
        levelSections.Remove(section);
        Snackbar.Add("Section deleted.", Severity.Success);
    }

    private async Task AddSection(AcademicLevel level)
    {
        var name = newSectionPerLevel[level.AcademicLevelID];

        if (!string.IsNullOrWhiteSpace(name))
        {
            // API call

            levelSections.Add(new LevelSection
            {
                LevelSectionID = Guid.NewGuid(),
                AcademicLevelID = level.AcademicLevelID,
                SectionCode = name,
                SchoolID = Guid.Parse(AppState.SchoolID),
                IsActive = true,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow,

            });
            var service = GenericService.GetService<List<LevelSection>>();
            var result = await service.PostAsync("api/Dynamic/PostEntities", "levelsection", new List<LevelSection> { levelSections.Last() });
            if (result.IsSuccess)
            {
                Snackbar.Add("Section added successfully.", Severity.Success);
                newSectionPerLevel[level.AcademicLevelID] = string.Empty;
            }
            else
            {
                Snackbar.Add("Failed to add section.", Severity.Error);
                levelSections.RemoveAt(levelSections.Count - 1); // remove the one we just added since it failed
            }

        }
    }

    private async Task SaveLevelTeacher(AcademicLevel level)
    {
        var teacherId = levelTeacherAssignments[level.AcademicLevelID];

        // API call
        var newAssignment = new ClassTeacher
        {
            ClassTeacherID = Guid.NewGuid(),
            TeacherID = teacherId,
            AcademicLevelID = level.AcademicLevelID,
            SchoolID = Guid.Parse(AppState.SchoolID),
            DateCreated = DateTime.UtcNow,
            DateUpdated = DateTime.UtcNow,
            CreatedBy = $"{AppState.FirstName} {AppState.LastName}"
        };
        await GenericService.GetService<List<ClassTeacher>>()
            .PostAsync("api/Dynamic/PostEntities", "classteachers", new List<ClassTeacher> { newAssignment });
        // Add to local list so we can track updates
        classTeachers.Add(newAssignment);
        Snackbar.Add("Class teacher assignment saved.", Severity.Success);

    }

}