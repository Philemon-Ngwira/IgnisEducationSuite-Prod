@page "/clinic-staff"
@using EDUSphereSharedProject.IdentiyModels
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.UniversalModels
@using IgnisEducationSuite.Client.Pages.Management.Dialog
@using MudBlazor
@inherits AppBaseComponent
@inject IDialogService DialogService
<MudStack Spacing="4" Class="pa-6">

    <!-- Page Header -->
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h4" Class="fw-bold">
                Clinic Staff Directory
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Nurses, doctors, and counseling personnel
            </MudText>
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenStaffAddDialog">
            Add Medical Staff
        </MudButton>
    </MudStack>
    @if (clinicStaff.Any())
    {
        <!-- Staff Grid -->
        <MudGrid Spacing="3">

            @foreach (var staff in clinicStaff)
            {
                <!-- Staff Card -->
                <MudItem xs="12" sm="6" lg="4">
                    <MudPaper Elevation="1" Class="pa-5 rounded-xl d-flex gap-4">

                        <!-- Avatar -->
                        <MudAvatar Size="Size.Medium"
                                   Variant="Variant.Filled"
                                   Color="Color.Success">
                            <MudIcon Icon="@Icons.Material.Filled.MedicalServices" />
                        </MudAvatar>

                        <!-- Details -->
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.h6" Class="fw-bold">
                                @staff.FullName
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Color="Color.Success"
                                     Class="fw-medium mb-2">
                                @staff.Role
                            </MudText>

                            <MudStack Spacing="1">

                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.Phone"
                                             Size="Size.Small"
                                             Class="me-1" />
                                    @staff.Contact
                                </MudText>


                            </MudStack>
                            <!-- Actions -->
                            <MudDivider />

                            <MudStack Row Spacing="1" Class="pa-2">
                                <MudButton FullWidth Variant="Variant.Text" Color="Color.Default" OnClick="() => OpenStaffManageDialog(staff)">
                                    View Profile
                                </MudButton>
                            </MudStack>
                        </div>

                    </MudPaper>
                </MudItem>

            }

        </MudGrid>
    }
    else
    {
        <!-- Empty State -->
        <MudPaper Elevation="0"
                  Class="pa-10 mt-4 rounded-xl text-center border-dashed"
                  Style="border:2px dashed var(--mud-palette-divider)">

            <MudIcon Icon="@Icons.Material.Filled.MedicalServices"
                     Size="Size.Large"
                     Color="Color.Dark" />

            <MudText Typo="Typo.h6" Class="mt-2">
                No clinic staff assigned
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Add nurses, doctors, or counselors to manage clinic operations
            </MudText>

        </MudPaper>
    }
</MudStack>


@code {
    protected List<ClinicStaff> clinicStaff = new();



    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait...");
        await GetClinicStaff();
        LoaderService.Hide();
    }

    protected async Task<IEnumerable<Clinic>> GetClinics()
    {
        var service = GenericService.GetService<Clinic>();
        var result = await service.GetAllAsync($"api/Dynamic/GetSchoolClinics/{AppState.SchoolID}", true);
        if (result.IsSuccess)
        {
            return result.Data.ToList();
        }
        return new List<Clinic>();
    }
    protected async Task GetClinicStaff()
    {
        var serv = GenericService.GetService<ClinicStaff>();
        var res = await serv.GetAllAsync($"api/Dynamic/GetClinicStaffBySchool/{Guid.Parse(AppState.SchoolID)}", true);
        if (res.IsSuccess)
        {
            clinicStaff = res.Data.ToList();
        }
    }
    protected async Task OpenStaffAddDialog()
    {
        var parameters = new DialogParameters<CreateGenericStaff>
    {
        { x => x.roleName, "Clinic Staff" },
        { x => x.Clinics, await GetClinics()},

    };

        var dialog = await DialogService.ShowAsync<CreateGenericStaff>("Create New Staff", parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is ClinicStaff newStaff)
        {

            Snackbar.Add($"User {newStaff.FullName} created successfully!", Severity.Success);

            clinicStaff.Add(newStaff);
            LoaderService.Hide();
            StateHasChanged();

        }
    }
    protected async Task OpenStaffManageDialog(ClinicStaff clinicStaff)
    {
        GenericStaffDTO staffDTO = new();
        ApplicationUser user = new();
        user = await GetUserInformation(clinicStaff.UserID);
        staffDTO.ClinicStaff = clinicStaff;
        staffDTO.ActiveType = StaffType.Clinic;
        var parameters = new DialogParameters<ManageGenericStaff>
    {
        { x => x.staffDTO, staffDTO },
        { x => x.Clinics, await GetClinics()},
        {x=>x.applicationUser, user }

    };

        var dialog = await DialogService.ShowAsync<ManageGenericStaff>($"Update {clinicStaff.FullName} Information", parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is true)
        {

            await GetClinicStaff();
            LoaderService.Hide();
            StateHasChanged();

        }
    }
}
