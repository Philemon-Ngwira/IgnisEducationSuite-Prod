@page "/MedicalInventory"
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.UniversalModels
@inherits AppBaseComponent

<MudCard Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Align="Align.Left">Clinic Inventory Management</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudPaper Class="p-4 mb-4" Elevation="1">
            <MudAlert Variant="Variant.Filled" Severity="Severity.Normal" NoIcon="true" Class="mb-3">
                Clinic Inventory Management
            </MudAlert>

            <MudTabs Elevation="4" Rounded="true" Centered="true" Color="@Color.Primary">

                <MudTabPanel Icon="@MaterialDesignIcons.Normal.MedicalBag" Text="Add New Stock In Bulk">

                    <!-- Section: Bulk Upload Users -->
                    <MudCard Class="mb-4 p-4" Elevation="4">
                        <MudCardHeader>
                            <MudText Typo="Typo.h5" Align="Align.Center"><b>Bulk Upload Inventory</b></MudText>
                        </MudCardHeader>

                        <MudDivider Class="my-2" />
                        <MudPaper>
                            <MudStepper @bind-ActiveIndex="_index" CompletedStepColor="Color.Success" CurrentStepColor="Color.Primary" NavClass="border-b mud-border-lines-default" StepClass="pt-4" ShowResetButton>
                                <TitleTemplate>@*This empty template prevents rendering the title*@</TitleTemplate>
                                <ConnectorTemplate Context="step">
                                    <div class="mud-stepper-nav-connector">
                                        @{
                                            int value = step.Completed ? 100 : 0;
                                            <MudProgressLinear Indeterminate="@(step.IsActive)" Striped Value="value" Min="0" Max="100" Color="Color.Success" Style="height: 2px; background-color: #d4ddeb; border-radius: 2px;" />
                                        }
                                    </div>
                                </ConnectorTemplate>
                                <LabelTemplate>
                                    @if (context.IsActive)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="context.Completed? Color.Success: Color.Primary"></MudIcon>
                                    }
                                    else if (context.Completed)
                                    {
                                        <div style="height: 10px; width:10px; background-color: var(--mud-palette-success); border-radius: 50%;"></div>
                                    }
                                    else
                                    {
                                        <div style="height: 10px; width:10px; background-color: #d4ddeb; border-radius: 50%;"></div>
                                    }
                                </LabelTemplate>
                                <ChildContent>
                                    <MudStep Title="Download Template">
                                        Cheklist Step 1: Download Inventory Template
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">

                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DownloadTemplate">
                                                Download Inventory Template
                                            </MudButton>

                                        </MudStack>
                                    </MudStep>
                                    <MudStep Title="Upload Inventory" Skippable="false">
                                        Checklist Step 2: Upload Bulk Inventory
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                            <MudFileUpload T="IBrowserFile" FilesChanged="UploadTemplateFile">
                                                <ActivatorContent>
                                                    <MudButton Variant="Variant.Filled"
                                                               Color="Color.Primary"
                                                               StartIcon="@Icons.Material.Filled.UploadFile">
                                                        Bulk upload Inventories
                                                    </MudButton>
                                                </ActivatorContent>
                                            </MudFileUpload>
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(!selectedFileReady)" OnClick="ConfirmUpload">
                                                Confirm Upload
                                            </MudButton>
                                        </MudStack>
                                    </MudStep>
                                    <MudStep Title="Review Data">
                                        Checklist Step 3: Review and Make sure everything is correct

                                    </MudStep>
                                    <MudStep Title="Complete Process" @bind-Completed="_completed">Checklist Final Step: Complete Inventory Upload Process</MudStep>
                                </ChildContent>
                                <CompletedContent>
                                    <MudStack Row Class="ma-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Done" Color="Color.Success" />
                                        <MudText>
                                            Process Completed! All Invetory has been added to schools Inventory
                                        </MudText>
                                    </MudStack>
                                </CompletedContent>
                                <ActionContent Context="stepper">
                                    <MudButton OnClick="@(() => stepper.ResetAsync())">Reset</MudButton>
                                    @if (!_completed)
                                    {
                                        <MudIconButton OnClick="@(() => stepper.PreviousStepAsync())" Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" Disabled="@(_index <= 0)" />
                                        <MudSpacer />
                                        @if (stepper.Steps[_index].Skippable == true)
                                        {
                                            <MudIconButton OnClick="@(() => stepper.SkipCurrentStepAsync())" Icon="@stepper.SkipButtonIcon" Color="Color.Primary" />
                                        }
                                        <MudIconButton OnClick="@(() => stepper.NextStepAsync())" Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" />
                                    }
                                </ActionContent>
                            </MudStepper>
                        </MudPaper>


                    </MudCard>


                </MudTabPanel>
                <MudTabPanel Icon="@MaterialDesignIcons.Normal.Medication" Text="Add New Stock Individually">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudAlert Variant="Variant.Filled" Severity="Severity.Normal" NoIcon="true" Class="mb-3">
                                Fill in all required information
                            </MudAlert>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          @bind-Value="newIndividualItem.Name"
                                          Label="Medication Name"
                                          Placeholder="Enter Medication Name"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined">
                            </MudTextField>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="newIndividualItem.Stock"
                                          Label="Stock"
                                          Placeholder="Enter Stock"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined">
                            </MudTextField>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          @bind-Value="newIndividualItem.Unit"
                                          Label="Unit"
                                          Placeholder="Enter Unit Of Measurement i.e mg"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined">
                            </MudTextField>
                        </MudItem>
                        @*  <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          @bind-Value="newIndividualItem.batchNumber"
                                          Label="Batch Number"
                                          Placeholder="Enter Bacth Number"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined">
                            </MudTextField>
                        </MudItem> *@
                        @* <MudItem xs="12" md="6">
                            <MudDatePicker @bind-Date="newIndividualItem.Expiry Date"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                            </MudDatePicker>
                        </MudItem> *@

                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled"
                                       StartIcon="@MaterialDesignIcons.Outline.ContentSave">
                                Save New Medical Item
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Icon="@MaterialDesignIcons.Normal.HospitalBuilding" Text="Manage Existing Stock">

                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudCardContent>
</MudCard>


@code {

    IList<IBrowserFile> _files = new List<IBrowserFile>();
    bool selectedFileReady = false;
    private int _index;
    private bool _completed;

    protected List<ClinicMedication> uploadedMeds = new();
    protected List<string> uploadErrors = new();
    protected ClinicMedication newIndividualItem = new();
    private async Task DownloadTemplate()
    {

        LoaderService.Show("Preparing download...");
        var path = "api/Templates/DownloadClinicInventoryTemplate";
        var fileName = "MedicalInventory_Upload_Template.xlsx";

        var response = await HttpClient.GetAsync(path);

        if (response.IsSuccessStatusCode)
        {
            // Read the file content as a byte array
            var fileBytes = await response.Content.ReadAsByteArrayAsync();

            // Get file name from response header if present, fallback to default
            if (response.Content.Headers.ContentDisposition != null)
            {
                fileName = response.Content.Headers.ContentDisposition.FileName.Trim('"');
            }

            // Use JSInterop to trigger the browser download
            await JS.InvokeVoidAsync("BlazorDownloadFile", fileName, fileBytes);
        }
        else
        {
            // Handle error (optional)
            Console.WriteLine("Failed to download template: " + response.StatusCode);
        }
        LoaderService.Hide();
    }
    private async Task ConfirmUpload()
    {

    }

    private async Task UploadTemplateFile(IBrowserFile file)
    {
        if (file == null || file.Size == 0) return;

        LoaderService.Show("Validating file, please wait...");

        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(fileContent, "file", file.Name);

            var response = await HttpClient.PostAsync("api/upload/uploadMedicine", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadPreviewResult>();

                if (result != null)
                {
                    uploadedMeds = result.Medications;
                    uploadErrors = result.Errors
                        .Select(e => $"Row {e.RowIndex}: {e.Message}")
                        .ToList();

                    selectedFileReady = true;
                }
            }
            else
            {
                uploadErrors.Add("Failed to upload Template file.");
            }
        }
        catch (Exception ex)
        {
            uploadErrors.Add($"Error uploading Template file: {ex.Message}");
        }
        finally
        {
            LoaderService.Hide();
            StateHasChanged();
        }
    }
}
