@page "/BusStaffManagement"
@using EDUSphereSharedProject.Models
@using IgnisEducationSuite.Client.Pages.Management.Dialog
@inherits AppBaseComponent
@inject IDialogService DialogService
<MudStack Spacing="4">

    <!-- Header -->
    <MudPaper Elevation="1" Class="pa-6 rounded-xl">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5" Class="fw-bold">Staff Management</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Manage drivers, attendants, and compliance certifications.
                </MudText>
            </div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd">
                Add Staff
            </MudButton>
        </MudStack>
    </MudPaper>

    <!-- Tabs -->
    <MudTabs Rounded="true" Elevation="0" Color="Color.Primary">
        <MudTabPanel Text="@DriversCount">
            @if (busStaff.Any())
            {
                <!-- Drivers Grid -->
                <MudGrid Spacing="3">
                    @foreach (var item in busStaff)
                    {
                        @* Driver Card *@
                        <MudItem xs="12" sm="6" lg="4">
                            <MudPaper Elevation="1" Class="rounded-xl overflow-hidden">

                                <!-- Card Header -->
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-4">
                                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                        <MudAvatar Size="Size.Medium" Color="Color.Surface">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                                        </MudAvatar>

                                        <div>
                                            <MudText Class="fw-bold">@item.FirstName @item.LastName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Driver
                                            </MudText>
                                        </div>
                                    </MudStack>
                                    @if (item.IsActive == true)
                                    {
                                        <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
                                            ACTIVE
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Dark" Variant="Variant.Outlined" Size="Size.Small">
                                            DE-ACTIVE
                                        </MudChip>
                                    }
                                </MudStack>

                                <!-- Contact Info -->
                                <MudDivider />

                                <MudStack Spacing="1" Class="pa-4" Style="background:#fafafa">
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="me-1" />
                                        @item.PhoneNumber
                                    </MudText>

                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="me-1" />
                                        Lic: <span class="mud-typography-caption">@item.LicenseNumber</span>
                                    </MudText>
                                </MudStack>

                                <!-- Details -->
                                <MudStack Spacing="3" Class="pa-4">

                                    <!-- License Expiry -->
                                    <div>
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.caption" Class="fw-bold">
                                                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="me-1" />
                                                License Expiry
                                            </MudText>

                                            <MudText Typo="Typo.caption" Color="Color.Error" Class="fw-bold">
                                                @item.LicenseExpiryDate.Value.ToShortDateString()
                                            </MudText>
                                        </MudStack>
                                        @if ((item.LicenseExpiryDate.Value - DateTime.Today).Days <= 30)
                                        {
                                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">
                                                Renewal required soon
                                            </MudAlert>
                                        }
                                    </div>

                                    <!-- Certifications -->
                                    <div>
                                        <MudText Typo="Typo.caption" Class="fw-bold mb-1">
                                            Certifications
                                        </MudText>

                                        <MudStack Row Spacing="1">
                                            @foreach (var certifcate in item.Certifications)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                    <MudIcon Icon="@MaterialDesignIcons.Normal.Certificate" Size="Size.Small" Class="me-1" />
                                                    @certifcate
                                                </MudChip>
                                            }
                                        </MudStack>
                                    </div>

                                </MudStack>

                                <!-- Actions -->
                                <MudDivider />

                                <MudStack Row Spacing="1" Class="pa-2">
                                    <MudButton FullWidth Variant="Variant.Text" Color="Color.Default">
                                        View Profile
                                    </MudButton>
                                    <MudButton FullWidth Variant="Variant.Text" Color="Color.Primary">
                                        Edit Shift
                                    </MudButton>
                                </MudStack>

                            </MudPaper>
                        </MudItem>

                    }


                </MudGrid>
            }
        </MudTabPanel>

        <!-- Attendants Tab -->
        <MudTabPanel Text="Attendants / Helpers (8)">

            <MudPaper Elevation="1" Class="rounded-xl">

                @* <MudTable T="string" Dense="true" Hover="true">

                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Contact</MudTh>
                        <MudTh>Certification</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd>
                            <MudText Class="fw-medium">Sarah Collins</MudText>
                        </MudTd>

                        <MudTd>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                +1 555-991-2211
                            </MudText>
                        </MudTd>

                        <MudTd>
                            <MudChip Color="Color.Success" Size="Size.Small">
                                CPR
                            </MudChip>
                        </MudTd>

                        <MudTd>
                            <MudStack Row AlignItems="center" Spacing="1">
                                <MudBadge Color="Color.Primary" Dot="true" />
                                <MudText Typo="Typo.body2">Assigned</MudText>
                            </MudStack>
                        </MudTd>

                        <MudTd>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">
                                Manage
                            </MudButton>
                        </MudTd>
                    </RowTemplate>

                </MudTable> *@

            </MudPaper>

        </MudTabPanel>
    </MudTabs>

</MudStack>
@code {
    protected List<BusStaff> busStaff = new();
    protected string DriversCount = "";
    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait...");
        await GetBusStaffAsync();
        LoaderService.Hide();
    }

    protected async Task GetBusStaffAsync()
    {
        var serv = GenericService.GetService<BusStaff>();
        var result = await serv.GetAllAsync($"api/Dynamic/GetTransportStaffBySchool{Guid.Parse(AppState.SchoolID)}", true);
        if (result.IsSuccess)
        {
            busStaff = result.Data.ToList();
            DriversCount = $"Drivers ({busStaff.Count})";
            StateHasChanged();
        }
    }
    protected async Task OpenStaffAddDialog()
    {
        var parameters = new DialogParameters<CreateGenericStaff>
    {
        { x => x.roleName, "TransportStaff" }
    };

        var dialog = await DialogService.ShowAsync<CreateGenericStaff>("Create New Dean", parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is BusStaff newStaff)
        {
            Snackbar.Add($"User {newStaff.FirstName} created successfully!", Severity.Success);
            busStaff.Add(newStaff);
            LoaderService.Hide();
            StateHasChanged();

        }
    }
}