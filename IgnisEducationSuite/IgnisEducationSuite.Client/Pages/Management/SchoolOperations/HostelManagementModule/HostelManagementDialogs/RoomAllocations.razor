@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@inherits AppBaseComponent
@inject IDialogService DialogService
<MudDialog>
    <DialogContent>

        @if (isLoading)
        {
            <div class="loader-overlay">
                <div class="spinner-container">
                    <div class="spinner"></div>
                    <p class="loading-text">Loading, please wait...</p>
                </div>
            </div>
        }

        <MudText Typo="Typo.h6" Class="mb-3">Room Allocation - @RoomNumber</MudText>

        <!-- Beds Grid -->
        <MudGrid Spacing="2" Class="mb-4 justify-center">
            @for (int i = 0; i < MaxOccupancy; i++)
            {
                int bedIndexCopy = i;
                var slot = BedSlots.ElementAtOrDefault(i);
                bool isTaken = slot != null;

                <MudItem xs="4" sm="3" Class="d-flex flex-column align-center">
                    <MudTooltip Text="@(isTaken ? $"{slot.FirstName} {slot.LastName} (Bed {i + 1})" : "Empty Bed")">
                        <MudButton Disabled="@isLoading"
                                   Color="@(isTaken ? Color.Error : Color.Success)"
                                   Variant="Variant.Filled"
                                   Class="d-flex flex-column align-center"
                                   OnClick="() => BedClicked(bedIndexCopy)">
                            <MudIcon Icon="@MaterialDesignIcons.Normal.Bed" Size="Size.Large" />
                            <MudText Typo="Typo.caption">
                                @(isTaken ? $"{slot.FirstName} {slot.LastName}" : $"Bed {i + 1}")
                            </MudText>
                        </MudButton>
                    </MudTooltip>
                </MudItem>
            }
        </MudGrid>

        <!-- Student Selection -->
        @if (!ShowOccupantsList)
        {
            <MudAutocomplete T="StudentsWithoutRoomDTO"
                             Label="Students To Allocate"
                             @bind-Value="SelectedStudentWithoutRoom"
                             SearchFunc="@SearchStudents"
                             ResetValueOnEmptyText="true"
                             CoerceText="true" CoerceValue="true"
                             SelectValueOnTab="true"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             AdornmentColor="Color.Primary"
                             Class="mb-3"
                             ToStringFunc="StudentTypeconverter"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense" />
        }

        <!-- Occupants List -->
        @if (ShowOccupantsList)
        {
            <MudPaper Class="p-3 mb-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Students in this room:</MudText>

                @if (Occupants.Any())
                {
                    @foreach (var slot in Occupants)
                    {
                        <MudGrid Class="align-center mb-1">
                            <MudItem xs="8">
                                <MudText><b>Bed @((Array.IndexOf(BedSlots, slot) + 1)):</b> @slot.FirstName @slot.LastName</MudText>
                                <MudText Typo="Typo.caption">Student#: @slot.StudentNumber</MudText>
                            </MudItem>
                            <MudItem xs="4" Class="d-flex justify-end">
                                <MudButton Color="Color.Error"
                                           Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           OnClick="() => CheckOutStudent(slot)">
                                    Check Out
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2"><i>No occupants in this room</i></MudText>
                }

                <div class="mt-2">
                    <MudButton Variant="Variant.Text" OnClick="() => ShowOccupantsList = false">Close</MudButton>
                </div>
            </MudPaper>
        }

    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="MudDialog.Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAllocations">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid RoomID { get; set; }
    [Parameter] public string RoomNumber { get; set; } = "";
    [Parameter] public int MaxOccupancy { get; set; }
    [Parameter] public Guid GenderID { get; set; }
    [Parameter] public string RoomGender { get; set; } = "";
    private List<StudentsWithoutRoomDTO> StudentsWithoutRoom = new();
    private List<RoomAsset> roomAssets = new();
    private List<StudentsInRoomDTO> Occupants = new();
    private StudentsInRoomDTO?[] BedSlots = Array.Empty<StudentsInRoomDTO?>();
    private StudentsWithoutRoomDTO? SelectedStudentWithoutRoom { get; set; }
    private bool ShowOccupantsList { get; set; } = false;
    private bool isLoading = false;

    protected Func<StudentsWithoutRoomDTO, string> StudentTypeconverter = p => $"{p?.FirstName} {p?.LastName}";
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        StateHasChanged();

        await Task.WhenAll(LoadStudentsWithoutRoom(), LoadRoomOccupants());

        if (BedSlots.Length != MaxOccupancy)
            BedSlots = new StudentsInRoomDTO?[MaxOccupancy];

        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadStudentsWithoutRoom()
    {
        var service = GenericService.GetService<StudentsWithoutRoomDTO>();
        var result = await service.GetAllAsync($"api/Dynamic/GetStudentsWithoutRoomByGender/{GenderID}/{AppState.SchoolID}", true);
        if (result.IsSuccess) StudentsWithoutRoom = result.Data.ToList();
    }

    private async Task LoadRoomOccupants()
    {
        var service = GenericService.GetService<StudentsInRoomDTO>();
        var result = await service.GetAllAsync($"api/Dynamic/GetStudentsInRoom/{RoomID}", true);

        Occupants = result.IsSuccess ? result.Data.OrderBy(r => r.CheckInDate).ToList() : new List<StudentsInRoomDTO>();
        BedSlots = new StudentsInRoomDTO?[MaxOccupancy];

        for (int i = 0; i < Occupants.Count && i < MaxOccupancy; i++)
            BedSlots[i] = Occupants[i];

        if (Occupants.Count > MaxOccupancy)
            Snackbar.Add($"Warning: {Occupants.Count} occupants found but MaxOccupancy is {MaxOccupancy}.", Severity.Warning);
    }

    private async Task<IEnumerable<StudentsWithoutRoomDTO>> SearchStudents(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value)) return StudentsWithoutRoom;
        return StudentsWithoutRoom.Where(s =>
            s.FirstName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            s.LastName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            s.StudentNumber.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    protected async Task GetRoomAssets()
    {
        var service = GenericService.GetService<RoomAsset>();
        var result = await service.GetAllAsync($"api/Dynamic/GetRoomAssets/{RoomID}", true);
        if (result.IsSuccess)
        {
            roomAssets = result.Data.ToList();
        }
    }
    private async Task BedClicked(int bedIndex)
    {
        if (isLoading) return;
        if (bedIndex < 0 || bedIndex >= MaxOccupancy) return;

        var slot = BedSlots[bedIndex];

        // If bed is taken, just show occupants
        if (slot != null)
        {
            ShowOccupantsList = true;
            return;
        }

        if (SelectedStudentWithoutRoom == null)
        {
            Snackbar.Add("Select a student from the list to allocate to this bed.", Severity.Info);
            return;
        }

        bool isFirstOccupant = Occupants.Count == 0;

        // 1️⃣ Allocate student in UI FIRST (so bed turns red immediately)
        var newOccupant = new StudentsInRoomDTO
        {
            AllocationId = Guid.Empty,
            StudentID = SelectedStudentWithoutRoom.StudentID,
            FirstName = SelectedStudentWithoutRoom.FirstName,
            LastName = SelectedStudentWithoutRoom.LastName,
            StudentNumber = SelectedStudentWithoutRoom.StudentNumber,
            GenderDescription = SelectedStudentWithoutRoom.GenderDescription,
            CheckInDate = DateTime.UtcNow
        };

        BedSlots[bedIndex] = newOccupant;
        Occupants.Add(newOccupant);
        StudentsWithoutRoom.Remove(SelectedStudentWithoutRoom);
        SelectedStudentWithoutRoom = null;

        // 🔴 Force UI refresh so bed color updates BEFORE async work
        StateHasChanged();

        StudentRoomLog? studentRoomLog = null;

        // 2️⃣ Create room log ONLY if first occupant
        if (isFirstOccupant)
        {
            studentRoomLog = new StudentRoomLog
            {
                StudentId = newOccupant.StudentID,
                RoomId = RoomID,
                CheckInDate = DateTime.UtcNow,
                CheckedInByStaffId = Guid.Parse(AppState.UserID),
                OccupancyType = "Allocated",
                Status = "Active"
            };

            var logService = GenericService.GetService<StudentRoomLog>();
            var logResult = await logService.PostAsync(
                "api/Dynamic/PostEntity",
                "studentroomlog",
                studentRoomLog
            );

            if (!logResult.IsSuccess)
            {
                Snackbar.Add("Failed to create room log.", Severity.Error);
                return;
            }

            studentRoomLog = logResult.Data;

            // 3️⃣ Capture initial room asset condition
            await GetRoomAssets();

            var parameters = new DialogParameters<RoomAssetConditionModal>
        {
            { x => x.RoomID, RoomID },
            { x => x.RoomNumber, RoomNumber },
            { x => x.StudentRoomLogId, studentRoomLog.Id },
            { x => x.StaffId, Guid.Parse(AppState.UserID) },
            { x => x.IsCheckIn, true }
        };

            var options = new DialogOptions
            {
                CloseOnEscapeKey = true,
                BackdropClick = false,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true
            };

            var dialog = DialogService.Show<RoomAssetConditionModal>(
                "Room Asset Condition",
                parameters,
                options
            );

            await dialog.Result;
        }

        Snackbar.Add($"{newOccupant.FirstName} allocated to bed {bedIndex + 1}.", Severity.Success);
    }

    private StudentsWithoutRoomDTO MapToWithoutRoom(StudentsInRoomDTO student) => new()
    {
        StudentID = student.StudentID,
        FirstName = student.FirstName,
        LastName = student.LastName,
        StudentNumber = student.StudentNumber,
        GenderDescription = student.GenderDescription
    };

    private RoomAllocation MapToRoomAllocation(StudentsInRoomDTO student, string status)
        => new()
        {
            AllocationId = student.AllocationId != Guid.Empty ? student.AllocationId : Guid.NewGuid(),
            RoomId = RoomID,
            StudentId = student.StudentID,
            CheckInDate = student.CheckInDate != default ? student.CheckInDate : DateTime.UtcNow,
            CheckOutDate = status == "Deactive" ? DateTime.UtcNow : null,
            Status = status
        };

    private async Task<StudentRoomLog?> GetRoomLogByID()
    {
        var service = GenericService.GetService<StudentRoomLog>();
        var result = await service.GetByIdAsync("api/Dynamic/GetActiveRoomLog", RoomID);
        if (!result.IsSuccess)
        {
            return null;
        }
        return result.Data;
    }
    private async Task CheckOutStudent(StudentsInRoomDTO student)
    {
        int slotIndex = Array.FindIndex(BedSlots, s => s != null && s.StudentID == student.StudentID);
        if (slotIndex >= 0) BedSlots[slotIndex] = null;

        Occupants.RemoveAll(x => x.StudentID == student.StudentID);
        StudentsWithoutRoom.Add(MapToWithoutRoom(student));

        bool isLastOccupantLeaving = Occupants.Count == 0;

        // ✅ Update StudentRoomLog as well
        var studentRoomLog = await GetRoomLogByID();
        var LogID = Guid.Empty;
        if (studentRoomLog != null)
        {
            var logService = GenericService.GetService<StudentRoomLog>();
            studentRoomLog.CheckOutDate = DateTime.UtcNow;
            studentRoomLog.CheckedOutByStaffId = Guid.Parse(AppState.UserID);
            studentRoomLog.Status = "Closed";
            var logResult = await logService.UpdateAsync("api/Dynamic/UpdateEntity", "studentroomlog", studentRoomLog);
            if (!logResult.IsSuccess)
            {
                Snackbar.Add("Failed to update room log. Cannot allocate student.", Severity.Error);
                return;

            }
            LogID = logResult.Data.Id;
            if (isLastOccupantLeaving)
            {
                await GetRoomAssets();
                var parameters = new DialogParameters<RoomAssetConditionModal>
        {
            { x => x.RoomID, RoomID },
            { x => x.RoomNumber, RoomNumber },
            { x => x.StudentRoomLogId, LogID },
            { x => x.StaffId, Guid.Parse(AppState.UserID) },
            { x => x.IsCheckIn, false }
        };

                var options = new DialogOptions
                {
                    CloseOnEscapeKey = true,
                    BackdropClick = false,
                    MaxWidth = MaxWidth.Medium,
                    FullWidth = true
                };
                var dialog = DialogService.Show<RoomAssetConditionModal>("Room Asset Condition", parameters, options);
                await dialog.Result;
            }

            var allocationToUpdate = MapToRoomAllocation(student, "Deactive");
            var service = GenericService.GetService<RoomAllocation>();
            var result = await service.UpdateAsync("api/Dynamic/UpdateEntity", "roomallocation", allocationToUpdate);

            if (!result.IsSuccess)
            {
                if (slotIndex >= 0) BedSlots[slotIndex] = student;
                Occupants.Add(student);
                StudentsWithoutRoom.RemoveAll(s => s.StudentID == student.StudentID);
                Snackbar.Add("Failed to check out student. Please try again.", Severity.Error);
            }
            else
            {
                Snackbar.Add($"Checked out {student.FirstName} {student.LastName}.", Severity.Success);
            }

        }


    }

    private async Task SaveAllocations()
    {
        var newAllocations = Occupants
            .Where(s => s.AllocationId == Guid.Empty)
            .Select(s => MapToRoomAllocation(s, "Active"))
            .ToList();

        if (!newAllocations.Any())
        {
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        var service = GenericService.GetService<List<RoomAllocation>>();
        var result = await service.PostAsync("api/Dynamic/PostEntities", "roomallocation", newAllocations);

        if (result.IsSuccess)
        {
            MudDialog.Close(DialogResult.Ok(true));
            Snackbar.Add("Allocations saved.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to save new allocations. Please try again.", Severity.Error);
        }
    }
}
