@page "/Deans"
@page "/hostel-staff"
@using EDUSphereSharedProject.IdentiyModels
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.UniversalModels
@using IgnisEducationSuite.Client.Pages.Management.Dialog
@inherits AppBaseComponent
@inject IDialogService DialogService
<MudStack Spacing="4" Class="pa-6">

    <!-- Page Header -->
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h4" Class="fw-bold">
                Staff Directory
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Deans, wardens, and hostel supervisory staff
            </MudText>
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="OpenStaffAddDialog">
            Add Staff
        </MudButton>
    </MudStack>

    @if (DeanStaff.Any())
    {
        <!-- Staff Grid -->
        <MudGrid Spacing="3">
            @foreach (var item in DeanStaff)
            {
                @* Staff Card *@
                <MudItem xs="12" sm="6" lg="4">
                    <MudPaper Elevation="1" Class="pa-5 rounded-xl d-flex gap-4">

                        <!-- Icon -->
                        <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" />
                        </MudAvatar>

                        <!-- Content -->
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.h6" Class="fw-bold">
                                @item.StaffName
                            </MudText>

                            <MudText Typo="Typo.body2" Color="Color.Warning" Class="fw-medium mb-2">
                                @if (item.DeanForGenderNavigation.GenderDescription == "Male")
                                {
                                    @("Dean of Boys")
                                }
                                else
                                {
                                    @("Dean of Girls")

                                }
                            </MudText>

                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="me-1" />
                                    @item.Email
                                </MudText>

                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="me-1" />
                                    @item.PhoneNumber
                                </MudText>


                            </MudStack>
                            <!-- Actions -->
                            <MudDivider />

                            <MudStack Row Spacing="1" Class="pa-2">
                                <MudButton FullWidth Variant="Variant.Text" Color="Color.Default" OnClick="() => OpenStaffManageDialog(item)">
                                    View Profile
                                </MudButton>
                            </MudStack>
                        </div>

                    </MudPaper>
                </MudItem>

            }

        </MudGrid>
    }
    else
    {
        <!-- Empty State -->
        <MudPaper Elevation="0"
                  Class="pa-10 mt-4 rounded-xl text-center border-dashed"
                  Style="border:2px dashed var(--mud-palette-divider)">

            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts"
                     Size="Size.Large"
                     Color="Color.Dark" />

            <MudText Typo="Typo.h6" Class="mt-2">
                No hostel staff assigned
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Add deans or wardens to manage hostel operations
            </MudText>

        </MudPaper>
    }
</MudStack>

@code {
    protected List<Staff> DeanStaff = new();
    protected List<Gender> genders = new();
    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait...");
        await GetGenders();
        var s = await GetStaffAsync("Dean");
        if (s != null)
        {
            DeanStaff = s.ToList();
            foreach (var item in DeanStaff)
            {
                item.DeanForGenderNavigation = genders.Where(x => x.GenderId == item.DeanForGender).First();
            }
        }
        LoaderService.Hide();
    }
    protected async Task GetGenders()
    {
        var result = GenericService.GetService<Gender>();
        var service = await result.GetAllAsync($"api/Dynamic/GetEntity/{"genders"}", true);
        genders = service.Data.ToList();

    }
    protected async Task OpenStaffAddDialog()
    {
        var parameters = new DialogParameters<CreateGenericStaff>
    {
        { x => x.roleName, "Dean" },
        { x => x.genders, genders },
    };

        var dialog = await DialogService.ShowAsync<CreateGenericStaff>("Create New Dean", parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Staff newStaff)
        {
            Snackbar.Add($"User {newStaff.Email} created successfully!", Severity.Success);
            newStaff.DeanForGenderNavigation = genders.Where(x => x.GenderId == newStaff.DeanForGender).First();
            DeanStaff.Add(newStaff);
            LoaderService.Hide();
            StateHasChanged();

        }
    }
    protected async Task OpenStaffManageDialog(Staff staff)
    {
        ApplicationUser user = new();
        user = await GetUserInformation(staff.UserID);
        GenericStaffDTO genericStaff = new();
        genericStaff.Staff = staff;
        genericStaff.ActiveType = StaffType.General;
        var parameters = new DialogParameters<ManageGenericStaff>
    {
        { x => x.staffDTO, genericStaff },
        { x => x.genders, genders },
        {x=>x.applicationUser, user }
    };

        var dialog = await DialogService.ShowAsync<ManageGenericStaff>($"Update {staff.StaffName} Information", parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is true)
        {
            await GetStaffAsync("Dean");
            LoaderService.Hide();
            StateHasChanged();

        }
    }
}
