@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@inherits AppBaseComponent
<MudDialog >
    <DialogContent>

        <MudText Class="mb-4" Align="Align.Center" Typo="Typo.h4"><b>Manage Student Details</b></MudText>

        <MudGrid GutterSize="3">
            <!-- Profile Picture -->
            <MudItem xs="12" Class="d-flex justify-center mb-3">
                @if (selectedStudent.ProfilePic == null)
                {
                    <MudImage Height="250" Src="@(selectedStudent.Gender == "Male" ? "images/Avatar/Man.png" : "images/Avatar/Woman.png")" Class="profile-pic" />
                }
                else
                {
                    <MudImage Class="profile-pic" Width="250"
                              Src="@($"data:image/jpeg;base64,{Convert.ToBase64String(selectedStudent.ProfilePic)}")" />
                }
            </MudItem>

            <!-- Basic Info -->
            <MudItem xs="12" md="6">
                <MudText>First Name: <b>@selectedStudent.FirstName</b></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText>Last Name: <b>@selectedStudent.LastName</b></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText>Grade: <b>@selectedStudent.AcademicLevel</b></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText>Student ID: <b>@(selectedStudent.StudentNumber ?? "Not Found")</b></MudText>
            </MudItem>

            <!-- Editable Fields -->
            <MudItem xs="12" md="6">
                <MudSelect Variant="Variant.Outlined" T="int?" Label="Change Academic Level" @bind-Value="selectedStudent.AcademicLevel">
                    @foreach (var a in academicLevels)
                    {
                        <MudSelectItem T="int?" Value="a.LevelInt">@a.LevelName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect Variant="Variant.Outlined" T="Class" ToStringFunc="ClassTypeconverter"
                           Label="Assign Classes" MultiSelection="true"
                           @bind-Value="value" @bind-SelectedValues="options"
                           Margin="Margin.Dense">
                    @foreach (var c in classes)
                    {
                        <MudSelectItem T="Class" Value="@c">@c.ClassName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Action Buttons -->
            <MudItem xs="12" Class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true" OnClick="CloseDialog">
                    Close
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="ConfirmChanges">
                    Confirm Changes
                </MudButton>
            </MudItem>

            <!-- Assigned Classes Table -->
            <MudItem xs="12">
                <MudAlert Class="mb-3" Severity="Severity.Normal" Variant="Variant.Filled" NoIcon="true">
                    Assigned Classes
                </MudAlert>

                <MudTable Items="@newstudentClasses" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Class Name</MudTh>
                        <MudTh>Teacher</MudTh>
                        <MudTh>Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.ClassID</MudTd>
                        <MudTd DataLabel="Class Name">@context.ClassName</MudTd>
                        <MudTd DataLabel="Teacher">@context.Teacher</MudTd>
                        <MudTd DataLabel="Action">
                            <MudButton Variant="Variant.Filled" Color="Color.Error" EndIcon="@Icons.Material.Filled.Delete">
                                Un-Assign
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>
        </MudGrid>
    </DialogContent>
</MudDialog>

<style>
    .profile-pic {
        border-radius: 12px;
        border: 2px solid #ccc;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        object-fit: cover;
        display: block;
        max-width: 100%;
        transition: box-shadow 0.3s ease;
    }

        .profile-pic:hover {
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }

 
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Student selectedStudent { get; set; } = new();
    [Parameter] public List<Class> classes { get; set; } = new();
    private IEnumerable<Class> options { get; set; } = new HashSet<Class>();
    private Class value { get; set; }
    [Parameter] public List<GetStudentClassInfoResult> newstudentClasses { get; set; } = new();
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    protected async Task ConfirmChanges()
    {
        LoaderService.Show("Please wait...");
        //Save Changes
        //Save Assigned Classes
        var serviceA = _genericService.GetService<List<StudentClass>>();
        List<StudentClass> studentClassesToAdd = new();
        if (options.Any())
        {
            foreach (var item in options)
            {
                StudentClass studentClass = new()
                {
                    StudentClassID = Guid.NewGuid(),
                    StudentID = selectedStudent.StudentID,
                    ClassID = item.ClassID
                };
                studentClassesToAdd.Add(studentClass);
            }


            var savedClasses = await serviceA.PostAsync("api/Dynamic/PostEntities", "studentclasses", studentClassesToAdd);
            if (savedClasses.IsSuccess)
            {
                Snackbar.Add("Classes assigned to student", Severity.Success);
            }
        }
        // Save remaining Changes
        var serviceB = _genericService.GetService<Student>();
        var finalresult = await serviceB.UpdateAsync("api/Dynamic/UpdateEntity", "student", selectedStudent);
        if (finalresult.IsSuccess)
        {
            LoaderService.Hide();
            Snackbar.Add("All Details Successfully Updated", Severity.Success);
            MudDialog.Close(DialogResult.Ok("Successful"));
        }

    }
    private void CloseDialog() => MudDialog.Close();


    #region To String Func

    protected Func<Class, string> ClassTypeconverter = p => p?.ClassName;
    #endregion
}
