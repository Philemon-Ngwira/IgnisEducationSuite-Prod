@using EDUSphereSharedProject.LicensingModel
@using EDUSphereSharedProject.Models

<MudDialog>
    <DialogContent>
        <MudText Class="mb-6" Align="Align.Center" Typo="Typo.h4"><b>Manage @school.SchoolName</b></MudText>
        <MudGrid>
            <MudItem xs="12">
                <MudImage Class="profile-pic" Width="100" Src="@($"data:image/jpeg;base64,{Convert.ToBase64String(school.SchoolLogo)}")"></MudImage>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="school.SchoolName"></MudTextField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
                    <ActivatorContent>
                        <MudFab Color="Color.Secondary"
                                StartIcon="@Icons.Material.Filled.Image"
                                Label="Change School Logo" />
                    </ActivatorContent>
                </MudFileUpload>
            </MudItem>
        </MudGrid>
        <MudDialog @bind-Visible="_nestedVisible">
            <DialogContent>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect @bind-Value="licenseRequest.PlanType" Label="Select License Plan" HelperText="String" Placeholder="Please Select" AdornmentIcon="@Icons.Material.Filled.Subscriptions" AdornmentColor="Color.Primary">
                            <MudSelectItem Value="@("Monthly")">Monthly</MudSelectItem>
                            <MudSelectItem Value="@("Quarterly")">Quarterly</MudSelectItem>
                            <MudSelectItem Value="@("BiAnnual")">BiAnnual</MudSelectItem>
                            <MudSelectItem Value="@("Annual")">Annual</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="licenseRequest.UserLimit" Label="User Limit" Placeholder="0" AdornmentIcon="@Icons.Material.Filled.Numbers"></MudNumericField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="licenseRequest.Email" Label="School Email" AdornmentIcon="@Icons.Material.Filled.ShortText"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="licenseRequest.Phone" Label="School Phone" Placeholder="+260123456789" AdornmentIcon="@Icons.Material.Filled.ShortText"></MudTextField>
                    </MudItem>
                    <MudItem xs="12">
                        <MudDateRangePicker Label="Select License Period" @bind-DateRange="_dateRange" />
                    </MudItem>
                </MudGrid>
            </DialogContent>
            <DialogActions>
                <MudButton Color="Color.Success" OnClick="GenerateLicense">Generate</MudButton>
                <MudButton Color="Color.Primary" OnClick="CloseNested">Close</MudButton>
            </DialogActions>
        </MudDialog>
    </DialogContent>
    <DialogActions>
        <MudButtonGroup OverrideStyles="false">
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="CloseDialog">Close</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.GeneratingTokens" OnClick="OpenNested">Generate and Activate License</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.SaveAlt" OnClick="UpdateDetails">Update</MudButton>
        </MudButtonGroup>
    </DialogActions>
</MudDialog>

@code {































    private MudDateRangePicker _picker;
    private DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);
    private bool _nestedVisible = false;

    private void OpenNested() => _nestedVisible = true;

    private void CloseNested() => _nestedVisible = false;
    [Parameter] public School school { get; set; } = new();
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] HttpClient HttpClient { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    protected ActivateLicenseRequest licenseRequest = new();
    private async Task UploadFiles(IBrowserFile file)
    {

        if (file == null || school == null)
            throw new ArgumentNullException(nameof(file), "File or model cannot be null");

        using (var memoryStream = new MemoryStream())
        {
            await file.OpenReadStream().CopyToAsync(memoryStream);
            school.SchoolLogo = memoryStream.ToArray();
        }
    }

    private void CloseDialog() => MudDialog.Close();
    private async Task GenerateLicense()
    {
        licenseRequest.ClientId = school.SchoolID.ToString();
        licenseRequest.StartDate = _dateRange.Start.Value;
        licenseRequest.EndDate = _dateRange.End.Value;
        licenseRequest.ClientName = school.SchoolName;
        licenseRequest.Application = "IgnisEducationSuite";

        var result = await HttpClient.PostAsJsonAsync("api/Verification/Generate", licenseRequest);
        if (result.IsSuccessStatusCode)
        {
            Snackbar.Add("License Generated Successfully", Severity.Success);
        }
    }
    private async Task UpdateDetails()
    {
        var service = _genericService.GetService<School>();
        var result = await service.UpdateAsync("api/Dynamic/UpdateEntity", "school", school);
        if (result.IsSuccess)
        {
            string Message = "Details Updated Successfully";
            MudDialog.Close(DialogResult.Ok(Message));
        }
    }
}
