@using EDUSphereSharedProject.LicensingModel
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.UniversalModels
@using IgnisEducationSuite.Client.Pages.Management.SuperAdmin.Dialogs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6"><b>Manage @school.SchoolName</b></MudText>
    </TitleContent>

    <DialogContent>
        <MudGrid>
            <MudItem xs="12" class="d-flex align-center gap-4">
                @* Guarded. This used to call Convert.ToBase64String on SchoolLogo unconditionally,
                   so opening a school registered without a logo threw a NullReferenceException and
                   the dialog never rendered. *@
                @if (school.SchoolLogo is { Length: > 0 } logo)
                {
                    <MudImage Class="profile-pic" Width="100"
                              Src="@($"data:image/jpeg;base64,{Convert.ToBase64String(logo)}")" />
                }
                else
                {
                    <MudAvatar Color="Color.Secondary" Size="Size.Large">
                        @(string.IsNullOrWhiteSpace(school.SchoolName) ? "?" : school.SchoolName[..1].ToUpperInvariant())
                    </MudAvatar>
                }

                <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Accept="image/*">
                    <ActivatorContent>
                        <MudFab Color="Color.Secondary"
                                StartIcon="@Icons.Material.Filled.Image"
                                Size="Size.Small"
                                Label="@(school.SchoolLogo is { Length: > 0 } ? "Change logo" : "Add logo")" />
                    </ActivatorContent>
                </MudFileUpload>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Label="School name"
                              @bind-Value="school.SchoolName"
                              Error="@(string.IsNullOrWhiteSpace(school.SchoolName))"
                              ErrorText="A school name is required." />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Label="Contact number"
                              @bind-Value="school.SchoolPhoneContact" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Label="Email address"
                              @bind-Value="school.SchoolEmail" InputType="InputType.Email" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Label="Website"
                              @bind-Value="school.SchoolWebsite" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Currency: @(string.IsNullOrWhiteSpace(school.CurrencyCode) ? "not set" : $"{school.CurrencyCode} {school.CurrencySymbol}")
                    — set at registration and used for every fee and invoice, so it is not editable here.
                </MudText>
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseDialog" Disabled="_saving">Close</MudButton>

        @* Licensing now runs through the SuperAdmin console's dialog rather than a nested form here.
           That one derives the client identity from the school record, defaults the period from the
           plan, warns when the seat count is below the accounts that already exist, and clears the
           server's licence cache so the change is visible immediately instead of in half an hour. *@
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Key"
                   Disabled="_saving"
                   OnClick="OpenLicenceDialogAsync">
            Licence
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.SaveAlt"
                   Disabled="_saving"
                   OnClick="UpdateDetails">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public School school { get; set; } = new();
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] IDialogService DialogService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    private bool _saving;

    private async Task UploadFiles(IBrowserFile file)
    {
        if (file is null) return;

        using var memoryStream = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(memoryStream);
        school.SchoolLogo = memoryStream.ToArray();
    }

    private void CloseDialog() => MudDialog.Close();

    private async Task OpenLicenceDialogAsync()
    {
        var parameters = new DialogParameters<LicenseDialog>
        {
            { x => x.SchoolId, school.SchoolID },
            { x => x.SchoolName, school.SchoolName ?? "this school" },
        };

        await DialogService.ShowAsync<LicenseDialog>(
            "Licence", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task UpdateDetails()
    {
        if (string.IsNullOrWhiteSpace(school.SchoolName))
        {
            Snackbar.Add("A school name is required.", Severity.Error);
            return;
        }

        _saving = true;
        try
        {
            var service = _genericService.GetService<School>();
            var result = await service.UpdateAsync("api/Dynamic/UpdateEntity", "school", school);

            // The previous version closed the dialog on success and did nothing at all on failure,
            // so a failed save looked exactly like no click.
            if (result.IsSuccess)
            {
                MudDialog.Close(DialogResult.Ok("Details updated successfully"));
            }
            else
            {
                Snackbar.Add("The changes could not be saved. Please try again.", Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
