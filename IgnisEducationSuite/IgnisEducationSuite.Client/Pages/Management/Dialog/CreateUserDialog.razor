@using System;
@using System.Security.Cryptography;
@using System.Text;
@using EDUSphereSharedProject.IdentiyModels
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.UniversalModels
@using EDUSphereSharedProject.UniversalModels.ParentLinking
@using IgnisEducationSuite.Client.Services
@inject HttpClient Http
@inject NavigationManager navigationManager
@inject GenericServiceFactory genericService
@inject ISnackbar Snackbar
@inject StudentNumberGenerator StudentNumberGenerator
@inject IParentLinkingClientService ParentLinking
@inherits AppBaseComponent
<MudDialog>
    <DialogContent>
        <MudText Class="mb-4" Align="Align.Center" Typo="Typo.h4"><b>Manage User Account</b></MudText>

        <MudGrid Spacing="3">

            <!-- Section: Account Details -->
            <MudItem xs="12" Class="mb-2">
                <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" NoIcon="true">User Account Details</MudAlert>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newUser.UserName" Label="Username" />
            </MudItem>
            <MudItem xs="12" md="6">
                @if (AppState.HideStudentDashboard && Role == "Student")
                {
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newUser.Email" Label="Parent Email for Password" />
                }
                else
                {
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newUser.Email" Label="Email" />
                }
            </MudItem>

            <!-- Section: Personal Information -->
            <MudItem xs="12" Class="mb-2 mt-3">
                <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" NoIcon="true">User Information</MudAlert>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newUser.FirstName" Label="First Name" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newUser.LastName" Label="Last Name" />
            </MudItem>

            <!-- Location: Country & City -->
            <MudItem xs="12" md="6">
                <MudAutocomplete Variant="Variant.Outlined" ValueChanged="(e) => GetCities(e)" ToStringFunc="CountryTypeconverter"
                                 T="CountryDTO" Label="Country" Placeholder="Select Country"
                                 SearchFunc="@SearchCountry" Margin="Margin.Dense"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true"
                                 AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAutocomplete Variant="Variant.Outlined" @bind-Value="City" ToStringFunc="CityTypeconverter"
                                 T="CityDTO" Label="City" Disabled="Country.CountryName == null"
                                 SearchFunc="@SearchCity" Margin="Margin.Dense"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true"
                                 AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" />
            </MudItem>

            <!-- Student-specific fields -->
            @if (Role == "Student")
            {
                @* Chosen from the school's actual structure rather than typed. Class matching joins on
                   LevelName and GradeSection, so a typo here produced a student enrolled in nothing —
                   with no visible sign anything was wrong. *@
                <MudItem xs="12" md="6">
                    <MudSelect T="AcademicLevel" Label="Academic Level" Value="_selectedLevel"
                               ValueChanged="OnAcademicLevelChanged"
                               ToStringFunc="@(l => l?.LevelName ?? "Select a level")"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                        @foreach (var level in AppState.AcademicLevels)
                        {
                            <MudSelectItem Value="@level">@level.LevelName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="LevelSection" Label="Grade Section" Value="_selectedSection"
                               ValueChanged="OnLevelSectionChanged"
                               ToStringFunc="@(s => s?.SectionCode ?? "Select a section")"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Disabled="@(_selectedLevel is null)" Required="true">
                        @foreach (var levelSection in SectionsForSelectedLevel)
                        {
                            <MudSelectItem Value="@levelSection">@levelSection.SectionCode</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Option Group" @bind-Value="_selectedGroupName"
                               ToStringFunc="@(g => string.IsNullOrEmpty(g) ? "None — core classes only" : g)"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               HelperText="Only needed if this student takes option-set subjects.">
                        <MudSelectItem T="string" Value="@("")">None — core classes only</MudSelectItem>
                        @foreach (var group in _groupOptions)
                        {
                            <MudSelectItem T="string" Value="@group.GroupName">
                                @group.GroupName (@group.ClassCount class@(group.ClassCount == 1 ? "" : "es"))
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Optional on purpose: an unlinked student appears on the Students Without a Parent
                   screen, so creation is not blocked on the parent existing yet. *@
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="ParentOptionDto" Label="Parent (optional)"
                                     Value="_selectedParentForStudent"
                                     ValueChanged="v => _selectedParentForStudent = v"
                                     SearchFunc="@SearchParentsForStudent"
                                     ToStringFunc="@(p => p is null ? "" : p.FullName)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                     HelperText="Leave blank to link later from the parent mapping screen." />
                </MudItem>

                @if (_selectedGroupName is { Length: > 0 })
                {
                    var chosen = _groupOptions.FirstOrDefault(g => g.GroupName == _selectedGroupName);
                    @if (chosen is not null)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                Will also be enrolled in: @string.Join(", ", chosen.ClassNames)
                            </MudAlert>
                        </MudItem>
                    }
                }
            }

            <!-- Gender & Address -->
            <MudItem xs="12" md="6">
                <MudSelect T="string" Variant="Variant.Outlined" Label="Gender" Margin="Margin.Dense" @bind-Value="newUser.Gender">
                    @foreach (var item in genders)
                    {
                        <MudSelectItem T="string" Value="item.GenderDescription">@item.GenderDescription</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newUser.Address" Label="Address" />
            </MudItem>

            <!-- Teacher-specific -->
            @if (Role == "Teacher")
            {
                <MudItem xs="12" md="6">
                    <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Label="Engagement Date" @bind-Date="newUser.DateEngaged" />
                </MudItem>
            }

            <!-- ID Prefix -->
            @if (Role == "Teacher" || Role == "Student")
            {
                <MudItem xs="12" md="6">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="IDPrefix" Disabled="string.IsNullOrEmpty(PrefixLabel)" Label="@PrefixLabel" />
                </MudItem>
            }

            <!-- Parent-specific -->
            @if (Role == "Parent")
            {
                <MudItem xs="12">
                    <MudAutocomplete T="Student"
                                     Label="Search & Add Child"
                                     Placeholder="Type student name"
                                     ToStringFunc="StudentTypeconverter"
                                     SearchFunc="@SearchStudent"
                                     ValueChanged="AddChildToParent"
                                     CoerceText="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     AdornmentColor="Color.Primary" />

                </MudItem>

                <MudItem xs="12">
                    @if (parentsChildren.Any())
                    {
                        <MudChipSet T="string">
                            @foreach (var child in parentsChildren)
                            {
                                <MudChip Color="Color.Primary" OnCloseClicked="@(() => RemoveChild(child))" Closeable="true">
                                    @child.FirstName @child.LastName
                                </MudChip>
                            }
                        </MudChipSet>
                    }
                    else
                    {
                        <MudText>No children selected</MudText>
                    }
                </MudItem>

            }

            <!-- Contact Number -->
            @if (Role == "Parent" || Role == "Teacher")
            {
                <MudItem xs="12" md="6">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="newUser.ContactNo" Label="Contact Number" />
                </MudItem>
            }

            <!-- Profile Picture Upload -->
            <MudItem xs="12" md="6">
                <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
                    <ActivatorContent>
                        <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Image" Label="Load Profile Picture" />
                    </ActivatorContent>
                </MudFileUpload>
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles="false" FullWidth="true" Class="gap-2">
            <MudButton Color="Color.Primary" OnClick="CreateNewUser" Variant="Variant.Filled">Add New User</MudButton>
            <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Clear">Clear</MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="CloseDialog">Close</MudButton>
        </MudButtonGroup>
    </DialogActions>
</MudDialog>


@code {

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Role { get; set; } = string.Empty;
    [Parameter] public List<CountryDTO> countries { get; set; } = new();
    [Parameter] public List<Gender> genders { get; set; } = new();
    [Parameter] public ClientAdmin LoggedAdmin { get; set; } = new();

    /// <summary>
    /// Children to attach to the new parent, already chosen elsewhere. Used by the student-to-parent
    /// mapping screen, which knows which unparented students prompted the creation — so the admin
    /// does not have to search for them again in this dialog.
    /// </summary>
    [Parameter] public List<Student> PreselectedChildren { get; set; } = new();

    // ---- Student enrolment (level, section, group, parent) ----

    private AcademicLevel? _selectedLevel;
    private LevelSection? _selectedSection;
    private string _selectedGroupName = "";
    private ParentOptionDto? _selectedParentForStudent;
    private List<StudentGroupOptionDto> _groupOptions = new();

    private IEnumerable<LevelSection> SectionsForSelectedLevel =>
        _selectedLevel is null
            ? Enumerable.Empty<LevelSection>()
            : AppState.AcademicSections.Where(s => s.AcademicLevelID == _selectedLevel.AcademicLevelID);

    private void OnAcademicLevelChanged(AcademicLevel? level)
    {
        _selectedLevel = level;

        // The previously chosen section belongs to the old level and would put the student in a
        // section that does not exist for this one.
        _selectedSection = null;

        newUser.GradeLevel = level?.LevelInt ?? 0;
        newUser.GradeSection = "";
    }

    private void OnLevelSectionChanged(LevelSection? levelSection)
    {
        _selectedSection = levelSection;
        newUser.GradeSection = levelSection?.SectionCode ?? "";
    }

    private async Task<IEnumerable<ParentOptionDto>> SearchParentsForStudent(string value, CancellationToken token)
    {
        var parents = await ParentLinking.ListParentsAsync(value);
        return parents.Take(25);
    }
    private List<Student> parentsChildren = new();
    protected List<CityDTO> Cities = new();
    protected UniversalUser newUser = new();
    protected string IDPrefix = string.Empty;
    protected string PrefixLabel = string.Empty;
    protected CountryDTO Country = new();
    protected CityDTO City = new();
    [Inject] AuthenticationStateProvider _authenticationStateProvider { get; set; } = default!;
    [Inject] ClientEmailService _emailService { get; set; } = default!;
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    IList<IBrowserFile> _files = new List<IBrowserFile>();
    protected List<Student> students = new();
    protected Student selectedStudent = new();
    protected Clinic SelectedClinic = new();
    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Please wait a moment...");
        if (Role == "Student")
        {
            PrefixLabel = "StudentNumber Prefix";

            // Group tokens are derived from real class names, so every option offered is guaranteed
            // to match at least one class.
            _groupOptions = await ParentLinking.ListGroupOptionsAsync();
        }
        else if (Role == "Teacher" || Role == "Staff")
        {
            PrefixLabel = "EmployeeNumber Prefix";
        }
        else
        {
            await GetStudent();
            PrefixLabel = "";

            // Seed the child list from whoever sent us here. Matched by id against the loaded
            // students so the chips carry the same instances the search would have produced.
            if (Role == "Parent" && PreselectedChildren.Count > 0)
            {
                foreach (var preselected in PreselectedChildren)
                {
                    var match = students.FirstOrDefault(s => s.StudentID == preselected.StudentID) ?? preselected;
                    if (!parentsChildren.Any(c => c.StudentID == match.StudentID))
                    {
                        parentsChildren.Add(match);
                    }
                }
            }
        }
        LoaderService.Hide();
    }
    protected async Task GetStudent()
    {
        var result = _genericService.GetService<Student>();
        var service = await result.GetAllAsync($"api/Dynamic/GetStudentsBySchool/{AppState.SchoolID}", true);
        students = service.Data.ToList();

    }
    private void AddChildToParent(Student student)
    {
        if (student != null && !parentsChildren.Contains(student))
        {
            parentsChildren.Add(student);
            StateHasChanged();
        }
    }

    private void RemoveChild(Student student)
    {
        if (parentsChildren.Contains(student))
        {
            parentsChildren.Remove(student);
            StateHasChanged();
        }
    }
    protected async Task GetCities(CountryDTO selectedCountry)
    {
        Country = selectedCountry;
        var service = _genericService.GetService<CityDTO>();
        var result = await service.GetAllAsync($"api/CountriesAndCities/GetCities/{selectedCountry.CountryCode}", true);
        if (result.IsSuccess)
        {
            Cities = result.Data.ToList();
        }
    }

    private async Task UploadFiles(IBrowserFile file)
    {
        if (file == null || newUser == null)
            throw new ArgumentNullException(nameof(file), "File or model cannot be null");

        using (var memoryStream = new MemoryStream())
        {
            await file.OpenReadStream().CopyToAsync(memoryStream);

            // Check if the byte array size exceeds 500 KB
            if (memoryStream.Length > 500 * 1024)
            {
                Snackbar.Add("File too large", Severity.Error);

                throw new InvalidOperationException("File size exceeds the 500 KB limit.");
            }
            else
                newUser.profilePic = memoryStream.ToArray();
            Snackbar.Add("Image Uploaded Succesfullt", Severity.Success);
        }
    }

    public static string GenerateOneTimePassword(int length = 8)
    {
        const string lowercase = "abcdefghijklmnopqrstuvwxyz";
        const string uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const string numbers = "1234567890";
        const string special = "!@#$%^&*()_-+=<>?";

        if (length < 8)
            length = 8;

        const string allChars = lowercase + uppercase + numbers + special;

        using var rng = RandomNumberGenerator.Create();

        var password = new List<char>
    {
        GetRandomChar(lowercase, rng),
        GetRandomChar(uppercase, rng),
        GetRandomChar(numbers, rng),
        GetRandomChar(special, rng)
    };

        // Fill the remaining characters randomly
        while (password.Count < length)
        {
            password.Add(GetRandomChar(allChars, rng));
        }

        // Shuffle the password so the required characters aren't always first
        for (int i = password.Count - 1; i > 0; i--)
        {
            byte[] randomByte = new byte[1];
            rng.GetBytes(randomByte);

            int j = randomByte[0] % (i + 1);

            (password[i], password[j]) = (password[j], password[i]);
        }

        return new string(password.ToArray());
    }

    private static char GetRandomChar(string characters, RandomNumberGenerator rng)
    {
        byte[] randomByte = new byte[1];
        rng.GetBytes(randomByte);

        return characters[randomByte[0] % characters.Length];
    }
    
    public async Task<string> GetLoggedInuser()
    {
        var auth = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var CreatedBy = user.Identity.Name;

        return CreatedBy;
    }
    protected async Task CreateNewUser()
    {
        try
        {
            LoaderService.Show("Please wait, creating user!");
            StateHasChanged();

            // 1️⃣ Generate credentials
            newUser.Password = GenerateOneTimePassword();
            newUser.Role = Role;

            string email = (AppState.HideStudentDashboard && newUser.Role == "Student") ? "N/A" : newUser.Email;
            string studentID = (newUser.Role == "Student")
                ? await StudentNumberGenerator.GenerateStudentIdAsync(IDPrefix, navigationManager.BaseUri)
                : "N/A";

            var createUserModel = new CreateUserModel
            {
                UserName = newUser.UserName,
                Password = newUser.Password,
                Email = email,
                Role = newUser.Role,
                SchoolID = LoggedAdmin.SchoolID.Value,
                UserID = studentID,
                ProfilePic = newUser.profilePic ?? Array.Empty<byte>(),
                FirstName = newUser.FirstName,
                LastName = newUser.LastName
            };

            // 2️⃣ Create Identity User
            var result = await Http.PostAsJsonAsync($"{navigationManager.BaseUri}api/Admin/createUser", createUserModel);
            if (!result.IsSuccessStatusCode)
            {
                Snackbar.Add("Error: Saving user failed", Severity.Error);
                return;
            }

            var createdUser = await result.Content.ReadFromJsonAsync<ApplicationUser>();
            newUser.UserID = createdUser.Id;

            // 3️⃣ Role-specific entity creation
            switch (newUser.Role)
            {
                case "Teacher":
                    await CreateTeacherAsync(newUser, createdUser.Id);
                    break;

                case "Student":
                    await CreateStudentAsync(newUser, studentID, createdUser.Id);
                    break;

                case "Parent":
                    await CreateParentAsync(newUser, selectedStudent, createdUser.Id);
                    break;

                default:
                    Snackbar.Add("Unknown role selected", Severity.Error);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error);
        }
        finally
        {
            LoaderService.Hide();
            StateHasChanged();
        }
    }
    private async Task SendOneTimePasswordEmail(UniversalUser user, string recipientName, string studentID)
    {
        try
        {
            var emailRequest = new EmailRequest
            {
                To = user.Email,
                Reciepient = recipientName,
                Password = user.Password,
                UserName = user.UserName,
                StudentID = studentID,
                isFirstMail = true
            };

            var emailResult = await _emailService.SendPasswordResetEmailAsync(emailRequest, navigationManager.BaseUri);
            if (emailResult == "Password reset email sent successfully!")
            {
                Snackbar.Add($"One time password sent successfully to {recipientName}", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Email failed to send: {emailResult}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error sending email: {ex.Message}", Severity.Error);
        }
    }
    private async Task CreateTeacherAsync(UniversalUser user, string userId)
    {
        var teacher = new Teacher
        {
            TeacherID = Guid.NewGuid(),
            FirstName = user.FirstName,
            LastName = user.LastName,
            EmailAddress = user.Email,
            Gender = user.Gender,
            DateEngaged = user.DateEngaged,
            ProfilePic = user.profilePic,
            UserID = userId,
            SchoolID = LoggedAdmin.SchoolID,
            CreatedBy = await GetLoggedInuser(),
            CreatedDate = DateTime.Now,
            Nationality = Country.CountryName,
            City = City.CityName
        };

        var service = genericService.GetService<Teacher>();
        var saved = await service.PostAsync("api/Dynamic/PostEntity", "teacher", teacher);

        if (!saved.IsSuccess)
        {
            Snackbar.Add("Error: Saving teacher failed", Severity.Error);
            return;
        }

        await SendOneTimePasswordEmail(user, $"{saved.Data.FirstName} {saved.Data.LastName}", "N/A");
        MudDialog.Close(DialogResult.Ok("successful"));
    }
    private async Task CreateStudentAsync(UniversalUser user, string studentID, string userId)
    {
        if (_selectedLevel is null || _selectedSection is null)
        {
            Snackbar.Add("Choose the academic level and section — class matching depends on them.", Severity.Error);
            return;
        }

        var student = new Student
        {
            StudentID = Guid.NewGuid(),
            FirstName = user.FirstName,
            LastName = user.LastName,
            Gender = user.Gender,
            Address = user.Address,
            Email = user.Email,
            Country = Country.CountryName,
            City = City.CityName,
            StudentNumber = studentID,
            ProfilePic = user.profilePic,
            UserID = userId,
            DateOnBoarded = DateTime.Now,
            SchoolID = LoggedAdmin.SchoolID,

            // These four are what the bulk upload sets and individual creation did not.
            // SyncStudentsToClasses joins on LevelName and GradeSection and matches option-set
            // classes by GroupName, so without them a student matches no classes at all.
            AcademicLevel = _selectedLevel.LevelInt ?? user.GradeLevel,
            LevelName = _selectedLevel.LevelName,
            GradeSection = _selectedSection.SectionCode,
            GroupName = string.IsNullOrWhiteSpace(_selectedGroupName) ? null : _selectedGroupName,

            // Carried so schedule saving and parent-gap reporting can scope by section without
            // matching on display names.
            AcademicLevelID = _selectedLevel.AcademicLevelID,
            LevelSectionID = _selectedSection.LevelSectionID,

            // Optional by design — an unlinked student surfaces on the parent mapping screen.
            ParentID = _selectedParentForStudent?.ParentId,
        };

        var service = genericService.GetService<Student>();
        var saved = await service.PostAsync("api/Dynamic/PostEntity", "student", student);

        if (!saved.IsSuccess)
        {
            Snackbar.Add("Error: Saving student failed", Severity.Error);
            return;
        }

        // Enrol them in their classes. The bulk path relies on this procedure; individual creation
        // never ran it, so a student added one at a time had no StudentClasses rows and was missing
        // from class lists and report card mark sheets.
        var sync = await ParentLinking.SyncStudentClassesAsync(student.StudentID);

        if (!sync.Succeeded)
        {
            Snackbar.Add(
                $"{student.FirstName} was created, but class matching failed: {string.Join(" ", sync.Errors)}",
                Severity.Warning);
        }
        else if (sync.StudentClassCount == 0)
        {
            // Created but enrolled in nothing. Almost always means no class exists for this
            // level/section combination — say so now rather than at reporting time.
            Snackbar.Add(
                $"{student.FirstName} was created but matched no classes. Check that classes exist for " +
                $"{_selectedLevel.LevelName} {_selectedSection.SectionCode}.",
                Severity.Warning);
        }
        else
        {
            Snackbar.Add($"{student.FirstName} enrolled in {sync.StudentClassCount} class(es).", Severity.Success);
        }

        if (_selectedParentForStudent is null)
        {
            Snackbar.Add(
                $"{student.FirstName} has no parent linked yet — they will appear on the Students Without a Parent screen.",
                Severity.Info);
        }

        await SendOneTimePasswordEmail(user, $"{saved.Data.FirstName} {saved.Data.LastName}", studentID);
        MudDialog.Close(DialogResult.Ok("successful"));
    }
    private async Task CreateParentAsync(UniversalUser user, Student selectedStudent, string userId)
    {
        // Checks parentsChildren, which is what the linking below actually uses. The previous guard
        // tested selectedStudent, a field initialised to new Student() and therefore never null —
        // so a parent created with no children selected passed the check, linked nobody, and still
        // reported success, leaving an orphan parent record behind.
        if (!parentsChildren.Any())
        {
            Snackbar.Add("Add at least one child before creating a parent.", Severity.Error);
            return;
        }

        var parent = new Parent
        {
            ParentID = Guid.NewGuid(),
            FirstName = user.FirstName,
            LastName = user.LastName,
            Email = user.Email,
            UserId = userId,
            Address = user.Address,
            Country = user.Country,
            City = user.City,
            PhoneNumber = user.ContactNo,
            ProfilePic = user.profilePic,
            SchoolID = LoggedAdmin.SchoolID
        };

        var service = genericService.GetService<Parent>();
        var saved = await service.PostAsync("api/Dynamic/PostEntity", "parent", parent);

        if (!saved.IsSuccess)
        {
            Snackbar.Add("Error: Saving parent failed", Severity.Error);
            return;
        }

        // Link parent to student
        foreach (var item in parentsChildren)
        {
            item.ParentID = parent.ParentID;
        }
        var updateService = genericService.GetService<List<Student>>();
        var updatedStudent = await updateService.UpdateAsync("api/Dynamic/UpdateEntities", "student", parentsChildren);

        if (!updatedStudent.IsSuccess)
        {
            Snackbar.Add("Error linking parent to student", Severity.Error);
            return;
        }

        await SendOneTimePasswordEmail(user, $"{saved.Data.FirstName} {saved.Data.LastName}", "N/A");
        MudDialog.Close(DialogResult.Ok("successful"));
    }
    private async Task CreateClinicStaff(UniversalUser user, string recipientName)
    {
        ClinicStaff newStaff = new()
        {
            StaffId = Guid.NewGuid(),
            ClinicId = SelectedClinic.ClinicId,
            Contact = user.ContactNo,
            FullName = $"{user.FirstName} {user.LastName}",
            Role = user.Role
        };

        var service = GenericService.GetService<ClinicStaff>();
        var saved = await service.PostAsync("api/Dynamic/PostEntity", "clinicstaff", newStaff);


        if (!saved.IsSuccess)
        {
            Snackbar.Add("Error: Saving teacher failed", Severity.Error);
            return;
        }

        await SendOneTimePasswordEmail(user, $"{saved.Data.FullName}", "N/A");
        MudDialog.Close(DialogResult.Ok("successful"));

    }
    private async Task<IEnumerable<CountryDTO>> SearchCountry(string value, CancellationToken token)
    {
        await Task.Delay(5, token);

        if (string.IsNullOrEmpty(value))
            return new List<CountryDTO>();
        return countries.Where(x => x.CountryName.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    private async Task<IEnumerable<CityDTO>> SearchCity(string value, CancellationToken token)
    {

        await Task.Delay(5, token);


        if (string.IsNullOrEmpty(value))
            return new List<CityDTO>();
        return Cities.Where(x => x.CityName.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    private async Task<IEnumerable<Student>> SearchStudent(string value, CancellationToken token)
    {

        await Task.Delay(5, token);


        if (string.IsNullOrEmpty(value))
            return new List<Student>();
        return students.Where(x => x.FirstName.Contains(value, StringComparison.InvariantCultureIgnoreCase) || x.LastName.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    #region To String Func

    protected Func<CountryDTO, string> CountryTypeconverter = p => p?.CountryCode + ":" + p?.CountryName;
    protected Func<CityDTO, string> CityTypeconverter = p => p?.CityName;
    protected Func<Student, string> StudentTypeconverter = p => p?.FirstName + " " + p?.LastName + "-" + p?.LevelName;
    #endregion

