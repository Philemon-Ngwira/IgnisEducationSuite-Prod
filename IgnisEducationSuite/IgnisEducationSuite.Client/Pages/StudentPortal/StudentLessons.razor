@page "/StudentLessons"
@using System.Text.Json
@using EDUSphereSharedProject.Models
@inject LessonService LessonService
@inherits AppBaseComponent
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Lessons</b></MudText>
        </CardHeaderContent>

    </MudCardHeader>

    <MudCardContent>
        <MudGrid>

            @if (availableLessons.Any())
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Success" Variant="Variant.Filled">Available Lessons</MudAlert>
                </MudItem>
                @foreach (var item in availableLessons)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MudCard  Class="hover-card">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Secondary">
                                        @if (item.Teacher.ProfilePic != null)
                                        {
                                            <MudImage Src="@($"data:image/jpeg;base64,{Convert.ToBase64String(item.Teacher.ProfilePic)}")" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                                        }
                                    </MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.body1"><b>@item.Title</b></MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardMedia Image="@item.imageUrl" Height="250" />
                            <MudCardContent>
                                <MudText Typo="Typo.body2">@item.Teacher.FirstName @item.Teacher.LastName</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudTooltip Text="Rate this lesson">
                                    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Star">Rate Lesson</MudButton>
                                </MudTooltip>

                                <MudTooltip Text="View lesson details">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="() => NavigateToDetails(item, false)" StartIcon="@Icons.Material.Filled.More">View Lesson</MudButton>
                                </MudTooltip>

                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }

            }
            else if (CompletedLessons.Any())
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Filled">Completed Lessons</MudAlert>
                </MudItem>
                @foreach (var item in CompletedLessons)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MudCard Class="hover-card">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Secondary">
                                        @if (item.Teacher.ProfilePic != null)
                                        {
                                            <MudImage Src="@($"data:image/jpeg;base64,{Convert.ToBase64String(item.Teacher.ProfilePic)}")" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                                        }
                                    </MudAvatar>

                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.body1"><b>@item.Title</b></MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardMedia Image="@item.imageUrl" Height="250" />
                            <MudCardContent>
                                <MudText Typo="Typo.body2">@item.Teacher.FirstName @item.Teacher.LastName</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudTooltip Text="Rate this lesson">
                                    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Star">Rate Lesson</MudButton>
                                </MudTooltip>

                                <MudTooltip Text="View lesson details">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="() => NavigateToDetails(item, true)" StartIcon="@Icons.Material.Filled.More">View Lesson</MudButton>
                                </MudTooltip>

                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }

            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.School">
                    No lessons available at the moment.
                </MudAlert>



            }
        </MudGrid>
    </MudCardContent>
</MudCard>
<style>
    .hover-card:hover {
        box-shadow: 0px 8px 20px rgba(0,0,0,0.2);
        cursor: pointer;
        transform: translateY(-2px);
        transition: all 0.2s ease-in-out;
</style>
@code {
    protected Lesson selectedLesson = new();
    protected List<Lesson> availableLessons = new();
    protected List<Lesson> CompletedLessons = new();
    protected List<Teacher> teachers = new();
    [Inject] ImageService _imageService { get; set; } = default!;
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] AppState _appState { get; set; } = default!;
    string UserID = string.Empty;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    protected bool isLoading = false;
    protected Guid SchoolID = Guid.Empty;
    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Loading lessons...");

        UserID = _appState.UserID;

        if (UserID != string.Empty || UserID != null)
        {
            var tasks = new List<Task>{
                GetTeachers(),
                GetStudentClasses(),
                GetStudentCompletedLessons()

            };

            await Task.WhenAll(tasks);
            foreach (var item in availableLessons)
            {
                //item.imageUrl = await _imageService.GetRandomImageUrlAsync(_navigationManager.BaseUri);

                item.Teacher = teachers.Where(x => x.TeacherID == item.TeacherID).FirstOrDefault();
            }
            foreach (var item in CompletedLessons)
            {
                // item.imageUrl = await _imageService.GetRandomImageUrlAsync(_navigationManager.BaseUri);

                item.Teacher = teachers.Where(x => x.TeacherID == item.TeacherID).FirstOrDefault();
            }
        }
        LoaderService.Hide();
    }

    protected async Task GetStudentClasses()
    {
        var service = _genericService.GetService<Lesson>();
        var result = await service.GetAllAsync($"api/Dynamic/GetStudentLessons/{UserID}", true);
        if (result.IsSuccess)
        {
            availableLessons = result.Data.ToList();
            SchoolID = Guid.Parse(AppState.SchoolID);

        }
        else
        {
            Snackbar.Add("Error Collecting Lessons, Please refresh your page and try again", Severity.Error);
        }
    }

    protected async Task GetStudentCompletedLessons()
    {
        var service = _genericService.GetService<Lesson>();
        var result = await service.GetAllAsync($"api/Dynamic/GetStudentCompletedLessons/{UserID}", true);
        if (result.IsSuccess)
        {
            CompletedLessons = result.Data.ToList();

        }
    }
    protected async Task GetTeachers()
    {
        var service = _genericService.GetService<Teacher>();
        var result = await service.GetAllAsync($"api/Dynamic/GetTeachersBySchoolID/{AppState.SchoolID}", true);
        teachers = result.Data.ToList();
    }
    protected async void NavigateToDetails(Lesson selectedLesson, bool LessonCompleted)
    {
        LoaderService.Show("Loading lesson details...");
        await GetTeachers();
        await GetLessonMedia(selectedLesson.LessonID);
        selectedLesson.Teacher = teachers.Where(x => x.TeacherID == selectedLesson.TeacherID).FirstOrDefault();
        LessonService.CurrentLesson = selectedLesson;
        LessonService.LessonCompleted = LessonCompleted;
        LoaderService.Hide();
        _navigationManager.NavigateTo("/LessonDetails");

    }

    protected async Task GetLessonMedia(Guid LessonID)
    {
        var service = _genericService.GetService<LessonMedium>();
        var result = await service.GetAllAsync($"api/Dynamic/GetLessonMedia/{LessonID}", true);
        if (result.IsSuccess)
        {
            LessonService.LessonMedia = result.Data.ToList();
        }
    }

}
