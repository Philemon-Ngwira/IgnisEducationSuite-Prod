@page "/Exams"
@using EDUSphereSharedProject.Models
@using EDUSphereSharedProject.Models.StoreProModels
@using IgnisEducationSuite.Client.Pages.Shared
@inherits AppBaseComponent
@inject LessonService LessonService

<MudCard>
    <MudCardHeader Class="mb-2">
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4">Exams, Tests, Quizzes</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="mb-3">
       
        <MudTabs Elevation="4" Rounded="true" Centered="true" Color="@Color.Primary">
            <!-- Exams Tab -->
            <MudTabPanel Text="Exams">
                <MudTable Items="@examQuizzes.Where(x => x.ExamType == "Exam")"
                          Dense="true" Hover="true" Bordered="true" Striped="true"
                          Filter="new Func<GetUpcomingExamsOrQuizzesResult, bool>(FilterFunc1)"
                          @bind-SelectedItem="selectedItem"
                          Breakpoint="Breakpoint.Sm">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Available Exams</MudText>
                        <MudSpacer />
                        <MudTextField @bind-Value="searchString"
                                      Placeholder="Search"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Medium"
                                      Class="mt-0" />
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Title</MudTh>
                        <MudTh>Total Marks</MudTh>
                        <MudTh>Created Date</MudTh>
                        <MudTh>Exam Date</MudTh>
                        <MudTh>Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Title">@context.Title</MudTd>
                        <MudTd DataLabel="Total Marks">@context.TotalMarks</MudTd>
                        <MudTd DataLabel="Created Date">@context.CreatedDate.Value.ToShortDateString()</MudTd>
                        <MudTd DataLabel="Exam Date">@context.EndDate.ToShortDateString()</MudTd>
                        <MudTd DataLabel="Action">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       EndIcon="@Icons.Material.Filled.ReadMore"
                                       OnClick="() => NavigateToDetails(context)">
                                Go to Exam
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </MudTabPanel>

            <!-- Tests Tab -->
            <MudTabPanel Text="Tests">
                <!-- Repeat similar table as above, filtering ExamType == "Test" -->
                <MudTabPanel Text="Exams">
                    <MudTable Items="@examQuizzes.Where(x => x.ExamType == "Test")"
                              Dense="true" Hover="true" Bordered="true" Striped="true"
                              Filter="new Func<GetUpcomingExamsOrQuizzesResult, bool>(FilterFunc1)"
                              @bind-SelectedItem="selectedItem"
                              Breakpoint="Breakpoint.Sm">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6">Available Exams</MudText>
                            <MudSpacer />
                            <MudTextField @bind-Value="searchString"
                                          Placeholder="Search"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium"
                                          Class="mt-0" />
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Title</MudTh>
                            <MudTh>Total Marks</MudTh>
                            <MudTh>Created Date</MudTh>
                            <MudTh>Exam Date</MudTh>
                            <MudTh>Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Title">@context.Title</MudTd>
                            <MudTd DataLabel="Total Marks">@context.TotalMarks</MudTd>
                            <MudTd DataLabel="Created Date">@context.CreatedDate.Value.ToShortDateString()</MudTd>
                            <MudTd DataLabel="Exam Date">@context.EndDate.ToShortDateString()</MudTd>
                            <MudTd DataLabel="Action">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           EndIcon="@Icons.Material.Filled.ReadMore"
                                           OnClick="() => NavigateToDetails(context)">
                                    Go to Exam
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </MudTabPanel>

            </MudTabPanel>

            <!-- Quizzes Tab -->
            <!-- Repeat similar table as above, filtering ExamType == "Quiz" -->
            <MudTabPanel Text="Quizzes">
                <MudTabPanel Text="Exams">
                    <MudTable Items="@examQuizzes.Where(x => x.ExamType == "Quiz")"
                              Dense="true" Hover="true" Bordered="true" Striped="true"
                              Filter="new Func<GetUpcomingExamsOrQuizzesResult, bool>(FilterFunc1)"
                              @bind-SelectedItem="selectedItem"
                              Breakpoint="Breakpoint.Sm">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6">Available Exams</MudText>
                            <MudSpacer />
                            <MudTextField @bind-Value="searchString"
                                          Placeholder="Search"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium"
                                          Class="mt-0" />
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Title</MudTh>
                            <MudTh>Total Marks</MudTh>
                            <MudTh>Created Date</MudTh>
                            <MudTh>Exam Date</MudTh>
                            <MudTh>Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Title">@context.Title</MudTd>
                            <MudTd DataLabel="Total Marks">@context.TotalMarks</MudTd>
                            <MudTd DataLabel="Created Date">@context.CreatedDate.Value.ToShortDateString()</MudTd>
                            <MudTd DataLabel="Exam Date">@context.EndDate.ToShortDateString()</MudTd>
                            <MudTd DataLabel="Action">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           EndIcon="@Icons.Material.Filled.ReadMore"
                                           OnClick="() => NavigateToDetails(context)">
                                    Go to Exam
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </MudTabPanel>

              
            </MudTabPanel>
        </MudTabs>
    </MudCardContent>
</MudCard>

@code {
    protected List<GetUpcomingExamsOrQuizzesResult> examQuizzes = new();
    protected List<Student> students = new();
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] AppState _appState { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    protected Student student = new();
    protected GetUpcomingExamsOrQuizzesResult selectedItem = new();
    protected string UserID = string.Empty;
    protected string searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        LoaderService.Show("Loading exams, please wait...");
        try
        {
            UserID = _appState.UserID;

            if (!string.IsNullOrEmpty(UserID))
            {
                await GetStudent();
            }
        }
        finally
        {
            LoaderService.Hide();
        }
    }

    protected async Task GetStudent()
    {
        var result = _genericService.GetService<Student>();
        var service = await result.GetAllAsync($"api/Dynamic/GetStudentsByUser/{_appState.UserID}", true);
        if (service.IsSuccess)
        {
            students = service.Data.ToList();
            if (students.Any())
            {
                student = students.First();
                await GetExamstestsAndQuizzes(student.AcademicLevel);
            }
        }
    }

    protected async Task GetExamstestsAndQuizzes(int? GradeLevel)
    {
        var service = _genericService.GetService<GetUpcomingExamsOrQuizzesResult>();
        var result = await service.GetAllAsync($"api/Dynamic/GetUpcomingExamsAndQuizzes/{GradeLevel}", true);
        if (result.IsSuccess)
        {
            examQuizzes = result.Data.ToList();
        }
    }

    protected async Task<List<ExamQuizTestQuestion>> GetExamstestsAndQuizzesQuestions(Guid Id)
    {
        var service = _genericService.GetService<ExamQuizTestQuestion>();
        var result = await service.GetAllAsync($"api/Dynamic/GetExamTestQuizQuestions/{Id}", true);
        return result.IsSuccess ? result.Data.ToList() : new List<ExamQuizTestQuestion>();
    }

    protected async Task GetMultipleChoiceAnswers()
    {
        foreach (var item in LessonService.examQuizTestQuestions)
        {
            if (item.isMultipleChoice == true)
            {
                var service = _genericService.GetService<ExamTestQuizMultipleChoiceAnswer>();
                var result = await service.GetAllAsync($"api/Dynamic/GetQuestionChoicesExams/{item.QuestionID}", true);
                if (result.IsSuccess)
                    LessonService.ExamAnswerChoices.AddRange(result.Data.ToList());
            }
        }
    }

    protected async void NavigateToDetails(GetUpcomingExamsOrQuizzesResult examHeader)
    {
        LoaderService.Show("Loading exam details...");
        try
        {
            LessonService.examQuizTestQuestions = await GetExamstestsAndQuizzesQuestions(examHeader.ExamQuizID);
            if (LessonService.examQuizTestQuestions.Any())
                await GetMultipleChoiceAnswers();

            LessonService.ExamTestQuizID = examHeader.ExamQuizID;
            LessonService.studentID = student.StudentID;
            _navigationManager.NavigateTo("/ExamDetails");
        }
        finally
        {
            LoaderService.Hide();
        }
    }

    private bool FilterFunc1(GetUpcomingExamsOrQuizzesResult element) => FilterFunc(element, searchString);

    private bool FilterFunc(GetUpcomingExamsOrQuizzesResult element, string searchString)
    {
        return string.IsNullOrWhiteSpace(searchString) ||
               element.Title.Contains(searchString, StringComparison.OrdinalIgnoreCase);
    }
}
