@page "/ExamDetails"
@using EDUSphereSharedProject.Models
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4"><b>Questions</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (isLoading)
        {
            <div id="loader-overlay" class="loader-overlay">
                <div class="loader-container">
                    <!-- Spinner -->
                    <div class="spinner"></div>
                    <!-- Loader Icon -->
                    <div class="loader-icon">🔄</div>
                    <!-- Loading Text -->
                    <p class="loading-text">Loading, please wait...</p>
                </div>
            </div>
        }
        @foreach (var item in examQuizTestQuestions)
        {
            @if (item.isMultipleChoice == true)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.body1">Q @item.QuestionNumber @item.QuestionText</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudList T="string">
                        @foreach (var Aitem in LS.ExamAnswerChoices.Where(a => a.ExamTestQuizQuestionID == item.QuestionID)
                        .OrderBy(x=>x.MultipleChoiceLetter))
                        {
                            <MudListItem>
                                <MudCheckBox T="bool"
                                             Label="@Aitem.MuiltpleChoiceAnswer"
                                             Value="IsChecked(item.QuestionID, Aitem.MultipleChoiceLetter)"
                                             ValueChanged="(e) => HandleMultipleChoiceSelection(item.QuestionID,Aitem.MultipleChoiceLetter,Aitem.MuiltpleChoiceAnswer,e)">
                                    <span class="bullet-answer"> @Aitem.MuiltpleChoiceAnswer</span>
                                </MudCheckBox>
                            </MudListItem>
                        }
                    </MudList>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.body1">Q @item.QuestionNumber @item.QuestionText</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="GetOrCreateAnswer(item.QuestionID).AnswerText"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Placeholder="Enter your answer here" />
                </MudItem>
            }
           @*  <MudText Class="mb-3">Q: @item.QuestionText</MudText>
            <MudTextField Class="mb-3" @bind-Value="GetOrCreateAnswer(item.QuestionID).AnswerText" Variant="Variant.Outlined" Margin="Margin.Dense" T="string" Label="Answer Box" Placeholder="Enter Your Answer Here"></MudTextField> *@
        }
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAnswers" >Submit</MudButton>
    </MudCardActions>
</MudCard>
<style>
    .bullet-answer::before {
        content: "•";
        margin-right: 5px;
    }

</style>

@code {
    protected bool isLoading = false;
    [Inject] LessonService LS { get; set; } = default!;
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] NavigationManager _navigationManager { get; set; } = default!;
    protected List<ExamQuizTestQuestion> examQuizTestQuestions = new();
    protected List<StudentExamQuizAndTestAnswer> answers = new();
    protected StudentExamsTestsAndQuiz examHeader = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(1000);
        examQuizTestQuestions = LS.examQuizTestQuestions;
        isLoading = false;
    }

    private async Task SubmitAnswers()
    {
        isLoading = true;
        await SaveExamHeader();
        foreach (var item in answers)
        {
            item.HeaderID = examHeader.StudentExamID;
        }
        var service = _genericService.GetService<List<StudentExamQuizAndTestAnswer>>();
        var result = await service.PostAsync("api/Dynamic/PostEntities", "examanswers", answers);
        if (result.IsSuccess)
        {
            answers.Clear();
            Snackbar.Add("Submitted Successfully", Severity.Success);
            isLoading = false;
            _navigationManager.NavigateTo(_navigationManager.BaseUri, true);
        }
        else
        {
            Snackbar.Add("Error Saving please check your internet and try again, if problem persists please contact your system admin", Severity.Error);
            isLoading = false;
            return;
        }
    }
    private void HandleMultipleChoiceSelection(Guid questionId, string selectedLetter, string AnswerText,bool isChecked)
    {
        if (isChecked)
        {
            // Create a new answer entry for this choice
            var newAnswer = new StudentExamQuizAndTestAnswer
                {
                    QuestionID = questionId,
                    AnswerText = $"{selectedLetter} : {AnswerText}" // Store the selected letter as the answer
                };

            answers.Add(newAnswer);
        }
        else
        {
            // Remove the answer if the checkbox is unchecked
            var existingAnswer = answers.FirstOrDefault(a => a.QuestionID == questionId && a.AnswerText == selectedLetter);
            if (existingAnswer != null)
            {
                answers.Remove(existingAnswer);
            }
        }
    }

    private bool IsChecked(Guid questionId, string letter)
    {
        return answers.Any(a => a.QuestionID == questionId && a.AnswerText == letter);
    }
    protected async Task SaveExamHeader()
    {
        examHeader.SubmissionDate = DateTime.Now;
        examHeader.StudentID = LS.studentID;
        examHeader.StudentExamID = Guid.NewGuid();
        examHeader.ExamID = LS.ExamTestQuizID;
        examHeader.Grade = 0;

        var service = _genericService.GetService<StudentExamsTestsAndQuiz>();
        var result = await service.PostAsync("api/Dynamic/PostEntity", "studentexamsheader", examHeader);
        if (result.IsSuccess)
        {
            Snackbar.Add("Please wait while we complete your submission", Severity.Success);
        }
        else
        {
            Snackbar.Add("Error Saving please check your internet and try again, if problem persists please contact your system admin", Severity.Error);
            isLoading = false;
            return;

        }
    }

    private StudentExamQuizAndTestAnswer GetOrCreateAnswer(Guid questionId)
    {
        // Look for an existing answer object for this question
        var answer = answers.FirstOrDefault(a => a.QuestionID == questionId);

        // If no answer exists, create a new one and add it to the list
        if (answer == null)
        {
            answer = new StudentExamQuizAndTestAnswer { QuestionID = questionId };
            answer.StudentExamAnswerID = Guid.NewGuid();
            answer.AnswerDate = DateTime.Today;
            answer.isCorrect = false;
            answer.isWrong = false;
            answers.Add(answer);
        }

        return answer;
    }
}
