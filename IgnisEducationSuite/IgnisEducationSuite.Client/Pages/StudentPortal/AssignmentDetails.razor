@page "/AssignmentDetails"
@using IgnisEducationSuite.Client.Pages.Shared
@inject LoaderService LoaderService

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4">Assignment Details</MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />


    <MudCardContent>
        <MudAlert Severity="Severity.Normal" NoIcon="true" Variant="Variant.Filled">
            Please answer all questions below before submitting
        </MudAlert>

        <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />

        <MudGrid>
            @foreach (var item in assignmentQuestions)
            {
                @if (item.isMultipleChoice == true)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body1">Q @item.QuestionNumber @item.QuestionText</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudList T="string">
                            @foreach (var Aitem in LessonService.AssignmentAnswerChoices
                                                .Where(a => a.AssignmentQuestionID == item.QuestionID)
                                                .OrderBy(a => a.MultipleChoiceLetter))
                            {
                                <MudListItem>
                                    <MudCheckBox T="bool"
                                                 Label="@Aitem.MultipleChoiceLetter"
                                                 Value="@IsChecked(item.QuestionID, Aitem.MultipleChoiceLetter)"
                                                 ValueChanged="@(checkedValue => HandleMultipleChoiceSelection(
                                                                                                                                                                                       item.QuestionID,
                                                                                                                                                                                       Aitem.MultipleChoiceLetter,
                                                                                                                                                                                       Aitem.MuiltpleChoiceAnswer,
                                                                                                                                                                                       checkedValue))">
                            <span class="bullet-answer">@Aitem.MuiltpleChoiceAnswer</span>
                        </MudCheckBox>
                    </MudListItem>
                                        }
                        </MudList>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body1">Q @item.QuestionNumber @item.QuestionText</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="GetOrCreateAnswer(item.QuestionID).AnswerText"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Enter your answer here" />
                    </MudItem>
                }
            }
        </MudGrid>
    </MudCardContent>

    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Send"
                   OnClick="SaveAssignment">
            Finish And Submit
        </MudButton>
    </MudCardActions>
</MudCard>

<style>
    .bullet-answer::before {
        content: "•";
        margin-right: 5px;
    }
</style>
