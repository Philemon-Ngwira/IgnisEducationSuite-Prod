@page "/LessonDetails"
@using System.Text.Json
@using EDUSphereSharedProject.Models
@inject NavigationManager NavigationManager
@inject LessonService LessonService
@inherits AppBaseComponent
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Align="Align.Center" Typo="Typo.h4" Class="text-primary">
                📚 @Lesson.Title
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>


    <div class="lesson-content">
        <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />
        <MudCardContent>

            <MudGrid>
                <MudGrid Class="mb-3">
                    <MudItem xs="12" md="6">
                        <MudChip T="string" Color="Color.Primary" Icon="@Icons.Material.Filled.Person">
                            By: @salutation @Lesson.Teacher.LastName
                        </MudChip>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudChip T="string" Color="Color.Info" Icon="@Icons.Material.Filled.CalendarToday">
                            Released: @Lesson.DatePosted.Value.ToShortDateString()
                        </MudChip>
                    </MudItem>
                </MudGrid>

                <MudItem xs="12">
                    <MudChip T="string" Color="@(Lesson.LessonCompleted == 1 ? Color.Success : Color.Warning)"
                             Variant="Variant.Filled"
                             ToolTip="Lesson Status">
                        @(Lesson.LessonCompleted == 1 ? "Completed" : "Pending")
                    </MudChip>

                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-4 mb-4">
                @((MarkupString)LessonFormatter.FormatLessonContent(Lesson.Content))
            </MudPaper>

            <MudDivider Class="border border-secondary border-2 opacity-50 mb-3" />
            @if (LessonService.LessonMedia.Any())
            {
                <MudAlert Severity="Severity.Normal" Icon="@Icons.Material.Filled.Image">Lesson Media</MudAlert>
                <div class="gallery">
                    @foreach (var image in PagedImages)
                    {
                        <img src="@image.Url" class="gallery-img" @onclick="() => OpenModal(image.Url)" />
                    }
                </div>
                <div class="pagination">
                    <MudButton Variant="Variant.Outlined" Disabled="@(_currentPage == 1)" OnClick="PrevPage">Prev</MudButton>
                    <span>Page @_currentPage of @_totalPages</span>
                    <MudButton Variant="Variant.Outlined" Disabled="@(_currentPage == _totalPages)" OnClick="NextPage">Next</MudButton>
                </div>


            }
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DoneAll" Color="Color.Success" OnClick="MarkLessonAsComplete">
                Mark as Complete
            </MudButton>

            <MudRating @bind-SelectedValue="Rating" HoveredValueChanged="HandleHoveredValueChanged" MaxValue="5" />
            <MudText Typo="Typo.subtitle2" Class="mt-1">@LabelText</MudText>

        </MudCardActions>
    </div>
</MudCard>
<style>
    .lesson-content {
        margin-bottom: 20px;
    }

        .lesson-content h3, .lesson-content h4 {
            color: #0078d7;
        }

        .lesson-content p {
            margin-bottom: 10px;
        }

        .lesson-content ul {
            margin-top: 10px;
            margin-bottom: 10px;
        }



    /* A4 Paper Size Simulation */
    .lesson-content {
        width: 210mm; /* A4 width */
        height: 297mm; /* A4 height */
        margin: 0 auto; /* Center the content */
        padding: 20mm; /* Padding around the content */
        box-sizing: border-box; /* Include padding and border in the width and height */
        font-family: 'Times New Roman', serif; /* Common font for A4 documents */
        font-size: 12pt; /* Standard font size for reading */
        line-height: 1.5; /* Proper line height for readability */
        background: #fff; /* White background (like a paper) */
        border: 1px solid #ddd; /* Light border to simulate paper edges */
        overflow-y: auto; /* Enable vertical scrolling for overflow content */
        overflow-x: hidden; /* Prevent horizontal scrolling */
    }

    .gallery-img {
        width: 100px;
        margin: 5px;
        border-radius: 6px;
        cursor: pointer;
        transition: transform 0.2s;
    }

        .gallery-img:hover {
            transform: scale(1.05);
        }

</style>


@code {
    private bool IsModalOpen = false;

    private string SelectedImage = string.Empty;

    private int _currentPage = 1;
    private int _itemsPerPage = 5;
    private int selectedIndex;
    private IEnumerable<LessonMedium> PagedImages =>
     LessonService.LessonMedia.Skip((_currentPage - 1) * _itemsPerPage).Take(_itemsPerPage);
    private int _totalPages => (int)Math.Ceiling((double)LessonService.LessonMedia.Count / _itemsPerPage);
    bool hovered = false;
    protected int Rating = 0;
    private int? activeVal;
    protected Lesson Lesson = new();
    protected Student loggedInStudent = new();
    protected StudentCompletedLesson completedLesson = new();
    protected string salutation = string.Empty;
    [Inject] GenericServiceFactory _genericService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    protected bool isLoading = false;
    protected override void OnInitialized()
    {
        LoaderService.Show("Preparing lesson...");
        Lesson = LessonService.CurrentLesson;
        if (Lesson.Teacher.Gender == "Male")
        {
            salutation = "Mr.";

        }
        else
        {
            salutation = "Ms.";
        }
        LoaderService.Hide();
    }
    private void OpenModal(string image)
    {
        SelectedImage = image;
        IsModalOpen = true;
    }

    private void CloseModal()
    {
        SelectedImage = string.Empty;
        IsModalOpen = false;
    }
    private void NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
        }
    }
    private void ShowNextImage()
    {
        selectedIndex = (selectedIndex + 1) % LessonService.LessonMedia.Count;
        SelectedImage = LessonService.LessonMedia[selectedIndex].Url;
    }

    private void ShowPreviousImage()
    {
        selectedIndex = (selectedIndex - 1 + LessonService.LessonMedia.Count) % LessonService.LessonMedia.Count;
        SelectedImage = LessonService.LessonMedia[selectedIndex].Url;
    }

    private void PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
        }
    }
    protected async Task MarkLessonAsComplete()
    {
        LoaderService.Show("Completing...");
        completedLesson.StudentID = Lesson.StudentID;
        completedLesson.LessonID = Lesson.LessonID;

        completedLesson.StudentLessonCompletionID = Guid.NewGuid();
        var ser = _genericService.GetService<StudentCompletedLesson>();
        var result = await ser.PostAsync("api/Dynamic/PostEntity", "studentcompletedlesson", completedLesson);
        if (result.IsSuccess)
        {
            Snackbar.Add("Lesson Marked as completed");
        }
        //Update Rating

        await UpdateLessonRating();
        LoaderService.Hide();
    }
    protected async Task UpdateLessonRating()
    {
        UpdatedRating();
        Lesson.Teacher = null;
        Lesson.Class = null;

        var service = _genericService.GetService<Lesson>();
        var result = await service.UpdateAsync("api/Dynamic/UpdateEntity", "lesson", Lesson);
        if (result.IsSuccess)
        {
            Snackbar.Add("Completed Successfully", Severity.Success);
        }

    }


    private void HandleHoveredValueChanged(int? val) => activeVal = val;

    private void UpdatedRating()
    {
        if (Rating != 0)
        {
            //  Current rating and the number of ratings.
            int currentRating = Lesson.Rating.Value;
            int numberOfRatings = (Lesson.NumberOfRatings == null) ? 0 : Lesson.NumberOfRatings.Value;

            // Calculate the new average rating.
            int totalRating = currentRating * numberOfRatings + Rating;
            int newNumberOfRatings = 0;

            newNumberOfRatings = numberOfRatings + 1;

            // Calculate the new average (integer division)
            int newAverageRating = totalRating / newNumberOfRatings;

            // If necessary, handle rounding (depending on how you want to round the average)
            // Example: if you want to round up or down:
            int remainder = totalRating % newNumberOfRatings;
            if (remainder * 2 >= newNumberOfRatings) // Round up if more than half
            {
                newAverageRating++;
            }
            Lesson.Rating = newAverageRating;
            if (Lesson.NumberOfRatings == null)
            {
                Lesson.NumberOfRatings = 0;
                Lesson.NumberOfRatings = Lesson.NumberOfRatings + 1;
            }
        }
        else
        {
            if (Lesson.NumberOfRatings == null)
            {
                Lesson.NumberOfRatings = 0;
            }
            else
            {
                Lesson.NumberOfRatings = Lesson.NumberOfRatings;
            }
        }


    }
    private string LabelText => (activeVal ?? Rating) switch
    {
        1 => "Very bad",
        2 => "Bad",
        3 => "Sufficient",
        4 => "Good",
        5 => "Awesome!",
        _ => "Rate the lesson!"
    };
}
