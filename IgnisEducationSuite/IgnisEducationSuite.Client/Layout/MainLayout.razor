@using IgnisEducationSuite.Client.Pages.Shared
@using IgnisEducationSuite.Client.Services
@inherits LayoutComponentBase
@inject AppState AppState
@inject NavigationManager Nav
@using System.Security.Claims
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthProvider
<MudThemeProvider Theme="theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="ignis-layout">

    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle" />

        <MudText Typo="Typo.h6" Style="color: white;">
            @(string.IsNullOrEmpty(AppState.SchoolName)
                        ? "Ignis Education Suite"
                        : AppState.SchoolName)
        </MudText>
    </MudAppBar>

    @if (!IsAuthPage)
    {
        <MudDrawer Elevation="0"
                   @bind-Open="_drawerOpen"
                   Class="ignis-drawer"
                   ClipMode="DrawerClipMode.Docked">
            <NavMenu />
        </MudDrawer>
    }
    <MudMainContent Class="ignis-main-content">
        <IgnisEducationSuite.Client.Pages.Shared.GlobalLoader />

        @if (IsAuthPage)
        {
            @Body
        }
        else if (!_authChecked)
        {
            <InitializerLoader Message="Checking session..."
                               SubMessage="Verifying authentication securely..." />
        }
        else if (_isAuthenticated && !AppState.IsCoreInitialized)
        {
            <InitializerLoader Message="Loading your dashboard..."
                               SubMessage="Preparing lessons, students, and analytics..." />
        }
        else
        {
            @Body
        }
    </MudMainContent>

    <Footer Version="1.0.2" Environment="PROD" />

</MudLayout>

<Radzen.Blazor.RadzenComponents @rendermode="InteractiveAuto" />

@code {
    private bool _initialized;
    private bool _drawerOpen = false;
    private Theme theme = new();
    private bool _subscribed;
    private bool _authChecked = false;
    private bool _isAuthenticated = false;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        _initialized = true;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _isAuthenticated = user.Identity?.IsAuthenticated == true;

        if (_isAuthenticated)
        {
            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                _ = Task.Run(async () =>
                {
                    await AppState.EnsureInitializedAsync(userId, true);
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
        else
        {
            _authChecked = true;
            _isAuthenticated = false;
            StateHasChanged();
            return;
        }
        _authChecked = true;


        if (!_subscribed)
        {
            AppState.OnChange += StateHasChanged;
            _subscribed = true;
        }

        StateHasChanged();
    }

    private bool IsAuthPage =>
        Nav.Uri.Contains("Account/Login", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("Account/Register", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("Account/ForgotPassword", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("Account/ResetPassword", StringComparison.OrdinalIgnoreCase);
    public async ValueTask DisposeAsync()
    {
        if (_subscribed)
        {
            AppState.OnChange -= StateHasChanged;
            _subscribed = false;
        }

        await Task.CompletedTask;
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}