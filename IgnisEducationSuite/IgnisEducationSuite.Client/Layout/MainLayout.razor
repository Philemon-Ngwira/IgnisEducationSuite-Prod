@using IgnisEducationSuite.Client.Services
@using System.Security.Claims
@inherits LayoutComponentBase
@inject AppState AppState
@inject NavigationManager Nav

<MudThemeProvider Theme="theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="ignis-layout">
    @if (!partiallyIntialized)
    {
        <div class="d-flex flex-column align-center justify-center" style="height:100%;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />

        </div>
    }
    else
    {

        <MudAppBar>
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="DrawerToggle" />
            <MudText Typo="Typo.h6" Style="color: white;">
                @if (string.IsNullOrEmpty(AppState.SchoolName))
                {
                    @("Ignis Education Suite")
                }
                else
                {
                    @(AppState.SchoolName)
                }
            </MudText>
        </MudAppBar>
        @if (!IsAuthPage)
        {
            <MudDrawer Elevation="0"
                       @bind-Open="_drawerOpen"
                       Class="ignis-drawer" ClipMode="DrawerClipMode.Docked">
                <NavMenu />
            </MudDrawer>

        }


        <MudMainContent Class="ignis-main-content">
            <IgnisEducationSuite.Client.Pages.Shared.GlobalLoader />


            @if (!AppState.IsLicenseChecked)
            {
                <div class="d-flex flex-column align-center justify-center" style="height:100%;">
                    <MudProgressCircular Indeterminate="true" />
                    <MudText>Checking license...</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Loading: @AppState.IsLicenseLoading
                    </MudText>
                </div>
            }

            else if (!AppState.LicenseIsActive)
            {
                <!-- License invalid -->
                <div class="d-flex flex-column align-center justify-center" style="height:100%;">
                    <MudText Typo="Typo.h5" Color="Color.Error">
                        License Expired or Invalid
                    </MudText>
                    <MudText>Please contact your administrator.</MudText>
                </div>
            }
            else
            {
                <!-- Normal app -->
                @Body
            }
        </MudMainContent>
        <Footer Version="1.0.2" Environment="PROD" />
    }
</MudLayout>
<Radzen.Blazor.RadzenComponents @rendermode="InteractiveAuto" />
@code {

    private bool _drawerOpen = false;
    private bool partiallyIntialized = false;
    private Theme theme = new();
    private bool IsAuthPage =>
        Nav.Uri.Contains("Account/Login", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("Account/Register", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("Account/ForgotPassword", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("Account/ResetPassword", StringComparison.OrdinalIgnoreCase);

    [Inject] AuthenticationStateProvider authenticationStateProvider { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (!user.Identity.IsAuthenticated)
        {
            partiallyIntialized = true;
            return;
        }
        // 🔑 Always unblock layout for auth pages
        if (IsAuthPage)
        {
            partiallyIntialized = true;
            return;
        }

        if (user.Identity?.IsAuthenticated == true)
        {
            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                partiallyIntialized = await AppState.InitializeAsync(userId, true);
                AppState.OnChange += StateHasChanged;
            }
            else
            {
                partiallyIntialized = true;
            }
        }
        else
        {
            // Not authenticated + not an auth page → still render layout
            partiallyIntialized = true;
        }


    }


    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
