@using IgnisEducationSuite.Client.Services
@implements IDisposable
@inject NavigationManager NavigationManager
@inject AppState AppState


<MudNavMenu Class="ignis-nav">

    <!-- BRAND / LOGO -->
    <div class="nav-image-container">
        @if (!string.IsNullOrEmpty(AppState.SchoolLogo))
        {
            <MudImage Alt="School Logo"
                      Src="@($"data:image/jpeg;base64,{AppState.SchoolLogo}")"
                      Width="180"
                      Height="180" />
        }
        else
        {
            <MudImage Alt="Ignis Logo"
                      Src="/images/LogoW.png"
                      Width="180"
                      Height="180" />
        }
    </div>
    <AuthorizeView>
        <Authorized>

            @if (AppState.IsFullyInitialized)
            {
                @if (AppState.UserRoles.Count > 1)
                {
                    <MudSelect Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               T="string"
                               Label="Current Role"
                               Dense="true"
                               ValueChanged="RoleChanged">
                        @foreach (var role in AppState.UserRoles)
                        {
                            <MudSelectItem Value="@role">@role</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
                    Dashboard
                </MudNavLink>
                @switch (AppState.UserRole)
                {
                    case "SuperAdmin":
                        <MudNavGroup Icon="@Icons.Material.Filled.SupervisorAccount" Title="Administration">
                            <MudNavLink Href="ClientManagement" Icon="@Icons.Material.Filled.People">Client Management</MudNavLink>
                            <MudNavLink Href="ManageSchoolAdmins" Icon="@Icons.Material.Filled.Person">Client Admins</MudNavLink>
                            <MudNavLink Href="ClassManagement" Icon="@Icons.Material.Filled.Class">Class Management</MudNavLink>
                            <MudNavLink Href="ClassSchedules" Icon="@Icons.Material.Filled.Schedule">Class Schedules</MudNavLink>
                            <MudNavLink Href="UserManagement" Icon="@Icons.Material.Filled.SupervisedUserCircle">User Management</MudNavLink>
                            <MudNavLink Href="ReportCardManagement" Icon="@Icons.Material.Filled.AddCard">Report Card Preparations</MudNavLink>
                            <MudNavLink Href="ReportCards" Icon="@Icons.Material.Filled.Book">Report Cards</MudNavLink>
                        </MudNavGroup>
                        break;

                    case "Admin":
                        <MudNavGroup Icon="@Icons.Material.Filled.SupervisorAccount"
                                     Title="Administration"
                                     Disabled="!AppState.LicenseIsActive"
                                     Expanded="true">

                            <MudNavGroup Icon="@Icons.Material.Filled.VerifiedUser" Title="User Management">
                                <MudNavLink Href="UserManagement" Icon="@Icons.Material.Filled.SupervisedUserCircle">Users</MudNavLink>
                                <MudNavLink Href="StudentManagement" Icon="@MaterialDesignIcons.Normal.HumanMaleFemaleChild">Students</MudNavLink>
                                <MudNavLink Href="TeacherManagement" Icon="@Icons.Material.Filled.Person">Teachers</MudNavLink>
                            </MudNavGroup>

                            <MudDivider Class="my-4" />

                            <MudNavGroup Icon="@Icons.Material.Filled.School" Title="Academics">
                                <MudNavLink Href="term-settings" Icon="@Icons.Material.Filled.EditCalendar" ForceLoad="true">Term Settings</MudNavLink>
                                <MudNavLink Href="AcademicStructure" Icon="@Icons.Material.Filled.AccountTree" ForceLoad="true">Academic Structure</MudNavLink>
                                <MudNavLink Href="ClassManagement" Icon="@Icons.Material.Filled.Class">Classes</MudNavLink>
                                <MudNavLink Href="ClassSchedules" Icon="@MaterialDesignIcons.Normal.Timetable">Schedules</MudNavLink>
                                <MudNavLink Href="ReportCardManagement" Icon="@MaterialDesignIcons.Normal.CardAccountDetails">Report Card Prep</MudNavLink>
                                <MudNavLink Href="ReportCards" Icon="@Icons.Material.Filled.Book">Report Cards</MudNavLink>
                                <MudNavLink Href="Library" Icon="@Icons.Material.Filled.LocalLibrary">Library</MudNavLink>
                            </MudNavGroup>

                            <MudDivider Class="my-4" />

                            <MudNavGroup Icon="@Icons.Material.Filled.Hotel" Title="Operations">
                                <MudNavGroup Icon="@MaterialDesignIcons.Normal.Bus" Title="Transport">

                                    <MudNavLink Href="BusStaffManagement" Icon="@MaterialDesignIcons.Normal.NaturePeople">Bus Staff</MudNavLink>
                                    <MudNavLink Href="fleet" Icon="@MaterialDesignIcons.Normal.BusSchool">Fleet & Registry</MudNavLink>
                                    <MudNavLink Href="RoutePlanning" Icon="@MaterialDesignIcons.Normal.MapMarkerPath">Route Planning</MudNavLink>
                                    <MudNavLink Href="tripManagment" Icon="@MaterialDesignIcons.Normal.Calendar">Trip Schedule</MudNavLink>
                                    <MudNavLink Href="DriverPortal" Icon="@MaterialDesignIcons.Normal.Steering">Portal</MudNavLink>

                                </MudNavGroup>
                                <MudNavGroup Icon="@Icons.Material.Filled.DinnerDining" Title="Dining">
                                    <MudNavLink Href="kitchen-staff" Icon="@MaterialDesignIcons.Normal.ChefHat">KitchenStaff</MudNavLink>
                                    <MudNavLink Href="KitchenInventory" Icon="@MaterialDesignIcons.Normal.StorageTank">Kitchen Inventory</MudNavLink>
                                    <MudNavLink Href="DiningManagement" Icon="@Icons.Material.Filled.Dining">Dining Hall</MudNavLink>
                                </MudNavGroup>

                                <MudNavGroup Icon="@Icons.Material.Filled.Warehouse" Title="Hostels">
                                    <MudNavLink Href="Deans" Icon="@Icons.Material.Filled.Man">Deans & Wardens</MudNavLink>
                                    <MudNavLink Href="HostelManagement" Icon="@Icons.Material.Filled.BedroomChild">Hostels</MudNavLink>
                                    <MudNavLink Href="HostelRoomMaintainance" Icon="@Icons.Material.Filled.Build">Maintenance</MudNavLink>
                                </MudNavGroup>
                                <MudNavGroup Icon="@Icons.Material.Filled.LocalHospital" Title="Clinic">
                                    <MudNavLink Href="clinic-staff" Icon="@Icons.Material.Filled.MedicalServices">Clinic Staff</MudNavLink>
                                    <MudNavLink Href="Clinics" Icon="@MaterialDesignIcons.Normal.Hospital">Clinics</MudNavLink>
                                    <MudNavLink Href="MedicalInventory" Icon="@Icons.Material.Filled.Medication">Inventory</MudNavLink>
                                </MudNavGroup>
                            </MudNavGroup>
                            <MudNavGroup Icon="@MaterialDesignIcons.Normal.BankPlus" Title="Finance">
                                <MudNavLink Href="finance-management" Icon="@MaterialDesignIcons.Normal.Finance">Finance Management</MudNavLink>
                                <MudNavLink Href="FinancePortal" Icon="@MaterialDesignIcons.Normal.BankCircle">Finance Portal</MudNavLink>
                                <MudNavLink Href="finance/dashboard" Icon="@MaterialDesignIcons.Normal.ChartPie">Finance Report</MudNavLink>
                            </MudNavGroup>

                            <MudDivider Class="my-4" />

                            <MudNavLink Href="MainChat" Icon="@Icons.Material.Filled.ChatBubble">
                                Ignis Communication Hub
                            </MudNavLink>

                            <MudNavLink Href="UserGuide" Icon="@Icons.Material.Filled.Info">
                                Guide
                            </MudNavLink>

                        </MudNavGroup>
                        break;

                    case "Teacher":
                        <MudNavGroup Icon="@Icons.Material.Filled.Hub" Title="Teacher Portal">
                            <MudNavLink Href="createliveclass" Icon="@Icons.Material.Filled.LiveTv">Live Classes</MudNavLink>
                            <MudNavLink Href="LessonManagement" Icon="@Icons.Material.Filled.School">Lessons</MudNavLink>
                            <MudNavLink Href="AsssignmentManagement" Icon="@Icons.Material.Filled.Work">Assignments</MudNavLink>
                            <MudNavLink Href="AssingmentChecking" Icon="@Icons.Material.Filled.Checklist">Mark Assignments</MudNavLink>
                            <MudNavLink Href="ExamQuizTestManagement" Icon="@Icons.Custom.FileFormats.FileDocument">Exams</MudNavLink>
                            <MudNavLink Href="ExamMarking" Icon="@Icons.Material.Filled.Checklist">Mark Exams</MudNavLink>
                            <MudNavLink Href="StudentAttendance" Icon="@Icons.Custom.Uncategorized.AlertSuccess">Attendance</MudNavLink>
                            <MudNavLink Href="CourseManagement" Icon="@Icons.Material.Filled.LibraryBooks">Courses</MudNavLink>
                            <MudNavLink Href="Library" Icon="@Icons.Material.Filled.LocalLibrary">Library</MudNavLink>
                            <MudNavLink Href="ReportCards" Icon="@Icons.Material.Filled.Book">Report Cards</MudNavLink>
                            <MudNavLink Href="ReportCardManagement" Icon="@MaterialDesignIcons.Normal.CardAccountDetails">Report Card Prep</MudNavLink>
                            <MudNavLink Href="MainChat" Icon="@Icons.Material.Filled.ChatBubbleOutline">Communication</MudNavLink>
                        </MudNavGroup>
                        break;

                    case "Student":
                        <MudNavGroup Icon="@Icons.Material.Filled.Mediation" Title="Student Portal">
                            <MudNavLink Href="StudentLessons" Icon="@Icons.Material.Filled.Class">Lessons</MudNavLink>

                            <MudBadge Content="@AppState.NewAssignmentsCount"
                                      Visible="AppState.NewAssignmentsCount > 0"
                                      Color="Color.Primary"
                                      Overlap="true">
                                <MudNavLink Href="StudentAssignments" Icon="@Icons.Material.Filled.HomeWork">
                                    Assignments
                                </MudNavLink>
                            </MudBadge>

                            @if (!AppState.HideStudentDashboard)
                            {
                                <MudNavLink Href="ReportCards" Icon="@Icons.Material.Filled.Book">Report Cards</MudNavLink>
                                <MudNavLink Href="Exams" Icon="@Icons.Material.Filled.Pages">Exams</MudNavLink>
                                <MudNavLink Href="StudentResults" Icon="@MaterialDesignIcons.Normal.FileDocumentMultiple">Results</MudNavLink>
                            }

                            <MudNavLink Href="Library" Icon="@Icons.Material.Filled.LocalLibrary">Library</MudNavLink>
                            <MudNavLink Href="MainChat" Icon="@Icons.Material.Filled.ChatBubbleOutline">Communication</MudNavLink>
                        </MudNavGroup>
                        break;

                    case "Parent":
                        <MudNavGroup Icon="@Icons.Material.Filled.Mediation" Title="Parent Portal">
                            <MudNavLink Href="ParentTransportPortal" Icon="@Icons.Material.Filled.BusAlert">Transport Portal</MudNavLink>
                            <MudNavLink Href="ReportCards" Icon="@Icons.Material.Filled.Book">Report Cards</MudNavLink>
                            <MudNavLink Href="MainChat" Icon="@Icons.Material.Filled.ChatBubbleOutline">Communication</MudNavLink>
                        </MudNavGroup>
                        break;
                    case "Clinic Staff":
                        <MudNavGroup Icon="@Icons.Material.Filled.LocalHospital" Title="Clinic Portal">
                            <MudNavLink Href="MedicalInventory" Icon="@Icons.Material.Filled.Medication">Inventory</MudNavLink>
                            <MudNavLink Href="ClinicVisits" Icon="@MaterialDesignIcons.Normal.Doctor">Clinic Visit</MudNavLink>
                            <MudNavLink Href="MainChat" Icon="@Icons.Material.Filled.ChatBubbleOutline">Communication</MudNavLink>
                        </MudNavGroup>
                        break;
                    case "TransportStaff":
                        <MudNavGroup Icon="@Icons.Material.Filled.EmojiTransportation" Title="Driver Portal">
                            <MudNavLink Href="DriverPortal" Icon="@MaterialDesignIcons.Normal.Steering">Portal</MudNavLink>
                            <MudNavLink Href="MainChat" Icon="@Icons.Material.Filled.ChatBubbleOutline">Communication</MudNavLink>
                        </MudNavGroup>

                        break;
                    case "Dean":
                        <MudNavLink Href="HostelRoomMaintainance" Icon="@Icons.Material.Filled.Build">Hostel Issues</MudNavLink>
                        <MudNavLink Href="ReportCardManagement" Icon="@MaterialDesignIcons.Normal.CardAccountDetails">Report Card Prep</MudNavLink>
                        break;
                    case "Principal":
                        <MudNavLink Href="ReportCardManagement" Icon="@MaterialDesignIcons.Normal.CardAccountDetails">Report Card Prep</MudNavLink>
                        break;
                }
            }

            <MudDivider Class="my-6" />

            <!-- ACCOUNT -->
            <MudNavGroup Icon="@Icons.Material.Filled.AccountCircle" Title="Account">
                <MudNavLink Href="Profile"
                            Disabled="!AppState.LicenseIsActive"
                            Icon="@Icons.Material.Filled.Person">
                    Profile
                </MudNavLink>

                <MudForm Action="Account/Logout" Method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@HomeURL" />
                    <MudNavLink>
                        <MudButton ButtonType="ButtonType.Submit"
                                   EndIcon="@Icons.Material.Filled.Logout">
                            Logout
                        </MudButton>
                    </MudNavLink>
                </MudForm>
            </MudNavGroup>

            <MudNavLink Href="https://www.philtiaraenterprises.com"
                        Icon="@Icons.Material.Filled.Info">
                About Ignis
            </MudNavLink>

        </Authorized>

        <NotAuthorized>
            <MudNavLink Href="Account/Login" Icon="@Icons.Material.Filled.Login">
                Login
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>

</MudNavMenu>


@code {
    private string HomeURL = "Account/Login";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        AppState.OnChange += StateHasChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        AppState.OnChange -= StateHasChanged;
    }

    private void RoleChanged(string role)
    {
        AppState.UserRole = role;
        AppState.SwitchRole(role);
        NavigationManager.NavigateTo("/", forceLoad: false); // soft navigation
    }
}

<style>
    .nav-image-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 16px 0;
    }
</style>
