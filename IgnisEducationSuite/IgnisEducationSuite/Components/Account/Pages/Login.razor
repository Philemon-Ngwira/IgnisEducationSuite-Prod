                            </div>
                            <p class="forgot-pass mb-0">Forgot Password?, Contact Your System Admin For a Password Reset</p>
                            <button class="btn btn-primary w-100" type="submit">Sign in</button>
                            <!--end col-->
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- JAVASCRIPT -->
    <script src="libs/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>

</html>
