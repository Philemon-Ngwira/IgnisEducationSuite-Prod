<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="favicon.png" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />

    <!-- App styles -->
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="IgnisEducationSuite.styles.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/Css/MainLoader.css" />
    <link rel="stylesheet" href="/Css/Spinner.css" />
    <link rel="stylesheet" href="/Css/ReportCardStyleSheet.css" />
    <link rel="stylesheet" href="/Css/TextFields.css" />
    <link rel="stylesheet" href="/Css/main.scss" />
    <link rel="stylesheet" href="/Css/TimeTable.css" />
    <link rel="stylesheet" href="/Css/LibraryBook.css" />
    <link rel="stylesheet" href="/Css/NotAuthorizedCss.css" />
    <link rel="stylesheet" href="/Css/IntructionText.css" />
    <link rel="stylesheet" href="/Css/style.css" />
    <link rel="stylesheet" href="/Css/remixicon.css" />
    <link rel="stylesheet" href="/Css/ZoomCustom.css" />

    <!-- QuillJS Styles -->
    <link href="//cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <link href="//cdn.quilljs.com/1.3.6/quill.bubble.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Lora:ital,wght@0,400..700;1,400..700&family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />

    <!-- MudBlazor -->
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- Zoom CSS -->
    <link type="text/css" rel="stylesheet" href="https://source.zoom.us/3.4.5/css/bootstrap.css" />
    <link type="text/css" rel="stylesheet" href="https://source.zoom.us/3.4.5/css/react-select.css" />

    <link href="manifest.json" rel="manifest" />
    <link rel="apple-touch-icon" sizes="512x512" href="icon-512.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="icon-apple-180.png">
    <link rel="apple-touch-icon" sizes="152x152" href="icon-apple-152.png">
    <link rel="apple-touch-icon" sizes="120x120" href="icon-apple-120.png">
    <link rel="apple-touch-icon" sizes="76x76" href="icon-apple-76.png">

    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <div class="page-container">
        <main class="content-container">
            <div id="app">
                <div id="loading-screen">
                    <img src="/images/LogoW.png" alt="Phoenix EduSphere Logo" />
                </div>
            </div>

            <Routes @rendermode="@RenderModeForPage" />
        </main>

       
    </div>

    <!-- Blazor -->
    <script src="_framework/blazor.web.js"></script>

    <!-- MudBlazor -->
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <!--Downloader-->
    <script src="/js/Downloader.js"></script>

    <!-- QuillJS -->
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script src="_content/Blazored.TextEditor/quill-blot-formatter.min.js"></script>
    <script src="_content/Blazored.TextEditor/Blazored-BlazorQuill.js"></script>

    <!-- Other libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
    <script src="_content/ChartJs.Blazor.Fork/ChartJsBlazorInterop.js"></script>
    <script src="/js/mainloader.js"></script>
    <script type="text/javascript" src="https://www.google.com/books/jsapi.js"></script>
    <script src="/js/GoogleBooksPreview.js"></script>

    <!-- Dependencies for client view and component view -->
    <script src="https://source.zoom.us/4.0.0/lib/vendor/react.min.js"></script>
    <script src="https://source.zoom.us/4.0.0/lib/vendor/react-dom.min.js"></script>
    <script src="https://source.zoom.us/4.0.0/lib/vendor/redux.min.js"></script>
    <script src="https://source.zoom.us/4.0.0/lib/vendor/redux-thunk.min.js"></script>
    <script src="https://source.zoom.us/4.0.0/lib/vendor/lodash.min.js"></script>

    <!-- For Client View -->
    <script src="https://source.zoom.us/4.0.0/zoom-meeting-embedded-4.0.0.min.js"></script>



    <!-- Zoom Initialization -->
    <script src="/js/Zoom.js"></script>

    <script>navigator.serviceWorker.register('service-worker.js');</script>


</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? RenderModeForPage => HttpContext.Request.Path.StartsWithSegments("/Account")
        ? null
        : new InteractiveAutoRenderMode(prerender: true);
}
